    {% when 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {% when 'map-pin' %}<path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>
    {% when 'help' %}<circle cx="12" cy="12" r="9"/><path d="M9.6 9a2.6 2.6 0 1 1 4.4 1.9c-1.2.9-2 1.4-2 3.1"/><path d="M12 18h.01"/>
    {% when 'truck' %}<path d="M3 6h11v10H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
    {% when 'return' %}<path d="m9 7-4 4 4 4"/><path d="M5 11h9a5 5 0 0 1 5 5v2"/>
    {% when 'info' %}<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/>
    {% when 'book' %}<path d="M4 4h6a3 3 0 0 1 3 3v13a3 3 0 0 0-3-3H4z"/><path d="M20 4h-6a3 3 0 0 0-3 3v13a3 3 0 0 1 3-3h6z"/>
    {% when 'arrow-right' %}<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
    {% when 'instagram' %}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r=".8" fill="currentColor" stroke="none"/>
    {% when 'youtube' %}<path d="M21 12s0-4-1-5c-1-1-8-1-8-1s-7 0-8 1-1 5-1 5 0 4 1 5 8 1 8 1 7 0 8-1 1-5 1-5Z"/><path d="m10 9 5 3-5 3Z" fill="currentColor" stroke="none"/>
    {% when 'facebook' %}<path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v5h4v-5h3l1-4h-4V9c0-.7.3-1 1-1Z"/>
    {% when 'chevron-down' %}<path d="m6 9 6 6 6-6"/>
    {% when 'search' %}<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
    {% when 'user' %}<circle cx="12" cy="7" r="4"/><path d="M20 21a8 8 0 0 0-16 0"/>
    {% when 'menu' %}<path d="M4 6h16M4 12h16M4 18h16"/>
    {% else %}<circle cx="12" cy="12" r="9"/>
  {% endcase %}
</svg>