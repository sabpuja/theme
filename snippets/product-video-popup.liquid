<!-- /snippets/product-video-popup.liquid -->
<div class="reveal product-video-popup" id="product-video-popup" data-product-video-popup data-reveal data-animation-in="fade-in fast" data-animation-out="fade-out fast">
  <div class="video-popup-content">
    <iframe data-popup-src-video src="" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
  </div>
  <a class="close-reveal" aria-label="Close" data-close>
    <svg class="svg-icon"><use xlink:href="#icon-close" /></svg>
  </a>
</div>
