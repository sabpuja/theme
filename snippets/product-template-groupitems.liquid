<div class="product-newgroupitems">
{%- include 'breadcrumbs' -%}
{%- if section.blocks.size > 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.position == 'left_sidebar' -%}
      {%- assign left_sidebar = true -%}
    {%- elsif block.settings.position == 'right_sidebar' -%}
      {%- assign right_sidebar = true -%}
    {%- elsif block.settings.position == 'top_content' -%}
      {%- assign top_content = true -%}
    {%- elsif block.settings.position == 'bottom_content' -%}
      {%- assign bottom_content = true -%}
    {%- elsif block.settings.position == 'top_container' -%}
      {%- assign top_container = true -%}
    {%- elsif block.settings.position == 'bottom_container' -%}
      {%- assign bottom_container = true -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign product_thumb_size = section.settings.image_width | append: 'x' | append: section.settings.image_height -%}
{%- if top_container -%}
  <div class="grid-container">
    <div class="layout-top-container">
      {%- for block in section.blocks -%}
        {%- if block.settings.position == 'top_container' -%}
          {%- include block.type -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
<div itemscope itemtype="http://schema.org/Product">
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}
  <meta itemprop="name" content="{{ product.title }}{% unless product.has_only_default_variant %} - {{ current_variant.title }}{% endunless %}">
  <meta itemprop="url" content="{{ shop.url }}{{ current_variant.url }}">
  <meta itemprop="brand" content="{{ product.vendor }}">
  <meta itemprop="image" content="{{ featured_image | img_url: product_thumb_size }}">
  <meta itemprop="description" content="{{ page_description | escape }}">
  <div class="hide mobile-info">
    {% if section.settings.show_vendor %}
    <div class="cell product-vendor">                
      <span class="product-info-text">{{ product.vendor }}</span>
    </div>
    {% endif %}
    <h1 class="product-title">{{ product.title }}</h1>
    <div class="group-price-stock grid-x grid-margin-x">
      <div class="product-price-wrapper cell small-12 medium-12 large-6 xlarge-6 xxlarge-6 xxxlarge-6" data-price-wrapper>
        <span class="product-price" data-product-price>
          {{ current_variant.price | money }}
        </span>
        {% if product.compare_at_price_max > product.price %}
        <del class="product-price-old" data-product-compare-price>
          {% if current_variant.compare_at_price > current_variant.price %}
          {{ current_variant.compare_at_price | money }}
          {%- endif -%}
        </del>
        {%- endif -%}
      </div>
      {%- if section.settings.show_inventory -%}
      <div class="cell product-inventory cell small-12 medium-12 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
        {% if current_variant.available %}
        {%- assign available = 'products.product.in_stock' | t -%}
        {%- assign availabletext = 'sli sli-check' -%}                  
        {%- else -%}
        {%- assign available = 'products.product.out_stock' | t -%}
        {%- assign availabletext = 'sli sli-close' -%}
        {%- endif -%}
        <span class="product-info-icon"><em class="{{ availabletext }}"></em></span>
        <span class="product-info-text" data-product-inventory data-in-stock="{{ 'products.product.in_stock' | t }}" data-out-stock="{{ 'products.product.out_stock' | t }}">{{ available }}</span>
        {% if section.settings.show_randomstock and current_variant.available %}
        <span class="product-info-stock">{{ 'products.product.only' |t }} <span class="prodstock" data-prodstock data-prodstock-min="{{ section.settings.randomstockmin }}" data-prodstock-max="{{ section.settings.randomstockmax }}"></span> {{ 'products.product.left' |t }}</span>
        {% endif %}
      </div>
      {%- endif -%}
    </div>
    {% if section.settings.show_countdowntimer %}
    <div class="countdown-timer" data-timer data-timer-languages='{"days": "d", "hours": "h", "minutes": "m", "seconds": "s"}' data-timervalue="{{ section.settings.ct_timer }}">
      <div class="ct-title">{{ section.settings.ct_title }}</div>
      <div class="timer">
        <div id="countdowntimer" data-shipcountdown></div>
      </div>
    </div>
    {% endif %}              
    {%- if section.settings.show_review -%}
      <div class="product-rating">
        <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
        <span class="product-rating-add"><a href="#product-detail-review" data-review-anchor>{{ 'products.review.add' | t }}</a></span>
      </div>
    {%- endif -%}
  </div>
  <div class="grid-container">
    <div class="grid-x grid-margin-x">
      {%- if left_sidebar -%}
        <div class="cell small-12 large-3 layout-left-sidebar show-for-large">
          {%- for block in section.blocks -%}
            {%- if block.settings.position == 'left_sidebar' -%}
              {%- include block.type -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="cell auto layout-content">        
        <div class="grid-x grid-margin-x">
          <div class="cell small-12 medium-12 large-6 left-area" id="left-area-sticky">
            {%- if product.images.size -%}
              <div class="grid-x grid-margin-x is-relactive" data-sticky='{
                "stickTo": "#left-area-sticky",
                "top": 120,
                "bottom":50,
                "responsive": {
                  "801": {
                    "disable": true
                  }
                }
              }'> 
                <div class="cell small-12 large-12">
                  <div class="product-gallery carousel" data-product-gallery>
                    <div class="carousel-wrapper carousel-nav-middle">
                      <div class="swiper-container" data-carousel-container>
                        <div class="swiper-wrapper">
                          {%- assign image_item = 0 -%}
                          {%- for media in product.media -%}
                            <div class="swiper-slide swiper-slide-gallery height-100" data-carousel-item="{{ media.src | handle }}">
                              {% include 'media', media: media %}
                            </div>
                          {%- endfor -%}
                        </div>
                      </div>
                      <div class="carousel-navigation carousel-nav-prev show-for-large" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                      <div class="carousel-navigation carousel-nav-next show-for-large" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                    </div>
                    <div class="carousel-pagination hide-for-large" data-carousel-pagination></div>
                    <a class="product-zoom-in hide-for-large" data-product-gallery-zoom><em class="sli sli-magnifier-add"></em></a>
                    {% if section.settings.show_visitor %}
                      <div class="product-visitor">
                        <em class="sli sli-eye"></em> <span data-visitor data-visitormin="{{ section.settings.visitormin }}" data-visitormax="{{ section.settings.visitormax }}"></span> {{ 'products.product.visitor' | t}}
                      </div>
                    {% endif %}
                  </div>
                </div>   
                <div class="product-thumbnail show-for-large product-slider" data-product-thumbnail>
                  <div class="flex-container align-middle">
                    <div class="product-thumbnail-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                    <div class="swiper-container" data-carousel-container>
                      <div class="swiper-wrapper">
                        {%- assign thumb_height = section.settings.image_height | times: 500 | divided_by: section.settings.image_width | round -%}
                        {%- assign thumb_size = '500x' | append: thumb_height -%}
                        {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
                          
                        {%- for media in product.media -%}
                          <div class="swiper-slide" data-carousel-item="{{ media.src | handle }}">
                            {% include 'media-thumbnail', media: media %}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                    <div class="product-thumbnail-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
          <div class="cell small-12 medium-12 large-6">
            <div class="product-info-container" itemprop="offers" itemscope itemtype="http://schema.org/Offer" data-product-container>
              <meta itemprop="priceCurrency" content="{{ shop.currency }}">
              <meta itemprop="price" content="{{ current_variant.price | divided_by: 100.00 }}">
              <link itemprop="available" href="http://schema.org/{% if current_variant.available %}InStock{%- else -%}OutOfStock{%- endif -%}">
              
              {%- if top_content -%}
              <div class="layout-top-content">
                {%- for block in section.blocks -%}
                {%- if block.settings.position == 'top_content' -%}
                {%- include block.type -%}
                {%- endif -%}
                {%- endfor -%}
              </div>
              {%- endif -%}
              
              <h1 class="product-title">{{ product.title }}</h1>
              <div class="group-price-stock grid-x grid-margin-x">
                <div class="product-price-wrapper cell small-12 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6" data-price-wrapper>
                  <span class="product-price" data-product-price>
                    {{ current_variant.price | money }}
                  </span>
                  {% if product.compare_at_price_max > product.price %}
                  <del class="product-price-old" data-product-compare-price>
                    {% if current_variant.compare_at_price > current_variant.price %}
                    {{ current_variant.compare_at_price | money }}
                    {%- endif -%}
                  </del>
                  {%- endif -%}
                </div>
                {%- if section.settings.show_inventory -%}
                <div class="cell product-inventory cell small-12 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                  {% if current_variant.available %}
                  {%- assign available = 'products.product.in_stock' | t -%}
                  {%- assign availabletext = 'sli sli-check' -%}                  
                  {%- else -%}
                  {%- assign available = 'products.product.out_stock' | t -%}
                  {%- assign availabletext = 'sli sli-close' -%}
                  {%- endif -%}
                  <span class="product-info-icon"><em class="{{ availabletext }}"></em></span>
                  <span class="product-info-text" data-product-inventory data-in-stock="{{ 'products.product.in_stock' | t }}" data-out-stock="{{ 'products.product.out_stock' | t }}">{{ available }}</span>
                  {% if section.settings.show_randomstock and current_variant.available %}
                  <span class="product-info-stock">{{ 'products.product.only' |t }} <span class="prodstock" data-prodstock data-prodstock-min="{{ section.settings.randomstockmin }}" data-prodstock-max="{{ section.settings.randomstockmax }}"></span> {{ 'products.product.left' |t }}</span>
                  {% endif %}
                </div>
                {%- endif -%}
              </div>
              {% if section.settings.show_countdowntimer %}
              <div class="countdown-timer" data-timer data-timer-languages='{"days": "d", "hours": "h", "minutes": "m", "seconds": "s"}' data-timervalue="{{ section.settings.ct_timer }}">
                <div class="ct-title">{{ section.settings.ct_title }}</div>
                <div class="timer">
                  <div id="countdowntimer" data-shipcountdown></div>
                </div>
              </div>
              {% endif %}              
              {%- if section.settings.show_review -%}
              <div class="product-rating">
                <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
                <span class="product-rating-add"><a href="#product-detail-review" data-review-anchor>{{ 'products.review.add' | t }}</a></span>
              </div>
              {%- endif -%}
              {% if section.settings.show_earnpoints %}
              {% assign point = current_variant.price | divided_by: 200 %}
              <div class="product-earnpoints">
                <em class="sli sli-diamond"></em> <span class="earnpoints-text">{{ 'products.product.earn_points' | t : point: point }}</span>
                <a href="#" data-product-learnmore>{{ 'products.product.learn_more' |t }}</a>
                {% include 'product-learnmore-popup' %}
              </div>
              {% endif %}                            
              
              <div data-desktop-product-form-area>                
                <form action="/cart/add" method="post" enctype="multipart/form-data" class="product-form" data-product-form data-add-cart-bundle-new-form>
                  {% if section.settings.show_bundle %}
                  <div class="product-discount">
                    <div class="product-discount-load">
                      <div class="loader position-absolute flex-container align-center-middle hide" data-discount-loader>
                        <img src="{{ 'icon-loader-clock.svg' | asset_url }}" alt="loader"/>
                      </div>
                    </div>
                    <div class="product-discount-group">
                      <div class="collection-discount-heading">
                        <div class="item-info">{{ "products.product.group_heading.product" |t }}</div>
                        <div class="item-variant">{{ "products.product.group_heading.qty" |t }}</div>
                        <div class="item-prices">{{ "products.product.group_heading.price" |t }}</div>
                      </div>
                      <div class="product-discount-content" data-product-discount2 data-product-discount2-info='{"price": "{{ current_variant.price }}", "id": "{{ product.id }}"}' data-product-discount-tag="{%- for tag in product.tags -%}{%- if tag contains 'discount:' -%}{{ tag }}{%- break -%}{%- endif -%}{%- endfor -%}"></div>
                      <div class="product-discount-price">
                        <span class="product-discount-text">{{ 'products.product.priceforall' |t }}</span>
                        <span class="" data-product-discount2-sumprice="0"><span class="money">$0.00</span></span>
                      </div>
                    </div>
                  </div>
                  {% endif %}
                  <button type="submit" name="add" class="product-add-cart" {% unless current_variant.available %}disabled="disabled"{% endunless %} data-product-add-cart-form-discount data-add-cart-bundle-new data-product-add-cart data-placeholder="{{'general.button.add_to_cart' | t}}" data-adding-message="{{'general.button.adding_to_cart' | t}}" data-added-message="{{'general.button.added_to_cart' | t}}">
                    <span data-product-add-cart-text>
                      {%- if current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                    <small class="progress secondary"><small class="progress-meter"></small></small>
                  </button>
                  {% if section.settings.show_shipping %}
                  <div class="product-shippinginfo">
                    {{ 'products.product.order_next_html' | t }}<span data-shipdate data-shipdatevalue="{{ section.settings.shippingdate }}"></span>
                  </div>
                  {% endif %}
                  
                  {% if section.settings.show_details %}
                  <div class="details-area">
                    {% if section.settings.detail_title %}<div class="title-area">{{ section.settings.detail_title }}</div>{% endif %}
                    <div class="content-area">
                      <ul>
                        {%- if section.settings.show_sku -%}
                        <li class="product-sku">
                          <span class="product-info-title">{{ 'products.product.sku' | t }}</span>
                          <span class="product-info-text" data-product-sku>{{ current_variant.sku }}</span>
                        </li>              
                        {%- endif -%}
                        {% if section.settings.show_vendor %}
                        <li class="product-vendor">   
                          <span class="product-info-title">{{ 'products.product.vendor' | t }}</span>
                          <span class="product-info-text">{{ product.vendor }}</span>
                        </li>
                        {% endif %}
                        {% if section.settings.show_type %}
                        <li class="product-type">   
                          <span class="product-info-title">{{ 'products.product.type' | t }}</span>
                          <span class="product-info-text">{{ product.type }}</span>
                        </li>
                        {% endif %}
                        {%- if section.settings.show_inventory -%}
                        <li class="product-inventory">
                          {% if current_variant.available %}
                          {%- assign available = 'products.product.in_stock' | t -%}
                          {%- else -%}
                          {%- assign available = 'products.product.out_stock' | t -%}
                          {%- endif -%}
                          <span class="product-info-title">{{ 'products.product.available' | t }}:</span>
                          <span class="product-info-text" data-product-inventory data-in-stock="{{ 'products.product.in_stock' | t }}" data-out-stock="{{ 'products.product.out_stock' | t }}">{{ available }}</span>
                        </li>
                        {%- endif -%}
                      </ul>
                    </div>
                  </div>
                  {% endif %}
                  
                  {% if section.settings.show_description %}
                  <div class="description-area">
                    {% if section.settings.desc_title %}<div class="title-area">{{ section.settings.desc_title }}</div>{% endif %}
                    <div class="content-area">
                      {{ product.description }}
                    </div>
                  </div>
                  {% endif %}                                    
                </form>                
                
                {%- if section.settings.show_share_buttons -%}
                <div class="product-widget-item product-widget-sharing text-center">
                  <div class="product-widget-item-text">{{ 'general.button.share' | t }}</div>
                  {%- include 'social-sharing', share_title: product.title, share_permalink: product.url, share_image: product -%}
                </div>
                {%- endif -%} 
                
                {% if section.settings.show_customimage %}
                <div class="product-safecheckout">
                  <div class="safecheckout-title">{{ section.settings.customimagetext }}</div>
                  <div class="safecheckout-image">
                    <img src="{{ section.settings.customimage | img_url: 'master' }}" alt="{{ section.settings.customimage.alt }}" />
                  </div>
                </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>                

        {%- if bottom_content -%}
          <div class="layout-bottom-content">
            {%- for block in section.blocks -%}
              {%- if block.settings.position == 'bottom_content' -%}
                {%- include block.type -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        
        {%- if section.settings.show_review -%}
        <div class="product-review">
          <div class="heading">
            <span>
              {{ 'products.tab.review' | t }}
            </span>
          </div>
          <div id="product-detail-review">
            <div id="shopify-product-reviews" data-id="{{product.id}}">{{ product.metafields.spr.reviews }}</div>
          </div>
        </div>
        {%- endif -%}
      </div>
      {%- if right_sidebar -%}
        <div class="cell small-12 large-3 layout-right-sidebar show-for-large">
          {%- for block in section.blocks -%}
            {%- if block.settings.position == 'right_sidebar' -%}
              {%- include block.type -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
<a class="product-buy flex-container align-center-middle hide" data-toggle="product-form"><em class="sli sli-basket"></em></a>
{%- if bottom_container -%}
  <div class="grid-container">
    <div class="layout-bottom-container">
      {%- for block in section.blocks -%}
        {%- if block.settings.position == 'bottom_container' -%}
          {%- include block.type -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
<div id="product-form" class="layout-mobile-overlap reveal full" data-reveal data-overlap-mobile data-v-offset="0" data-h-offset="0" data-overlay="false" data-animation-in="fade-in fast" data-animation-out="fade-out fast" data-enable-padding="true">
  {%- assign map_to = 'product-form' -%}
  {%- capture mobile_header_left -%}
    <a class="header-button-back display-inline-block" data-close="product-form">
      <svg class="svg-icon">
        <use xlink:href="#icon-arrow-left" />
      </svg>
    </a>
  {%- endcapture -%}
  {%- include 'header-mobile-overlap' -%}
  <div class="product-form-container" data-mobile-product-form-area></div>
</div>
<div class="pswp" tabindex="-1" role="dialog" aria-hidden="true" data-product-pswp>
  <div class="pswp__bg"></div>
  <div class="pswp__scroll-wrap">
    <div class="pswp__container">
      <div class="pswp__item"></div>
      <div class="pswp__item"></div>
      <div class="pswp__item"></div>
    </div>
    <div class="pswp__ui pswp__ui--hidden">
      <div class="pswp__top-bar">
        <div class="pswp__counter"></div>
        <button class="pswp__button pswp__button--close" title="Close (Esc)"></button>
        <button class="pswp__button pswp__button--share" title="Share"></button>
        <button class="pswp__button pswp__button--fs" title="Toggle fullscreen"></button>
        <button class="pswp__button pswp__button--zoom" title="Zoom in/out"></button>
        <div class="pswp__preloader">
          <div class="pswp__preloader__icn">
            <div class="pswp__preloader__cut">
              <div class="pswp__preloader__donut"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="pswp__share-modal pswp__share-modal--hidden pswp__single-tap">
        <div class="pswp__share-tooltip"></div> 
      </div>
      <button class="pswp__button pswp__button--arrow--left" title="Previous (arrow left)"></button>
      <button class="pswp__button pswp__button--arrow--right" title="Next (arrow right)"></button>
      <div class="pswp__caption">
        <div class="pswp__caption__center"></div>
      </div>
    </div>
  </div>
</div>
{%- unless product == empty -%}
  <script>
    if (theme === undefined) {
      var theme = {};
    }
    theme.product = {{ product | json }};
  </script>
{%- endunless -%}
  
</div>