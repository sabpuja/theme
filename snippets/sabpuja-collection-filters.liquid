{% assign sp_filter_scope = scope | default: 'desktop' %}
<form class="sp-col-filters sp-col-filters--{{ sp_filter_scope }}" action="{{ collection.url }}" method="get">
  {% if collection.sort_by != blank %}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{% endif %}

  <div class="sp-col-filters__head">
    <strong>Filter products</strong>
    <a href="{{ collection.url }}">Clear</a>
  </div>

  {% for filter in collection.filters %}
    <fieldset class="sp-col-filter">
      <legend>{{ filter.label }}</legend>

      {% case filter.type %}
        {% when 'boolean', 'list' %}
          <div class="sp-col-filter__options">
            {% for filter_value in filter.values %}
              {% assign sp_filter_id = 'Filter-' | append: sp_filter_scope | append: '-' | append: filter.param_name | handleize | append: '-' | append: forloop.index %}
              <label class="sp-col-filter__option" for="{{ sp_filter_id }}">
                <input
                  id="{{ sp_filter_id }}"
                  type="checkbox"
                  name="{{ filter_value.param_name }}"
                  value="{{ filter_value.value | escape }}"
                  {% if filter_value.active %}checked{% endif %}
                  {% if filter_value.count == 0 and filter_value.active == false %}disabled{% endif %}
                >
                <span>{{ filter_value.label }}</span>
                <small>{{ filter_value.count }}</small>
              </label>
            {% endfor %}
          </div>

        {% when 'price_range' %}
          <div class="sp-col-filter__price">
            <label for="Filter-{{ sp_filter_scope }}-{{ filter.min_value.param_name | handleize }}">
              <span>Min</span>
              <input
                id="Filter-{{ sp_filter_scope }}-{{ filter.min_value.param_name | handleize }}"
                type="number"
                inputmode="decimal"
                min="0"
                name="{{ filter.min_value.param_name }}"
                {% if filter.min_value.value != blank %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                placeholder="0"
              >
            </label>
            <label for="Filter-{{ sp_filter_scope }}-{{ filter.max_value.param_name | handleize }}">
              <span>Max</span>
              <input
                id="Filter-{{ sp_filter_scope }}-{{ filter.max_value.param_name | handleize }}"
                type="number"
                inputmode="decimal"
                min="0"
                name="{{ filter.max_value.param_name }}"
                {% if filter.max_value.value != blank %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
              >
            </label>
          </div>
      {% endcase %}
    </fieldset>
  {% endfor %}

  <div class="sp-col-filters__actions">
    <button class="sp-col-filters__apply" type="submit">Apply filters</button>
  </div>
</form>
