{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  

  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

{% if settings.index_style == '1' or template contains 'page' %}
  {% unless full %}
<div class="grid-container">
  {% endunless %}
{% endif %}
  <div class="{{ section.settings.display }} section-layout spacing-{{ section.id }}">
    <div data-section-id="{{ section.id }}" data-section-type="group-middleblocks-section">
      <div class="box border-none index-group-middleblocks-container">
        <div class="box-content grid-x grid-margin-x">
          {% if section.blocks.size > 0 %}          
          <div class="left-area cell small-12 medium-8 large-9 xlarge-9 xxlarge-9 xxxlarge-9">
            {% for block in section.blocks %}
            {% if block.type == 'product' %}
            <div class="box border-none left-productblock grid-x">
              <div class="product-title width-100" style="background-color: {{ block.settings.bkg-color }};">{{ block.settings.title }}</div>
              <div class="product-content">
                <div class="grid-x">
                  <div class="width-banner cell small-12 medium-6 large-3 xlarge-3">
                    <div class="effect-{{block.settings.effect}} effect ">
                       <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">
                        <img src="{% if block.settings.image %}{{ block.settings.image | img_url: 'master' }}{% else %}{{ '285x800.png' | asset_url }}{% endif %}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                      </a>
                    </div>                   
                  </div>
                  <div class="width-product-content cell small-12 medium-12 large-9 xlarge-9">
                    <div class="products-box grid-x">
                      {% for product in collections[block.settings.collection].products limit:6 %}
                      <div class="product-element cell small-6 medium-6 large-4 xlarge-4 xxlarge-4 xxxlarge-4">
                        <div class="product-grid">
                          {% include 'index-product-item' %} 
                        </div>
                      </div>
                      {% else %}
                      {% for i in (1..6) %}
                      {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                      <div class="product-element cell small-6 medium-6 large-4 xlarge-4 xxlarge-4 xxxlarge-4">
                        <div class="product-grid">
                          <div class="product-item" data-product-item>
                        <div class="product-item-thumb">
                          <a href="javascript:void(0);" class="display-block">
                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                          </a>
                          <div class="group-button top-right">      
                            {%- if settings.product_item_quick_view -%}
                            <a href="javascript:void(0);" class="group-button-quickview group-button-item product-item-button product-item-button-quick-view" title="{{ 'general.button.quick_view' | t }}"><em class="sli sli-magnifier"></em>
                            </a>
                            {%- endif -%}
                            {%- if settings.product_item_wishlist -%}
                            <div class="group-button-wishlist group-button-item product-item-button-wishlist">
                              <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                              <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                            </div>
                            {%- endif -%}
                            {%- if settings.product_item_compare -%}
                            <div class="group-button-compare group-button-item product-item-button product-item-button-compare">
                              <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                              <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>        
                            </div>
                            {%- endif -%}
                          </div>

                          <div class="cart-button bottom-center">
                            <div class="product-item-buttons">
                              <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>            
                            </div>
                          </div>
                        </div>
                        <div class="product-item-caption">
                          <div class="product-item-group grid-x">
                            <div class="product-item-title-rating cell small-12 medium-6 large-8 xlarge-8 xxlarge-8 xxxlarge-9">
                              <h4 class="product-item-title">
                                <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                              </h4>  
                            </div>
                            <div class="product-item-price cell small-12 medium-6 large-4 xlarge-4 xxlarge-4 xxxlarge-3">
                              <span class="product-item-price-sale">$99.00</span>
                            </div>
                          </div>
                        </div>
                      </div>
                        </div>
                      </div>      
                      {% endfor %}
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </div>                  
            </div>
            {% endif %}
            {% endfor %}
          </div>
          <div class="right-area cell small-12 medium-4 large-3 xlarge-3 xxlarge-3 xxxlarge-3">
            {% for block in section.blocks %}
            {% if block.type == 'productcol' %}
            <div class="right-productcol">
              <div class="product-title">{{ block.settings.title }}</div>
              <div class="product-content">
                {% for product in collections[block.settings.collection].products limit:block.settings.limit %}
                <div class="product-element cell small-12 medium-6 large-4 xlarge-4 xxlarge-4 xxxlarge-4">
                  <div class="product-grid">
                    {% include 'index-product-item-grid' %} 
                  </div>
                </div>
                {% else %}
                {% for i in (1..block.settings.limit) %}
                {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                <div class="product-element">
                  <div class="product-grid width-100">
                    <div class="product-item grid-x" data-product-item>
                      <div class="product-item-thumb cell small-12 medium-12 large-4">
                        <a href="javascript:void(0);" class="display-block">
                          {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                        </a>
                      </div>
                      <div class="product-item-caption cell small-12 medium-12 large-4">
                        <div class="product-title-vendor">
                          <h4 class="product-item-title">
                            <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                          </h4>
                          {% if settings.product_item_vendor %}
                          <div class="product-item-vendor">
                            {{ 'homepage.onboarding.vendor' | t }}
                          </div>
                          {% endif %}       
                        </div>
                        <div class="product-item-group grid-x">
                          <div class="product-item-price cell small-12 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                            <span class="product-item-price-sale">$99.00</span>
                          </div>
                        </div>
                        <div class="position-relative flex-container align-middle">
                          <div class="btn-cart">
                            <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><span>{{ 'general.button.add_to_cart' | t }}</span></a>            
                          </div>
                          {%- if settings.product_item_wishlist -%}
                          <div class="product-item-button group-button-wishlist product-item-button-wishlist group-button-item">
                            <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                            <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                          </div>
                          {%- endif -%}
                          {%- if settings.product_item_compare -%}
                          <div class="group-button-compare group-button-item product-item-button product-item-button-compare">
                            <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                            <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>        
                          </div>
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>      
                {% endfor %}
                {% endfor %}
              </div>
            </div>
            {% elsif block.type == 'banner' %}
            <div class="right-banner effect-{{block.settings.effect}} effect">
              <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">
                <img src="{% if block.settings.image %}{{ block.settings.image | img_url: 'master' }}{% else %}{{ '345x450.png' | asset_url }}{% endif %}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
              </a>
            </div>              
            {% endif %}
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% if settings.index_style == '1' or template contains 'page' %}
  {% unless full %}
</div>
  {% endunless %}
{% endif %}