      "g3_044": "अंग्रेज़ी राशि",
      "g3_045": "हर शामिल वस्तु;",
      "g3_046": "अग्नि सुरक्षा:",
      "g3_047": "सरलता के लिए। विस्तृत वैदिक ज्योतिष मानने वाले ग्राहक चंद्र राशि, लग्न, नक्षत्र, ग्रह स्थिति या व्यक्तिगत मार्गदर्शन पर निर्भर कर सकते हैं।",
      "g3_048": "हिंदू पूजा और समारोहों में भेंट के रूप में अक्सर उपयोग होता है।",
      "g3_049": "ताज़ी या स्थानीय रूप से प्राप्त वस्तुएँ",
      "g3_050": "गंगाजल",
      "g3_051": "गंगाजल और गोमूत्र",
      "g3_052": "घी",
      "g3_053": "घी, शहद और द्रव",
      "g3_054": "गुग्गुल",
      "g3_055": "हल्दी",
      "g3_056": "हवन समिधा",
      "g3_057": "यदि आप वैदिक ज्योतिष मानते हैं",
      "g3_058": "सामान्य पश्चिमी ज्योतिष में सन साइन जन्म के समय सूर्य की राशि पर आधारित होता है।",
      "g3_059": "जनेऊ",
      "g3_060": "कन्या",
      "g3_061": "कपूर",
      "g3_062": "कर्क",
      "g3_063": "साफ, सूखा और धूल से सुरक्षित रखें। उपयोग के लिए तैयार होने तक रूई की बत्ती को खुली लौ से दूर रखें।",
      "g3_064": "कंटेनर सीलबंद रखें और सत्यापित पैकेजिंग निर्देशों का पालन करें। स्वतंत्र रूप से सत्यापित अतिरिक्त दावों के बिना इन उत्पादों को केवल उनके निर्धारित पूजा उपयोग के संदर्भ में वर्णित करें।",
      "g3_065": "अलग-अलग पाउडर और भेंट अलग रखें।",
      "g3_066": "पूजा सामग्री को साफ, सूखा और उत्पाद के वास्तविक निर्देशों के अनुसार रखें। उत्पाद-विशिष्ट निर्देश इस सामान्य गाइड से प्राथमिक हैं।",
      "g3_067": "किट की सामग्री बिना बताए नहीं बदली जानी चाहिए। किसी भी परिचालन प्रतिस्थापन नीति को स्पष्ट रूप से परिभाषित और संप्रेषित किया जाना चाहिए।",
      "g3_068": "किट गाइड",
      "g3_069": "कुंभ",
      "g3_070": "मकर",
      "g3_071": "मीन",
      "g3_072": "मेष",
      "g3_073": "मिश्री",
      "g3_074": "मिथुन",
      "g3_075": "पेज नहीं मिला",
      "g3_076": "पंचमेवा",
      "g3_077": "पूजा सामग्री भंडारण और देखभाल",
      "g3_078": "हर वस्तु की मात्रा या पैक साइज;",
      "g3_079": "राशि",
      "g3_080": "पढ़ें: सन साइन बनाम राशि →",
      "g3_081": "लाल पूजा पाउडर, जो तिलक और कई पूजा थालियों में आम तौर पर उपयोग होता है।",
      "g3_082": "पूजा के अनुसार लाल, पीला या सफेद वस्त्र विभिन्न भक्तिपूर्ण संदर्भों में उपयोग हो सकता है।",
      "g3_083": "जहाँ संभव हो मूल पैकेजिंग फिर से बंद करें।",
