      "g2_072": "सुरक्षित दीया या हवन व्यवस्था रखें और व्यावहारिक सुरक्षा के लिए पास में पानी रखें।",
      "g2_073": "हम पहले परिचित ग्राहक नाम का उपयोग करते हैं और जहाँ उपयोगी हो वहाँ अंग्रेज़ी या लिप्यंतरित रूप जोड़ते हैं—जैसे Roli (Kumkum), Kapoor (Camphor) या Janeu (Sacred Thread)।",
      "g2_074": "आपको क्या मिलेगा",
      "g2_075": "जहाँ उचित हो, हम सरल तैयारी या उपयोग मार्गदर्शन देते हैं। यदि आपके परिवार या पंडित की अलग परंपरा है, तो अपनी पूजा के अनुसार वही पद्धति अपनाएँ।",
      "g2_076": "गलत, क्षतिग्रस्त या गायब वस्तु?",
      "g2_077": "आपका ऑर्डर नंबर;"
    },
    "g3": {
      "g3_001": "सामान्य सन-साइन किट को भक्तिपूर्ण/सुविधा उत्पाद माना जाना चाहिए, व्यक्तिगत ज्योतिषीय नुस्खा नहीं।",
      "g3_002": "पूजा या प्रसाद में उपयोग होने वाला मिश्रित भोग; सटीक सामग्री बदल सकती है और जाँचनी चाहिए।",
      "g3_003": "अक्सर उपयोग होने वाली पूजा सामग्री का सरल परिचय। सटीक उपयोग पूजा और परंपरा के अनुसार बदलता है।",
      "g3_004": "एक राल जो पारंपरिक रूप से कुछ हवन और भक्तिपूर्ण प्रथाओं में उपयोग होती है।",
      "g3_005": "विशिष्ट हिंदू अनुष्ठानों और परंपराओं में उपयोग होने वाला पवित्र धागा; उपयोग समारोह और समुदाय के अनुसार बदलता है।",
      "g3_006": "सामान्यतः उपयोग होने वाली वस्तुओं का छोटा चयन, जो पूरी पूजा आवश्यकता को कवर न भी करे।",
      "g3_007": "एक उपयोगी पूजा किट किसी विशेष पूजा की संबंधित सामग्री को साथ रखकर तैयारी आसान बनाए और अंदर क्या है यह स्पष्ट दिखाए।",
      "g3_008": "खोलने के बाद",
      "g3_009": "अक्षत",
      "g3_010": "सभी 12 उत्पाद पेज देखने के लिए उपलब्ध हैं। अंतिम उत्पादन मात्रा और विनिर्देश तय होने तक खरीद के लिए इन्वेंटरी उपलब्ध नहीं है।",
      "g3_011": "पूजा की तारीख से पहले पर्याप्त डिलीवरी समय रखें।",
      "g3_012": "ज्योतिष गाइड",
      "g3_013": "ज्योतिष उपाय किट — ग्राहक मार्गदर्शिका",
      "g3_014": "गीले या दूषित बर्तनों से बचें।",
      "g3_015": "ऑर्डर से पहले",
      "g3_016": "सुपारी, जो पूजा भेंट और समारोह व्यवस्था में सामान्यतः शामिल होती है।",
      "g3_017": "पूजा के दौरान सुगंध के लिए जलाई जाती है। सामग्री और सुगंध का विवरण केवल सत्यापन के बाद दिया जाना चाहिए।",
      "g3_018": "राल, धूप, कपूर और हवन सामग्री जलाते समय सावधानीपूर्वक निगरानी आवश्यक है। इन्हें ज्वलनशील सतहों, बच्चों और पालतू जानवरों से दूर रखें।",
      "g3_019": "देखभाल गाइड",
      "g3_020": "चंदन",
      "g3_021": "अपवर्जन जाँचें।",
      "g3_022": "मात्राएँ जाँचें।",
      "g3_023": "किट चुनना",
      "g3_024": "वस्त्र, जनेऊ और रूई की बत्ती",
      "g3_025": "नारियल",
      "g3_026": "सामान्य संस्कृत/हिंदी नाम",
      "g3_027": "सामान्य राशि नाम",
      "g3_028": "आरती के दौरान सामान्यतः जलाया जाता है। उचित होल्डर का उपयोग करें और खुली लौ की निगरानी रखें।",
      "g3_029": "आम तौर पर आवश्यक लेकिन शामिल न की गई वस्तुएँ;",
      "g3_030": "दीये और हवन में सामान्यतः उपयोग होता है। खाने योग्य उपयोग केवल तभी बताया जाना चाहिए जब संबंधित उत्पाद के लिए सत्यापित हो।",
      "g3_031": "अपने पंडित/परिवार की सूची से तुलना करें।",
      "g3_032": "अन्य पूरक वस्तुएँ जो फिर भी आवश्यक हो सकती हैं।",
      "g3_033": "संपूर्ण किट",
      "g3_034": "संपूर्ण किट बनाम आवश्यक सामग्री किट",
      "g3_035": "पूजा का सटीक नाम सुनिश्चित करें।",
      "g3_036": "सुविधा / आवश्यक सामग्री किट",
      "g3_037": "रूई की बत्ती",
