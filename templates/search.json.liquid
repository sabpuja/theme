<!-- /templates/search.json.liquid -->
{% layout none %}
{% capture results %}
  {% for product in search.results %}
    {% capture sp_search_image %}{% render 'sabpuja-product-image-url', product: product %}{% endcapture %}
    {% assign sp_search_image = sp_search_image | strip %}
    {
      "title": {{ product.title | json }},
      "price": {% if product.price > 0 %}{{ product.price | money | json }}{% else %}{{ 'Price coming soon' | json }}{% endif %},
      "url": {{ product.url | within: product.collections.last | json }},
      "thumbnail": {{ sp_search_image | json }}
    }
    {% unless forloop.last %},{% endunless %}
  {% endfor %}
{% endcapture %}
{
  "results_count": {{ search.results_count }},
  "results": [{{ results }}]
}