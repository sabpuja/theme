<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | default: shop.locale }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#C84700">
  <link rel="canonical" href="{{ canonical_url }}">

  {% if template.name == 'index' %}
    {% capture sp_seo_title %}Sabpuja — {{ 'sabpuja_custom.fixed.home_tagline' | t }}{% endcapture %}
    {% assign sp_og_title = sp_seo_title %}
  {% else %}
    {% capture sp_seo_title %}{{ page_title }}{% unless page_title contains 'Sabpuja' %} — Sabpuja{% endunless %}{% endcapture %}
    {% assign sp_og_title = page_title %}
  {% endif %}
  <title>{{ sp_seo_title | strip }}</title>

  {% assign sp_meta_description = page_description | strip_html | strip %}
  {% if template.name == 'index' %}
    {% assign sp_meta_description = 'sabpuja_custom.fixed.meta_home' | t %}
  {% elsif template.name == 'product' %}
    {% capture sp_meta_description %}{{ product.title }} {{ 'sabpuja_custom.fixed.meta_product_suffix' | t }}{% endcapture %}
  {% elsif template.name == 'collection' %}
    {% capture sp_meta_description %}{{ 'sabpuja_custom.fixed.meta_collection_prefix' | t }} {{ collection.title }} {{ 'sabpuja_custom.fixed.meta_collection_suffix' | t }}{% endcapture %}
  {% elsif template.name == 'search' %}
    {% assign sp_meta_description = 'sabpuja_custom.fixed.meta_search' | t %}
  {% elsif template.name == 'cart' %}
    {% assign sp_meta_description = 'sabpuja_custom.fixed.meta_cart' | t %}
  {% elsif template.name == 'blog' %}
    {% assign sp_meta_description = 'sabpuja_custom.fixed.meta_blog' | t %}
  {% elsif template.name == 'article' %}
    {% capture sp_meta_description %}{{ article.title }} — {{ 'sabpuja_custom.fixed.meta_article_suffix' | t }}{% endcapture %}
  {% elsif template.name == 'list-collections' %}
    {% assign sp_meta_description = 'sabpuja_custom.fixed.meta_collections' | t %}
  {% elsif template.name == 'page' and page.handle == 'about-us' %}
    {% assign sp_meta_description = 'sabpuja_custom.fixed.meta_about' | t %}
  {% elsif template.name == 'page' and page.handle == 'contact-us' %}
    {% assign sp_meta_description = 'sabpuja_custom.fixed.meta_contact' | t %}
  {% endif %}
  {% if sp_meta_description != blank %}<meta name="description" content="{{ sp_meta_description | escape }}">{% endif %}

  <meta property="og:site_name" content="Sabpuja">
  <meta property="og:title" content="{{ sp_og_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
  {% if sp_meta_description != blank %}<meta property="og:description" content="{{ sp_meta_description | escape }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    html,body{margin:0!important;padding:0!important}
    html body.sabpuja-staging{font-family:Inter,Arial,sans-serif!important}
    body.sabpuja-staging h1,body.sabpuja-staging h2,body.sabpuja-staging h3,body.sabpuja-staging h4,body.sabpuja-staging h5,body.sabpuja-staging h6{font-family:Poppins,Arial,sans-serif!important}
    body.sabpuja-staging a[href^="tel:"]{display:none!important}
    body.suffix-contact .sp-page-grid>.sp-card:nth-child(2){display:none!important}
    body.suffix-contact .sp-contact-stack>span.sp-contact-link{display:none!important}
    body.suffix-contact .sp-page-grid{grid-template-columns:minmax(0,1fr)!important}
    .sp-staging-badge,.sp-demo-note,.sp-zodiac__demo-note{display:none!important}
  </style>

  {{ content_for_header }}
  <script>document.documentElement.className=document.documentElement.className.replace('no-js','js');</script>
</head>
<body class="sabpuja-staging template-{{ template.name }}{% if template.suffix != blank %} suffix-{{ template.suffix }}{% endif %}">
  {% section 'theme-header4' %}
  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>
  {% section 'theme-footer5' %}

  <script>
    (function () {
      function ready(fn) {
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn, { once: true });
        else fn();
      }

      ready(function () {
        var announcement = document.querySelector('.sp-announcement .sp-container');
        if (announcement) announcement.textContent = 'Delhi NCR delivery in 1–3 business days • Free shipping on orders ₹1,999+ • ₹100 flat shipping below ₹1,999 • Prepaid orders';

        var footerService = document.querySelector('.sp-footer-service span');
        if (footerService) footerService.textContent = 'Free shipping on orders ₹1,999+ • ₹100 flat shipping below ₹1,999';

        document.querySelectorAll('a[href^="tel:"]').forEach(function (link) {
          link.setAttribute('aria-hidden', 'true');
          link.tabIndex = -1;
        });

        document.querySelectorAll('.sp-page-note,.sp-demo-note,.sp-zodiac__demo-note').forEach(function (note) {
          var text = (note.textContent || '').toLowerCase();
          if (text.indexOf('staging') !== -1 || text.indexOf('demo') !== -1 || text.indexOf('illustrative') !== -1 || text.indexOf('approval') !== -1) note.remove();
        });

        var replacements = [
          ['₹100 flat shipping on every order while the store is in staging.', 'Free shipping on orders ₹1,999 and above. Orders below ₹1,999 have ₹100 flat shipping.'],
          ['₹100 flat shipping on every order.', 'Free shipping on orders ₹1,999 and above. Orders below ₹1,999 have ₹100 flat shipping.']
        ];
        var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        var node;
        while ((node = walker.nextNode())) {
          var value = node.nodeValue;
          replacements.forEach(function (pair) { value = value.split(pair[0]).join(pair[1]); });
          if (value !== node.nodeValue) node.nodeValue = value;
        }
      });
    }());
  </script>
</body>
</html>