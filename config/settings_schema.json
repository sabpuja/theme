      {
        "type": "checkbox",
        "id": "currencyactive",
        "label": "Show Currency dropdown",
        "default": true
      },
      {
        "type": "paragraph",
        "content": "Although you will be able to display prices on your store front in different currencies, Shopify will still process orders in your shop's currency."
      },
      {
        "type": "select",
        "id": "currency_format",
        "label": "Money format",
        "options": [
          {
            "value": "money_format",
            "label": "Without Currency, ex: $10.00"
          },
          {
            "value": "money_with_currency_format",
            "label": "With Currency, ex: $10 CAD"
          }
        ],
        "default": "money_with_currency_format"
      },
      {
        "type": "text",
        "id": "supported_currencies",
        "label": "Currency you wish to support",
        "default": "INR GBP CAD USD AUD EUR JPY"
      },
      {
        "type": "text",
        "id": "default_currency",
        "label": "Default currency",
        "default": "USD"
      },
      {
        "type": "paragraph",
        "content": "Separate your currency codes with a space. Use the ISO 4217 3-letter currency code. [Click here](http:\/\/www.xe.com\/iso4217.php) for a complete list of currency codes. Example: CAD USD."
      },
      {
        "type": "paragraph",
        "content": "* For this functionality to work in your shop, you are required to edit your money formats as per [these instructions](https:\/\/docs.shopify.com\/support\/settings\/general\/tell-my-script-where-to-find-money-formats)."
      }
    ]
