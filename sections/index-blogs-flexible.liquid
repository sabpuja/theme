{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="blogs" data-section-name="index-blogs-flexible">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">   
        <div class="index-blogs-container isb-product box border-none">
          <div class="top-area effect-{{section.settings.effect}} effect">
          {%- if section.settings.title != blank or section.settings.sub_title != blank -%}
          <div class="box-divider position-{{ section.settings.title_position }}">
            {%- if section.settings.title != blank -%}
            <h2 class="box-title width-100">{{ section.settings.title }}</h2>
            {%- endif -%}
          </div>
          {%- endif -%}
          <div class="effect-parent">
            <img class="banner" src="{% if section.settings.bkg %}{{ section.settings.bkg | img_url: 'master' }}{% else %}{{ '1470x660.png' | asset_url }}{% endif %}" alt="" />
          </div>          
          </div>
          <div class="box-content">
            <div class="index-blogs-content grid-x">      
              <div class="left-area cell large-6">
                {% for article in blogs[section.settings.select_blog].articles limit:section.settings.limit %}
                <div class="article-element {% if forloop.index == 1 %}active{% endif %}" data-flexible-article-content="data-article-content{{forloop.index}}">
                  <div class="article-title">{{ article.title }}</div>
                  <div class="article-content">{{ article.content | strip_html | truncatewords: 70  }} <a class="readmore" href="{{ article.url }}">{{ section.settings.readmore }}</a></div>
                  <div class="article-date">{{ article.published_at | date: '%b %d, %Y' }}</div>
                </div>
                {% endfor %}
              </div>
              <div class="right-area cell large-6">
                {% for article in blogs[section.settings.select_blog].articles limit:section.settings.limit %}
                <div class="article-element grid-x" data-flexible-article="data-article-content{{forloop.index}}">
                  <div class="article-thumb cell large-4 effect-{{section.settings.effect2}} effect">
                    <img src="{{ article.image | img_url: '500x' }}" alt="{{ article.title }}"/>
                  </div>
                  <div class="article-info cell large-8">
                    <div class="article-title">{{ article.title | truncate: 35 }}</div>
                    <div class="article-content">{{ article.content | strip_html | truncatewords: 15  }}</div>
                    <a class="readmore" href="{{ article.url }}">{{ section.settings.readmore }}</a>
                    <div class="article-date">{{ article.published_at | date: '%b %d, %Y' }}</div>
                  </div>
                </div>
                {% endfor %}
              </div>                                                
            </div>            
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


