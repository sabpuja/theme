        },       
        {
          "value": "blur",
          "label": "Blur"
        },
        {
          "value": "grayscale",
          "label": "Gray scale"
        },
        {
          "value": "line-image",
          "label": "Line 1"        
        }, 
        {
          "value": "scope3",
          "label": "Line 2"
        },              
        {
          "value": "zoom",
          "label": "Zoom"        
        },
        {
          "value": "zoom-opacity",
          "label": "Zoom Opacity"        
        },
        {
          "value": "apollo",
          "label": "Apollo"        
        },
        {
          "value": "jazz",
          "label": "Jazz"        
        },
        {
          "value": "ming",
          "label": "Ming"        
        },
        {
          "value": "bounce",
          "label": "Bounce"        
        },
        {
          "value": "flash",
          "label": "Flash"        
        },
        {
          "value": "animate-pulse",
          "label": "Animate Pulse"        
        },
        {
          "value": "heartBeat",
          "label": "Heart Beat"        
        },
        {
          "value": "backInDown",
