        },                
        {
          "value": "bounceInUp",
          "label": "Bounce In Up"        
        },        
        {
          "value": "bounceInRight",
          "label": "Bounce In Right"        
        },
        {
          "value": "bounceInLeft",
          "label": "Bounce In Left"        
        },
        {
          "value": "bounceInDown",
          "label": "Bounce In Down"        
        },
        {
          "value": "bounceIn",
          "label": "Bounce In"        
        },        
        {
          "value": "rotateInUpRight",
          "label": "Rotate In Up Right"        
        },
        {
          "value": "rotateInUpLeft",
          "label": "Rotate In Up Left"        
        },
        {
          "value": "rotateInDownRight",
          "label": "Rotate In Down Right"        
        },
        {
          "value": "rotateInDownLeft",
          "label": "Rotate In Down Left"        
        },
        {
          "value": "rotateIn",
          "label": "Rotate In"        
        },        
        {
          "value": "lightSpeedInLeft",
          "label": "Light Speed InLeft"        
        },        
        {
          "value": "flipInY",
          "label": "Flip In Y"        
        },
        {
          "value": "flipInX",
          "label": "Flip In X"        
        },
        {
          "value": "flip",
          "label": "Flip"        
        },
        {
          "value": "jackInTheBox",
          "label": "Jack In The Box"        
        }                                                    
      ],
      "default": "scope"      
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "background",
          "label": "Slide Background (Desktop)",
          "info": "Required"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link"
        },
        {
          "type": "select",
          "id": "entrance_effect",
          "label": "Captions Entrances Effect",
          "options": [
            {
              "group": "Bouncing",
              "value": "bounceIn",
              "label": "Bouncing"
            },
            {
              "group": "Bouncing",
              "value": "bounceInDown",
              "label": "Bouncing Down"
            },
            {
              "group": "Bouncing",
              "value": "bounceInLeft",
              "label": "Bouncing Left"
            },
            {
              "group": "Bouncing",
              "value": "bounceInRight",
              "label": "Bouncing Right"
            },
            {
              "group": "Bouncing",
              "value": "bounceInUp",
              "label": "Bouncing Up"
            },
            {
              "group": "Fading",
              "value": "fadeIn",
              "label": "Fade"
            },
            {
              "group": "Fading",
