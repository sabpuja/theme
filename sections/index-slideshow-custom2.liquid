      "label": "1st Banner Link to"
    },
	{
      "type": "image_picker",
      "id": "banner2",
      "label": "2nd Banner"
    },
	{
      "type": "url",
      "id": "banner2link",
      "label": "2nd Banner Link to"
    },
	{    
      "type": "select",
      "id": "effect1",
      "label": "Banner Hover Effect",
      "options": [
        {
          "value": "scope",
