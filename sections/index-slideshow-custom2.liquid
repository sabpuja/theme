              "label": "Fade Down"
            },
            {
              "group": "Fading",
              "value": "fadeInDownBig",
              "label": "Fade Down (Long)"
            },
            {
              "group": "Fading",
              "value": "fadeInLeft",
              "label": "Fade Left"
            },
            {
              "group": "Fading",
              "value": "fadeInLeftBig",
              "label": "Fade Left (Long)"
            },
