{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="image" data-section-name="index-banner-custom16">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none index-banner-grid-container">
          <div class="box-content">
            {% for block in section.blocks %}
            {% if block.type == 'two_banner' %}
            <div class="banner-2">
			        <div class="grid-x">
                <div class="cell large-6 medium-6 small-12">
                  <div class="banner-item">
                    <div class="effect-{{section.settings.effect}} effect">
                      {% if block.settings.banner1 %}
                      <a class="banner-image" href="{{ block.settings.banner1url }}"><img src="{{ block.settings.banner1 | img_url: 'master' }}" alt="{{ block.settings.banner1.alt }}" /></a>
                      {% endif %}
                      <div class="banner-text">
                        <div class="banner-name" style="font-size:{{ block.settings.title1size1 }}px;">{{ block.settings.banner1title }}</div>
                        <div class="banner-action" style="font-size:{{ block.settings.title1size2 }}px;"><a href="{{ block.settings.banner1url }}">{{ block.settings.banner1desc }}</a></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="cell large-6 medium-6 small-12">
                  <div class="banner-item">
                    <div class="effect-{{section.settings.effect}} effect">
                      {% if block.settings.banner2 %}
                      <a class="banner-image" href="{{ block.settings.banner2url }}"><img src="{{ block.settings.banner2 | img_url: 'master' }}" alt="{{ block.settings.banner2.alt }}" /></a>
                      {% endif %}
                      <div class="banner-text">
                        <div class="banner-name" style="font-size:{{ block.settings.title2size1 }}px;">{{ block.settings.banner2title }}</div>
                        <div class="banner-action" style="font-size:{{ block.settings.title2size2 }}px;"><a href="{{ block.settings.banner2url }}">{{ block.settings.banner2desc }}</a></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            {% else %} 
            <div class="banner-4">
              <div class="grid-x">
                <div class="cell large-3 medium-6 small-12">
                 <div class="banner-item">
                  <div class="effect-{{section.settings.effect}} effect">
                    {% if block.settings.banner1 %}
                    <a class="banner-image" href="{{ block.settings.banner1url }}"><img src="{{ block.settings.banner1 | img_url: 'master' }}" alt="{{ block.settings.banner1.alt }}" />
                    </a>
                    {% endif %}
                    <div class="banner-text">
                      <div class="banner-name" style="font-size:{{ block.settings.title1size1 }}px;">{{ block.settings.banner1title }}</div>
                      <div class="banner-action" style="font-size:{{ block.settings.title1size2 }}px;"><a href="{{ block.settings.banner1url }}">{{ block.settings.banner1desc }}</a></div>
                    </div>
                    </div>
                   </div>
                </div>
                <div class="cell large-3 medium-6  small-12">
                  <div class="banner-item">
                   <div class="effect-{{section.settings.effect}} effect">
                      {% if block.settings.banner2 %}
                      <a class="banner-image" href="{{ block.settings.banner2url }}"><img src="{{ block.settings.banner2 | img_url: 'master' }}" alt="{{ block.settings.banner2.alt }}" /></a>
                      {% endif %}
                      <div class="banner-text">
                        <div class="banner-name" style="font-size:{{ block.settings.title2size1 }}px;">{{ block.settings.banner2title }}</div>
                        <div class="banner-action" style="font-size:{{ block.settings.title2size2 }}px;"><a href="{{ block.settings.banner2url }}">{{ block.settings.banner2desc }}</a></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="cell large-3 medium-6  small-12">
                  <div class="banner-item">
                   <div class="effect-{{section.settings.effect}} effect">
                      {% if block.settings.banner3 %}
                      <a class="banner-image" href="{{ block.settings.banner3url }}"><img src="{{ block.settings.banner3 | img_url: 'master' }}" alt="{{ block.settings.banner3.alt }}" /></a>
                      {% endif %}
                      <div class="banner-text">
                        <div class="banner-name" style="font-size:{{ block.settings.title3size1 }}px;">{{ block.settings.banner3title }}</div>
                        <div class="banner-action" style="font-size:{{ block.settings.title3size2 }}px;"><a href="{{ block.settings.banner3url }}">{{ block.settings.banner3desc }}</a></div>
                      </div>
                    </div>
                   </div>
                </div>
                <div class="cell large-3 medium-6  small-12">
                  <div class="banner-item">
                    <div class="effect-{{section.settings.effect}} effect">
                      {% if block.settings.banner4 %}
                      <a class="banner-image" href="{{ block.settings.banner4url }}"><img src="{{ block.settings.banner4 | img_url: 'master' }}" alt="{{ block.settings.banner4.alt }}" /></a>
                      {% endif %}
                      <div class="banner-text">
                        <div class="banner-name" style="font-size:{{ block.settings.title4size1 }}px;">{{ block.settings.banner4title }}</div>
                        <div class="banner-action" style="font-size:{{ block.settings.title4size2 }}px;"><a href="{{ block.settings.banner4url }}">{{ block.settings.banner4desc }}</a></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            {% endif %}    
            {% endfor %}
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

