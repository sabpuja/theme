{% comment %}
  Sabpuja customer chatbot. Merchant controls the visible text, endpoint and colors.
  The widget never contains or receives Hermes / Shopify credentials.
{% endcomment %}
{% if section.settings.enabled %}
  <aside id="sp-chat-{{ section.id }}" class="sp-chat" style="--sp-chat-accent:{{ section.settings.accent }};--sp-chat-paper:{{ section.settings.paper }};" data-sp-chat data-endpoint="{{ section.settings.endpoint | escape }}">
    <button class="sp-chat__launcher" type="button" aria-expanded="false" aria-controls="sp-chat-panel-{{ section.id }}" aria-label="{{ section.settings.launcher_text | escape }}">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6A8.38 8.38 0 0 1 12.5 3h.5a8.48 8.48 0 0 1 8 8v.5Z"/></svg>
      <span>{{ section.settings.launcher_text | escape }}</span>
    </button>
    <section class="sp-chat__panel" id="sp-chat-panel-{{ section.id }}" role="region" aria-label="{{ section.settings.heading | escape }}" hidden>
      <header class="sp-chat__head">
        <div><strong>{{ section.settings.heading | escape }}</strong><small>{{ section.settings.subtitle | escape }}</small></div>
        <button class="sp-chat__close" type="button" aria-label="{{ section.settings.close_label | escape }}">&#215;</button>
      </header>
      <div class="sp-chat__conversation" aria-live="polite" aria-relevant="additions">
        <p class="sp-chat__bubble sp-chat__bubble--bot">{{ section.settings.welcome | escape }}</p>
      </div>
      <div class="sp-chat__suggestions">
        {% if section.settings.suggestion_1 != blank %}<button type="button" data-suggestion="{{ section.settings.suggestion_1 | escape }}">{{ section.settings.suggestion_1 | escape }}</button>{% endif %}
        {% if section.settings.suggestion_2 != blank %}<button type="button" data-suggestion="{{ section.settings.suggestion_2 | escape }}">{{ section.settings.suggestion_2 | escape }}</button>{% endif %}
        {% if section.settings.suggestion_3 != blank %}<button type="button" data-suggestion="{{ section.settings.suggestion_3 | escape }}">{{ section.settings.suggestion_3 | escape }}</button>{% endif %}
      </div>
      <form class="sp-chat__form">
        <label class="visually-hidden" for="sp-chat-question-{{ section.id }}">{{ section.settings.input_label | escape }}</label>
        <input id="sp-chat-question-{{ section.id }}" type="text" maxlength="750" required autocomplete="off" placeholder="{{ section.settings.placeholder | escape }}">
        <button type="submit" aria-label="{{ section.settings.send_label | escape }}">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4 20-7Z"/><path d="M22 2 11 13"/></svg>
        </button>
      </form>
      <p class="sp-chat__notice">{{ section.settings.notice | escape }}</p>
    </section>
  </aside>
  <style>
    .sp-chat{position:fixed;z-index:2000;right:clamp(12px,2vw,28px);bottom:clamp(12px,2vw,28px);font:400 14px/1.5 Inter,'Noto Sans Devanagari',Arial,sans-serif;color:#362e29}
    .sp-chat button,.sp-chat input{font:inherit}
    .sp-chat__launcher{display:flex;align-items:center;gap:9px;min-height:48px;padding:10px 17px;border:0;border-radius:999px;background:var(--sp-chat-accent);color:#fff;box-shadow:0 8px 24px #2b15152e;cursor:pointer}
    .sp-chat__panel{position:absolute;bottom:calc(100% + 12px);right:0;width:min(380px,calc(100vw - 24px));max-height:min(670px,calc(100dvh - 96px));background:var(--sp-chat-paper);border:1px solid #ddccba;border-radius:19px;box-shadow:0 18px 44px #3a191929;display:flex;flex-direction:column;overflow:hidden}
    .sp-chat__panel[hidden]{display:none}
    .sp-chat__head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;background:var(--sp-chat-accent);color:#fff}
    .sp-chat__head strong,.sp-chat__head small{display:block}.sp-chat__head strong{font:600 16px/1.4 Poppins,Arial,sans-serif}.sp-chat__head small{opacity:.88;font-size:12px}
    .sp-chat__close{width:36px;height:36px;border:0;background:transparent;color:#fff;font-size:26px;cursor:pointer}
    .sp-chat__conversation{padding:16px;display:flex;flex-direction:column;gap:12px;overflow:auto;min-height:145px;flex:1;overscroll-behavior:contain}
    .sp-chat__bubble{max-width:94%;padding:11px 13px;border-radius:14px;margin:0;white-space:pre-wrap;overflow-wrap:anywhere;background:#fff;border:1px solid #e8ddd1}
    .sp-chat__bubble--user{margin-left:auto;background:#f1e7e0}
    .sp-chat__bubble--bot{margin-right:auto}
    .sp-chat__sources{display:flex;gap:6px;flex-wrap:wrap;font-size:12px}
    .sp-chat__sources a{color:var(--sp-chat-accent);border:1px solid #e3d4c8;border-radius:9px;padding:5px 7px;text-decoration:none;background:#fff}
    .sp-chat__suggestions{padding:8px 12px;display:flex;gap:6px;flex-wrap:wrap}
    .sp-chat__suggestions button{border:1px solid #dbc6b8;border-radius:999px;background:transparent;padding:5px 9px;cursor:pointer;font-size:12px;color:var(--sp-chat-accent)}
    .sp-chat__form{display:flex;align-items:center;gap:6px;padding:8px 12px;border-top:1px solid #e8ded4}
    .sp-chat__form input{flex:1;min-width:0;padding:10px;border:1px solid #d8c9bb;background:white;border-radius:12px;color:#362e29}
    .sp-chat__form button{display:grid;place-items:center;width:40px;height:40px;border:0;border-radius:11px;background:var(--sp-chat-accent);color:white;cursor:pointer}
    .sp-chat__form button:disabled{opacity:.5;cursor:not-allowed}
    .sp-chat__notice{margin:0;padding:0 12px 10px;font-size:11px;color:#625b55;text-align:center}
    .sp-chat button:focus-visible,.sp-chat input:focus-visible,.sp-chat a:focus-visible{outline:3px solid #ffb121;outline-offset:2px}
    @media(max-width:420px){.sp-chat__launcher span{display:none}.sp-chat__launcher{width:52px;height:52px;justify-content:center;padding:0}.sp-chat__panel{max-height:calc(100dvh - 90px)}}
    @media(prefers-reduced-motion:reduce){.sp-chat *{scroll-behavior:auto!important}}
  </style>
  <script>
  (() => {
    const root = document.getElementById('sp-chat-{{ section.id }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const endpoint = root.dataset.endpoint;
    const panel = root.querySelector('.sp-chat__panel');
    const launcher = root.querySelector('.sp-chat__launcher');
    const close = root.querySelector('.sp-chat__close');
    const list = root.querySelector('.sp-chat__conversation');
    const form = root.querySelector('.sp-chat__form');
    const input = form.querySelector('input');
    const submit = form.querySelector('button');
    const suggestions = root.querySelector('.sp-chat__suggestions');
    const history = [];
    const errorText = {{ section.settings.error_message | json }};
    const unavailableText = {{ section.settings.unavailable_message | json }};
    function toggle(open) {
      panel.hidden = !open;
      launcher.setAttribute('aria-expanded', String(open));
      if (open) input.focus(); else launcher.focus();
    }
    launcher.addEventListener('click', () => toggle(panel.hidden));
    close.addEventListener('click', () => toggle(false));
    root.addEventListener('keydown', e => { if (e.key === 'Escape' && !panel.hidden) toggle(false); });
    function bubble(content, type) {
      const el = document.createElement('p');
      el.className = 'sp-chat__bubble sp-chat__bubble--' + type;
      el.textContent = content;
      list.append(el);
      list.scrollTop = list.scrollHeight;
      return el;
    }
    async function ask(question) {
      if (!question || submit.disabled) return;
      bubble(question, 'user');
      suggestions.hidden = true;
      input.value = '';
      submit.disabled = true;
      const pending = bubble('...', 'bot');
      try {
        if (!endpoint || !/^https:\/\//.test(endpoint)) throw new Error('unconfigured');
        const res = await fetch(endpoint, {
          method:'POST', mode:'cors', credentials:'omit', cache:'no-store',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({message:question,history:history.slice(-4)}),
          signal:AbortSignal.timeout(29000)
        });
        if (!res.ok) throw new Error('unavailable');
        const data = await res.json();
        if (!data || typeof data.answer !== 'string') throw new Error('unavailable');
        pending.textContent = data.answer;
        if (Array.isArray(data.sources) && data.sources.length) {
          const sources = document.createElement('div'); sources.className = 'sp-chat__sources';
          for (const source of data.sources.slice(0,5)) {
            try {
              const url = new URL(source.url);
              if (url.protocol !== 'https:' || !['sabpuja.com','www.sabpuja.com'].includes(url.hostname)) continue;
              const a = document.createElement('a'); a.href = url.href; a.target = '_blank'; a.rel = 'noopener noreferrer';
              a.textContent = String(source.title || 'Read more').slice(0,60); sources.append(a);
            } catch (_) { /* ignore invalid source */ }
          }
          list.append(sources);
        }
        history.push({role:'user',content:question},{role:'assistant',content:data.answer});
        if (history.length > 6) history.splice(0,history.length-6);
      } catch(err) {
        pending.textContent = err.message === 'unconfigured' ? unavailableText : errorText;
      } finally {
        submit.disabled = false;
        list.scrollTop = list.scrollHeight;
      }
    }
    form.addEventListener('submit', e => { e.preventDefault(); ask(input.value.trim()); });
    suggestions.addEventListener('click', e => { const button = e.target.closest('button[data-suggestion]'); if (button) ask(button.dataset.suggestion); });
  })();
  </script>
{% endif %}
{% schema %}
{
  "name": "Sabpuja AI Assistant",
  "settings": [
    {"type":"checkbox","id":"enabled","label":"Enable on storefront","default":false},
    {"type":"text","id":"endpoint","label":"HTTPS chat API endpoint","info":"Add the customer chatbot HTTPS endpoint after backend QA. Do not enter an API key."},
    {"type":"color","id":"accent","label":"Brand accent","default":"#B80D0D"},
    {"type":"color","id":"paper","label":"Panel background","default":"#FFF9ED"},
    {"type":"text","id":"launcher_text","label":"Launcher button","default":"Ask Sabpuja"},
    {"type":"text","id":"heading","label":"Chat heading","default":"Sabpuja Assistant"},
    {"type":"text","id":"subtitle","label":"Chat subtitle","default":"Puja guides and shopping help"},
    {"type":"textarea","id":"welcome","label":"Welcome message","default":"Namaste! Ask about puja vidhi, puja kits or Sabpuja products. Hindi and English are welcome."},
    {"type":"text","id":"suggestion_1","label":"Suggestion 1","default":"Show me a daily puja guide"},
    {"type":"text","id":"suggestion_2","label":"Suggestion 2","default":"Which puja kit should I choose?"},
    {"type":"text","id":"suggestion_3","label":"Suggestion 3","default":"Navratri puja kaise karein?"},
    {"type":"text","id":"input_label","label":"Input label","default":"Ask a question"},
    {"type":"text","id":"placeholder","label":"Input placeholder","default":"Ask a question..."},
    {"type":"text","id":"send_label","label":"Send button label","default":"Send message"},
    {"type":"text","id":"close_label","label":"Close button label","default":"Close assistant"},
    {"type":"text","id":"error_message","label":"Error message","default":"Unable to answer just now. Please try again."},
    {"type":"text","id":"unavailable_message","label":"API not configured text","default":"The assistant is being prepared. Please check back soon."},
    {"type":"textarea","id":"notice","label":"Bottom notice","default":"AI answers may have limitations. Follow your family or priest's tradition."}
  ]
}
{% endschema %}
