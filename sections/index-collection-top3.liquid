{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="products" data-section-name="index-collection-top3">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">    
        <div class="index-collection-tab-container box border-none position-{{ section.settings.title_position }}">
          <div class="title-tablist-collection">
            <div class="box-divider">
              {%- if section.settings.title != blank -%}
              <h2 class="box-title">{{ section.settings.title }}</h2>
              {%- endif -%}
              {% if section.settings.viewall != '' %}
              <div class="viewall"><a href="{{ block.settings.url }}">{{ section.settings.viewall }} <em class="sli sli-arrow-right"></em></a></div>
              {% endif %}
            </div>
          </div>
          <div class="index-collection-tab-content" data-tabs-content="index-collection-tab-{{ section.id }}">
            <div class="grid-x grid-margin-x">
              {% for block in section.blocks %}            
              <div class="cell cell small-{{ section.settings.column_small }} medium-{{ section.settings.column_medium }} large-{{ section.settings.column_large }} xlarge-{{ section.settings.column_xlarge }}">
				<div class="top3-inner">
                  <div class="top3-products grid-x">
                  	<div class="top3-1product cell small-8 medium-12 large-8">
                      <span class="top3-label label1">{{ block.settings.title1 }}</span>
                      {% assign product = all_products[block.settings.product1] %}
                      <a href="{{ product.url }}">
                        {% if block.settings.image1 %}
                        <img src="{{ block.settings.image1 | img_url: 'master' }}" alt="{{ block.settings.image1.alt }}" />
                        {% else %}
                        <img src="{{ '315x400.png' | asset_url }}" alt="{{ block.settings.image1.alt }}" />
                        {% endif %}
                      </a>
                    </div>
                    <div class="top3-2product cell small-4 medium-12 large-4">
                      <div class="top3-product2">
                        <span class="top3-label label2">{{ block.settings.title2 }}</span>
                        {% assign product = all_products[block.settings.product2] %}
                        <a href="{{ product.url }}">
                          {% if block.settings.image2 %}
                          <img src="{{ block.settings.image2 | img_url: 'master' }}" alt="{{ block.settings.image2.alt }}" />
                          {% else %}
                          <img src="{{ '155x200.png' | asset_url }}" alt="{{ block.settings.image2.alt }}" />
                          {% endif %}
                        </a>
                      </div>
                      <div class="top3-product3">
                        <span class="top3-label label2">{{ block.settings.title3 }}</span>
                        {% assign product = all_products[block.settings.product3] %}
                        <a href="{{ product.url }}">
                          {% if block.settings.image3 %}
                          <img src="{{ block.settings.image3 | img_url: 'master' }}" alt="{{ block.settings.image3.alt }}" />
                          {% else %}
                          <img src="{{ '155x200.png' | asset_url }}" alt="{{ block.settings.image3.alt }}" />
                          {% endif %}
                        </a>
                      </div>
                    </div>
                  </div>
                  <div class="top3-title">{{ block.settings.title }}</div>
                </div>
              </div>                                
            {% endfor %}
            </div>
          </div>          
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

