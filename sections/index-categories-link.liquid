{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  

  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="collection" data-section-name="index-categories-link" style="background-color:{{ section.settings.color }}">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">  
        <div class="index-categories-container">
        <div class="box border-none">
          {%- if section.settings.title != blank-%}
          <div class="box-divider grid-x">
            {%- if section.settings.title != blank -%}
            <h2 class="box-title width-100">{{ section.settings.title }}</h2>
            {%- endif -%}
          </div>
          {%- endif -%}
          <div class="box-content">
            {% if section.blocks.size > 0 %}
            <div class="grid-x grid-margin-x align-center">
              {% for block in section.blocks %}
              <div class="cell index-categories-item  cell small-{{ section.settings.column_small }} medium-{{ section.settings.column_medium }} large-{{ section.settings.column_large }} xlarge-{{ section.settings.column_xlarge }} xxlarge-{{ section.settings.column_xxlarge }} xxxlarge-{{ section.settings.column_xxxlarge }}" style="background-color:{{ block.settings.bkg2 }};background-image:url({% if block.settings.bkg %}{{ block.settings.bkg | img_url: 'master' }}{% else %}{{ '370x330.png' | asset_url }}{% endif %})">
                <div class="grid-x">                  
                  <div class="index-categories-item-content">
                    <div class="index-categories-item-divider">
                      <h2 class="index-categories-item-title">{{ block.settings.title }}</h2>                      
                    </div>
                    <ul class="index-categories-item-nav no-bullet margin-0">
                      {% for link in linklists[block.settings.linklist].links %}
                      <li class="index-categories-item-nav-link">
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      </li>
                      {% endfor %}
                    </ul>
                  </div>
                </div>
              </div>
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </div>
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>



