{{ 'sabpuja-faq.css' | asset_url | stylesheet_tag }}

{% liquid
  assign variant = section.settings.variant | default: 'standard'
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign faq_count = 0
  for block in section.blocks
    if block.type == 'faq'
      assign faq_count = faq_count | plus: 1
    endif
  endfor
%}

<section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | escape }}"{% endif %} class="sp-faq sp-faq--{{ variant }} sp-faq--{{ section.settings.background }} sp-faq--width-{{ section.settings.width }} sp-faq--align-{{ section.settings.alignment }}">
  <div class="sp-faq__inner">
    <header class="sp-faq__head">
      {% if section.settings.eyebrow != blank %}<p class="sp-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<{{ heading_tag }} class="sp-faq__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>{% endif %}
      {% if section.settings.body != blank %}<div class="sp-faq__body">{{ section.settings.body }}</div>{% endif %}
      {% if section.settings.show_count and faq_count > 0 %}<span class="sp-faq__count">{{ faq_count }} questions</span>{% endif %}
    </header>

    {% capture faq_markup %}
      <div class="sp-faq__list">
        {% assign faq_seen = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'group_heading' %}
            {% if variant == 'grouped' %}
              <div class="sp-faq__group-head" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}<{{ subheading_tag }} class="sp-faq__group-title">{{ block.settings.heading | escape }}</{{ subheading_tag }}>{% endif %}
                {% if block.settings.text != blank %}<p class="sp-faq__group-text">{{ block.settings.text | escape }}</p>{% endif %}
              </div>
            {% endif %}
          {% elsif block.type == 'faq' and block.settings.question != blank %}
            {% assign faq_seen = faq_seen | plus: 1 %}
            <details class="sp-faq__item"{% if section.settings.open_first and faq_seen == 1 %} open{% endif %} {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.question | escape }}</span>
                <span class="sp-faq__chevron" aria-hidden="true">{% render 'sabpuja-icon', name: 'chevron-down' %}</span>
              </summary>
              <div class="sp-faq__answer">
                {% if block.settings.label != blank %}<span class="sp-faq__label">{{ block.settings.label | escape }}</span>{% endif %}
                {{ block.settings.answer }}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    {% endcapture %}

    {% if variant == 'split_support' %}
      <div class="sp-faq__layout">
        <aside class="sp-faq__support">
          {% if section.settings.support_eyebrow != blank %}<p class="sp-faq__support-eyebrow">{{ section.settings.support_eyebrow | escape }}</p>{% endif %}
          {% if section.settings.support_heading != blank %}<{{ subheading_tag }} class="sp-faq__support-title">{{ section.settings.support_heading | escape }}</{{ subheading_tag }}>{% endif %}
          {% if section.settings.support_text != blank %}<div class="sp-faq__support-text">{{ section.settings.support_text }}</div>{% endif %}
          {% if section.settings.support_label != blank and section.settings.support_link != blank %}<a class="sp-faq__support-link" href="{{ section.settings.support_link }}">{{ section.settings.support_label | escape }} →</a>{% endif %}
        </aside>
        {{ faq_markup }}
      </div>
    {% else %}
      {{ faq_markup }}
    {% endif %}
  </div>
</section>

{% if section.settings.enable_faq_schema and schema_count > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% assign schema_seen = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'faq' and block.settings.question != blank and block.settings.answer != blank %}
            {% assign schema_seen = schema_seen | plus: 1 %}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | json }}
              }
            }{% if schema_seen < schema_count %},{% endif %}
          {% endif %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "Sabpuja FAQ",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anchor ID"},
    {"type":"select","id":"variant","label":"Layout variant","default":"standard","options":[{"value":"standard","label":"Standard accordion"},{"value":"compact","label":"Compact"},{"value":"two_column","label":"Two column"},{"value":"grouped","label":"Grouped topics"},{"value":"split_support","label":"Split support"},{"value":"premium_dark","label":"Premium dark"}]},
    {"type":"select","id":"heading_tag","label":"Heading level","default":"h2","options":[{"value":"h2","label":"H2"},{"value":"h3","label":"H3"}]},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Frequently asked questions"},
    {"type":"text","id":"heading","label":"Heading","default":"Helpful answers before you choose"},
    {"type":"richtext","id":"body","label":"Supporting copy","default":"<p>Keep answers concise, factual and specific to the page or product.</p>"},
    {"type":"checkbox","id":"show_count","label":"Show question count","default":false},
    {"type":"checkbox","id":"open_first","label":"Open first question","default":false},
    {"type":"checkbox","id":"enable_faq_schema","label":"Output FAQPage structured data","default":true,"info":"Enable only when every visible question and answer is accurate for this page."},
    {"type":"header","content":"Split support panel"},
    {"type":"text","id":"support_eyebrow","label":"Support eyebrow","default":"Need more help?"},
    {"type":"text","id":"support_heading","label":"Support heading","default":"Still have a question?"},
    {"type":"richtext","id":"support_text","label":"Support text","default":"<p>Use this panel for a genuine support or contact path when the FAQ does not cover the customer's question.</p>"},
    {"type":"text","id":"support_label","label":"Support link label","default":"Contact support"},
    {"type":"url","id":"support_link","label":"Support link"},
    {"type":"header","content":"Layout"},
    {"type":"select","id":"alignment","label":"Heading alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}]},
    {"type":"select","id":"background","label":"Section background","default":"white","options":[{"value":"white","label":"White"},{"value":"ivory","label":"Ivory"},{"value":"cream","label":"Cream"},{"value":"sacred-brown","label":"Sacred Brown"}]},
    {"type":"select","id":"width","label":"Section width","default":"contained","options":[{"value":"contained","label":"Contained"},{"value":"wide","label":"Wide"},{"value":"full","label":"Full width"}]}
  ],
  "blocks": [
    {"type":"faq","name":"FAQ item","settings":[{"type":"text","id":"question","label":"Question"},{"type":"richtext","id":"answer","label":"Answer"},{"type":"text","id":"label","label":"Optional answer label"}]},
    {"type":"group_heading","name":"Topic heading","settings":[{"type":"text","id":"heading","label":"Topic heading"},{"type":"text","id":"text","label":"Short topic description"}]}
  ],
  "max_blocks": 24,
  "presets": [{"name":"Sabpuja FAQ","blocks":[{"type":"faq","settings":{"question":"How should I use this information?","answer":"<p>Use the guidance on the page as a practical reference and follow your family tradition or priest guidance where practices vary.</p>"}},{"type":"faq","settings":{"question":"Where can I find product-specific details?","answer":"<p>Use the product page for the current contents, imagery, price and availability of the item you are viewing.</p>"}},{"type":"faq","settings":{"question":"What if I still need help?","answer":"<p>Use the support link provided on the page when your question is not covered here.</p>"}}]}]
}
{% endschema %}
