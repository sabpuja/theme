{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="image" data-section-name="index-banner-custom23" class="{% if section.settings.dark %}dark-mode{% else %}normal-mode{% endif %}">
  <div class="index-banner-custom21-bg {{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">        
        <div class="box border-none index-banner-grid-container">
          {%- if section.settings.title != "" -%}
          <div class="box-divider grid-x">
            {%- if section.settings.title != blank -%}
            <h2 class="box-title width-100" style="font-size:{{ section.settings.titlesize }}px;">{{ section.settings.title }}</h2>
            {%- endif -%}
          </div>
          {%- endif -%}
          <div class="box-content">          
            <div class="left-area"> 
              <div class="top-image effect-{{section.settings.effect1 }} effect">
                <a class="banner" href="{{ section.settings.banner1link }}">
                  <img src="{% if section.settings.banner1 %}{{ section.settings.banner1 | img_url: 'master' }}{% else %}{{ '470x590.png' | asset_url }}{% endif %}" alt="{{ section.settings.banner1.alt }}" />
                </a>                
              </div> 
              <div class="bottom-image effect-{{section.settings.effect2 }} effect">
                <a class="banner" href="{{ section.settings.banner2link }}">
                  <img src="{% if section.settings.banner2 %}{{ section.settings.banner2 | img_url: 'master' }}{% else %}{{ '700x560.png' | asset_url }}{% endif %}" alt="{{ section.settings.banner2.alt }}" />
                </a>                
              </div>
            </div>
            <div class="right-area">
              <div class="bottomleft-image">
                <div class="effect-{{section.settings.effect3 }} effect">
                  <a class="banner" href="{{ section.settings.banner3link }}">
                    <img src="{% if section.settings.banner3 %}{{ section.settings.banner3 | img_url: 'master' }}{% else %}{{ '700x1068.png' | asset_url }}{% endif %}" alt="{{ section.settings.banner3.alt }}" />
                  </a>
                </div>                
                {% if section.settings.text3 != '' %}<a class="action" href="{{ section.settings.text4 }}">{{ section.settings.text3 }}</a>{% endif %}
              </div> 
            </div>
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


