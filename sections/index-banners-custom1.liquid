{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banners-custom1">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none index-banner-grid-container">
          <div class="box-content grid-x">
            <div class="left-area cell medium-6 large-6">
              <div class="top-area grid-x">
                <div class="top-left-area cell effect-{{section.settings.effect}} effect small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                  {%- unless section.settings.l1banner == blank -%}
                  <a href="{{ section.settings.l1bannerlink }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ section.settings.l1banner | img_url: 'master' }}" class="width-100 lazyload" alt="{{ section.settings.l1banner.alt }}" />
                  </a>
                  {% else %}
                  <a href="{{ section.settings.l1bannerlink }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '370x370.png' | asset_url }}" class="width-100 lazyload" alt="{{ section.settings.l1banner.alt }}" />
                  </a>
                  {%- endunless -%}
                </div>
                <div class="top-right-area cell effect-{{section.settings.effect}} effect small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                  {%- unless section.settings.l2banner == blank -%}
                  <a href="{{ section.settings.l2bannerlink }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ section.settings.l2banner | img_url: 'master' }}" class="width-100 lazyload" alt="{{ section.settings.l2banner.alt }}" />
                  </a>
                  {% else %}
                  <a href="{{ section.settings.l2bannerlink }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '370x370.png' | asset_url }}" class="width-100 lazyload" alt="{{ section.settings.l2banner.alt }}" />
                  </a>
                  {%- endunless -%}
                </div>
              </div>
              <div class="bottom-area grid-x">
                <div class="bottom-left-area cell effect-{{section.settings.effect}} effect small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                  {%- unless section.settings.l3banner == blank -%}
                  <a href="{{ section.settings.l3bannerlink }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ section.settings.l3banner | img_url: 'master' }}" class="width-100 lazyload" alt="{{ section.settings.l3banner.alt }}" />
                  </a>
                  {% else %}
                  <a href="{{ section.settings.l3bannerlink }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '370x370.png' | asset_url }}" class="width-100 lazyload" alt="{{ section.settings.l3banner.alt }}" />
                  </a>
                  {%- endunless -%}
                </div>
                <div class="bottom-right-area cell effect-{{section.settings.effect}} effect small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                  {%- unless section.settings.l4banner == blank -%}
                  <a href="{{ section.settings.l4bannerlink }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ section.settings.l4banner | img_url: 'master' }}" class="width-100 lazyload" alt="{{ section.settings.l4banner.alt }}" />
                  </a>
                  {% else %}
                  <a href="{{ section.settings.l4bannerlink }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '370x370.png' | asset_url }}" class="width-100 lazyload" alt="{{ section.settings.l4banner.alt }}" />
                  </a>
                  {%- endunless -%}
                </div>
              </div>
            </div>
            <div class="right-area cell medium-6 large-6">
              <div class="effect-{{section.settings.effect}} effect">
                {%- unless section.settings.rbanner == blank -%}
                <a href="{{ section.settings.rbannerlink }}" class="index-banner-grid-image display-block">
                  <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ section.settings.rbanner | img_url: 'master' }}" class="width-100 lazyload" alt="{{ section.settings.rbanner.alt }}" />
                </a>
                {% else %}
                <a href="{{ section.settings.rbannerlink }}" class="index-banner-grid-image display-block">
                  <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '735x735.png' | asset_url }}" class="width-100 lazyload" alt="{{ section.settings.rbanner.alt }}" />
                </a>
                {%- endunless -%}
              </div>
            </div>   
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

