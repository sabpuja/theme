{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="collection" data-section-name="index-collection-flexible">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content"> 
        <div class="index-collection-banner-container box border-none">
        <div class="box-content">
          {% if section.blocks.size > 0 %}
          <div class="index-collection-grid-list grid-x grid-margin-x align-center">
            {% for block in section.blocks %}
            {% case block.type %}
            {% when 'top_rate' %}
            <div class="top-rate-content isb-product cell small-{{ block.settings.re_column_small }} medium-{{ block.settings.re_column_medium }} large-{{ block.settings.re_column_large }} xlarge-{{ block.settings.re_column_xlarge }} xxlarge-{{ block.settings.re_column_xxlarge }} xxxlarge-{{ block.settings.re_column_xxxlarge }}">
              <div class="box-divider grid-x">
                {% if block.settings.title != blank %}
                <h2 class="box-title width-100">{{ block.settings.title }}</h2>
                {% endif %}
              </div>
              <div class="box-content top-rate-group">
                <div class="carousel" data-carousel-param='{"effect": "{{ block.settings.effect }}", "autoplay": "{{ block.settings.autoplay }}", "autoplaySpeed": "{{ block.settings.autoplay_speed }}", "space": "{{ block.settings.space }}", "column_small": "1", "column_medium": "1", "column_large": "1", "column_xlarge": "1", "column_xxlarge": "1", "column_xxxlarge": "1", "row": "1"}' data-carousel>
                  <div class="carousel-wrapper carousel-nav-visible carousel-nav-top-right">
                    <div class="swiper-container" data-carousel-container>
                      <div class="swiper-wrapper grid-margin-x small-up-1 medium-up-1 large-up-1 xlarge-up-1 xxlarge-up-1 xxxlarge-up-1">
                        {% for product in collections[block.settings.collection].products limit:block.settings.limit %}
                        <div class="swiper-slide cell" data-carousel-item>
                          <div class="product-grid">
                            {% include 'index-product-item3' %} 
                          </div>
                        </div>
                        {% else %}
                        {% for i in (1..1) %}
                        {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                        <div class="product-grid">
                          <div class="product-item" data-product-item>
                            <div class="product-item-thumb">
                              <a href="javascript:void(0);" class="display-block">
                                {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                              </a>                          
                            </div>
                            <div class="product-item-caption">
                              <div class="grid-x">
                                <div class="cell auto">
                                  <h4 class="product-item-title">
                                    <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                                  </h4>
                                </div>
                                <div class="cell shrink show-for-large">
                                  {%- if settings.product_item_wishlist -%}
                                  <button class="product-item-button-wishlist">
                                    <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                                    <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                                  </button>
                                  {%- endif -%}
                                </div>
                              </div>
                              <div class="position-relative">
                                <div class="product-item-buttons">
                                  <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>    
                                  {%- if settings.product_item_compare -%}
                                  <button class="product-item-button product-item-button-compare">
                                    <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                                    <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                                    <span>{{ 'general.button.compare' | t }}</span>
                                  </button>
                                  {%- endif -%}
                                </div>
                              </div>
                              <div class="product-item-price">
                                <span class="product-item-price-sale">$99.00</span>
                              </div>
                            </div>
                          </div>
                        </div>
                        {% endfor %}                        
                        {% endfor %}
                      </div>
                    </div>
                    <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                    <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                  </div>
                </div>
              </div>
            </div>
            {% when 'best_seller' %}
            <div class="best-seller-banner-content isb-product cell small-{{ block.settings.re_column_small }} medium-{{ block.settings.re_column_medium }} large-{{ block.settings.re_column_large }} xlarge-{{ block.settings.re_column_xlarge }} xxlarge-{{ block.settings.re_column_xxlarge }} xxxlarge-{{ block.settings.re_column_xxxlarge }}">
              <div class="box-divider grid-x">
                {%- if block.settings.title != blank -%}
                <h2 class="box-title width-100">{{ block.settings.title }}</h2>
                {% endif %}
              </div>
              <div class="box-content best-seller-banner-group">
                {% if block.settings.collections_active %}
                <div class="best-seller-content grid-x">
                  <div class="carousel" data-carousel-param='{"effect": "{{ block.settings.effect }}", "autoplay": "{{ block.settings.autoplay }}", "autoplaySpeed": "{{ block.settings.autoplay_speed }}", "space": "{{ block.settings.space }}", "column_small": "2", "column_medium": "2", "column_large": "3", "column_xlarge": "3", "column_xxlarge": "3", "column_xxxlarge": "3", "row": "1"}' data-carousel>
                    <div class="carousel-wrapper carousel-nav-visible carousel-nav-top-right">
                      <div class="swiper-container" data-carousel-container>
                        <div class="swiper-wrapper grid-margin-x small-up-3 medium-up-3 large-up-3 xlarge-up-3 xxlarge-up-3 xxxlarge-up-3">
                          {% for product in collections[block.settings.collection].products limit: block.settings.limit %}
                          <div class="swiper-slide cell" data-carousel-item>                          
                            <div class="product-grid">
                              {% include 'index-product-item' %}
                            </div>
                          </div>
                          {% else %}
                          {% for i in (1..block.settings.limit) %}
                          {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                          <div class="swiper-slide cell" data-carousel-item>
                            <div class="product-grid">
                              <div class="product-item" data-product-item>
                                <div class="product-item-thumb">
                                  <a href="javascript:void(0);" class="display-block">
                                    {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                  </a>                          
                                </div>
                                <div class="product-item-caption">
                                  <div class="grid-x">
                                    <div class="cell auto">
                                      <h4 class="product-item-title">
                                        <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                                      </h4>
                                    </div>
                                    <div class="cell shrink show-for-large">
                                      {%- if settings.product_item_wishlist -%}
                                      <button class="product-item-button-wishlist">
                                        <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                                        <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                                      </button>
                                      {%- endif -%}
                                    </div>
                                  </div>
                                  <div class="position-relative">
                                    <div class="product-item-buttons">
                                      <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>    
                                      {%- if settings.product_item_compare -%}
                                      <button class="product-item-button product-item-button-compare">
                                        <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                                        <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                                        <span>{{ 'general.button.compare' | t }}</span>
                                      </button>
                                      {%- endif -%}
                                    </div>
                                  </div>
                                  <div class="product-item-price">
                                    <span class="product-item-price-sale">$99.00</span>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                          {% endfor %}
                          {% endfor %}
                        </div>
                      </div>
                      <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                      <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                    </div>
                  </div>
                </div>
                {% endif %}
                {% if block.settings.banner_active %}
                <div class="banner-content">
                  {% unless block.settings.banner == blank %}
                  <a href="{{ block.settings.banner_link }}" class="index-banner-grid-image display-block effect-{{section.settings.effect}} effect">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.banner | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.banner.alt }}" />
                  </a>
                  {% else %}
                  <a href="{{ block.settings.banner_link }}" class="index-banner-grid-image display-block effect-{{section.settings.effect}} effect">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '720x220.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.banner.alt }}" />
                  </a>
                  {% endunless %}
                </div>
                {%- endif -%}
              </div>
            </div>
            {% when 'recently_viewed' %}
            <div class="recently-viewed-content isb-product cell small-{{ block.settings.re_column_small }} medium-{{ block.settings.re_column_medium }} large-{{ block.settings.re_column_large }} xlarge-{{ block.settings.re_column_xlarge }} xxlarge-{{ block.settings.re_column_xxlarge }} xxxlarge-{{ block.settings.re_column_xxxlarge }}">
              <div class="box-divider grid-x">
                {% if block.settings.title != blank %}
                <h2 class="box-title width-100">{{ block.settings.title }}</h2>
                {% endif %}
              </div>
              <div class="box-content recently-viewed-group">
                <div class="recently-viewed-content grid-x">
                  <div class="carousel" data-carousel-param='{"effect": "{{ block.settings.effect }}", "autoplay": "{{ block.settings.autoplay }}", "autoplaySpeed": "{{ block.settings.autoplay_speed }}", "space": "{{ block.settings.space }}", "column_small": "2", "column_medium": "1", "column_large": "1", "column_xlarge": "1", "column_xxlarge": "1", "column_xxxlarge": "1", "row": "4", "rowMobile": "1"}' data-carousel>
                    <div class="carousel-wrapper carousel-nav-visible carousel-nav-top-right">
                      <div class="swiper-container" data-carousel-container>
                        <div class="swiper-wrapper grid-margin-x small-up-1 medium-up-1 large-up-1 xlarge-up-1 xxlarge-up-1 xxxlarge-up-1">
                          {% for product in collections[block.settings.collection].products limit: block.settings.limit %}
                          <div class="swiper-slide cell" data-carousel-item>                          
                            <div class="product-grid">
                              {% include 'index-product-item-grid' %}
                            </div>
                          </div>
                          {% else %}
                          {% for i in (1..block.settings.limit) %}
                          {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                          <div class="swiper-slide cell" data-carousel-item>
                            <div class="product-grid">
                              <div class="product-item grid-x" data-product-item>
                                <div class="product-item-thumb cell small-12 medium-12 large-4 xlarge-4 xxlarge-4 xxxlarge-4">
                                  <a href="javascript:void(0);" class="display-block">
                                    {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                  </a>                          
                                </div>
                                <div class="product-item-caption cell small-12 medium-12 large-8 xlarge-8 xxlarge-8 xxxlarge-8">
                                  <div class="grid-x">
                                    <div class="cell auto">
                                      <h4 class="product-item-title">
                                        <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                                      </h4>
                                    </div>
                                    <div class="cell shrink show-for-large">
                                      {%- if settings.product_item_wishlist -%}
                                      <button class="product-item-button-wishlist">
                                        <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                                        <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                                      </button>
                                      {%- endif -%}
                                    </div>
                                  </div>
                                  <div class="position-relative">
                                    <div class="product-item-buttons">
                                      <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>    
                                      {%- if settings.product_item_compare -%}
                                      <button class="product-item-button product-item-button-compare">
                                        <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                                        <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                                        <span>{{ 'general.button.compare' | t }}</span>
                                      </button>
                                      {%- endif -%}
                                    </div>
                                  </div>
                                  <div class="product-item-price">
                                    <span class="product-item-price-sale">$99.00</span>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                          {% endfor %}
                          {% endfor %}
                        </div>
                      </div>
                      <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                      <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            {% endcase %}
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Products Flexible",
  "class": "index-section index-collection-flexible",
  "settings": [
	{
      "type": "paragraph",
      "content": "View [Mockup of Section layout](https:\/\/i.imgur.com\/7NIjYYZ.png)"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{    
      "type": "select",
      "id": "effect",
      "label": "Banner Hover Effect",
      "options": [
        {
          "value": "scope",
          "label": "Scope"
        },       
        {
          "value": "pulse",
          "label": "Pulse"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        },       
        {
          "value": "blur",
          "label": "Blur"
        },
        {
          "value": "grayscale",
          "label": "Gray scale"
        },
        {
          "value": "line-image",
          "label": "Line 1"        
        }, 
        {
          "value": "scope3",
          "label": "Line 2"
        },              
        {
          "value": "zoom",
          "label": "Zoom"        
        },
        {
          "value": "zoom-opacity",
          "label": "Zoom Opacity"        
        },
        {
          "value": "apollo",
          "label": "Apollo"        
        },
        {
          "value": "jazz",
          "label": "Jazz"        
        },
        {
          "value": "ming",
          "label": "Ming"        
        },
        {
          "value": "bounce",
          "label": "Bounce"        
        },
        {
          "value": "flash",
          "label": "Flash"        
        },
        {
          "value": "animate-pulse",
          "label": "Animate Pulse"        
        },
        {
          "value": "heartBeat",
          "label": "Heart Beat"        
        },
        {
          "value": "backInDown",
          "label": "Back In Down"        
        },                
        {
          "value": "bounceInUp",
          "label": "Bounce In Up"        
        },        
        {
          "value": "bounceInRight",
          "label": "Bounce In Right"        
        },
        {
          "value": "bounceInLeft",
          "label": "Bounce In Left"        
        },
        {
          "value": "bounceInDown",
          "label": "Bounce In Down"        
        },
        {
          "value": "bounceIn",
          "label": "Bounce In"        
        },        
        {
          "value": "rotateInUpRight",
          "label": "Rotate In Up Right"        
        },
        {
          "value": "rotateInUpLeft",
          "label": "Rotate In Up Left"        
        },
        {
          "value": "rotateInDownRight",
          "label": "Rotate In Down Right"        
        },
        {
          "value": "rotateInDownLeft",
          "label": "Rotate In Down Left"        
        },
        {
          "value": "rotateIn",
          "label": "Rotate In"        
        },        
        {
          "value": "lightSpeedInLeft",
          "label": "Light Speed InLeft"        
        },        
        {
          "value": "flipInY",
          "label": "Flip In Y"        
        },
        {
          "value": "flipInX",
          "label": "Flip In X"        
        },
        {
          "value": "flip",
          "label": "Flip"        
        },
        {
          "value": "jackInTheBox",
          "label": "Jack In The Box"        
        }                                                    
      ],
      "default": "scope"      
    }
  ],
  "blocks": [
    {
      "type": "top_rate",
      "name": "Top Rate",
      "settings": [
		{
          "type": "header",
          "content": "Block Grid"
        },
		{
          "type": "select",
          "id": "re_column_small",
          "label": "Width",
          "info": "For small screen (0px - 550px)",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            },
            {
              "value": "3",
              "label": "1/4"
            },
            {
              "value": "9",
              "label": "3/4"
            }
          ],
          "default": "12"
        },
        {
          "type": "select",
          "id": "re_column_medium",
          "label": "Width",
          "info": "For medium screen (551px - 800px)",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            },
            {
              "value": "3",
              "label": "1/4"
            },
            {
              "value": "9",
              "label": "3/4"
            }
          ],
          "default": "3"
        },
        {
          "type": "select",
          "id": "re_column_large",
          "label": "Width",
          "info": "For large screen (801px - 1260px)",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            },
            {
              "value": "3",
              "label": "1/4"
            },
            {
              "value": "9",
              "label": "3/4"
            }
          ],
          "default": "3"
        },
        {
          "type": "select",
          "id": "re_column_xlarge",
          "label": "Width",
          "info": "For xlarge screen (1261px - 1440px)",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
