{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-banner-testimonial">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content" style="background-color:{{ section.settings.bkg }}">
        <div class="box border-none index-text-banner-grid-container">
          {%- if section.settings.title != blank or section.settings.sub_title != blank -%}
          <div class="box-divider blog-title">
            <h2 class="box-title width-100">{{ section.settings.title }}</h2>
          </div>
          {%- endif -%}
          <div class="box-content">
            <div class="grid-x gr-testimonial-area">          
              {% for block in section.blocks %}
              {% if block.type == 'text' %}
              <div class="testimonial-area" {% if block.settings.color !='rgba(0,0,0,0)' and  block.settings.color !='' %} {% endif %}>
                <div class="index-test-content {{ column }}">
                  <div class="test-icon"><svg class="svg-icon"><use xlink:href="#quote-left" /></svg></div>
                  <div class="test-preview">{{ block.settings.title }}</div>
                  <div class="test-info">{{ block.settings.desc }}</div>    
                  {% if block.settings.rating %}
                  <div class="test-rating stars-global">
                    <svg class="svg-icon"><use xlink:href="#icon-star" /></svg>
                    <svg class="svg-icon"><use xlink:href="#icon-star" /></svg>
                    <svg class="svg-icon"><use xlink:href="#icon-star" /></svg>
                    <svg class="svg-icon"><use xlink:href="#icon-star" /></svg>
                    <svg class="svg-icon"><use xlink:href="#icon-star" /></svg>
                  </div>
                  {% endif %}
                </div>
              </div>
              {% elsif block.type == 'banner' %}
              <div class="banner-area">
                {%- unless block.settings.image == blank -%}
                <a href="{{ block.settings.link }}" class="index-banner-grid-image effect-{{section.settings.effect}} effect display-block">
                  <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image | img_url: image_size }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                </a>
                {% else %}
                <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">                
                  <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '625x500.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                </a>
                {%- endunless -%}
              </div>
              {% endif %}
              {% endfor %}          
            </div>
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

  
