{{ 'sabpuja-guide.css' | asset_url | stylesheet_tag }}
{{ 'sabpuja-puja-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sabpuja-published-guides.js' | asset_url }}"></script>
<script src="{{ 'sabpuja-guide.js' | asset_url }}" defer></script>
<script src="{{ 'sabpuja-puja-guide.js' | asset_url }}" defer></script>

<section
  class="sp-guide"
  data-sp-guide-root
  data-sp-guide-finder
  data-predictive-search-url="{{ routes.predictive_search_url }}"
  aria-labelledby="sp-guide-title"
>
  <div class="sp-guide__ambient sp-guide__ambient--left" aria-hidden="true"></div>
  <div class="sp-guide__ambient sp-guide__ambient--right" aria-hidden="true"></div>

  <div class="sp-guide__card">
    <div class="sp-guide__brand">
      <img
        src="{{ 'sabpuja-logo-horizontal.svg' | asset_url }}"
        alt="Sabpuja"
        width="280"
        height="93"
        loading="eager">
    </div>

    <p class="sp-guide__kicker">Your Personal Puja Guide</p>
    <h1 class="sp-guide__title" id="sp-guide-title">Find Your Puja Guide</h1>
    <p class="sp-guide__intro">
      Namaste <span aria-hidden="true">🙏</span><br>
      Choose your <strong>Puja Guide</strong> below. If you have a Guide Code or SKU, you can use that as an alternate way to find the right guide.
    </p>

    <div class="sp-guide__methods">
      <form class="sp-guide__method sp-guide__method--primary" data-sp-guide-select-form>
        <div class="sp-guide__method-head">
          <span class="sp-guide__step">1</span>
          <div>
            <h2>Choose a Puja Guide</h2>
            <p>Select the Sabpuja kit you have and open its published Puja Vidhi.</p>
          </div>
        </div>

        <label class="sp-guide__label" for="sp-guide-select">Select your Puja Kit</label>
        <div class="sp-guide__select-wrap">
          <select class="sp-guide__control sp-guide__select" id="sp-guide-select" name="guide" data-sp-guide-select>
            <option value="">Select a Puja Guide</option>
          </select>
          <span class="sp-guide__select-icon" aria-hidden="true">⌄</span>
        </div>

        <button class="sp-guide__button" type="submit" data-sp-guide-select-button disabled>
          <span>Open Selected Guide</span>
          <span aria-hidden="true">→</span>
        </button>
        <p class="sp-guide__hint">Choose from the published Sabpuja kit guides. Your selected Puja Vidhi will open below.</p>
      </form>

      <div class="sp-guide__or" aria-hidden="true"><span>or use your code</span></div>

      <form class="sp-guide__method sp-guide__method--secondary" data-sp-guide-code-form novalidate>
        <div class="sp-guide__method-head">
          <span class="sp-guide__step">2</span>
          <div>
            <h2>Find by Guide Code</h2>
            <p>Best when you have your Sabpuja packaging with you.</p>
          </div>
        </div>

        <label class="sp-guide__label" for="sp-guide-code">Guide Code / SKU</label>
        <input
          class="sp-guide__control"
          id="sp-guide-code"
          name="guide_code"
          type="text"
          inputmode="text"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          placeholder="Example: SP-..."
          aria-describedby="sp-guide-code-hint sp-guide-status">

        <button class="sp-guide__button sp-guide__button--secondary" type="submit">
          <span>Find My Guide</span>
          <span aria-hidden="true">→</span>
        </button>

        <p class="sp-guide__hint" id="sp-guide-code-hint">
          Enter the code exactly as printed near the product name or barcode.
        </p>
        <p class="sp-guide__status" id="sp-guide-status" data-sp-guide-status role="status" aria-live="polite"></p>
      </form>
    </div>

    <div class="sp-guide__help">
      <details>
        <summary>Where can I find my Guide Code?</summary>
        <p>
          Check near the product name or barcode on your Sabpuja packaging or product label.
          The SKU shown with the product can also be used for lookup when it matches the purchased item.
        </p>
      </details>
    </div>

    <div class="sp-guide__divider" aria-hidden="true"><span>ॐ</span></div>
    <p class="sp-guide__trust">Simple <span>•</span> Private <span>•</span> No login required</p>
  </div>
</section>


<section class="sp-puja-reader" data-sp-puja-reader data-requires-guide="true" hidden>
  <div class="pg-shell">
    <a class="pg-guide-back" href="/pages/guide" data-pg-back>← Back to Guide Finder</a>
    <section class="pg-hero">
      <div class="pg-eyebrow">SP-GUIDE · Published Sabpuja guide</div>
      <h1 data-pg-title>Sabpuja Puja Guide</h1>
      <p data-pg-summary></p>
      <div class="pg-guide-selector">
        <div class="pg-field">
          <label for="store-published-guide-select">Choose another published guide</label>
          <select class="pg-select" id="store-published-guide-select" data-pg-guide-select></select>
        </div>
        <div class="pg-status-chip"><span class="pg-status-dot"></span><span data-pg-status-chip>Published guide</span></div>
      </div>
      <div class="pg-guide-meta-row">
        <span class="pg-meta-chip" data-pg-code></span>
        <span class="pg-meta-chip" data-pg-version></span>
        <span class="pg-meta-chip" data-pg-reviewed></span>
      </div>
      <div class="pg-preflight">
        <div class="pg-preflight-card">
          <h2>Before you begin</h2>
          <ul data-pg-preparation></ul>
        </div>
        <div class="pg-preflight-card">
          <h2>Important guidance</h2>
          <p class="pg-important" data-pg-important></p>
        </div>
      </div>
      <div class="pg-guide-panels">
        <details data-pg-special-panel hidden>
          <summary data-pg-special-title>Optional / tradition-specific guidance</summary>
          <div data-pg-special-content></div>
        </details>
        <details data-pg-care-panel>
          <summary>Care &amp; safety</summary>
          <div data-pg-care-content></div>
        </details>
        <details data-pg-about-panel>
          <summary>About this published guide</summary>
          <div data-pg-about-content></div>
        </details>
      </div>
    </section>

    <div class="pg-layout">
      <aside class="pg-rail" aria-label="Guide steps">
        <div class="pg-rail-title">Your puja journey</div>
        <div class="pg-steps" data-pg-step-nav></div>
        <div class="pg-rail-note"><strong>Gentle guidance:</strong> move at your own pace. You can revisit completed steps at any time.</div>
        <button class="pg-reset" data-pg-reset type="button">Reset progress</button>
      </aside>

      <section class="pg-main" aria-live="polite">
        <div class="pg-progress-card">
          <div class="pg-progress-ring" data-pg-progress-ring><strong data-pg-ring-label>0%</strong></div>
          <div class="pg-progress-copy">
            <strong data-pg-progress-title></strong>
            <span data-pg-progress-subtitle></span>
            <div class="pg-progress-track" aria-hidden="true"><div class="pg-progress-fill" data-pg-progress-fill></div></div>
          </div>
          <div class="pg-streak"><strong data-pg-blessing-count>0</strong><span>steps completed</span></div>
        </div>

        <div class="pg-mobile-progress" data-pg-mobile-progress aria-label="Guide progress"></div>

        <article class="pg-card" data-pg-guide-card>
          <div data-pg-step-view>
            <div class="pg-card-head">
              <div class="pg-step-kicker"><span data-pg-step-label></span><span data-pg-step-time>About 1–2 min</span></div>
              <h2 data-pg-step-title></h2>
              <p class="pg-intro" data-pg-step-intro></p>
            </div>
            <div class="pg-card-body">
              <div class="pg-instruction">
                <div class="pg-icon" data-pg-step-icon>🙏</div>
                <div><strong data-pg-instruction-title></strong><p data-pg-instruction-copy></p></div>
              </div>

              <div class="pg-detail-grid">
                <div class="pg-detail"><h3>Guide note</h3><p data-pg-guide-note></p></div>
                <div class="pg-detail"><h3>Tradition note</h3><p data-pg-tradition-note></p></div>
              </div>

              <div class="pg-mantra" data-pg-mantra-card hidden>
                <small>Mantra / prayer guidance</small>
                <blockquote data-pg-mantra></blockquote>
                <p data-pg-mantra-note></p>
              </div>

              <div class="pg-optional" data-pg-extra-wrap hidden>
                <details>
                  <summary>Need a little more guidance?</summary>
                  <p data-pg-extra-guidance></p>
                </details>
              </div>

              <div class="pg-blessing" data-pg-blessing-card>
                <div class="pg-blessing-icon">🌼</div>
                <div><strong>Step completed</strong><p data-pg-blessing-copy></p></div>
              </div>

              <div class="pg-action-zone">
                <div class="pg-check" data-pg-completion-status><span class="dot"></span><span>Complete this step when you are ready</span></div>
                <div class="pg-actions">
                  <button class="pg-btn pg-btn--ghost" data-pg-back-btn type="button">Back</button>
                  <button class="pg-btn pg-btn--primary" data-pg-primary-btn type="button">Complete step</button>
                </div>
              </div>

              <div class="pg-timeline pg-timeline--inline" aria-label="Puja journey timeline">
                <div class="pg-timeline-label">
                  <strong>Your puja journey</strong>
                  <span>See what is done and what comes next</span>
                </div>
                <div class="pg-timeline__track" data-pg-journey-timeline>
                  <div class="pg-timeline__fill" data-pg-timeline-fill aria-hidden="true"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="pg-complete" data-pg-complete-view>
            <div class="pg-garland" aria-hidden="true">🌼 🌼 🌼 🌼 🌼</div>
            <div class="pg-complete-badge">🙏</div>
            <h2>Puja Sampann</h2>
            <p data-pg-complete-copy>Your guide is complete. Close the puja with gratitude according to your family tradition.</p>
            <div class="pg-complete-offering">Guide completed with shraddha and care</div>
            <div class="pg-final-blessing">शुभम् भवतु · May there be auspiciousness</div>
            <div class="pg-complete-actions">
              <button class="pg-btn pg-btn--primary" data-pg-finish-again type="button">View completed journey</button>
              <button class="pg-btn pg-btn--ghost" data-pg-restart type="button">Start again</button>
            </div>
          </div>
        </article>
      </section>
    </div>
  </div>
  <div class="pg-petal-layer" data-pg-petal-layer aria-hidden="true"></div>
  <div class="pg-reward-toast" data-pg-reward-toast role="status" aria-live="polite">
    <div class="pg-toast-mark">✦</div>
    <div><strong>Step completed</strong><span data-pg-toast-copy>Continue when you are ready.</span></div>
  </div>
</section>


