{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banners-custom7">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none index-banner-grid-container">
          <div class="box-content">
            {% if section.blocks.size > 0 %}
            <div class="index-banner-grid-list grid-x align-center">
              {% for block in section.blocks %}
              {% if block.type == 'one_banner' %}
              <div class="index-banner-grid-one cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }} xxlarge-{{ block.settings.column_xxlarge }} xxxlarge-{{ block.settings.column_xxxlarge }} text-center">
                <div class="index-banner-grid-item effect-{{section.settings.effect}} effect">
                  {% unless block.settings.image == blank %}
                  <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                  </a>
                  {% else %}
                  <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">
                    {% if block.settings.column_xxxlarge == '4' %}
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '640x640.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                    {% elsif block.settings.column_xxxlarge == '12' %}
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '1920x450.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                    {% else %}
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '960x700.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                    {% endif %}
                  </a>
                  {% endunless %}
                  <div class="index-banner-grid-info index-banner-grid-info--image">
                    <div class="index-top-banner-title">
                      <a href="{{ block.settings.link }}">
                        {% if block.settings.title != blank %}{{ block.settings.title }}{% endif %}
                      </a>
                    </div>
                  </div>
                </div>
              </div>
              {% else %}
              <div class="index-banner-grid-two cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }} xxlarge-{{ block.settings.column_xxlarge }} xxxlarge-{{ block.settings.column_xxxlarge }} text-center">
                <div class="banner-grid-two-top index-banner-grid-item effect-{{section.settings.effect}} effect">
                  {% unless block.settings.top_image == blank %}
                  <a href="{{ block.settings.top_link }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.top_image | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.top_image.alt }}" />
                  </a>
                  {% else %}
                  <a href="{{ block.settings.top_link }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '960x350.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.top_image.alt }}" />
                  </a>
                  {% endunless %}
                  <div class="index-banner-grid-info index-banner-grid-info--image">
                    <div class="index-top-banner-title">
                      <a href="{{ block.settings.top_link }}">
                        {% if block.settings.top_title != blank %}{{ block.settings.top_title }}{% endif %}
                      </a>
                    </div>
                  </div>
                </div>
                <div class="banner-grid-two-bottom index-banner-grid-item effect-{{section.settings.effect}} effect">
                  {% unless block.settings.bottom_image == blank %}
                  <a href="{{ block.settings.bottom_link }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.bottom_image | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.bottom_image.alt }}" />
                  </a>
                  {% else %}
                  <a href="{{ block.settings.bottom_link }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '960x350.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.bottom_image.alt }}" />
                  </a>
                  {% endunless %}
                  <div class="index-banner-grid-info index-banner-grid-info--image">
                    <div class="index-top-banner-title">
                      <a href="{{ block.settings.bottom_link }}">
                        {% if block.settings.bottom_title != blank %}{{ block.settings.bottom_title }}{% endif %}
                      </a>
                    </div>
                  </div>
                </div>
              </div>
              {% endif %}
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

