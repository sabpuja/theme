{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banner-parallax2">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{ section.settings.bkg }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="index-banner-parallax-container parallax-custom" style="background-image:url({% if section.settings.banner %}{{ section.settings.banner | img_url: 'master'}}{% else %}{{ '1920x1460.png' | asset_url }}{% endif %})">          
          {% if section.settings.title %}
          <div class="index-banner-parallax-title" style="color:{{ section.settings.color }}; font-size:{{ section.settings.titlesize }}px;">
            {{ section.settings.title }}
          </div>
          {% endif %}            
          <div class="index-banner-parallax-image">
            <img src="{% if section.settings.banner %}{{ section.settings.caption | img_url: 'master' }}{% else %}{{ '1920x500.png' | asset_url }}{% endif %}" alt="{{ section.settings.caption.alt }}"/>
          </div>                                
        </div>  
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div> 
  
  
{% schema %}
{
  "name": "Banner Parallax #2",
  "class": "index-section index-banner-parallax2",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "color",
      "id": "bkg",
      "label": "Background color",
	  "default":"#f4f4f4"
    },
    {
      "type": "header",
      "content": "Section settings"
    },  
	{
      "type": "image_picker",
      "id": "banner",
	  "label":"Upload Image background"
    },
	{
      "type": "textarea",
      "id": "title",
	  "label":"Caption Text"
    },	
	{
      "type":   "range",
      "id":     "titlesize",
      "min":       12,
      "max":       100,
      "step":      1,
      "unit":      "px",
      "label":     "Font size",
      "default":   24
    },	
	{
      "type": "color",
      "id": "color",
      "label": "Title Color",
	  "default":"#000"
    },
	{
      "type": "image_picker",
      "id": "caption",
	  "label":"Caption Image"
    }	
  ],
  "presets": [
    {
      "name": "Banner Parallax #2",
      "category": "Image"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}