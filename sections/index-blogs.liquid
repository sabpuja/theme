{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="blogs" data-section-name="index-blogs" class="{% if section.settings.dark %}dark-mode{% else %}normal-mode{% endif %}">
  <div class="{{ section.settings.display }} spacing-{{ section.id }} {% if section.settings.bkg %}have-bkg{% else %}no-bkg{% endif %}" style="{% if section.settings.bkg %}background-image:url({{ section.settings.bkg | img_url: 'master' }}){% endif %}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">   
        <div class="index-blogs-container isb-product box border-none">
          {%- if section.settings.title != blank or section.settings.sub_title != blank -%}
          <div class="box-divider position-{{ section.settings.title_position }} line-{{ section.settings.line }}">
            {%- if section.settings.title != blank -%}
            <h2 class="box-title width-100" style="color:{{ section.settings.color }}; font-size:{{ section.settings.titlesize }}px; font-weight:{{ section.settings.title_weight}};">{{ section.settings.title }}</h2>
            {%- endif -%}
          </div>
          {%- endif -%}
          <div class="box-content">
            <div class="index-blogs-content align-{{ section.settings.layout2}}">
              <div class="carousel" data-carousel-param='{"effect": "{{ section.settings.effect }}", "direction": "{{ section.settings.direction }}", "autoplay": "{{ section.settings.autoplay }}", "autoplaySpeed": "{{ section.settings.autoplay_speed }}", "space": "{{ section.settings.space }}", "column_small": "{{ section.settings.column_small }}", "column_medium": "{{ section.settings.column_medium }}", "column_large": "{{ section.settings.column_large }}", "column_xlarge": "{{ section.settings.column_xlarge }}", "column_xxlarge": "{{ section.settings.column_xxlarge }}", "column_xxxlarge": "{{ section.settings.column_xxxlarge }}", "row": "{{ section.settings.row }}", "center": "{{ section.settings.center }}"}' data-carousel>
                <div class="carousel-wrapper carousel-{{ section.settings.navigation_position }} carousel-nav-visible">
                  {%- assign image_size = section.settings.image_width | append: 'x' | append: section.settings.image_height -%}
                  {% assign readmore = section.settings.readmore %}
                  {% assign effect2 = section.settings.effect2 %}
                  <div class="swiper-container" data-carousel-container>
                    <div class="swiper-wrapper small-up-{{ section.settings.column_small }} medium-up-{{ section.settings.column_medium }} large-up-{{ section.settings.column_large }} xlarge-up-{{ section.settings.column_xlarge }} xxlarge-up-{{ section.settings.column_xxlarge }} xxxlarge-up-{{ section.settings.column_xxxlarge }}">
                      {% for article in blogs[section.settings.select_blog].articles limit:section.settings.limit %}
                      <div class="swiper-slide" data-carousel-item>
                        <div class="index-blogs-item width-{{ section.settings.layout }}">
                          {%- include 'index-article-item' -%}
                        </div>
                      </div>
                      {% else %}
                      {% for i in (1..section.settings.limit) %}
                      <div class="swiper-slide" data-carousel-item>
                        <div class="index-blogs-item">
                          <div class="article-item grid-x">
                            <div class="article-image effect-{{section.settings.effect2}} effect cell medium-6">
                              <a href="javascript:void(0);" class="display-block">
                                <img src="{{ '470x320.png' | asset_url }}" class="article-item-image" alt="{{ article.title }}"/>
                              </a>
                            </div>
                            <div class="article-information cell medium-auto">                
                              <h2 class="article-item-title">
                                <a href="{{ article.url }}">{{ 'homepage.onboarding.blog_title' |t }}</a>
                              </h2>
                              <div class="article-item-info">       
                                <span class="article-item-date">March 25, 2018</span>
                              </div>
                              <div class="article-content">
                                Your post content
                              </div>
                              <a class="article-readmore" href="{{ article.url }}">{{ section.settings.readmore }}</a>
                            </div>
                          </div>
                        </div>
                      </div>
                      {% endfor %}
                      {% endfor %}
                    </div>
                  </div>
                  {%- if section.settings.navigation -%}
                  <!-- If we need navigation buttons -->
                  <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                  <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                  {%- endif -%}
                </div>
                {%- if section.settings.pagination -%}
                <!-- If we need pagination -->
                <div class="carousel-pagination" data-carousel-pagination></div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


