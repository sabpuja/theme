{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-collection-grid">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content"> 
        <div class="box border-none index-group-blocks-container">
        <div class="box-content grid-x grid-margin-x">
          <div class="left-area cell {% if section.settings.rightcol %}small-12 medium-8 large-9{% else %}small-12 medium-12 large-12 xlarge-12 xxlarge-12 xxxlarge-12{% endif %}">
            {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
            {% if block.type == 'banner' %}
            <div class="left-element left-banner grid-x grid-margin-x">
              <div class="index-banner-grid-item effect-{{block.settings.effect}} effect cell">
                {%- unless block.settings.image1 == blank -%}
                <a href="{{ block.settings.link1 }}" class="index-banner-grid-image display-block">
                  <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image1 | img_url: 'master' }}" class="lazyload" alt="{{ block.settings.image1.alt }}" />
                </a>
                {% else %}
                <a href="{{ block.settings.link1 }}" class="index-banner-grid-image display-block">
                  <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '1095x250.png' | asset_url }}" class="lazyload" alt="{{ block.settings.image1.alt }}" />
                </a>
                {%- endunless -%}
              </div>
            </div>
            {% endif %}

            {% if block.type == 'banners' %}
            <div class="left-element left-banners grid-x grid-margin-x">
              <div class="index-banner-grid-item effect-{{block.settings.effect}} effect cell small-12 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                {%- unless block.settings.image1 == blank -%}
                <a href="{{ block.settings.link1 }}" class="index-banner-grid-image display-block">
                  <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image1 | img_url: 'master' }}" class="lazyload" alt="{{ block.settings.image1.alt }}" />
                </a>
                {% else %}
                <a href="{{ block.settings.link1 }}" class="index-banner-grid-image display-block">
                  <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '532x250.png' | asset_url }}" class="lazyload" alt="{{ block.settings.image1.alt }}" />
                </a>
                {%- endunless -%}
              </div>
              <div class="index-banner-grid-item effect effect-{{block.settings.effect}} cell small-12 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                {%- unless block.settings.image2 == blank -%}
                <a href="{{ block.settings.link2 }}" class="index-banner-grid-image display-block">
                  <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image2 | img_url: 'master' }}" class="lazyload" alt="{{ block.settings.image2.alt }}" />
                </a>
                {% else %}
                <a href="{{ block.settings.link2 }}" class="index-banner-grid-image display-block">
                  <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '532x250.png' | asset_url }}" class="lazyload" alt="{{ block.settings.image2.alt }}" />
                </a>
                {%- endunless -%}
              </div>
            </div>
            {% endif %}

            {% if block.type == 'productslider' %}
            <div class="left-element left-product-slider grid-x">
              {% if block.settings.title != '' %}<div class="box-title">{{ block.settings.title }}</div>{% endif %}
              <div class="box-slider width-100">
                <div class="carousel" data-carousel-param='{"effect": "{{ block.settings.effect }}", "autoplay": "{{ block.settings.autoplay }}", "autoplaySpeed": "{{ block.settings.autoplay_speed }}", "space": "{{ block.settings.space }}", "column_small": "{{ block.settings.column_small }}", "column_medium": "{{ block.settings.column_medium }}", "column_large": "{{ block.settings.column_large }}", "column_xlarge": "{{ block.settings.column_xlarge }}", "column_xxlarge": "{{ block.settings.column_xxlarge }}", "column_xxxlarge": "{{ block.settings.column_xxxlarge }}", "row": "{{ block.settings.row }}"}' data-carousel>
                  <div class="carousel-wrapper carousel-nav-top-right">
                    <div class="swiper-container" data-carousel-container>
                      <div class="swiper-wrapper grid-margin-x small-up-{{ block.settings.column_small }} medium-up-{{ block.settings.column_medium }} large-up-{{ block.settings.column_large }} xlarge-up-{{ block.settings.column_xlarge }} xxlarge-up-{{ block.settings.column_xxlarge }} xxxlarge-up-{{ block.settings.column_xxxlarge }}">
                        {%- assign product_image_size = '400x' -%}
                        {% for product in collections[block.settings.collection].products limit:block.settings.limit %}
                        <div class="swiper-slide cell" data-carousel-item>
                          <div class="product-grid">
                            {% include 'index-product-item' %}
                          </div>
                        </div>
                        {% else %}
                        {% for i in (1..block.settings.limit) %}
                        {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                        <div class="swiper-slide cell" data-carousel-item>
                          <div class="product-grid">
                            <div class="product-item" data-product-item>
                              <div class="product-item-thumb">
                                <a href="javascript:void(0);" class="display-block">
                                  {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                </a>
                                <div class="group-button top-right">      
                                  {%- if settings.product_item_quick_view -%}
                                  <a href="javascript:void(0);" class="group-button-quickview group-button-item product-item-button product-item-button-quick-view" title="{{ 'general.button.quick_view' | t }}"><em class="sli sli-magnifier"></em>
                                  </a>
                                  {%- endif -%}
                                  {%- if settings.product_item_wishlist -%}
                                  <div class="group-button-wishlist group-button-item product-item-button-wishlist">
                                    <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                                    <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                                  </div>
                                  {%- endif -%}
                                  {%- if settings.product_item_compare -%}
                                  <div class="group-button-compare group-button-item product-item-button product-item-button-compare">
                                    <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                                    <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>        
                                  </div>
                                  {%- endif -%}
                                </div>

                                <div class="cart-button bottom-center">
                                  <div class="product-item-buttons">
                                    <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>            
                                  </div>
                                </div>
                              </div>
                              <div class="product-item-caption">
                                <div class="product-title-vendor">
                                  <h4 class="product-item-title">
                                    <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                                  </h4>
                                  {% if settings.product_item_vendor %}
                                  <div class="product-item-vendor">
                                    {{ 'homepage.onboarding.vendor' | t }}
                                  </div>
                                  {% endif %}       
                                </div>
                                <div class="product-item-group grid-x">
                                  <div class="product-item-price cell small-12 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                                    <span class="product-item-price-sale">$99.00</span>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>      
                        {% endfor %}
                        {% endfor %}
                      </div>
                    </div>
                    {%- if block.settings.navigation -%}
                    <!-- If we need navigation buttons -->
                    <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                    <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.pagination -%}
                  <!-- If we need pagination -->
                  <div class="carousel-pagination" data-carousel-pagination></div>
                  {%- endif -%}
                </div>
              </div>
            </div>
            {% endif %}
            {%- endfor -%}
            {%- endif -%}
          </div>

          {% if section.settings.rightcol %}
          <div class="right-column cell small-12 medium-4 large-3">
            {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
            {% if block.type == 'rbanner' %}
            <div class="right-element right-banner grid-x grid-margin-x">
              <div class="index-banner-grid-item effect effect-{{block.settings.effect}} cell">
                {%- unless block.settings.image1 == blank -%}
                <a href="{{ block.settings.link1 }}" class="index-banner-grid-image display-block">
                  <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image1 | img_url: 'master' }}" class="lazyload" alt="{{ block.settings.image1.alt }}" />
                </a>
                {% else %}
                <a href="{{ block.settings.link1 }}" class="index-banner-grid-image display-block">
                  <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '345x520.png' | asset_url }}" class="lazyload" alt="{{ block.settings.image1.alt }}" />
                </a>
                {%- endunless -%}
              </div>
            </div>
            {% endif %}

            {% if block.type == 'rreview' %}
            <div class="right-element right-testimonial grid-x">
              <div class="box-slider">
                <div class="carousel" data-carousel-param='{"effect": "{{ block.settings.effect }}", "autoplay": "{{ block.settings.autoplay }}", "autoplaySpeed": "{{ block.settings.autoplay_speed }}", "space": "0", "column_small": "1", "column_medium": "1", "column_large": "1", "column_xlarge": "1", "column_xxlarge": "1", "column_xxxlarge": "1", "row": "1"}' data-carousel>
                  <div class="carousel-wrapper carousel-{{ block.settings.navigation_position }}">
                    <div class="swiper-container" data-carousel-container>
                      <div class="swiper-wrapper grid-margin-x small-up-1 medium-up-1 large-up-1 xlarge-up-1 xxlarge-up-1 xxxlarge-up-1">
                        {% for i in (1..5) %}
                        {% capture active %}active{{i}}{% endcapture %}
                        {% capture avatar %}avatar{{i}}{% endcapture %}
                        {% capture url %}url{{i}}{% endcapture %}
                        {% capture name %}name{{i}}{% endcapture %}
                        {% capture job %}job{{i}}{% endcapture %}
                        {% capture review %}review{{i}}{% endcapture %}
                        {% if block.settings[active] %}
                        <div class="swiper-slide cell" data-carousel-item>
                          <div class="testimonial-element testimonial-{{i}}">
                            <div class="te-avatar">
                              <a href="{{ block.settings[url] }}">
                                {% if block.settings[avatar] %}
                                <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings[avatar] | img_url: 'master' }}" class="lazyload" alt="{{ block.settings[avatar].alt }}" />
                                {% else %}
                                <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '110x110.png' | asset_url }}" class="lazyload" alt="{{ block.settings.banner.alt }}" />
                                {% endif %}
                              </a>
                            </div>
                            <div class="name-job">
                              {% if block.settings[name] != '' %}<span class="name">{{ block.settings[name] }}</span>{% endif %}
                              <span class="space-block"> - </span>
                              {% if block.settings[job] != '' %}<span class="job">{{ block.settings[job] }}</span>{% endif %}
                            </div>
                            {% if block.settings[review] != '' %}<div class="te-review">{{ block.settings[review] }}</div>{% endif %}                    
                          </div>
                        </div>
                        {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                    {%- if block.settings.navigation -%}
                    <!-- If we need navigation buttons -->
                    <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                    <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.pagination -%}
                  <!-- If we need pagination -->
                  <div class="carousel-pagination" data-carousel-pagination></div>
                  {%- endif -%}
                </div>
              </div>
            </div>
            {% endif %}

            {% if block.type == 'rproducts' %}
            <div class="right-element right-products grid-x">
              {% if block.settings.title != '' %}<div class="box-title">{{ block.settings.title }}</div>{% endif %}
              <div class="box-products">
                {%- assign product_image_size = '400x' -%}
                {% for product in collections[block.settings.collection].products limit:block.settings.limit %}                          
                <div class="product-list">
                  {% include 'index-product-item-grid' %}
                </div>
                {% else %}
                {% for i in (1..block.settings.limit) %}
                {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}                          
                <div class="product-grid">
                  <div class="product-item" data-product-item>
                    <div class="product-item-thumb">
                      <a href="javascript:void(0);" class="display-block">
                        {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                      </a>
                      <div class="group-button top-right">      
                        {%- if settings.product_item_quick_view -%}
                        <a href="javascript:void(0);" class="group-button-quickview group-button-item product-item-button product-item-button-quick-view" title="{{ 'general.button.quick_view' | t }}"><em class="sli sli-magnifier"></em>
                        </a>
                        {%- endif -%}
                        {%- if settings.product_item_wishlist -%}
                        <div class="group-button-wishlist group-button-item product-item-button-wishlist">
                          <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                          <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                        </div>
                        {%- endif -%}
                        {%- if settings.product_item_compare -%}
                        <div class="group-button-compare group-button-item product-item-button product-item-button-compare">
                          <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                          <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>        
                        </div>
                        {%- endif -%}
                      </div>

                      <div class="cart-button bottom-center">
                        <div class="product-item-buttons">
                          <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>            
                        </div>
                      </div>
                    </div>
                    <div class="product-item-caption">
                      <div class="product-title-vendor">
                        <h4 class="product-item-title">
                          <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                        </h4>
                        {% if settings.product_item_vendor %}
                        <div class="product-item-vendor">
                          {{ 'homepage.onboarding.vendor' | t }}
                        </div>
                        {% endif %}       
                      </div>
                      <div class="product-item-group grid-x">
                        <div class="product-item-price cell small-12 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                          <span class="product-item-price-sale">$99.00</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                {% endfor %}
                {% endfor %}
              </div>      
            </div>    
            {% endif %}    
            {% endfor %}
            {% endif %}
          </div>
          {% endif %}
        </div>
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>  
 
{% schema %}
{
  "name": "Group Blocks #1",
  "class": "index-section index-group-blocks1",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "header",
      "content": "Section Settings"
    },
	{
      "type": "checkbox",
      "id": "rightcol",
      "label": "Show Right column",
	  "default": true
    }
  ],
  "blocks": [	 
	{
      "type": "banner",
      "name": "Left - Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image1",
          "label": "1st Image"
        },
        {
          "type": "url",
          "id": "link1",
          "label": "1st Link"
        },
		{    
      "type": "select",
      "id": "effect",
      "label": "Hover Effect",
      "options": [
        {
          "value": "scope",
          "label": "Scope"
        },       
        {
          "value": "pulse",
          "label": "Pulse"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        },       
        {
          "value": "blur",
          "label": "Blur"
        },
        {
          "value": "grayscale",
          "label": "Gray scale"
        },
        {
          "value": "line-image",
          "label": "Line 1"        
        }, 
        {
          "value": "scope3",
          "label": "Line 2"
        },              
        {
          "value": "zoom",
          "label": "Zoom"        
        },
        {
          "value": "zoom-opacity",
          "label": "Zoom Opacity"        
        },
        {
          "value": "apollo",
          "label": "Apollo"        
        },
        {
          "value": "jazz",
          "label": "Jazz"        
        },
        {
          "value": "ming",
          "label": "Ming"        
        },
        {
          "value": "bounce",
          "label": "Bounce"        
        },
        {
          "value": "flash",
          "label": "Flash"        
        },
        {
          "value": "animate-pulse",
          "label": "Animate Pulse"        
        },
        {
          "value": "heartBeat",
          "label": "Heart Beat"        
        },
        {
          "value": "backInDown",
          "label": "Back In Down"        
        },                
        {
          "value": "bounceInUp",
          "label": "Bounce In Up"        
        },        
        {
          "value": "bounceInRight",
          "label": "Bounce In Right"        
        },
        {
          "value": "bounceInLeft",
          "label": "Bounce In Left"        
        },
        {
          "value": "bounceInDown",
          "label": "Bounce In Down"        
        },
        {
          "value": "bounceIn",
          "label": "Bounce In"        
        },        
        {
          "value": "rotateInUpRight",
          "label": "Rotate In Up Right"        
        },
        {
          "value": "rotateInUpLeft",
          "label": "Rotate In Up Left"        
        },
        {
          "value": "rotateInDownRight",
          "label": "Rotate In Down Right"        
        },
        {
          "value": "rotateInDownLeft",
          "label": "Rotate In Down Left"        
        },
        {
          "value": "rotateIn",
          "label": "Rotate In"        
        },        
        {
          "value": "lightSpeedInLeft",
          "label": "Light Speed InLeft"        
        },        
        {
          "value": "flipInY",
          "label": "Flip In Y"        
        },
        {
          "value": "flipInX",
          "label": "Flip In X"        
        },
        {
          "value": "flip",
          "label": "Flip"        
        },
        {
          "value": "jackInTheBox",
          "label": "Jack In The Box"        
        }                                                    
      ],
      "default": "scope"      
    }
      ]
    },
	{
      "type": "banners",
      "name": "Left - Banners",
      "settings": [
        {
          "type": "image_picker",
          "id": "image1",
          "label": "1st Image"
        },
        {
          "type": "url",
          "id": "link1",
          "label": "1st Link"
        },
        {
          "type": "image_picker",
          "id": "image2",
          "label": "2nd Image"
        },
        {
          "type": "url",
          "id": "link2",
          "label": "2nd Link"
        },
		{    
      "type": "select",
      "id": "effect",
      "label": "Hover Effect",
      "options": [
        {
          "value": "scope",
          "label": "Scope"
        },       
