{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-banners-slider">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">    
      <div class="section-content" style="background-color:{{ section.settings.bkg }}">
        <div class="box border-none">
          <div class="grid-container">
          {%- if section.settings.title != blank %}
          <div class="box-divider style-{{ section.settings.titlestyle }}">
            {% if section.settings.titlestyle == 'simple' %}
              {% if section.settings.title2 != '' %}<div class="box-heading width-100" style="color:{{ section.settings.color2}}; font-size:{{ section.settings.titlesize2 }}px;">{{ section.settings.title2 }}</div>{% endif %}
			  <h2 class="box-title width-100" style="color:{{ section.settings.color }}; font-size:{{ section.settings.titlesize }}px; font-weight:{{ section.settings.title_weight}};">{{ section.settings.title }}</h2>
              {% if section.settings.title3 != '' %}<div class="box-desc width-100" style="color:{{ section.settings.color3 }}; font-size:{{ section.settings.titlesize3 }}px;">{{ section.settings.title3 }}</div>{% endif %}
            {% else %}
			  <div class="left-area" style="color:{{ section.settings.color2}};">
                {% if section.settings.title2 != '' %}<div class="box-heading width-100" style="color:{{ section.settings.color2}}; font-size:{{ section.settings.titlesize2 }}px;">{{ section.settings.title2 }}</div>{% endif %}
                <h2 class="box-title width-100" style="color:{{ section.settings.color }}; font-size:{{ section.settings.titlesize }}px; font-weight:{{ section.settings.title_weight}};">{{ section.settings.title }}</h2>
              </div>
              <div class="right-area">
                {% if section.settings.title3 != '' %}<div class="box-desc width-100" style="color:{{ section.settings.color3 }}; font-size:{{ section.settings.titlesize3 }}px;">{{ section.settings.title3 }}</div>{% endif %}
              </div>
            {% endif %}
            </div>
          </div>
          {% endif %}
          {% if settings.index_style == '1' or template contains 'page' %}
          {% unless full %}
          <div class="grid-container">
          {% endunless %}
          {% endif %}
            <div class="box-content">
              <div class="gr-banners-area slider-mode-{% if section.settings.centermode %}center{% else %}normal{% endif %}">  
                <div class="carousel" data-carousel-param='{"effect": "{{ section.settings.effect }}", "direction": "{{ section.settings.direction }}", "autoplay": "{{ section.settings.autoplay }}", "autoplaySpeed": "{{ section.settings.autoplay_speed }}", "space": "{{ section.settings.space }}", "column_small": "{{ section.settings.column_small }}", "column_medium": "{{ section.settings.column_medium }}", "column_large": "{{ section.settings.column_large }}", "column_xlarge": "{{ section.settings.column_xlarge }}", "column_xxlarge": "{{ section.settings.column_xxlarge }}", "column_xxxlarge": "{{ section.settings.column_xxxlarge }}", "row": "{{ section.settings.row }}", "center": "{{ section.settings.center }}"}' data-carousel>
                  <div class="carousel-wrapper carousel-{{ section.settings.navigation_position }} carousel-nav-visible">
                    <div class="swiper-container" data-carousel-container>
                      <div class="swiper-wrapper small-up-{{ section.settings.column_small }} medium-up-{{ section.settings.column_medium }} large-up-{{ section.settings.column_large }} xlarge-up-{{ section.settings.column_xlarge }} xxlarge-up-{{ section.settings.column_xxlarge }} xxxlarge-up-{{ section.settings.column_xxxlarge }}">
                        {% for block in section.blocks %}
                        <div class="swiper-slide text-center" data-carousel-item style="background:{{ section.settings.bkg }};">
                          <div class="banner-area">
                            <div class="banner-img effect-{{section.settings.effect2}} effect">
                              {%- unless block.settings.image == blank -%}
                              <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">
                                <img src="{{ block.settings.image | img_url: image_size }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                              </a>
                              {% else %}
                              <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">                
                                <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '470x570.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                              </a>
                              {%- endunless -%}
                            </div>
                            <div class="banner-caption">
                              <div class="caption-top">
                                {% if block.settings.text1 != '' %}<div class="caption-heading" style="color:{{ block.settings.color1}}; font-size:{{ block.settings.titlesize1 }}px;">{{ block.settings.text1 }}</div>{% endif %}
                                {% if block.settings.text2 != '' %}<div class="caption-title"> <a href="{{ block.settings.link }}" style="color:{{ block.settings.color2}}; font-size:{{ block.settings.titlesize2 }}px;">{{ block.settings.text2 }}</a></div>{% endif %}
                              </div>
                              {% if block.settings.text3 != '' %}
                              <div class="caption-bottom">
                                <a href="{{ block.settings.link }}" style="color:{{ block.settings.color3}}; font-size:{{ block.settings.titlesize3 }}px;">
                                  {{ block.settings.text3 }}
                                </a>
                              </div>
                              {% endif %}
                            </div>
                          </div>         
                        </div>
                        {% endfor %}    
                      </div>
                    </div>
                    {%- if section.settings.navigation -%}
                    <!-- If we need navigation buttons -->
                    <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                    <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                    {%- endif -%}
                  </div>
                  {%- if section.settings.pagination -%}
                  <!-- If we need pagination -->
                  <div class="carousel-pagination" data-carousel-pagination></div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {% if settings.index_style == '1' or template contains 'page' %}
          {% unless full %}
          </div>
          {% endunless %}
          {% endif %}
        </div>
      </div>    
  </div>
</div>

  
