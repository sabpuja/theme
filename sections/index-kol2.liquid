{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-kol2">
  <div class="index-link-bg {{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{ section.settings.color6 }};">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="pricing-content">          
          <div class="box-content grid-x">
            <div class="left-text">
              {%- if section.settings.title != blank -%}
              <div class="box-divider">
                <h2 class="box-title" style="font-size:{{ section.settings.titlesize }}px;">{{ section.settings.title }}</h2>
              </div>
              {%- endif -%}
              {% if section.blocks.size > 0 %}
              <div class="box-text">
                {% for block in section.blocks %}
                <div class="text-element">
                  <div class="text-count">{{ forloop.index }}</div>
                  <div class="text-content"><div class="kol-group">{{ block.settings.title }}</div></div>
                </div>
                {% endfor %}
              </div>
              {% endif %}              
            </div>
            <div class="right-form">
              <div style="border: 1px solid {{ section.settings.color2 }};">             
                <div class="form-header" style="background: {{ section.settings.color2 }};">
                  {% if section.setings.title1 != '' %}<div class="form-title" style="font-size:{{ section.settings.titlesize1 }}px; color:{{ section.settings.color1 }}">{{ section.settings.title1 }}</div>{% endif %}
                  {% if section.setings.title2 != '' %}<div class="form-desc" style="color:{{ section.settings.color1 }}">{{ section.settings.title2 }}</div>{% endif %}
                </div>
                <div class="form-box">
                  {%- form 'contact' -%}
                  {%- if form.posted_successfully? -%}
                  <div class="callout success">
                    {{ 'contact.form.post_success' | t }}
                  </div>
                  {%- endif -%}
                  {%- if form.errors -%}
                  <div class="callout alert">
                    {{ form.errors | default_errors }}
                  </div>
                  {%- endif -%}
                  <div class="grid-x grid-margin-x">
                    <div class="form-group cell large-12">
                      <label class="form-group-label">{{ section.settings.box1 }}</label>
                      <input type="text" name="contact[name]" value="{% if form[name] %}{{ form[name] }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ section.settings.box1 }}" class="form-group-field" />
                    </div>
                    <div class="form-group cell large-12">
                      <label class="form-group-label">{{ section.settings.box2 }}</label>
                      <input type="text" name="contact[name]" value="" placeholder="{{ section.settings.box2 }}" class="form-group-field" />
                    </div>
                    <div class="form-group cell large-12">
                      <label class="form-group-label">{{ section.settings.box3 }}</label>
                      <input type="text" name="contact[phone]" value="" placeholder="{{ section.settings.box3 }}" class="form-group-field" />
                    </div>
                    <div class="form-group{% if form.errors contains 'email' %} has-error{% endif %}  cell large-12">
                      <label class="form-group-label">{{ section.settings.box4 }}</label>
                      <input type="email" name="contact[email]"  autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" placeholder="{{ section.settings.box4 }}" class="form-group-field" />
                    </div>
                    <div class="form-group cell large-12">
                      <label class="form-group-label">{{ section.settings.box5 }}</label>
                      <textarea name="contact[body]" placeholder="{{ section.settings.box5 }}" class="form-group-field">{% if form.body %}{{ form.body }}{% endif %}</textarea>
                      <input type="submit" class="button form-button" value="{{ section.settings.box6 }}"/>
                    </div>

                  </div>
                  {%- endform -%}
                </div>
              </div>
            </div>            
          </div>
        </div>   
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "KOL Form",
  "class": "index-section index-kol2",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "header",
      "content": "Left Text Settings"
    },
	{
      "type": "text",
      "id": "title",
      "label": "Title"
    },
	{
      "type": "color",
      "id": "color0",
      "label": "Title Color Text",
	  "default":"#000"
    },
	{
      "type":   "range",
      "id":     "titlesize",
      "min":       12,
      "max":       40,
      "step":      1,
      "unit":      "px",
      "label":     "Title Font size",
      "default":   24
    },	
	{
      "type": "color",
      "id": "color6",
      "label": "Color Background"
    },
	{
      "type": "header",
      "content": "Right Form Settings"
    },
	{
      "type": "text",
      "id": "title1",
      "label": "Title"
    },	
	{
      "type": "color",
      "id": "color1",
      "label": "Title Color Text",
	  "default":"#000"
    },
	{
      "type":   "range",
      "id":     "titlesize1",
      "min":       12,
      "max":       40,
      "step":      1,
      "unit":      "px",
      "label":     "Title Font size",
      "default":   24
    },	
	{
      "type": "text",
      "id": "title2",
      "label": "Desc"
    },
	{
      "type": "color",
      "id": "color2",
      "label": "Color Background"
    },
	{
      "type": "text",
      "id": "box1",
      "label": "First Name",
	  "default":"Your First Name"
    },
	{
      "type": "text",
      "id": "box2",
      "label": "Last Name",
	  "default":"Your Last Name"
    },
	{
      "type": "text",
      "id": "box3",
      "label": "Phone",
	  "default":"Your Phone"
    },
	{
      "type": "text",
      "id": "box4",
      "label": "Email",
	  "default":"Your Email"
    },
	{
      "type": "text",
      "id": "box5",
      "label": "Message",
	  "default":"Message"
    },
	{
      "type": "text",
      "id": "box6",
      "label": "Submit",
	  "default":"Book Now!"
    }
  ],  
  "blocks": [	
	{
      "type": "price",
      "name": "Text",
      "settings": [        
        {
          "type": "textarea",
          "id": "title",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KOL Form",
      "category": "Advanced"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}