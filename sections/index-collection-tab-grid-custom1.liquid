{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="products" data-section-name="index-collection-tab-grid-custom1">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">    
        <div class="index-collection-tab-grid-container box border-none position-{{ section.settings.title_position }}">
        <div class="box-content grid-x">
          {% if section.blocks.size > 0 %}
          <div class="title-tablist-collection">
            <div class="box-divider">
              {%- if section.settings.title != blank -%}
              <h2 class="box-title">{{ section.settings.title }}</h2>
              {%- endif -%}
            </div>
            <ul  id="index-collection-tab-{{ section.id }}" class="index-collection-tab-tab grid-x align-center-middle no-bullet" data-tabs>
              {% for block in section.blocks %}
              <li class="tabs-title index-collection-tab-title {% if forloop.first == true %}is-active{% endif %}"><a href="#product-{{ section.id }}-{{forloop.index}}" class="padding-0">{{ block.settings.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
          <div class="index-collection-tab-content width-100" data-tabs-content="index-collection-tab-{{ section.id }}">
            {%- if  section.settings.image_width and section.settings.image_height -%}
            {%- assign product_image_size = section.settings.image_width | append: 'x' | append: section.settings.image_height -%}
            {%- elsif section.settings.image_width -%}
            {%- assign product_image_size = section.settings.image_width | append: 'x' -%}
            {%- elsif section.settings.image_height -%}
            {%- assign product_image_size = 'x' | append: section.settings.image_height -%}
            {%- else -%}
            {%- assign product_image_size = 'master' -%}
            {%- endif -%}
            {% assign limit = 9 %}
            {% for block in section.blocks %}
            <div class="tabs-panel padding-0 index-collection-tab-panel {% if forloop.first == true %}is-active{% endif %}" id="product-{{ section.id }}-{{forloop.index}}">
              <div class="{% if section.settings.itemactive %}have-item{% else %}no-item{% endif %} grid-x grid-margin-x">    
                {% if section.settings.itemactive %}
                <div class="index-collection-tab-item cell small-12 medium-4 large-4 xlarge-4">
                  {% for product in collections[block.settings.collection].products limit: 1 %}
                  <div class="product-grid">
                    {% include 'index-product-item-slider' %}
                  </div>
                  {% else %}
                  {% for i in (1..1) %}
                  {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                  <div class="product-grid">
                    <div class="product-item" data-product-item>
                      <div class="product-item-thumb">
                        <a href="javascript:void(0);" class="display-block">
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        </a>
                        <div class="group-button top-right">      
                          {%- if settings.product_item_quick_view -%}
                          <a href="javascript:void(0);" class="group-button-quickview group-button-item product-item-button product-item-button-quick-view" title="{{ 'general.button.quick_view' | t }}"><em class="sli sli-magnifier"></em>
                          </a>
                          {%- endif -%}
                          {%- if settings.product_item_wishlist -%}
                          <div class="group-button-wishlist group-button-item product-item-button-wishlist">
                            <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                            <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                          </div>
                          {%- endif -%}
                          {%- if settings.product_item_compare -%}
                          <div class="group-button-compare group-button-item product-item-button product-item-button-compare">
                            <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                            <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>        
                          </div>
                          {%- endif -%}
                        </div>

                        <div class="cart-button bottom-center">
                          <div class="product-item-buttons">
                            <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>            
                          </div>
                        </div>
                      </div>
                      <div class="product-item-caption">
                        <div class="product-item-group grid-x">
                          <div class="product-item-title-rating cell small-12 medium-6 large-8 xlarge-8 xxlarge-8 xxxlarge-9">
                            <h4 class="product-item-title">
                              <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                            </h4>  
                          </div>
                          <div class="product-item-price cell small-12 medium-6 large-4 xlarge-4 xxlarge-4 xxxlarge-3">
                            <span class="product-item-price-sale">$99.00</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  {% endfor %}
                  {% endfor %}
                </div>
                {% endif %}
                <div class="index-collection-tab-product cell {% if section.settings.itemactive %}small-12 medium-8 large-8 xlarge-8 {% else %}small-12 medium-12 large-12 xlarge-12 {% endif %}">
                  <div class="grid-x grid-margin-x grid-margin-y">
                    {% for product in collections[block.settings.collection].products limit: section.settings.limit offset:1 %}
                    <div class="product-item cell small-{{ section.settings.column_small }} medium-{{ section.settings.column_medium }} large-{{ section.settings.column_large }} xlarge-{{ section.settings.column_xlarge }} xxlarge-{{ section.settings.column_xxlarge }} xxxlarge-{{ section.settings.column_xxxlarge }}">
                      <div class="product-grid">
                        {% include 'index-product-item' %}
                      </div>
                    </div>
                    {% else %}
                    {% for i in (1..section.settings.limit) %}
                    {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                    <div class="cell small-{{ section.settings.column_small }} medium-{{ section.settings.column_medium }} large-{{ section.settings.column_large }} xlarge-{{ section.settings.column_xlarge }} xxlarge-{{ section.settings.column_xxlarge }} xxxlarge-{{ section.settings.column_xxxlarge }}">
                      <div class="product-grid">
                        <div class="product-item" data-product-item>
                          <div class="product-item-thumb">
                            <a href="javascript:void(0);" class="display-block">
                              {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                            </a>
                            <div class="group-button top-right">      
                              {%- if settings.product_item_quick_view -%}
                              <a href="javascript:void(0);" class="group-button-quickview group-button-item product-item-button product-item-button-quick-view" title="{{ 'general.button.quick_view' | t }}"><em class="sli sli-magnifier"></em>
                              </a>
                              {%- endif -%}
                              {%- if settings.product_item_wishlist -%}
                              <div class="group-button-wishlist group-button-item product-item-button-wishlist">
                                <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                                <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                              </div>
                              {%- endif -%}
                              {%- if settings.product_item_compare -%}
                              <div class="group-button-compare group-button-item product-item-button product-item-button-compare">
                                <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                                <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>        
                              </div>
                              {%- endif -%}
                            </div>

                            <div class="cart-button bottom-center">
                              <div class="product-item-buttons">
                                <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>            
                              </div>
                            </div>
                          </div>
                          <div class="product-item-caption">
                            <div class="product-item-group grid-x">
                              <div class="product-item-title-rating cell small-12 medium-6 large-8 xlarge-8 xxlarge-8 xxxlarge-9">
                                <h4 class="product-item-title">
                                  <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                                </h4>  
                              </div>
                              <div class="product-item-price cell small-12 medium-6 large-4 xlarge-4 xxlarge-4 xxxlarge-3">
                                <span class="product-item-price-sale">$99.00</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>      
                    {% endfor %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>  


{% schema %}
{
  "name": "Products Tab Grid Custom",
  "class": "index-section index-collection-tab-grid index-collection-tab-grid-custom",
  "settings": [
	{
      "type": "paragraph",
      "content": "View [Mockup of Section layout](https:\/\/i.imgur.com\/mHrzd2F.png)"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "header",
      "content": "Section Settings"
    },
	{
      "type": "text",
      "id": "title",
      "label": "Title"
    },
	{
      "type": "select",
      "id": "title_position",
      "label": "Title Position",
      "options": [
        {
          "value": "full-left",
          "label": "One Whole - Left"
        },
        {
          "value": "full-center",
          "label": "One Whole - Center"
        },
        {
          "value": "onehalf-left",
          "label": "One Half - Left"
        }
      ],
      "default": "full-left"
    },
    {
      "type": "number",
      "id": "image_width",
      "label": "Image Width",
      "info": "Must be set a non-zero number",
      "default": 450
    },
    {
      "type": "number",
      "id": "image_height",
      "label": "Image Height",
      "info": "Must be set a non-zero number",
      "default": 577
    },
	{
      "type": "checkbox",
      "id": "itemactive",
      "label": "Show Item in Left"
    },
    {
      "type": "checkbox",
      "id": "navigation",
      "label": "Enable Navigaiton",
      "default": true
    },    
	{
      "type": "header",
      "content": "Responsive columns"
    },
    {
      "type": "select",
      "id": "column_small",
      "label": "Products per row",
      "info": "For small screen (0px - 550px)",
      "options": [
        {
          "value": "12",
          "label": "1"
        },
        {
          "value": "6",
          "label": "2"
        },
        {
          "value": "4",
          "label": "3"
        },
        {
          "value": "3",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "column_medium",
      "label": "Products per row",
      "info": "For medium screen (551px - 800px)",
      "options": [
        {
          "value": "12",
          "label": "1"
        },
        {
          "value": "6",
          "label": "2"
        },
        {
          "value": "4",
          "label": "3"
        },
        {
          "value": "3",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "column_large",
      "label": "Products per row",
      "info": "For large screen (801px - 1260px)",
      "options": [
        {
          "value": "12",
          "label": "1"
        },
        {
          "value": "6",
          "label": "2"
        },
        {
          "value": "4",
          "label": "3"
        },
        {
          "value": "3",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "column_xlarge",
      "label": "Products per row",
      "info": "For xlarge screen (1261px - 1440px)",
      "options": [
        {
          "value": "12",
          "label": "1"
        },
        {
          "value": "6",
          "label": "2"
        },
        {
          "value": "4",
          "label": "3"
        },
        {
          "value": "3",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "column_xxlarge",
      "label": "Products per row",
      "info": "For xxlarge screen (1441px - 1680px)",
      "options": [
        {
          "value": "12",
          "label": "1"
        },
        {
          "value": "6",
          "label": "2"
        },
        {
          "value": "4",
          "label": "3"
        },
        {
          "value": "3",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "column_xxxlarge",
      "label": "Products per row",
      "info": "For xxxlarge screen (1681px - infinity)",
      "options": [
        {
          "value": "12",
          "label": "1"
        },
        {
          "value": "6",
          "label": "2"
        },
        {
          "value": "4",
          "label": "3"
        },
        {
          "value": "3",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "number",
      "id": "limit",
      "label": "Limit product show",
      "default": 9
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products Tab - Grid Custom",
      "category": "Products",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}