{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-group-blocks5">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="index-custom-blocks-container box border-none">
      {%- if section.settings.title != blank or section.settings.sub_title != blank -%}
      <div class="box-divider grid-x">
        {%- if section.settings.title != blank -%}
        <h2 class="box-title cell small-12 medium-4 large-4 xlarge-4 xxlarge-4 xxxlarge-4">{{ section.settings.title }}</h2>
        {%- endif -%}
        <div class="box-linklist cell small-12 medium-8 large-8 xlarge-8 xxlarge-8 xxxlarge-8">
          <ul class="collections-list no-bullet margin-0">
            {% for l in linklists[section.settings.linklist].links %}
            <li class="link-element"><a href="{{ l.url }}">{{ l.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>
      {%- endif -%}
      <div class="box-content">
        {% if section.blocks.size > 0 %}
        <div class="index-cb-list grid-x">
          <div class="left-area">
            {% for block in section.blocks %}
            {% if block.type == 'banner' %}
            <div class="cb-banner-block effect-{{section.settings.effect1}} effect">
              <a href="{{ block.settings.url }}" class="index-cb-image display-block">
                {% if block.settings.image %}
                <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image | img_url: 'master' }}" class="lazyload" alt="{{ block.settings.image.alt }}" />
                {% else %}
                <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '550x750.png' | asset_url }}" class="lazyload" alt="{{ block.settings.image.alt }}" />
                {% endif %}
              </a>
              <div class="info-element">
                <div class="title-element">{{ block.settings.titleelement }}</div>
                <div class="price-element">{{ block.settings.priceelement }}</div>
              </div>
            </div>
            {% endif %}
            {% endfor %}
          </div>
          <div class="right-area">
            {% for block in section.blocks %}
            {% if block.type == 'item-listing' %}
            <div class="cb-itemlisting-block">
              <div class="grid-x">
                <div class="itemlisting item-1 cell large-4">
                  <div class="">
                    <div class="item-name">{{ block.settings.title }}</div>
                    <div class="item-price">{{ block.settings.price }}</div>
                  </div>
                  <div class="">
                    <a href="{{ block.settings.link }}">                        
                      <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{% if block.settings.image %}{{ block.settings.image | img_url: 'master' }}{% else %}{{ '150x150.png' | asset_url }}{% endif %}" class="lazyload" alt="{{ block.settings.image.alt }}" />                                                
                    </a>
                  </div>
                </div>
                <div class="itemlisting item-2 cell large-4">
                  <div class="">
                    <div class="item-name">{{ block.settings.title2 }}</div>
                    <div class="item-price">{{ block.settings.price2 }}</div>
                  </div>
                  <div class="">
                    <a href="{{ block.settings.link2 }}">                        
                      <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{% if block.settings.image2 %}{{ block.settings.image2 | img_url: 'master' }}{% else %}{{ '150x150.png' | asset_url }}{% endif %}" class="lazyload" alt="{{ block.settings.image2.alt }}" />                                                
                    </a>
                  </div>
                </div>
                <div class="itemlisting item-3 cell large-4">
                  <div class="">
                    <div class="item-name">{{ block.settings.title3 }}</div>
                    <div class="item-price">{{ block.settings.price3 }}</div>
                  </div>
                  <div class="">
                    <a href="{{ block.settings.link3 }}">                        
                      <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{% if block.settings.image3 %}{{ block.settings.image3 | img_url: 'master' }}{% else %}{{ '150x150.png' | asset_url }}{% endif %}" class="lazyload" alt="{{ block.settings.image3.alt }}" />                                                
                    </a>
                  </div>
                </div>
              </div>
            </div>
            {% elsif block.type == 'products' %}
            <div class="cb-products-block">                    
              <div class="sb-products-listing grid-x grid-margin-x">
                {% for product in collections[block.settings.collection].products limit:4 %}
                <div class="product-grid cell small-6 medium-12 large-3">
                  {% include 'index-product-item' %} 
                </div>
                {% else %}
                {% for i in (1..4) %}
                {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                <div class="product-grid cell large-3">
                  <div class="grid-x">
                    <div class="product-item" data-product-item>
                      <div class="product-item-thumb">
                        <a href="javascript:void(0);" class="display-block">
                          {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                        </a>
                        <div class="group-button top-right">      
                          {%- if settings.product_item_quick_view -%}
                          <a href="javascript:void(0);" class="group-button-quickview group-button-item product-item-button product-item-button-quick-view" title="{{ 'general.button.quick_view' | t }}"><em class="sli sli-magnifier"></em>
                          </a>
                          {%- endif -%}
                          {%- if settings.product_item_wishlist -%}
                          <div class="group-button-wishlist group-button-item product-item-button-wishlist">
                            <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                            <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                          </div>
                          {%- endif -%}
                          {%- if settings.product_item_compare -%}
                          <div class="group-button-compare group-button-item product-item-button product-item-button-compare">
                            <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                            <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>        
                          </div>
                          {%- endif -%}
                        </div>

                        <div class="cart-button bottom-center">
                          <div class="product-item-buttons">
                            <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>            
                          </div>
                        </div>
                      </div>
                      <div class="product-item-caption">
                        <div class="product-item-group grid-x">
                          <div class="product-item-title-rating cell small-12 medium-6 large-8 xlarge-8 xxlarge-8 xxxlarge-9">
                            <h4 class="product-item-title">
                              <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                            </h4>  
                          </div>
                          <div class="product-item-price cell small-12 medium-6 large-4 xlarge-4 xxlarge-4 xxxlarge-3">
                            <span class="product-item-price-sale">$99.00</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                {% endfor %}
                {% endfor %}
              </div>                            
            </div>                
            {% endif %}
            {% endfor %}
          </div>            
        </div>
        {% endif %}
      </div>
    </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>  
  

