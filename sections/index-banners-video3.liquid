{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banners-video3">
  <div class="have-bkg {{ section.settings.display }} spacing-{{ section.id }}">
    <div class="bg3" {% if section.settings.bkg_2 %}style="background-image:url({{ section.settings.bkg_2 | img_url: 'master' }})"{% endif %}></div>
    <div class="bg2" {% if section.settings.bkg_1 %}style="background-image:url({{ section.settings.bkg_1 | img_url: 'master' }})"{% endif %}></div> 
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="bg1" style="background-color: {{ section.settings.bkg_color }}">                                     
        </div>
        {%- if section.settings.title != blank or section.settings.sub_title != blank -%}
        <div class="box-divider position-{{ section.settings.title_position }}">
          {%- if section.settings.title != blank -%}
          <h2 class="box-title width-100" style="color:{{ section.settings.color }}">{{ section.settings.title }}</h2>
          {%- endif -%}
        </div>
        {%- endif -%}
        <div class="banners-content banners-videos-listing">
          {% if section.blocks.size > 0 %}
          <div class="grid-x {% if section.settings.padding %}grid-margin-x{% else %}no-padding{% endif %}">
            {%- for block in section.blocks -%}
            <div class="gallery-element cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }} effect-{{section.settings.effect}} effect"> 
              <div class="banner-image effect-parent">  
                <img class="img" src="{% if block.settings.image %}{{ block.settings.image | img_url: 'master' }}{% else %}{{ '960x765.png' | asset_url }}{% endif %}" alt=""/>                
              </div>  
              {% if block.settings.title1 != '' %}
              <div class="video-caption">
                <div class="video-icon" data-videoplay data-videoplayid="data-video-{{block.id}}"><img class="play-icon" src="{{ section.settings.play |img_url: 'master' }}" alt="{{ section.settings.play.alt }}"/></div>
                <div class="reveal video-popup" id="video-{{block.id}}" data-video-{{block.id}} data-reveal data-animation-in="fade-in fast" data-animation-out="fade-out fast">
                  <div class="video-popup-content">
                    {{ block.settings.video }}
                  </div>
                  <a class="close-reveal" aria-label="Close" data-close>
                    <svg class="svg-icon"><use xlink:href="#icon-close" /></svg>
                  </a>
                </div>
              </div>
              {% endif %}
            </div>            
            {% endfor %}
          </div>
          {% endif %}
        </div>   
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

