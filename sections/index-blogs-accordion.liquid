{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="blogs" data-section-name="index-blogs-accordion">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">   
        <div class="accordion-wrapper">
          {%- if section.settings.title != blank -%}
          <div class="box-title">{{ section.settings.title }}</div>
          {% endif %}
          <div class="blog-box">
            <ul class="margin-0 no-bullet">
              {% for block in section.blocks %}            
              <li class="blog-item {% if forloop.first %}active{% endif %}" style="background-image: url({% if block.settings.image %}{{ block.settings.image | img_url: 'master' }}{% else %}{{ '1200x700.png' | asset_url }}{% endif %})">
                <a class="caption" href="{{ block.settings.url }}">
                  {% if block.settings.image-cap %}
                  <img src="{{ block.settings.image-cap | img_url: 'master' }}" alt="" />                
                  {% endif %}
                </a>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Blogs Accordion",
  "class": "index-section index-blogs-accordion",
  "max_blocks": 5,
  "settings": [
	{
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    }	
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Banner",
      "settings": [
		{
          "type": "image_picker",
          "id": "image",
          "label": "Upload image"
        },
		{
          "type": "image_picker",
          "id": "image-cap",
          "label": "Upload caption"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link to",
		      "default":"/collections/all"
        }
  	  ]
    }
  ],
  "presets": [{
    "name": "Blogs Accordion",
    "category": "Blogs"
  }],
  "templates": ["index","page"]
}
{% endschema %}