{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-instagram6">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none">
          <div class="box-content index-instagram-content">
            <div class="left-area">
              <div class="left-top-area">
                <div class="photo-1">
                  <div class="effect-{{section.settings.effect}} effect">
                    <a href="{{ section.settings.photo1link }}">
                      <img src="{% if section.settings.photo1 %}{{ section.settings.photo1 | img_url: 'master' }}{% else %}{{ '345x300.png' | asset_url }}{% endif %}" 
                          alt="{{ section.settings.photo1.alt }}">
                    </a>
                  </div>
                </div>
                <div class="instagram-text">
                  <div class="instagram-text-group">
                      <div>
                        {% if section.settings.title != '' %}<div class="title">{{ section.settings.title }}</div>{% endif %}
                        {% if section.settings.title2 != '' %}<div class="sub-title">{{ section.settings.title2 }}</div>{% endif %}
                        {% if section.settings.title3 != '' %}<div class="desc">{{ section.settings.title3 }}</div>{% endif %}
                      </div>                      
                  </div>                  
                </div>
              </div>
              <div class="left-bottom-area">
                <div class="photo-2">
                  <div class="effect-{{section.settings.effect}} effect">
                    <a href="{{ section.settings.photo2link }}">
                      <img src="{% if section.settings.photo2 %}{{ section.settings.photo2 | img_url: 'master' }}{% else %}{{ '345x300.png' | asset_url }}{% endif %}" 
                          alt="{{ section.settings.photo2.alt }}">
                    </a>
                  </div>                  
                </div>
                <div class="photo-3">
                  <div class="effect-{{section.settings.effect}} effect">
                    <a href="{{ section.settings.photo3link }}">
                      <img src="{% if section.settings.photo3 %}{{ section.settings.photo3 | img_url: 'master' }}{% else %}{{ '345x300.png' | asset_url }}{% endif %}" 
                          alt="{{ section.settings.photo3.alt }}">
                    </a>
                  </div>
                </div>
                <div class="photo-4">
                    <div class="effect-{{section.settings.effect}} effect">
                      <a href="{{ section.settings.photo4link }}">
                        <img src="{% if section.settings.photo4 %}{{ section.settings.photo4 | img_url: 'master' }}{% else %}{{ '345x300.png' | asset_url }}{% endif %}" 
                            alt="{{ section.settings.photo4.alt }}">
                      </a>
                    </div>
                </div>
              </div>
            </div>
            <div class="right-area">
              <div class="photo-5">
                <div class="effect-{{section.settings.effect}} effect">
                  <a href="{{ section.settings.photo5link }}">
                    <img src="{% if section.settings.photo5 %}{{ section.settings.photo5 | img_url: 'master' }}{% else %}{{ '345x630.png' | asset_url }}{% endif %}" 
                        alt="{{ section.settings.photo5.alt }}">
                  </a>
                </div>
              </div>
            </div>            
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

