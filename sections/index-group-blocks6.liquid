{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-group-blocks6">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color2}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="index-custom-blocks-container box border-none">
          <div class="box-content">
            <div class="banners-slider"> 
              <div class="carousel" data-carousel-param='{"effect": "{{ section.settings.effect2 }}", "direction": "{{ section.settings.direction2 }}", "autoplay": "{{ section.settings.autoplay2 }}", "autoplaySpeed": "{{ section.settings.autoplay_speed2 }}", "space": "30", "column_small": "1", "column_medium": "1", "column_large": "1", "column_xlarge": "1", "column_xxlarge": "1", "column_xxxlarge": "1", "row": "1"}' data-carousel>
                <div class="carousel-wrapper carousel-{{ section.settings.navigation_position }} carousel-nav-visible">
                  <div class="swiper-container" data-carousel-container>
                    <div class="swiper-wrapper small-up-1 medium-up-1 large-up-1 xlarge-up-1 xxlarge-up-1 xxxlarge-up-1">
                      {% for block in section.blocks %}
                      <div class="swiper-slide" data-carousel-item>
                        <div class="banner-img">
                          {%- unless block.settings.image == blank -%}
                          <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">
                            <img src="{{ block.settings.image | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                          </a>
                          {% else %}
                          <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">                
                            <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '720x590.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                          </a>
                          {%- endunless -%}
                        </div>                                   
                      </div>
                      {% endfor %}    
                    </div>
                  </div>
                  {%- if section.settings.navigation2 -%}
                  <!-- If we need navigation buttons -->
                  <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                  <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                  {%- endif -%}
                </div>
                {%- if section.settings.pagination2 -%}
                <!-- If we need pagination -->
                <div class="carousel-pagination" data-carousel-pagination></div>
                {%- endif -%}
              </div>
            </div>
			<div class="right-products">
              <div class="right-top-products-slider">
                {%- if section.settings.title != blank -%}
                <div class="box-divider">
                  {%- if section.settings.title != blank -%}
                  <h2 class="box-title" style="font-size:{{ section.settings.titlesize }}px; color:{{ section.settings.color }}; font-weight:{{ section.settings.title_weight}};">{{ section.settings.title }}</h2>
                  {%- endif -%}
                  {%- if section.settings.more != blank -%}
                  <div class="box-more"><a href="{{ collections[section.settings.collection].url }}">{{ section.settings.more }}</a></div>
                  {% endif %}
                </div>
                {%- endif -%}
                <div class="products-slider">
                  <div class="carousel" data-carousel-param='{"effect": "{{ section.settings.effect }}", "autoplay": "{{ section.settings.autoplay }}", "autoplaySpeed": "{{ section.settings.autoplay_speed }}", "space": "{{ section.settings.space }}", "column_small": "{{ section.settings.column_small }}", "column_medium": "{{ section.settings.column_medium }}", "column_large": "{{ section.settings.column_large }}", "column_xlarge": "{{ section.settings.column_xlarge }}", "column_xxlarge": "{{ section.settings.column_xxlarge }}", "column_xxxlarge": "{{ section.settings.column_xxxlarge }}", "row": "{{ section.settings.row }}"}' data-carousel>
                    <div class="carousel-wrapper carousel-{{ section.settings.navigation_position }}">
                      <div class="swiper-container" data-carousel-container>
                        <div class="swiper-wrapper grid-margin-x small-up-{{ section.settings.column_small }} medium-up-{{ section.settings.column_medium }} large-up-{{ section.settings.column_large }} xlarge-up-{{ section.settings.column_xlarge }} xxlarge-up-{{ section.settings.column_xxlarge }} xxxlarge-up-{{ section.settings.column_xxxlarge }}">
                          {%- if  section.settings.image_width and section.settings.image_height -%}
                          {%- assign product_image_size = section.settings.image_width | append: 'x' | append: section.settings.image_height -%}
                          {%- elsif section.settings.image_width -%}
                          {%- assign product_image_size = section.settings.image_width | append: 'x' -%}
                          {%- elsif section.settings.image_height -%}
                          {%- assign product_image_size = 'x' | append: section.settings.image_height -%}
                          {%- else -%}
                          {%- assign product_image_size = 'master' -%}
                          {%- endif -%}
                          {% for product in collections[section.settings.collection].products limit:section.settings.limit %}
                          <div class="swiper-slide cell" data-carousel-item>
                            <div class="product-grid">
                              {% include 'index-product-item' %} 
                            </div>
                          </div>                          
                          {% endfor %}
                        </div>
                      </div>
                      {%- if section.settings.navigation -%}
                      <!-- If we need navigation buttons -->
                      <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                      <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                      {%- endif -%}
                    </div>
                    {%- if section.settings.pagination -%}
                    <!-- If we need pagination -->
                    <div class="carousel-pagination" data-carousel-pagination></div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
              <div class="right-bottom-products-countdown">
                {%- if section.settings.title2 -%}
                <div class="box-divider">
                  {%- if section.settings.title != blank -%}
                  <h2 class="box-title" style="font-size:{{ section.settings.titlesize2 }}px; color:{{ section.settings.color3 }}; font-weight:{{ section.settings.title_weight2}};">{{ section.settings.title2 }}</h2>
                  {%- endif -%}
                  {% if section.settings.countdown %}
                  <div class="countdown-area">
                    <div class="timertext">{{ section.settings.timertext }}</div>
                    <div class="box-timer" data-languages='{"day": "{{ section.settings.day }}", "hours": "{{ section.settings.hours }}", "minutes": "{{ section.settings.minutes }}", "seconds": "{{ section.settings.seconds }}"}' data-timer="deal{{ section.id }}" data-timervalue={{ section.settings.timer }}>
                      <div class="timer" data-countdown-timer id="deal{{ section.id }}"></div>
                    </div>
                  </div>
                  {% endif %}
                </div>
                {%- endif -%}
                <div class="products-coutdown">
                  {%- if  section.settings.image_width2 and section.settings.image_height2 -%}
                  {%- assign product_image_size = section.settings.image_width2 | append: 'x' | append: section.settings.image_height2 -%}
                  {%- elsif section.settings.image_width2 -%}
                  {%- assign product_image_size = section.settings.image_width2 | append: 'x' -%}
                  {%- elsif section.settings.image_height2 -%}
                  {%- assign product_image_size = 'x' | append: section.settings.image_height2 -%}
                  {%- else -%}
                  {%- assign product_image_size = 'master' -%}
                  {%- endif -%}
                  {% for product in collections[section.settings.collection2].products limit:2 %}                  
                    <div class="product-grid">
                      {% include 'index-product-item-grid' %} 
                    </div>                  
                  {% endfor %}
                </div>
              </div>
            </div>            
          </div>          
        </div>        
      </div>  
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>  
  

