{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="image" data-section-name="index-banner-custom17" style="background-color:{{ section.settings.clbkg }}">
  <div class="{{ section.settings.display }}{% if section.settings.clbkg %}have-bkg{% else %}no-bkg{% endif %} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none index-banner-grid-container">
          {%- if section.settings.title != blank or section.settings.sub_title != blank -%}
          <div class="box-divider position-center">
            {%- if section.settings.title != blank -%}
            <h2 class="box-title width-100">{{ section.settings.title }}</h2>
            {%- endif -%}
          </div>
          {%- endif -%}
          <div class="box-content">          
            <div class="custom17-gr">
              <div class="left-area">
                <div class="banner-item banner-item-banner1 effect-{{section.settings.effect}} effect">
                  {% if section.settings.banner1 %}
                  <a class="banner-image" href="{{ section.settings.banner1link }}"><img src="{{ section.settings.banner1 | img_url: 'master' }}" alt="{{ section.settings.banner1.alt }}" /></a>
                  {% else %}
                  <img src="{{ '360x500.png' | asset_url }}" alt="" />
                  {% endif %}
                </div>
                <div class="banner-item effect-{{section.settings.effect}} effect">
                  {% if section.settings.banner2 %}
                  <a class="banner-image " href="{{ section.settings.banner2link }}"><img src="{{ section.settings.banner2 | img_url: 'master' }}" alt="{{ section.settings.banner2.alt }}" /></a>
                  {% else %}
                  <img src="{{ '360x230.png' | asset_url }}" alt="" />
                  {% endif %}
                </div>
              </div>
              <div class="right-area">
                <div class="right-top-area">
                  <div class="gr">
                    <div class="banner-item banner-item3">
                      <div class="effect-{{section.settings.effect}} effect">
                      {% if section.settings.banner3 %}
                      <a class="banner-image " href="{{ block.settings.banner3link }}"><img src="{{ section.settings.banner3 | img_url: 'master' }}" alt="{{ section.settings.banner3.alt }}" /></a>
                      {% else %}
                      <img src="{{ '730x230.png' | asset_url }}" alt="" />
                      {% endif %}
                      </div>
                    </div>
                    <div class="banner-item banner-item4">
                      <div class="effect-{{section.settings.effect}} effect">
                      {% if section.settings.banner4 %}
                      <a class="banner-image " href="{{ block.settings.banner4link }}"><img src="{{ section.settings.banner4 | img_url: 'master' }}" alt="{{ section.settings.banner4.alt }}" /></a>
                      {% else %}
                      <img src="{{ '360x230.png' | asset_url }}" alt="" />
                      {% endif %}
                      </div>
                    </div>
                  </div>                    
                </div>
                <div class="right-bottom-area">
                  <div class="gr">
                    <div class="right-bottom-left-area">
                      <div class="banner-item effect-{{section.settings.effect}} effect">
                        {% if section.settings.banner5 %}
                        <a class="banner-image " href="{{ block.settings.banner5link }}"><img src="{{ section.settings.banner5 | img_url: 'master' }}" alt="{{ section.settings.banner5.alt }}" /></a>
                        {% else %}
                        <img src="{{ '500x500.png' | asset_url }}" alt="" />
                        {% endif %}
                      </div>
                    </div>
                    <div class="right-bottom-right-area">
                      <div class="banner-item banner-item-banner6 effect-{{section.settings.effect}} effect">
                        {% if section.settings.banner6 %}
                        <a class="banner-image " href="{{ section.settings.banner6link }}"><img src="{{ section.settings.banner6 | img_url: 'master' }}" alt="{{ section.settings.banner6.alt }}" /></a>
                        {% else %}
                        <img src="{{ '590x245.png' | asset_url }}" alt="" />
                        {% endif %}
                      </div>
                      <div class="banner-item banner-item-banner7 effect-{{section.settings.effect}} effect">
                        {% if section.settings.banner7 %}
                        <a class="banner-image " href="{{ section.settings.banner7link }}"><img src="{{ section.settings.banner7 | img_url: 'master' }}" alt="{{ section.settings.banner7.alt }}" /></a>
                        {% else %}
                        <img src="{{ '590x245.png' | asset_url }}" alt="" />
                        {% endif %}
                      </div>
                    </div>   
                  </div>                                    
                  </div>
                </div>  
            </div>                      
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


