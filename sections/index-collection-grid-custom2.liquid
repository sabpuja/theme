{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="products" data-section-name="index-collection-grid-custom2">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">  
        <div class="index-collection-banner-container box border-none">
        <div class="box-content">
          {%- if section.blocks.size > 0 -%}
          <div class="index-collection-grid-list grid-x grid-margin-x">
            {%- for block in section.blocks -%}
            {%- case block.type -%}
            {%- when 'top_rate' -%}
            <div class="bestseller-content cell small-12 medium-9 large-9">
              {%- if block.settings.title != blank or block.settings.sub_title != blank -%}
              <div class="box-divider grid-x">
                {%- if block.settings.title != blank -%}
                <h2 class="box-title">{{ block.settings.title }}</h2>
                {%- endif -%}
                {%- if block.settings.readmore != blank -%}
                <div class="box-readmore">
                  <a href="{{ collections[block.settings.collection].url }}"> <em class="sli sli-plus"></em> {{ block.settings.readmore }}</a>
                </div>
                {%- endif -%}
              </div>
              {%- endif -%}
              <div class="box-content bestseller-group">
                <div class="product-big">
                  {% for product in collections[block.settings.collection].products limit:1 %}
                  <div class="product-grid">
                    {% include 'index-product-item' %} 
                  </div>
                  {% else %}
                  {% for i in (1..1) %}
                  {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                  <div class="product-grid">
                    <div class="product-item" data-product-item>
                      <div class="product-item-thumb">
                        <a href="javascript:void(0);" class="display-block">
                          {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                        </a>
                        <div class="group-button top-right">      
                          {%- if settings.product_item_quick_view -%}
                          <a href="javascript:void(0);" class="group-button-quickview group-button-item product-item-button product-item-button-quick-view" title="{{ 'general.button.quick_view' | t }}"><em class="sli sli-magnifier"></em>
                          </a>
                          {%- endif -%}
                          {%- if settings.product_item_wishlist -%}
                          <div class="group-button-wishlist group-button-item product-item-button-wishlist">
                            <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                            <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                          </div>
                          {%- endif -%}
                          {%- if settings.product_item_compare -%}
                          <div class="group-button-compare group-button-item product-item-button product-item-button-compare">
                            <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                            <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>        
                          </div>
                          {%- endif -%}
                        </div>

                        <div class="cart-button bottom-center">
                          <div class="product-item-buttons">
                            <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>            
                          </div>
                        </div>
                      </div>
                      <div class="product-item-caption">
                        <div class="product-title-vendor">
                          <h4 class="product-item-title">
                            <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                          </h4>
                          {% if settings.product_item_vendor %}
                          <div class="product-item-vendor">
                            {{ 'homepage.onboarding.vendor' | t }}
                          </div>
                          {% endif %}       
                        </div>
                        <div class="product-item-group grid-x">
                          <div class="product-item-price cell small-12 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                            <span class="product-item-price-sale">$99.00</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>     
                  {% endfor %}
                  {% endfor %}
                </div>
                <div class="product-small">
                  {% for product in collections[block.settings.collection].products limit:2 offset: 1 %}
                  <div class="product-grid">
                    {% include 'index-product-item-grid2' %} 
                  </div>
                  {% else %}
                  {% for i in (1..2) %}
                  {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                  <div class="product-grid">
                    <div class="product-item grid-x" data-product-item>
                      <div class="product-item-thumb cell small-12 medium-6 large-6">
                        <a href="javascript:void(0);" class="display-block">
                          {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                        </a>
                        <div class="group-button top-right">      
                          {%- if settings.product_item_quick_view -%}
                          <a href="javascript:void(0);" class="group-button-quickview group-button-item product-item-button product-item-button-quick-view" title="{{ 'general.button.quick_view' | t }}"><em class="sli sli-magnifier"></em>
                          </a>
                          {%- endif -%}
                          {%- if settings.product_item_wishlist -%}
                          <div class="group-button-wishlist group-button-item product-item-button-wishlist">
                            <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                            <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                          </div>
                          {%- endif -%}
                          {%- if settings.product_item_compare -%}
                          <div class="group-button-compare group-button-item product-item-button product-item-button-compare">
                            <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                            <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>        
                          </div>
                          {%- endif -%}
                        </div>

                        <div class="cart-button bottom-center">
                          <div class="product-item-buttons">
                            <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>            
                          </div>
                        </div>
                      </div>
                      <div class="product-item-caption cell small-12 medium-6 large-6">
                        <div class="product-title-vendor">
                          <h4 class="product-item-title">
                            <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                          </h4>
                          {% if settings.product_item_vendor %}
                          <div class="product-item-vendor">
                            {{ 'homepage.onboarding.vendor' | t }}
                          </div>
                          {% endif %}       
                        </div>
                        <div class="product-item-group grid-x">
                          <div class="product-item-price cell small-12 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                            <span class="product-item-price-sale">$99.00</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>     
                  {% endfor %}
                  {% endfor %}
                </div>
              </div>
            </div>                
            {%- when 'recently_viewed' -%}
            <div class="recently-viewed-content cell small-12 medium-3 large-3">
              {%- if block.settings.title != blank or block.settings.sub_title != blank -%}
              <div class="box-divider grid-x">
                {%- if block.settings.title != blank -%}
                <h2 class="box-title">{{ block.settings.title }}</h2>
                {%- endif -%}
              </div>
              {%- endif -%}
              <div class="box-content recently-viewed-group grid-x">                    
                <div class="recently-viewed-content-group">
                  <div class="carousel" data-carousel-param='{"effect": "slide", "autoplay": "5000", "autoplaySpeed": "true", "space": "30", "column_small": "1", "column_medium": "1", "column_large": "1", "column_xlarge": "1", "column_xxlarge": "1", "column_xxxlarge": "1", "row": "{{ block.settings.row }}"}' data-carousel>
                    <div class="carousel-wrapper carousel-nav-top-right">
                      <div class="swiper-container" data-carousel-container>
                        <div class="swiper-wrapper grid-margin-x small-up-1 medium-up-1 large-up-1 xlarge-up-1 xxlarge-up-1 xxxlarge-up-1">                            
                          {% for product in collections[block.settings.collection].products limit: block.settings.limit %}
                          <div class="swiper-slide cell" data-carousel-item>
                            <div class="product-grid">
                              {% include 'index-product-item-grid2' %}
                            </div>
                          </div>
                          {% else %}
                          {% for i in (1..block.settings.limit) %}
                          <div class="swiper-slide cell" data-carousel-item>
                            {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                            <div class="product-grid">
                              <div class="product-item grid-x" data-product-item>
                                <div class="product-item-thumb  cell small-12 medium-6 large-6">
                                  <a href="javascript:void(0);" class="display-block">
                                    {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                  </a>
                                  <div class="group-button top-right">      
                                    {%- if settings.product_item_quick_view -%}
                                    <a href="javascript:void(0);" class="group-button-quickview group-button-item product-item-button product-item-button-quick-view" title="{{ 'general.button.quick_view' | t }}"><em class="sli sli-magnifier"></em>
                                    </a>
                                    {%- endif -%}
                                    {%- if settings.product_item_wishlist -%}
                                    <div class="group-button-wishlist group-button-item product-item-button-wishlist">
                                      <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                                      <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                                    </div>
                                    {%- endif -%}
                                    {%- if settings.product_item_compare -%}
                                    <div class="group-button-compare group-button-item product-item-button product-item-button-compare">
                                      <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                                      <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>        
                                    </div>
                                    {%- endif -%}
                                  </div>

                                  <div class="cart-button bottom-center">
                                    <div class="product-item-buttons">
                                      <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>            
                                    </div>
                                  </div>
                                </div>
                                <div class="product-item-caption  cell small-12 medium-6 large-6">
                                  <div class="product-title-vendor">
                                    <h4 class="product-item-title">
                                      <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                                    </h4>
                                    {% if settings.product_item_vendor %}
                                    <div class="product-item-vendor">
                                      {{ 'homepage.onboarding.vendor' | t }}
                                    </div>
                                    {% endif %}       
                                  </div>
                                  <div class="product-item-group grid-x">
                                    <div class="product-item-price cell small-12 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">
                                      <span class="product-item-price-sale">$99.00</span>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>  
                          </div>
                          {% endfor %}
                          {% endfor %}
                        </div>
                      </div>
                      <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                      <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                    </div>
                  </div>
                </div>                    
              </div>
            </div>
            {%- endcase -%}
            {%- endfor -%}
          </div>
          {%- endif -%}
        </div>
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>  
  
  

{% schema %}
{
  "name": "Products Grid & Custom 2",
  "class": "index-section index-collection-grid-custom2",
  "settings": [
	{
      "type": "paragraph",
      "content": "View [Mockup of Section layout](https:\/\/i.imgur.com\/Bb5NU2m.png)"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    }
  ],
  "blocks": [
    {
      "type": "top_rate",
      "name": "Best Seller",
      "settings": [
		{
          "type": "text",
          "id": "title",
          "label": "Title"
        },
		{
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
		{
          "type": "text",
          "id": "readmore",
          "label": "More text",
		  "default":"More"
        }
	  ]
    },	
	{
      "type": "recently_viewed",
      "name": "Recently Viewed",
      "settings": [		
		{
          "type": "text",
          "id": "title",
          "label": "Title"
        },
		{
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },		
        {
          "type": "text",
          "id": "row",
          "label": "Product per slide",
          "default": "4"
        },
        {
          "type": "text",
          "id": "limit",
          "label": "Limit product show",
          "default": "4"
        }
	  ]
    }
  ],
  "presets": [
    {
      "name": "Products Grid & Custom 2",
      "category": "Products"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}