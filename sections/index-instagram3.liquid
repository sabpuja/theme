{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-instagram3">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content"> 
        <div class="isb-product box border-none">
          <div class="box-divider gallery-title position-{{ section.settings.title_position }}">
            {%- if section.settings.title != blank -%}
            <h2 class="box-title" style="color:{{ section.settings.color2}}">{{ section.settings.title }}</h2>
            {%- endif -%}
          </div>
          <div class="box-content">   
            <div class="left-area">
              <div class="photo-1">
                <div class="instagram-item effect-{{section.settings.effect}} effect">
                  <a class="instagram-photo" href="{{ section.settings.link1 }}" title="">                
                    <img class="width-100" src="{% if section.settings.image1 %}{{ section.settings.image1 | img_url: 'master' }}{% else %}{{ '280x280.png' | asset_url }}{% endif %}" alt="{{ section.settings.image1.alt }}" />
                  </a>
                  <a class="no-effect instagram-icon" href="{{ section.settings.link1 }}"><em class="sli sli-social-instagram"></em></a>
                </div> 
              </div>
              <div class="photo-2">
