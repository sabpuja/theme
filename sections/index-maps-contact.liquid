{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-maps-contact">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none index-text-banner-grid-container">
          <div class="box-content">
            <div class="grid-x">
              <div class="cell large-8 maps-area">
                {{ section.settings.map }}
              </div>
              <div class="cell large-4 contact-area">
                {%- form 'contact' -%}
                {%- if form.posted_successfully? -%}
                <div class="callout success">
                  {{ 'contact.form.post_success' | t }}
                </div>
                {%- endif -%}
                {%- if form.errors -%}
                <div class="callout alert">
                  {{ form.errors | default_errors }}
                </div>
                {%- endif -%}
                <div class="grid-x grid-margin-x">
                  <div class="form-group cell large-12">
                    <label class="form-group-label">{{ 'contact.form.name' | t }}</label>
                    <input type="text" name="contact[name]" value="{% if form[name] %}{{ form[name] }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ 'contact.form.name' | t }}" class="form-group-field" />
                  </div>
                  <div class="form-group{% if form.errors contains 'email' %} has-error{% endif %}  cell large-12">
                    <label class="form-group-label">{{ 'contact.form.email' | t }}</label>
                    <input type="email" name="contact[email]"  autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" placeholder="{{ 'contact.form.email' | t }}" class="form-group-field" />
                  </div>
                  <div class="form-group cell large-12">
                    <label class="form-group-label">{{ 'contact.form.message' | t }}</label>
                    <textarea name="contact[body]" placeholder="{{ 'contact.form.message' | t }}" class="form-group-field">{% if form.body %}{{ form.body }}{% endif %}</textarea>
                    <input type="submit" class="button form-button" value="{{ 'contact.form.submit' | t }}"/>
                  </div>

                </div>
                {%- endform -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

  
{% schema %}
{
  "name": "Maps & Contact #1",
  "class": "index-section index-maps-contact",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "header",
      "content": "Map Settings"
    },
	{
      "type": "textarea",
      "id": "map",
      "label": "Input Maps iframe"
    }
  ],  
  "presets": [
    {
      "name": "Maps & Contact #1",
      "category": "Advanced"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}