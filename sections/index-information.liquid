{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
  {% if section.settings.bkgmode %}
    .spacing-{{ section.id }}{	
	  background-image: linear-gradient({{ section.settings.color}}, {{ section.settings.color3}});
	}
  {% endif %}
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-information">
  <div class="{{ section.settings.display }} {% if section.settings.bkg %}have-bkg{% else %}no-bkg{% endif %} spacing-{{ section.id }}" style="{% if section.settings.bkgp == '1'%} {% if section.settings.bkg %}background-image:url({{ section.settings.bkg | img_url: 'master' }});{% endif %} background-color:{{ section.settings.color }}{% endif %}">
	{% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content" style="{% if section.settings.bkgp == '2'%} {% if section.settings.bkg %}background-image:url({{ section.settings.bkg | img_url: 'master' }});{% endif %} background-color:{{ section.settings.color }}{% endif %}">
        {%- if section.settings.title != blank or section.settings.sub_title != blank -%}
        <div class="box-divider blog-title">
          <h2 class="box-title width-100">{{ section.settings.title }}</h2>
        </div>
        {%- endif -%}
        <div class="index-information-grid-container {% if section.settings.color != '' %}have-colorbkg{% endif %}">
        {%- if section.blocks.size > 0 -%}
        <div class="box-content {% if section.settings.border %}have-border{% endif %} {% if section.settings.border2 %}have-border-each{% endif %}{% if section.settings.border3 %}have-between{% endif %}">
          <div class="index-information-grid-list grid-x align-{{ section.settings.layout2 }}">
            {%- for block in section.blocks -%}
            <div class="index-information-item {% if block.settings.border %}have-border{% endif %} cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }}" style="background-color:{{ block.settings.color }}">
              <div class="effect effect-scope layout-{{ section.settings.layout }}" style="color:{{ section.settings.color2 }}">
                <div class="info-icon">                 
                  {% if block.settings.image %}
                  <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image.alt }}"/>
                  {% elsif block.settings.icon != '' %}
                  <em class="sli sli-{{ block.settings.icon }}"></em>
                  {% else %}
                  {{ block.settings.iconsvg }}
                  {% endif %}               
                </div>
                <div class="info-text">
                  {%- if block.settings.title != blank -%}
                  <div class="title">{{ block.settings.title }}</div>
                  {%- endif -%}
                  {%- if block.settings.title2 != blank -%}
                  <div class="sub-title">{{ block.settings.title2 }}</div>
                  {%- endif -%}
                </div>
              </div>
            </div>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>  


