{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-kol3">
  <div class="index-link-bg {{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{ section.settings.color6 }};">
    <div class="section-content">
      <div class="kol-content">        
          {%- if section.settings.title != blank -%}
          <div class="box-divider">
            <div class="grid-container">
                <h2 class="box-title" style="font-size:{{ section.settings.titlesize }}px; color:{{ section.settings.color0 }};">{{ section.settings.title }}</h2>
                {%- if section.settings.stitle != "" -%}
                <div class="box-subtitle width-100">{{ section.settings.stitle }}</div>           
                {%- endif -%}  
            </div>        
          </div>
          {%- endif -%}                  
        <div class="box-content">
          <div class="box-text box-text-{{section.id}}">
             <div class="grid-container">
                <div class="box-text-gr grid-x">
                    <div class=" text text1 cell large-4">
                      {% if section.settings.title1 != '' %}<div class="text-title text1-title" style="color:{{ section.settings.color1 }};">{{ section.settings.title1 }}</div>{% endif %}
                      {% if section.settings.title1c != '' %}<div class="text-content text1-content" style="color:{{ section.settings.color1 }};">{{ section.settings.title1c }}</div>{% endif %}
                    </div>
                    <div class="text1 cell large-4">
                      {% if section.settings.title2 != '' %}<div class="text-title text2-title" style="color:{{ section.settings.color1 }};">{{ section.settings.title2 }}</div>{% endif %}
                      {% if section.settings.title2c != '' %}<div class="text-content text2-content" style="color:{{ section.settings.color1 }};">{{ section.settings.title2c }}</div>{% endif %}
                    </div>
                    <div class="text1 cell large-4">
                      {% if section.settings.title3 != '' %}<div class="text-title text3-title" style="color:{{ section.settings.color1 }};">{{ section.settings.title3 }}</div>{% endif %}
                      {% if section.settings.title3c != '' %}<div class="text-content text3-content" style="color:{{ section.settings.color1 }};">{{ section.settings.title3c }}</div>{% endif %}
                    </div>
                </div>
             </div>           
            <style>
              .box-text-{{section.id}} .box-text-gr{
                background-image: linear-gradient({{section.settings.color2 }}, {{section.settings.color3 }});
              }
              
              .kol-slider-gr:before{
                background-color: {{section.settings.color3 }};                
              }
            </style>
          </div>
          {% if section.blocks.size > 0 %}  
          <div class="kol-slider-gr">                       
            <div class="kol-slider-1">            
              <div class="carousel" data-carousel-param='{"effect": "{{ section.settings.effect }}", "direction": "horizontal", "autoplay": "{{ section.settings.autoplay }}", "autoplaySpeed": "{{ section.settings.autoplay_speed }}", "space": "{{ section.settings.space }}", "column_small": "{{ section.settings.column_small }}", "column_medium": "{{ section.settings.column_medium }}", "column_large": "{{ section.settings.column_large }}", "column_xlarge": "{{ section.settings.column_xlarge }}", "column_xxlarge": "{{ section.settings.column_xxlarge }}", "column_xxxlarge": "{{ section.settings.column_xxxlarge }}", "row": "{{ section.settings.row }}", "center": "false"}' data-carousel>
                <div class="carousel-wrapper carousel-{{ section.settings.navigation_position }}">
                  <div class="swiper-container" data-carousel-container>
                    <div class="swiper-wrapper align-middle grid-margin-x small-up-{{ section.settings.column_small }} medium-up-{{ section.settings.column_medium }} large-up-{{ section.settings.column_large }} xlarge-up-{{ section.settings.column_xlarge }} xxlarge-up-{{ section.settings.column_xxlarge }} xxxlarge-up-{{ section.settings.column_xxxlarge }}">
                      {% for block in section.blocks %}
                      {% if block.type == 'kol1'%}
                      <div class="swiper-slide cell text-center" data-carousel-item>
                        <div class="index-kol-item">
                          <div class="kol-avatar effect-zoom effect">
                            <a href="{{ block.settings.url }}"><img src="{% if block.settings.banner %}{{ block.settings.banner | img_url: 'master' }}{% else %}{{ '870x1110.png' | asset_url }}{% endif %}" alt=""/></a>
                          </div>
                          <div class="kol-caption">
                            <a class="name" href="{{ block.settings.url }}">{{ block.settings.title }}</a>                                           
                          </div>
                        </div>     
                      </div>
                      {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                  {%- if section.settings.navigation -%}
                  <!-- If we need navigation buttons -->
                  <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                  <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                  {%- endif -%}
                </div>
              </div>
            </div>
            <div class="kol-slider-2">            
              <div class="carousel" data-carousel-param='{"effect": "{{ section.settings.effect }}", "direction": "horizontal", "autoplay": "{{ section.settings.autoplay }}", "autoplaySpeed": "{{ section.settings.autoplay_speed }}", "space": "{{ section.settings.space }}", "column_small": "{{ section.settings.kol2_column_small }}", "column_medium": "{{ section.settings.kol2_column_medium }}", "column_large": "{{ section.settings.kol2_column_large }}", "column_xlarge": "{{ section.settings.kol2_column_xlarge }}", "column_xxlarge": "{{ section.settings.kol2_column_xxlarge }}", "column_xxxlarge": "{{ section.settings.kol2_column_xxxlarge }}", "row": "{{ section.settings.row }}", "center": "false"}' data-carousel>
                <div class="carousel-wrapper carousel-{{ section.settings.navigation_position }}">
                  <div class="swiper-container" data-carousel-container>
                    <div class="swiper-wrapper align-middle grid-margin-x small-up-{{ section.settings.kol2_column_small }} medium-up-{{ section.settings.kol2_column_medium }} large-up-{{ section.settings.kol2_column_large }} xlarge-up-{{ section.settings.kol2_column_xlarge }} xxlarge-up-{{ section.settings.kol2_column_xxlarge }} xxxlarge-up-{{ section.settings.kol2_column_xxxlarge }}">
                      {% for block in section.blocks %}
                      {% if block.type == 'kol2'%}
                      <div class="swiper-slide cell text-center" data-carousel-item>
                        <div class="index-kol-item">
                          <div class="kol-avatar effect-zoom effect">
                            <a href="{{ block.settings.url }}"><img src="{% if block.settings.banner %}{{ block.settings.banner | img_url: 'master' }}{% else %}{{ '870x1110.png' | asset_url }}{% endif %}" alt=""/></a>
                          </div>
                          <div class="kol-caption">
                            <a class="name" href="{{ block.settings.url }}">{{ block.settings.title }}</a>                                           
                          </div>
                        </div>     
                      </div>
                      {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                  {%- if section.settings.navigation -%}
                  <!-- If we need navigation buttons -->
                  <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                  <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div> 
          {% endif %}
        </div>
      </div>   
    </div>
  </div>
</div>

