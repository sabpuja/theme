{{ 'sabpuja-home-supporting.css' | asset_url | stylesheet_tag }}
{{ 'sabpuja-stay-connected-social.css' | asset_url | stylesheet_tag }}

<section class="sp2026-support sp2026-support__section" aria-labelledby="sp2026-connected-title-{{ section.id }}">
  <div class="sp2026-support__inner">
    <div class="sp2026-connected">
      <div class="sp2026-connected__copy">
        <p class="sp2026-support__eyebrow">Support &amp; community</p>
        <h2 class="sp2026-connected__title" id="sp2026-connected-title-{{ section.id }}">Stay Connected</h2>
        <p class="sp2026-connected__text">For product questions and order support, email us or use the chat widget on this page. You can also follow Sabpuja through our social channels and community updates.</p>

        <div class="sp2026-connected__actions">
          <a class="sp2026-connected__action" href="mailto:support@sabpuja.com" aria-label="Email Sabpuja support at support@sabpuja.com">{% render 'sabpuja-icon', name: 'mail' %}<span>Email support@sabpuja.com</span></a>
        </div>

        <p class="sp2026-connected__social-label">Follow Sabpuja</p>
        <nav class="sp2026-connected__socials" aria-label="Sabpuja social channels">
          {% if settings.social_instagram_link != blank %}
            <a class="sp2026-connected__social-link" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" aria-label="Sabpuja on Instagram, @sabpujaofficial — opens in a new tab">{% render 'sabpuja-icon', name: 'instagram' %}<strong>Instagram</strong><span>@sabpujaofficial</span></a>
          {% endif %}
          {% if settings.social_youtube_link != blank %}
            <a class="sp2026-connected__social-link" href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener noreferrer" aria-label="Sabpuja on YouTube — opens in a new tab">{% render 'sabpuja-icon', name: 'youtube' %}<strong>YouTube</strong><span>Sabpuja</span></a>
          {% endif %}
          {% if settings.social_facebook_link != blank %}
            <a class="sp2026-connected__social-link" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer" aria-label="Sabpuja on Facebook — opens in a new tab">{% render 'sabpuja-icon', name: 'facebook' %}<strong>Facebook</strong><span>Sabpuja</span></a>
          {% endif %}
        </nav>
      </div>

      <div class="sp2026-connected__media">
        <img src="https://cdn.shopify.com/s/files/1/0923/1381/3308/files/sabpuja-stay-connected-social-2026.webp?v=1789664793" width="1672" height="941" loading="lazy" decoding="async" alt="Sabpuja social connection scene with a smartphone, diya, flowers and devotional decor">
      </div>
    </div>
  </div>
</section>

{% schema %}
{"name":"Sabpuja stay connected","settings":[],"presets":[{"name":"Sabpuja stay connected"}]}
{% endschema %}