{{ 'sabpuja-related-products.css' | asset_url | stylesheet_tag }}

{% liquid
  assign variant = section.settings.variant | default: 'grid_four'
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign item_heading_tag = 'h3'
  if heading_tag == 'h3'
    assign item_heading_tag = 'h4'
  endif
%}

<section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | escape }}"{% endif %} class="sp-related-products sp-related-products--{{ variant }} sp-related-products--{{ section.settings.background }} sp-related-products--width-{{ section.settings.width }} sp-related-products--align-{{ section.settings.alignment }}">
  <div class="sp-related-products__inner">
    <header class="sp-related-products__head">
      <div class="sp-related-products__head-copy">
        {% if section.settings.eyebrow != blank %}<p class="sp-related-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<{{ heading_tag }} class="sp-related-products__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>{% endif %}
        {% if section.settings.body != blank %}<div class="sp-related-products__body">{{ section.settings.body }}</div>{% endif %}
      </div>
      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}<a class="sp-related-products__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>{% endif %}
    </header>

    <div class="sp-related-products__grid" role="list">
      {% for block in section.blocks %}
        {% assign card_product = block.settings.product %}
        {% if card_product != blank %}
          {% assign card_image = block.settings.image_override | default: card_product.featured_image %}
          {% assign card_alt = block.settings.image_alt %}
          {% if card_alt == blank and card_image != blank %}{% assign card_alt = card_image.alt %}{% endif %}
          {% if card_alt == blank %}{% assign card_alt = card_product.title %}{% endif %}
          <article class="sp-related-products__card" role="listitem" {{ block.shopify_attributes }}>
            {% if card_image != blank %}
              <a class="sp-related-products__media" href="{{ card_product.url }}" aria-label="View {{ card_product.title | escape }}">
                {{ card_image | image_url: width: 1000 | image_tag: widths: '320,480,640,800,1000', sizes: '(min-width: 990px) 25vw, (min-width: 620px) 45vw, 82vw', loading: 'lazy', alt: card_alt }}
              </a>
            {% endif %}
            <div class="sp-related-products__card-body">
              {% if block.settings.badge != blank %}<span class="sp-related-products__badge">{{ block.settings.badge | escape }}</span>{% endif %}
              <{{ item_heading_tag }} class="sp-related-products__title"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></{{ item_heading_tag }}>
              {% if block.settings.short_copy != blank %}<p class="sp-related-products__copy">{{ block.settings.short_copy | escape }}</p>{% endif %}
              {% if section.settings.show_price or section.settings.show_availability %}
                <div class="sp-related-products__meta">
                  {% if section.settings.show_price %}
                    <span class="sp-related-products__price">{{ card_product.price | money }}</span>
                    {% if card_product.compare_at_price > card_product.price %}<span class="sp-related-products__compare">{{ card_product.compare_at_price | money }}</span>{% endif %}
                  {% endif %}
                  {% if section.settings.show_availability %}<span class="sp-related-products__availability">{% if card_product.available %}Available{% else %}Unavailable{% endif %}</span>{% endif %}
                </div>
              {% endif %}
              <a class="sp-related-products__link" href="{{ card_product.url }}">{{ block.settings.link_label | default: 'View product' | escape }} &rarr;</a>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sabpuja Related Products",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anchor ID"},
    {"type":"select","id":"variant","label":"Layout variant","default":"grid_four","options":[{"value":"grid_three","label":"Three-card grid"},{"value":"grid_four","label":"Four-card grid"},{"value":"carousel","label":"Horizontal carousel"},{"value":"editorial","label":"Editorial recommendation"},{"value":"compact","label":"Compact list"},{"value":"premium_dark","label":"Premium dark"}]},
    {"type":"select","id":"heading_tag","label":"Heading level","default":"h2","options":[{"value":"h2","label":"H2"},{"value":"h3","label":"H3"}]},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"You may also like"},
    {"type":"text","id":"heading","label":"Heading","default":"Explore related puja essentials"},
    {"type":"richtext","id":"body","label":"Supporting copy","default":"<p>Use this section for genuinely relevant alternatives, complementary products or the next logical item in the customer's journey.</p>"},
    {"type":"checkbox","id":"show_price","label":"Show Shopify price","default":true},
    {"type":"checkbox","id":"show_availability","label":"Show availability","default":false},
    {"type":"text","id":"cta_label","label":"Section CTA label"},
    {"type":"url","id":"cta_link","label":"Section CTA link"},
    {"type":"select","id":"alignment","label":"Heading alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}]},
    {"type":"select","id":"background","label":"Section background","default":"white","options":[{"value":"white","label":"White"},{"value":"ivory","label":"Ivory"},{"value":"cream","label":"Cream"},{"value":"sacred-brown","label":"Sacred Brown"}]},
    {"type":"select","id":"width","label":"Section width","default":"contained","options":[{"value":"contained","label":"Contained"},{"value":"wide","label":"Wide"},{"value":"full","label":"Full width"}]}
  ],
  "blocks": [
    {"type":"product","name":"Related product","settings":[{"type":"product","id":"product","label":"Product"},{"type":"image_picker","id":"image_override","label":"Image override"},{"type":"text","id":"image_alt","label":"Image alt override"},{"type":"text","id":"badge","label":"Optional badge"},{"type":"text","id":"short_copy","label":"Short supporting copy"},{"type":"text","id":"link_label","label":"Link label","default":"View product"}]}
  ],
  "max_blocks": 8,
  "presets": [{"name":"Sabpuja Related Products","blocks":[{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"}]}]
}
{% endschema %}
