{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banners-grid">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{ section.settings.bkg2 }}; {% if section.settings.padding2 != 0 %}padding: {{ section.settings.padding2 }}px 0;{% endif %} {% if section.settings.bkg %}style="background-image:url({{ section.settings.bkg | img_url: 'master' }})"{% endif %}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}      
      <div class="section-content" {% if section.settings.margin4 %}style="margin-left:150px; margin-right:150px;"{% endif %}>
        {%- if section.settings.title != blank or section.settings.sub_title != blank -%}
        <div class="box-divider blog-title">
          <h2 class="box-title width-100" style="font-size:{{ section.settings.size }}px">{{ section.settings.title }}</h2>
        </div>
      {%- endif -%}
        <div class="box-content">
            <div class="banners-content">
          {% if section.blocks.size > 0 %}
          <div class="grid-x {% if section.settings.margin5 %}grid-margin-y{% else %}no-margin{% endif %} {% if section.settings.padding %}grid-margin-x{% else %}no-padding{% endif %}">
            {%- for block in section.blocks -%}
            <div class="gallery-element effect-{{section.settings.effect}} effect cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }}"> 
              <div class="banner-image {% if block.settings.center %}let-center{% else%}let-full{% endif %}">
                <a class="effect-parent" href="{{ block.settings.link }}" title="">   
                  {% if block.settings.image %}
                  <img class="" src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image.alt }}" />
                  {% else %}
                  {% if section.blocks.size == 1 %}
                    {% if settings.header_style == '8' %}
                    <img class="" src="{{ '1095x150.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />                   
                    {% else %}
                      {% if full %}
                      <img class="" src="{{ '1920x250.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                      {% else %}
                        {% if block.settings.column_xlarge == '12' %}
                        <img class="" src="{{ '1470x300.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                  		{% else %}
                        <img class="" src="{{ '640x400.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                  		{% endif %}
                      {% endif %}
                    {% endif %}
                  {% elsif section.blocks.size == 2 %}
                    {% if block.settings.column_xlarge == '8' %}
                    <img class="" src="{{ '970x240.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                    {% elsif block.settings.column_xlarge == '4' %}
                    <img class="" src="{{ '470x240.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                    {% elsif block.settings.column_xlarge == '9' %}
                    <img class="" src="{{ '1095x200.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                    {% elsif block.settings.column_xlarge == '3' %}
                    <img class="" src="{{ '345x200.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                    {% else %}
                    <img class="" src="{{ '720x200.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                    {% endif %}
                  {% elsif section.blocks.size == 3 %}
                    {% if full %}
                    <img class="" src="{{ '640x400.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                    {% else %}
                      {% if block.settings.column_xlarge == '3' %}
                  		<img class="" src="{{ '345x300.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                      {% elsif block.settings.column_xlarge == '4' %}
                        <img class="" src="{{ '470x320.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                  	  {% elsif block.settings.column_xlarge == '6' %}
                   		<img class="" src="{{ '720x300.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                      {% else %}
                        <img class="" src="{{ '470x320.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                      {% endif %}
                    {% endif %}
                  {% elsif section.blocks.size == 4 %}
                    <img class="" src="{{ '410x400.png' | asset_url }}" alt="{{ block.settings.image.alt }}" />
                    {% endif %}                  
                  {% endif %}
                </a>
              </div>  
              {% if block.settings.title != '' or block.settings.desc != '' %}
              <div class="banner-caption vertical-{{ block.settings.style }} horizontal-{{ block.settings.style2 }}">
                {% if block.settings.title %}<div class="heading"><a href="{{ block.settings.link }}" style="color:{{ block.settings.color }}"> {{ block.settings.title }}</a></div>{% endif %}
                {% if block.settings.desc %}<div class="desc" style="color:{{ block.settings.color }}">{{ block.settings.desc }}</div>{% endif %}
                {% if block.settings.action %}<div class="action mode-{{ block.settings.color2 }}"><a href="{{ block.settings.link }}">{{ block.settings.action }}</a></div>{% endif %}
              </div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </div> 
        </div>          
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>
