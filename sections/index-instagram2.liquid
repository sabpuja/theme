{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-instagram2">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content"> 
        <div class="isb-product box border-none">
          <div class="box-divider gallery-title position-{{ section.settings.title_position }}">
            {%- if section.settings.title != blank -%}
            <h2 class="box-title" style="color:{{ section.settings.color2}}">{{ section.settings.title }}</h2>
            {%- endif -%}
          </div>
          <div class="box-content">        
          {% if section.blocks.size > 0 %}
          <div class="grid-x grid-margin-y align-center"  {% if section.settings.padding %}style="margin-left:-5px; margin-right:-5px;"{% endif %} >
            {%- for block in section.blocks -%}
            <div class="gallery-element cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }} xxlarge-{{ block.settings.column_xxlarge }} xxxlarge-{{ block.settings.column_xxxlarge }}"> 
              <div class="banner-photo">
                <div class="left-area">
                  <div class="instagram-item effect-{{section.settings.effect}} effect">
                    <a class="instagram-photo" href="{{ block.settings.link1 }}" title="">                
                      <img class="width-100" src="{% if block.settings.image1 %}{{ block.settings.image1 | img_url: 'master' }}{% else %}{{ '490x490.png' | asset_url }}{% endif %}" alt="{{ block.settings.image1.alt }}" />
                    </a>
                    <a class="no-effect instagram-icon" href="{{ block.settings.link1 }}"><em class="sli sli-social-instagram"></em></a>
                  </div>                  
                </div>
                <div class="right-area">
                  <div class="right-top-area">
                    <div class="instagram-item effect-{{section.settings.effect}} effect">
                      <a class="instagram-photo" href="{{ block.settings.link2 }}" title="">                
                        <img class="width-100" src="{% if block.settings.image2 %}{{ block.settings.image2 | img_url: 'master' }}{% else %}{{ '280x280.png' | asset_url }}{% endif %}" alt="{{ block.settings.image2.alt }}" />
                      </a>
                      <a class="no-effect instagram-icon" href="{{ block.settings.link2 }}"><em class="sli sli-social-instagram"></em></a>
                    </div>                                   
                  </div>
                  <div class="right-bottom-area">
                    <div class="instagram-item effect-{{section.settings.effect}} effect">
                      <a class="instagram-photo" href="{{ block.settings.link3 }}" title="">                
                        <img class="width-100" src="{% if block.settings.image3 %}{{ block.settings.image3 | img_url: 'master' }}{% else %}{{ '280x280.png' | asset_url }}{% endif %}" alt="{{ block.settings.image3.alt }}" />
                      </a>
                      <a class="no-effect instagram-icon" href="{{ block.settings.link3 }}"><em class="sli sli-social-instagram"></em></a>
                    </div>                                    
                  </div>
                </div>
              </div>  
            </div>
            {% endfor %}
          </div>
          {% endif %}
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div> 

