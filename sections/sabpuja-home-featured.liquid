          <p class="sp2026-featured__copy">{{ 'sabpuja_custom.auto.s010' | t }}</p>
          <a class="sp2026-featured__cta" href="{{ all_products['navratri-puja-kit'].url }}">{{ 'sabpuja_custom.auto.s095' | t }}</a>
