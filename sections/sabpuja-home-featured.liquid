{{ 'sabpuja-home-featured.css' | asset_url | stylesheet_tag }}

<section class="sp2026-featured" aria-labelledby="sp2026-featured-title-{{ section.id }}">
  <div class="sp2026-featured__inner">
    <div class="sp2026-featured__head">
      <div>
        <p class="sp2026-featured__eyebrow">{{ 'sabpuja_custom.auto.s219' | t }}</p>
        <h2 class="sp2026-featured__title" id="sp2026-featured-title-{{ section.id }}">{{ 'sabpuja_custom.auto.s097' | t }}</h2>
      </div>
      <p class="sp2026-featured__intro">{{ 'sabpuja_custom.auto.s102' | t }}</p>
    </div>

    <div class="sp2026-featured__grid">
      <article class="sp2026-featured__card">
        <a class="sp2026-featured__media" href="{{ all_products['navratri-puja-kit'].url }}" aria-label="Explore the Navratri Puja Kit">
