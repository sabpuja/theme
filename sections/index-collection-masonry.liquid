{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="products" data-section-name="index-collection-masonry">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content"> 
        <div class="index-collection-masonry-container box border-none">
        {%- if section.settings.title != blank -%}
        <div class="box-divider">
          {%- if section.settings.title != blank -%}
          <h2 class="box-title">{{ section.settings.title }}</h2>
          {%- endif -%}
        </div>
        {%- endif -%}
        <div class="box-content">
          {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
          {% if block.type == 'type1' %}
          <div class="grid-row row-index{{ forloop.index }} row-{{block.type}} grid-x grid-margin-x">
            <div class="product-long product-item cell small-12 medium-12 large-12 xlarge-6">
              {% assign product = all_products[block.settings.product1] %}
              <div class="product-image">
                <a href="{{ product.url }}">
                  {% if block.settings.image1 %}
                  <img src="{{ block.settings.image1 | img_url: 'master' }}" alt="{{ block.settings.image1.alt }}" />
                  {% else %}
                  <img src="{{ '720x430.png' | asset_url }}" alt="{{ block.settings.image1.alt }}" />
                  {% endif %}
                </a>
              </div>           
              {% include 'index-product-info' %} 
            </div>
            <div class="product-small product-item cell small-6 medium-6 large-6 xlarge-3">
              {% assign product = all_products[block.settings.product2] %}
              <div class="product-image">
                <a href="{{ product.url }}">
                  {% if block.settings.image2 %}
                  <img src="{{ block.settings.image2 | img_url: 'master' }}" alt="{{ block.settings.image2.alt }}" />
                  {% else %}
