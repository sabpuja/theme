{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banners-links3">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="banners-content box-content grid-x">          
          <div class="allcoll-area cell small-12 medium-6 large-4 xlarge-3">
            <div class="allcoll-area-group">
                <div class="allcoll-title">{{ section.settings.title }}</div>
                <div class="allcoll-content">
                  <ul class="allcoll-list no-bullet margin-0">
                    {% for l in linklists[section.settings.linklist].links %}
                    <li class="allcoll-element"><a href="{{ l.url }}">{{ l.title }}</a></li>
                    {% endfor %}
                  </ul>
                </div>
            </div>            
          </div>
          <div class="allcoll-area-right cell small-12 medium-6 large-8 xlarge-9">
            {% if section.blocks.size > 0 %}
            <div class="grid-x grid-margin-x grid-margin-y">
              {%- for block in section.blocks -%}
              <div class="gallery-element effect-{{section.settings.effect}} effect cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }} xxlarge-{{ block.settings.column_xxlarge }} xxxlarge-{{ block.settings.column_xxxlarge }}"> 
                <div class="banner-image">
                  <a href="{{ block.settings.link }}" title="" class="effect-parent">                
                    <img class="" src="{% if block.settings.image %}{{ block.settings.image | img_url: 'master' }}{% else %}{{ '545x280.png' | asset_url }}{% endif %}" alt="{{ block.settings.image.alt }}" />
                  </a>
                </div>  
              </div>
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


