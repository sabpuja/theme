<section class="sp2026-support sp2026-support__section" aria-labelledby="sp2026-festival-title-{{ section.id }}">
  <div class="sp2026-support__inner">
    <div class="sp2026-support__head">
      <div>
        <p class="sp2026-support__eyebrow">{{ 'sabpuja_custom.auto.s269' | t }}</p>
        <h2 class="sp2026-support__title" id="sp2026-festival-title-{{ section.id }}">{{ 'sabpuja_custom.auto.s183' | t }}</h2>
      </div>
      <p class="sp2026-support__intro">{{ 'sabpuja_custom.auto.s173' | t }}</p>
    </div>

    <div class="sp2026-festival__grid">
      <article class="sp2026-festival__card">
        <a class="sp2026-festival__media" href="{{ routes.all_products_collection_url }}" aria-label="Explore Navratri puja essentials">
          <img src="{{ 'sabpuja-upcoming-festivals-navratri-01.webp' | asset_url }}" width="1672" height="941" loading="lazy" decoding="async" alt="Sabpuja Navratri preparation with Goddess Durga, puja thali, kalash and festive decor.">
        </a>
        <div class="sp2026-festival__body">
          <h3 class="sp2026-festival__name">{{ 'sabpuja_custom.auto.s145' | t }}</h3>
          <p class="sp2026-festival__copy">{{ 'sabpuja_custom.auto.s155' | t }}</p>
          <a class="sp2026-festival__cta" href="{{ routes.all_products_collection_url }}">{{ 'sabpuja_custom.auto.s091' | t }}</a>
        </div>
      </article>

      <article class="sp2026-festival__card">
        <a class="sp2026-festival__media" href="{{ routes.all_products_collection_url }}" aria-label="Explore Dussehra puja essentials">
          <img src="{{ 'sabpuja-upcoming-festivals-dussehra-01.webp' | asset_url }}" width="1672" height="941" loading="lazy" decoding="async" alt="Sabpuja Dussehra celebration with bow and arrow, festive puja offerings and a Ravan effigy in the distance.">
        </a>
        <div class="sp2026-festival__body">
          <h3 class="sp2026-festival__name">{{ 'sabpuja_custom.auto.s082' | t }}</h3>
          <p class="sp2026-festival__copy">{{ 'sabpuja_custom.auto.s142' | t }}</p>
          <a class="sp2026-festival__cta" href="{{ routes.all_products_collection_url }}">{{ 'sabpuja_custom.auto.s091' | t }}</a>
        </div>
      </article>

      <article class="sp2026-festival__card">
        <a class="sp2026-festival__media" href="{{ routes.all_products_collection_url }}" aria-label="Explore Diwali puja essentials">
          <img src="{{ 'sabpuja-upcoming-festivals-diwali-01.webp' | asset_url }}" width="1672" height="941" loading="lazy" decoding="async" alt="Sabpuja Diwali puja preparation with diyas, Lakshmi and Ganesha idols, puja essentials and festive floral decor.">
        </a>
        <div class="sp2026-festival__body">
          <h3 class="sp2026-festival__name">{{ 'sabpuja_custom.auto.s079' | t }}</h3>
          <p class="sp2026-festival__copy">{{ 'sabpuja_custom.auto.s280' | t }}</p>
          <a class="sp2026-festival__cta" href="{{ routes.all_products_collection_url }}">{{ 'sabpuja_custom.auto.s091' | t }}</a>
        </div>
      </article>
    </div>
  </div>
</section>

