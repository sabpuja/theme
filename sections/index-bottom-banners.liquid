{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="none" data-section-name="index-bottom-banners">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    <div class="grid-container">
      <div class="section-content">
        <div class="box border-none index-banner-grid-container">
          <div class="box-content">
            {%- if section.blocks.size > 0 -%}
            <div class="index-banner-grid-list grid-x grid-margin-x align-center">
              {%- for block in section.blocks -%}
              <div class="cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }} xxlarge-{{ block.settings.column_xxlarge }} xxxlarge-{{ block.settings.column_xxxlarge }} text-center">
                <div class="index-banner-grid-item effect-{{section.settings.effect}} effect">
                  {%- unless block.settings.image == blank -%}
                  <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image | img_url: image_size }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                  </a>
                  {% else %}
                  <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">
                    {% if forloop.index == 2 %}
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '720x345.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                    {% else %}
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '345x345.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                    {% endif %}
                  </a>
                  {%- endunless -%}
                  {%- if block.settings.action_text != blank -%}
                  <a href="{{ block.settings.link }}" class="no-effect button index-banner-grid-button">{{ block.settings.action_text }}</a>
                  {%- endif -%}
                </div>
              </div>
              {%- endfor -%}
            </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


