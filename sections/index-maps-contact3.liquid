{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-maps-contact3">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none index-text-banner-grid-container">
          <div class="box-content">            
            <div class="grid-x contact-text">
              <div class="left-box cell xlarge-3 large-6 medium-6 small-12">
                <div class="contact-title">{{ section.settings.title1 }}</div>                  
                <div class="contact-line1 contact-line">
                  <div class="title">{{ section.settings.line1title }}</div>
                  <div class="time">{{ section.settings.line1time }}</div>
                  <div class="time">{{ section.settings.line1time2 }}</div>
                </div>
                <div class="contact-line2 contact-line">
                  <div class="text">{{ section.settings.line2title }}</div>
                  <div class="address">{{ section.settings.line2address }}</div>
                  <div class="phone">{{ section.settings.line2phone }}</div>
                  <div class="direction btn"><a href="{{ section.settings.directionlink }}"><em class="sli sli-location-pin"></em>{{ section.settings.direction }}</a></div>
                </div>
              </div>             
              <div class="right-box cell xlarge-3 large-6 medium-6 small-12 effect-{{section.settings.effect}} effect">
                {% if section.settings.banner %}<a href="{{ section.settings.bannerlink }}"><img src="{{ section.settings.banner | img_url: 'master'}}" alt="{{ section.settings.banner.alt }}" /></a>{% endif %}
              </div>
              <div class="middle-box cell xlarge-6 large-12 small-12">
                {{ section.settings.map }}
              </div>
            </div>                          
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

  
