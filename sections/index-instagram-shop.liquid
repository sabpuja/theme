{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-instagram-shop">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{ section.settings.bkgcolor }};">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content" data-index-banner-item-products>         
        <div class="index-instagram-container box border-none">
          {%- if section.settings.title != blank or section.settings.user != blank -%}
          <div class="box-divider grid-x">
            {%- if section.settings.title != blank -%}
            <h2 class="box-title width-100" style="font-size:{{ section.settings.titlesize }}px; color:{{ section.settings.color }}; font-weight:{{ section.settings.title_weight}};">{{ section.settings.title }}</h2>
            {%- endif -%}
            {%- if section.settings.desc != blank -%}
            <p class="box-desc width-100"style="color:{{ section.settings.color }}; ">{{ section.settings.desc }}</p>
            {%- endif -%}
          </div>
          {%- endif -%}
          <div class="box-content">
            <div class="index-instagram-content">
              {%- if section.blocks.size > 0 -%}
              <div class="index-banner-item-products-list grid-x align-center">
                {%- for block in section.blocks -%}
                {%- if block.type == 'banner' -%}
                {% assign title_block = block.settings.title %}
                <div data-item-products-content class="cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }} xxlarge-{{ block.settings.column_xxlarge }} xxxlarge-{{ block.settings.column_xxxlarge }} text-center">
                  <div class="item-banner-background">
                    {%- unless block.settings.image == blank -%}
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                    {%- else -%}
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '320x320.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                    {%- endunless -%}
                    {%- for block in section.blocks -%}
                    {%- if block.type == 'product' -%}
                    {%- if block.settings.title == title_block -%}
                    {%- assign product = all_products[block.settings.item_product] -%}
                    {%- if product.handle != blank -%}
                    <div class="item-products-content" data-item-products-handle="{{ product.handle }}" data-item-top="{{ block.settings.title_y }}" data-item-left="{{ block.settings.title_x }}" style="top: {{ block.settings.title_y }}%;left:{{ block.settings.title_x }}%">
                      <span class="item-products-icon" data-item-products-icon></span>
                    </div>
                    {%- endif -%}
                    {%- endif -%}
                    {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {% if block.settings.title != '' %}
                  <a href="{{ block.settings.url }}" target="_blank" class="instagram-user">{{ block.settings.title }}</a>
                  {% endif %}

                  
                </div>
                {%- endif-%}
                {%- endfor -%}
              </div>
              <div class="item-products-popup-content" data-item-popup-width="310" data-item-products-popup-content></div>
              <div class="item-products-popup-close" data-item-products-popup-close></div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
      {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>
