{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-instagram" class="{% if section.settings.dark %}dark-mode{% else %}normal-mode{% endif %}">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" {% if section.settings.dark %}style="background-color:{{ section.settings.colorbkg }}; border-top:1px solid {{ section.settings.colorbkg }}; border-bottom:1px solid {{ section.settings.colorbkg }};"{% endif %}>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content {% if section.settings.container %}new-style{% endif %}">
        <div class="box border-none position-{{ section.settings.title_position }}">
          <div class="box-divider-heading">
            <div class="box-divider grid-x">
              {% if section.settings.img-left %}<span class="img-left"><img src="{{ section.settings.img-left | img_url: 'master' }}" /></span>{% endif %}
              {%- if section.settings.title != blank -%}
              <h2 class="box-title" style="font-size:{{ section.settings.titlesize }}px;">{{ section.settings.title }}</h2>
              {% if section.settings.img-right %}<span class="img-right"><img src="{{ section.settings.img-right | img_url: 'master' }}" /></span>{% endif %}
              {%- endif -%}
            </div>
            {% if section.settings.desc != '' %}<div class="desc">{{ section.settings.desc }}</div>{% endif %}
          </div>
          <div class="box-content index-instagram-content">
            <div class="instafeed-photos align-center grid-x small-up-{{ section.settings.column_small }} medium-up-{{ section.settings.column_medium }} large-up-{{ section.settings.column_large }} xlarge-up-{{ section.settings.column_xlarge }} xxlarge-up-{{ section.settings.column_xxlarge }} xxxlarge-up-{{ section.settings.column_xxxlarge }}">  
              {% for block in section.blocks %}
              {% if block.settings.photo %}<div class="cell">
                <div class="effect-{{section.settings.effect}} effect">
                  <a href="{{ block.settings.photo }}" title=""><img src="{{ block.settings.photo2 | img_url: 'master' }}" alt="{{ block.settings.photo2.alt }}"/></a>
                </div>              
              </div>{% endif %}
              {% endfor %}
            </div>
          </div>
          {% if section.settings.viewmore != '' %}
          <div class="viewmore">
            <a href="{{ section.settings.viewmorelink }}">{{ section.settings.viewmore }}</a>
          </div>
          {% endif %}
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

