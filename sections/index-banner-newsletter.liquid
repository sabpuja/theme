{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banner-newsletter">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="banners-content">
          {% if section.blocks.size > 0 %}
          <div class="grid-x {% if section.settings.padding %}grid-margin-x{% else %}no-padding{% endif %}">
            {%- for block in section.blocks -%}
            {% if block.type == 'image' %}
            <div class="banner-element cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }} xxlarge-{{ block.settings.column_xxlarge }} xxxlarge-{{ block.settings.column_xxxlarge }}"> 
              <div class="banner-image effect-{{section.settings.effect}} effect">
                <a href="{{ block.settings.link }}" title="">                
                  <img class="width-100" src="{% if block.settings.image %}{{ block.settings.image | img_url: 'master' }}{% else %}{{ '970x470.png' | asset_url }}{% endif %}" alt="{{ block.settings.image.alt }}" />
                </a>
              </div>  
            </div>
            {% else %}
            <div class="newsletter-element cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }} xxlarge-{{ block.settings.column_xxlarge }} xxxlarge-{{ block.settings.column_xxxlarge }}" style="background-image:url({% if block.settings.newsletter_bg %}{{ block.settings.newsletter_bg | img_url: 'master'}}{% endif %})"> 
              {%- if block.settings.newsletter_title != blank -%}
              <h3 class="index-newsletter-title">
                {{ block.settings.newsletter_title }}
              </h3>
              {%- endif -%}
              {% if block.settings.newsletter_desc != '' %}
              <div class="index-newsletter-desc">{{ block.settings.newsletter_desc }}</div>
              {% endif %}
              <form action="{{ block.settings.newsletter_action }}" method="post" target="_blank">
                <input type="email" class="newsletter-field" name="EMAIL" placeholder="{{ block.settings.newsletter_placeholder }}" />
                <button type="submit" class="button newsletter-button display-block" name="subsrcibe">
                  {{ block.settings.newsletter_actiontext }}
                </button>
              </form> 
              {% if block.settings.newsletter_more != '' %}
              <div class="index-newsletter-more">{{ block.settings.newsletter_more }}</div>
              {% endif %}
            </div>
            {% endif %}
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

