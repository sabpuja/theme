{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="products" data-section-name="index-collection-tab-grid" class="{% if section.settings.dark %}dark-mode{% else %}normal-mode{% endif %}">
  <div class="spacing-{{ section.id }} {{ section.settings.display }}" style="background-color:{{section.settings.color2}}; {% if section.settings.bkg %}background-image:url({{ section.settings.bkg | img_url: 'master' }}){% endif %};">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">    
        <div class="index-collection-tab-grid-container box border-none position-{{ section.settings.title_position }}">
        <div class="box-content grid-x">
          {% if section.blocks.size > 0 %}
          <div class="title-tablist-collection">
            <div class="box-divider {% if section.settings.img-left or section.settings.img-right %}grid-x position-1{% endif %}">
              {% if section.settings.img-left %}<span class="img-left"><img src="{{ section.settings.img-left | img_url: 'master' }}" /></span>{% endif %}
              {%- if section.settings.title != blank -%}
              <h2 class="box-title" style="font-size:{{ section.settings.titlesize }}px; color:{{ section.settings.color }}; font-weight:{{ section.settings.title_weight}};">{{ section.settings.title }}</h2>
              {% if section.settings.img-right %}<span class="img-right"><img src="{{ section.settings.img-right | img_url: 'master' }}" /></span>{% endif %}
              {%- endif -%}
              {% if section.settings.desc != '' %}
              <div class="box-desc">{{ section.settings.desc }}</div>
              {% endif %}
            </div>
            <ul  id="index-collection-tab-{{ section.id }}" class="index-collection-tab-tab grid-x align-center-middle no-bullet tab-title-{% if section.settings.tabdirection == 'rtl' %}rtl{% else %}ltr{% endif %}" data-tabs>
              {% for block in section.blocks %}
              <li class="tabs-title index-collection-tab-title {% if forloop.first == true %}is-active{% endif %} {% if section.settings.title == blank %}index-collection-tab-title-nomarl{% endif %}">
                <a href="#product-{{ section.id }}-{{forloop.index}}" class="padding-0" style="font-size:{{ block.settings.font_size }}px">{{ block.settings.title }}</a>
              </li>
              {% endfor %}
            </ul>
          </div>
          <div class="index-collection-tab-content" data-tabs-content="index-collection-tab-{{ section.id }}" style="width: 100%;">
            {%- if  section.settings.image_width and section.settings.image_height -%}
            {%- assign product_image_size = section.settings.image_width | append: 'x' | append: section.settings.image_height -%}
            {%- elsif section.settings.image_width -%}
            {%- assign product_image_size = section.settings.image_width | append: 'x' -%}
            {%- elsif section.settings.image_height -%}
            {%- assign product_image_size = 'x' | append: section.settings.image_height -%}
            {%- else -%}
            {%- assign product_image_size = 'master' -%}
            {%- endif -%}
            {% for block in section.blocks %}
            <div class="tabs-panel padding-0 index-collection-tab-panel {% if forloop.first == true %}is-active{% endif %}" id="product-{{ section.id }}-{{forloop.index}}">                
              <div class="grid-x grid-margin-x grid-margin-y">
                {% for product in collections[block.settings.collection].products limit: block.settings.limit %}
                <div class="cell small-{{ section.settings.column_small }} medium-{{ section.settings.column_medium }} large-{{ section.settings.column_large }} xlarge-{{ section.settings.column_xlarge }} xxlarge-{{ section.settings.column_xxlarge }} xxxlarge-{{ section.settings.column_xxxlarge }}">
                  <div class="product-grid">
                    {% include 'index-product-item' %}
                  </div>  
                </div>
                {% else %}
                {% for i in (1..block.settings.limit) %}
                  {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                  <div class="cell small-{{ section.settings.column_small }} medium-{{ section.settings.column_medium }} large-{{ section.settings.column_large }} xlarge-{{ section.settings.column_xlarge }} xxlarge-{{ section.settings.column_xxlarge }} xxxlarge-{{ section.settings.column_xxxlarge }}">
                    <div class="product-grid">
                      <div class="product-item" data-product-item>
                        <div class="product-item-thumb">
                          <a href="javascript:void(0);" class="display-block">
                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                          </a>
                          <div class="group-button top-right">      
                            {%- if settings.product_item_quick_view -%}
                            <a href="javascript:void(0);" class="group-button-quickview group-button-item product-item-button product-item-button-quick-view" title="{{ 'general.button.quick_view' | t }}"><em class="sli sli-magnifier"></em>
                            </a>
                            {%- endif -%}
                            {%- if settings.product_item_wishlist -%}
                            <div class="group-button-wishlist group-button-item product-item-button-wishlist">
                              <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                              <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                            </div>
                            {%- endif -%}
                            {%- if settings.product_item_compare -%}
                            <div class="group-button-compare group-button-item product-item-button product-item-button-compare">
                              <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                              <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>        
                            </div>
                            {%- endif -%}
                          </div>

                          <div class="cart-button bottom-center">
                            <div class="product-item-buttons">
                              <a  href="javascript:void(0);" class="product-item-button product-item-button-cart" title="{{ 'general.button.add_to_cart' | t }}"><em class="sli sli-basket"></em> <span>{{ 'general.button.add_to_cart' | t }}</span></a>            
                            </div>
                          </div>
                        </div>
                        <div class="product-item-caption">
                          <div class="product-item-group grid-x">
                            <div class="product-item-title-rating cell small-12 medium-6 large-8 xlarge-8 xxlarge-8 xxxlarge-9">
                              <h4 class="product-item-title">
                                <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                              </h4>  
                            </div>
                            <div class="product-item-price cell small-12 medium-6 large-4 xlarge-4 xxlarge-4 xxxlarge-3">
                              <span class="product-item-price-sale">$99.00</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>      
                  {% endfor %}
                {% endfor %}
              </div>
              {% if section.settings.all != '' %}
              <div class="seeall"><a href="{{ collections[block.settings.collection].url }}">{{ section.settings.all}}</a></div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>  


