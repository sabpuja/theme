{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-contact" class="{% if section.settings.dark %}dark-mode{% else %}normal-mode{% endif %}">
  <div class="index-contact-bg {{ section.settings.display }} spacing-{{ section.id }}" style="{% if section.settings.bkg %}background:url({{ section.settings.bkg | img_url: 'master' }}){% endif %}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
      {% endunless %}
      {% endif %}
        <div class="section-content">
          <div class="box border-none index-text-banner-grid-container">
            <div class="box-content">
              <div class="grid-x index-contact-group contact-position-{{ section.settings.position }}">
                {% if section.settings.position == 'right' and section.settings.banner %}
                <div class="image">
                  <div class="effect-jazz effect">
                    <span class="effect-parent">
                      <img src="{{ section.settings.banner | img_url: 'master' }}" alt="{{ section.settings.banner.alt }}"/>
                    </span>                    
                  </div>                  
                </div>
                {% endif %}
                <div class="contact-area">
                  <div class="contact-title" style="font-size:{{ section.settings.titlesize }}px; color:{{ section.settings.color }}; font-weight:{{ section.settings.title_weight}};">{{ section.settings.title }}</div>
                  {% if section.settings.title2 != '' %}<div class="desc">{{ section.settings.title2 }}</div>{% endif %}
                  {%- form 'contact' -%}
                  {%- if form.posted_successfully? -%}
                  <div class="callout success">
                    {{ 'contact.form.post_success' | t }}
                  </div>
                  {%- endif -%}
                  {%- if form.errors -%}
                  <div class="callout alert">
                    {{ form.errors | default_errors }}
                  </div>
                  {%- endif -%}
                  <div class="grid-x grid-margin-x">
                    <div class="form-group cell large-6">
                      <label class="form-group-label">{{ section.settings.box1 }}</label>
                      <input type="text" name="contact[name]" value="{% if form[name] %}{{ form[name] }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ section.settings.box1 }}" class="form-group-field" />
                    </div>
                    <div class="form-group cell large-6">
                      <label class="form-group-label">{{ section.settings.box2 }}</label>
                      <input type="text" name="contact[name]" value="" placeholder="{{ section.settings.box2 }}" class="form-group-field" />
                    </div>
                    <div class="form-group cell large-6">
                      <label class="form-group-label">{{ section.settings.box3 }}</label>
                      <input type="text" name="contact[phone]" value="" placeholder="{{ section.settings.box3 }}" class="form-group-field" />
                    </div>
                    <div class="form-group{% if form.errors contains 'email' %} has-error{% endif %}  cell large-6">
                      <label class="form-group-label">{{ section.settings.box4 }}</label>
                      <input type="email" name="contact[email]"  autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" placeholder="{{ section.settings.box4 }}" class="form-group-field" />
                    </div>
                    <div class="form-group cell large-12">
                      <label class="form-group-label">{{ section.settings.box5 }}</label>
                      <textarea name="contact[body]" placeholder="{{ section.settings.box5 }}" class="form-group-field">{% if form.body %}{{ form.body }}{% endif %}</textarea>
                      <input type="submit" class="button form-button" value="{{ section.settings.box6 }}"/>
                    </div>

                  </div>
                  {%- endform -%}
                </div>
                {% if section.settings.position == 'left' and section.settings.banner %}
                <div class="image">
                  <div class="effect-jazz effect">
                    <span class="effect-parent">
                      <img src="{{ section.settings.banner | img_url: 'master' }}" alt="{{ section.settings.banner.alt }}"/>
                    </span>
                  </div>                  
                </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% if settings.index_style == '1' or template contains 'page' %}
      {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

  
{% schema %}
{
  "name": "Contact",
  "class": "index-section index-contact",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type":   "checkbox",
      "id":     "dark",
      "label":   "Dark mode",
      "default":   false
    },
	{
      "type": "header",
      "content": "Section Settings"
    },
	{
      "type": "text",
      "id": "title",
      "label": "Title"
    },
	{
      "type":   "range",
      "id":     "titlesize",
      "min":       12,
      "max":       100,
      "step":      1,
      "unit":      "px",
      "label":     "Font size",
      "default":   30
    },
	{
      "type": "color",
      "id": "color",
      "label": "Color",
	  "default":"#000"
    },
	{
      "type": "select",
      "id": "title_weight",
      "label": "Title Font Weight",
      "options": [
		{
          "value": "100",
          "label": "200"
        },
		{
          "value": "200",
          "label": "200"
        },
        {
          "value": "300",
          "label": "300"
        },
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        },
        {
          "value": "800",
          "label": "800"
        },
        {
          "value": "900",
          "label": "900"
        }
      ],
      "default": "600"
    },
	{
      "type": "text",
      "id": "title2",
      "label": "Description"
    },
	{
      "type": "text",
      "id": "box1",
      "label": "First Name",
	  "default":"Your First Name"
    },
	{
      "type": "text",
      "id": "box2",
      "label": "Last Name",
	  "default":"Your Last Name"
    },
	{
      "type": "text",
      "id": "box3",
      "label": "Phone",
	  "default":"Your Phone"
    },
	{
      "type": "text",
      "id": "box4",
      "label": "Email",
	  "default":"Your Email"
    },
	{
      "type": "text",
      "id": "box5",
      "label": "Message",
	  "default":"Message"
    },
	{
      "type": "text",
      "id": "box6",
      "label": "Submit",
	  "default":"Book Now!"
    },
	{
      "type": "select",
      "id": "position",
      "label": "Contact box position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
	{
      "type": "image_picker",
      "id": "banner",
      "label": "Image"
    },
	{
      "type": "image_picker",
      "id": "bkg",
      "label": "Image Background"
    }
  ],  
  "presets": [
    {
      "name": "Contact",
      "category": "Advanced"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}