{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" {% if section.settings.active_bkg %}class="active-bkg"{% endif %} data-section-type="products" data-section-name="index-collection-grid-random">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.bkg}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content"> 
        <div class="index-collection-grid-container box border-none position-{{ section.settings.title_position }}">
        {%- if section.settings.title != blank or section.settings.sub_title != blank -%}
        <div class="box-divider grid-x position-{{ section.settings.more_position }}">
          {% if section.settings.img-left %}<span class="img-left"><img src="{{ section.settings.img-left | img_url: 'master' }}" /></span>{% endif %}
          {%- if section.settings.title != blank -%}
          <h2 class="box-title width-100" style="font-size: {{ section.settings.titlesize}}px;">
            {{ section.settings.title }}
          </h2>
          {% if section.settings.img-right %}<span class="img-right"><img src="{{ section.settings.img-right | img_url: 'master' }}" /></span>{% endif %}
          {%- endif -%}
          {% if section.settings.more != '' %}
            <div class="more-text">
              <a href="{{ collections[section.settings.collectionmore].url }}">{{ section.settings.more }} <em class="sli sli-arrow-right"></em></a>
            </div>
          {% endif %}
        </div>
        {%- endif -%}
        <div class="box-content">        
          <div class="products-area">
            <div class="product-grid-random-load" data-product-grid-random-load>
              <img src="{{ 'icon-loader-clock.svg' | asset_url }}" alt="Load">
            </div>
            <div class="product-grid-random group-right grid-x" data-product-grid-random>
              {% for product in collections[section.settings.collection].products limit: section.settings.limit %}
              <div class="shuffle-element product-grid cell small-{{ section.settings.column_small }} medium-{{ section.settings.column_medium }} large-{{ section.settings.column_large }} xlarge-{{ section.settings.column_xlarge }} xxlarge-{{ section.settings.column_xxlarge }} xxxlarge-{{ section.settings.column_xxxlarge }}">
                {% include 'index-product-item' %} 
              </div>
              {% else %}
              {% for i in (2..9) %}
              {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
              <div class="shuffle-element product-grid cell small-{{ section.settings.column_small }} medium-{{ section.settings.column_medium }} large-{{ section.settings.column_large }} xlarge-{{ section.settings.column_xlarge }} xxlarge-{{ section.settings.column_xxlarge }} xxxlarge-{{ section.settings.column_xxxlarge }}">
                <div class="product-item" data-product-item>
                  <div class="product-item-thumb">
                    <a href="javascript:void(0);" class="display-block">
                      {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                    </a>                          
                  </div>
                  <div class="product-item-caption">
                    <div class="grid-x">
                      <div class="cell auto">
                        <h4 class="product-item-title">
                          <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                        </h4>
                      </div>
                    </div>
                    <div class="product-item-price">
                      <span class="product-item-price-sale">$99.00</span>
                    </div>
                  </div>
                </div>
              </div>
              {% endfor %}
              {% endfor %}
            </div>        
          </div>
        </div>
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>  
  

