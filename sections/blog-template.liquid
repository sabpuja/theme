<!-- /sections/blog-template.liquid -->
{% include 'blog-template' %}

{% schema %}
{
  "name": "Blog pages",
  "class": "blog",
  "max_blocks": 30,
  "settings": [
    {
      "type": "number",
      "id": "limit",
      "label": "Pagination limit",
      "default": 12
    },
    {
      "type": "number",
      "id": "image_width",
      "label": "Image Width",
      "info": "Must be set a non-zero number",
      "default": 450
    },
    {
      "type": "number",
      "id": "image_height",
      "label": "Image Height",
      "info": "Must be set a non-zero number",
      "default": 281
    }
  ],
  "blocks": [
    {
      "name": "Custom Menu",
      "type": "blog-link-list",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Section Name",
          "info": "Name this section, it will help to control the section more easily."
        },
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            {
              "value": "top_container",
              "label": "Top Container"
            },
            {
              "value": "top_content",
              "label": "Top Content"
            },
            {
              "value": "left_sidebar",
              "label": "Left Sidebar"
            },
            {
              "value": "right_sidebar",
              "label": "Right Sidebar"
            },
            {
              "value": "bottom_content",
              "label": "Bottom Content"
            },
            {
              "value": "bottom_container",
              "label": "Bottom Container"
            }
          ]
        },
        {
          "type": "select",
          "id": "display",
          "label": "Display on",
          "options": [
            {
              "value": "",
              "label": "Desktop & Mobile"
            },
            {
              "value": "show-for-large",
              "label": "Desktop only"
            },
            {
              "value": "hide-for-large",
              "label": "Mobile only"
            }
          ],
          "default": ""
        },
        {
          "type": "link_list",
          "id": "link_list",
          "label": "Link List"
        }
