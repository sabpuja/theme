{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-testimonial-banner">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">  
        <div class="index-testimonial-banner-container">
        <div class="box border-none">
          {% if section.settings.title != blank -%}
          <div class="box-divider grid-x">
            <div class="box-title width-100">{{ section.settings.title }}</div>
          </div>
          {% endif%}
          {% if section.blocks.size > 0 %}
          <div class="box-content">
            <div class="grid-x {% if section.settings.padding %}grid-margin-x{% else %}no-padding{% endif %}">
              {% for block in section.blocks %}
              {% if block.type == 'testimonial' %}
              <div class="index-testimonial-content layout-{{ block.settings.layout }} cell large-{{ block.settings.grid }}" style="background-color:{{ section.settings.color }}">
                <div class="carousel" data-carousel-param='{"effect": "{{ section.settings.effect }}", "autoplay": "{{ section.settings.autoplay }}", "autoplaySpeed": "{{ section.settings.autoplay_speed }}", "space": "0", "column_small": "1", "column_medium": "1", "column_large": "1", "column_xlarge": "1", "column_xxlarge": "1", "column_xxxlarge": "1", "row": "1"}' data-carousel>
                  <div class="carousel-wrapper carousel-nav-middle">
                    <div class="swiper-container" data-carousel-container>
                      <div class="swiper-wrapper grid-margin-x small-up-1 medium-up-1 large-up-1 xlarge-up-1 xxlarge-up-1 xxxlarge-up-1">
                        {% assign count = block.settings.rating %}
                        {% for i in (1..count) %}
                        {% capture avatar %}avatar{{i}}{% endcapture %}
                        {% capture name %}name{{i}}{% endcapture %}
                        {% capture job %}job{{i}}{% endcapture %}
                        {% capture review %}review{{i}}{% endcapture %}                                                      
                        <div class="swiper-slide cell" data-carousel-item>
                          <div class="avatar">
                            {% if block.settings[avatar] %}
                            <img src="{{ block.settings[avatar] | img_url: 'master' }}" alt="{{ block.settings[avatar].alt }}" />
                            {% else %}
                            <img src="{{ '105x105.png' | asset_url }}" alt="{{ block.settings[avatar].alt }}" />
                            {% endif %}
                          </div>
                          <div class="info">
                            <div class="name-job"><div class="name">{{ block.settings[name] }}</div> 
                              <span class="space-block">/</span>
                              <div class="job">{{ block.settings[job] }}</div></div>
                            <span></span>
                            <div class="review">{{ block.settings[review] }}</div>
                          </div>
                        </div>
                        {% endfor %}
                      </div>
                    </div>
                    {%- if section.settings.navigation -%}
                    <!-- If we need navigation buttons -->
                    <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                    <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                    {%- endif -%}
                    {%- if section.settings.pagination -%}
                    <!-- If we need pagination -->
                    <div class="carousel-pagination" data-carousel-pagination></div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
              {% endif %}
              {% if block.type == 'banner' %}
              <div class="index-banner-content cell large-{{ block.settings.grid }}">
                <div class="box-banner">
                  <div class="imgbkg effect-{{section.settings.effect1}} effect">
                    {%- unless block.settings.image == blank -%}
                    <a href="{{ block.settings.url }}" class="index-banner-grid-image display-block">
                      <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                    </a>
                    {% else %}
                    <a href="{{ block.settings.url }}" class="index-banner-grid-image display-block">
                      <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '785x250.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                    </a>
                    {%- endunless -%}
                  </div>
                </div>
              </div>
              {% endif %}
              {% endfor %}
            </div>
          </div>
          {% endif %}
        </div>
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


