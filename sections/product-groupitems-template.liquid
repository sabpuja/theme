<!-- /sections/product-template.liquid -->
{%- include 'amp-detector' -%}
{%- unless googleamp-%}
  {%- include 'product-template-groupitems' -%}
{%- else -%}
  {%- include 'amp-product-template' -%}
{%- endunless -%}
{% schema %}
{
  "name": "Product pages",
  "class": "product",
  "max_blocks": 30,
  "settings": [
	{
      "type": "header",
      "content": "Product Image Settings"
    },
    {
      "type": "number",
      "id": "image_width",
      "label": "Image Width",
      "info": "Must be set a non-zero number",
      "default": 800
    },
    {
      "type": "number",
      "id": "image_height",
      "label": "Image Height",
      "info": "Must be set a non-zero number",
      "default": 1026
    },
	{
      "type": "header",
      "content": "Random Visitor"
    },
	{
      "type": "checkbox",
      "id": "show_visitor",
      "label": "Show Random Visitor",
      "default": true
    },
	{
      "type": "range",
      "id": "visitormin",
      "min": 1,
      "max": 50,
      "step": 1,
      "label": "Random Visitor minimun",
      "default": 30
    },
	{
      "type": "range",
      "id": "visitormax",
      "min": 1,
      "max": 100,
      "step": 1,
      "label": "Random Visitor maximun",
      "default": 100
    },
	{
      "type": "header",
      "content": "Random Stock"
    },	
	{
      "type": "checkbox",
      "id": "show_randomstock",
      "label": "Show Random Stock",
      "default": true
    },
	{
      "type": "range",
      "id": "randomstockmin",
      "min": 1,
      "max": 50,
      "step": 1,
      "label": "Random Stock minimun",
      "default": 10
    },
	{
      "type": "range",
      "id": "randomstockmax",
      "min": 1,
      "max": 50,
      "step": 1,
      "label": "Random Stock maximun",
      "default": 30
    },
	{
      "type": "header",
      "content": "Timer Bar"
    },
	{
      "type": "checkbox",
      "id": "show_countdowntimer",
      "label": "Show Countdown Timer",
      "default": true
    },
	{
      "type": "text",
      "id": "ct_title",
      "label": "Deal Title",
      "default": "Offer Ends in:"
    },
	{
      "type": "text",
      "id": "ct_timer",
      "label": "Deal Time",
      "default": "2018-11-25 22:11:00",
	  "info":"Syntax YYYY/MM/DD HH:MM:SS"
    },
	{
      "type": "header",
      "content": "Earn Reward Points"
    },
	{
      "type": "checkbox",
      "id": "show_earnpoints",
      "label": "Show Earn Reward Points",
      "default": true,
	  "info":"You need install the Apps to use it, we only use simple syntax!"
    },
	{
      "type": "textarea",
      "id": "earnpointsurl",
      "label": "Earn Reward Points Content"
    },		
	{
      "type": "header",
      "content": "Group Products"
    },
	{
      "type": "checkbox",
      "id": "show_bundle",
      "label": "Show Bundle",
      "default": true
    },
	{
      "type": "header",
      "content": "Shipping Information"
    },
	{
      "type": "checkbox",
      "id": "show_shipping",
      "label": "Show Shipping Infomration",
      "default": true
    },
	{
      "type": "range",
      "id": "shippingdate",
      "min": 1,
      "max": 20,
      "step": 1,
	  "unit": "d",
      "label": "Shipping Date",
      "default": 5
    },
	{
      "type": "header",
      "content": "Details Area"
    },
	{
      "type": "checkbox",
      "id": "show_details",
      "label": "Show it",
      "default": true
    },
	{
      "type": "text",
      "id": "detail_title",
      "label": "Detail Text",
      "default": "Details"
    },
	{
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": true
    },
	{
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": true
    },
	{
      "type": "checkbox",
      "id": "show_type",
      "label": "Show product Type",
      "default": true
    },	
	{
      "type": "checkbox",
      "id": "show_inventory",
      "label": "Show inventory management",
      "default": true
    },
	{
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product decription",
      "default": true
    },
	{
      "type": "text",
      "id": "desc_title",
      "label": "Description Text",
      "default": "Description"
    },		
	{
      "type": "header",
      "content": "Other Information"
    },
	{
      "type": "checkbox",
      "id": "show_customimage",
      "label": "Show Payment Security",
      "default": true
    },
	{
      "type": "image_picker",
      "id": "customimage",
      "label": "Payment Security Upload"
    },	
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "label": "Show social sharing buttons"
    },	
	{
      "type": "header",
      "content": "Product Review"
    },    
    {
      "type": "checkbox",
      "id": "show_review",
      "label": "Show product review",
      "default": true
    }
  ],
