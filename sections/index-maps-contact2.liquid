{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-maps-contact2">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none index-text-banner-grid-container">
          <div class="box-content">
            <div class="grid-x">
              <div class="cell large-12 contact-text">
                <div class="left-box large-6 small-12">
                  <div class="contact-title">{{ section.settings.title1 }}</div>
                  <div class="contact-line"></div>
                  <div class="contact-line1">
                    <div class="left-text">{{ section.settings.line1title }}</div>
                    <div class="right-text">{{ section.settings.line1time }}</div>
                  </div>
                  <div class="contact-line2">
                    <div class="left-text">{{ section.settings.line2title }}</div>
                    <div class="right-text">{{ section.settings.line2time }}</div>
                  </div>
                </div>
                <div class="right-box large-6 small-12">
                  <div class="contact-title">{{ section.settings.title2 }}</div>
                  <div class="contact-line"></div>
                  <div class="contact-phone">{{ section.settings.phone }}</div>
                  <div class="contact-desc">{{ section.settings.desc }}</div>
                </div>
              </div>
              <div class="cell large-12 maps-area">
                {{ section.settings.map }}
              </div>              
            </div>
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

  
{% schema %}
{
  "name": "Maps & Contact #2",
  "class": "index-section index-maps-contact2",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "header",
      "content": "Left Contact Settings"
    },
	{
      "type": "text",
      "id": "title1",
      "label": "Title"
    },
	{
      "type": "text",
      "id": "line1title",
      "label": "Line#1 Title"
    },
	{
      "type": "text",
      "id": "line1time",
      "label": "Line#1 Time"
    },
	{
      "type": "text",
      "id": "line2title",
      "label": "Line#2 Title"
    },
	{
      "type": "text",
      "id": "line2time",
      "label": "Line#2 Time"
    },
	{
      "type": "header",
      "content": "Right Contact Settings"
    },
	{
      "type": "text",
      "id": "title2",
      "label": "Title"
    },
	{
      "type": "text",
      "id": "phone",
      "label": "Phone Number"
    },
	{
      "type": "textarea",
      "id": "desc",
      "label": "Description"
    },
	{
      "type": "header",
      "content": "Map Settings"
    },
	{
      "type": "textarea",
      "id": "map",
      "label": "Input Maps iframe"
    }
  ],  
  "presets": [
    {
      "name": "Maps & Contact #2",
      "category": "Advanced"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}