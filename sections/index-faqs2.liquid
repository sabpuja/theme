{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-faqs2">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content grid-x">
        <div class="left-banner cell large-4 effect-{{section.settings.effect}} effect">
          <a href="{{ section.settings.link }}" class="">
            <img src="{% if section.settings.banner %}{{ section.settings.banner | img_url: 'master' }}{% else %}{{ '510x575.png' | asset_url }}{% endif %}" alt="{{ section.settings.banner.alt }}"/>
          </a>
        </div>
        <div class="right-faqs cell large-8">
          <h2 class="faqs-title">{{ section.settings.title }}</h2>
          <div class="faqs-desc">{{ section.settings.desc }}</div>
          <div class="faqs-content checkbox-{{ section.settings.style }}">
            {% if section.blocks.size > 0 %}        
            <ul class="accordion" data-responsive-accordion-tabs="accordion" data-multi-expand="true" data-allow-all-closed="true">
              {%- for block in section.blocks -%}
              <li class="accordion-item {% if forloop.index == 1 %}is-active{% endif %}" data-accordion-item>
                <a href="#faq-{{ forloop.index }}" class="accordion-title">{{ block.settings.title }}</a>
                <div id="faq-{{ forloop.index }}" class="accordion-content faq-{{ forloop.index }}" data-tab-content>
                  {{ block.settings.desc }}
                </div>
              </li>
              {% endfor %}          
            </ul>
            {% endif %}
          </div>
          {% if section.settings.active %}
          <div class="faqs-bottom grid-x">
            {% for i in (1..4)%}
              {% capture icon %}info{{i}}icon{% endcapture %}
              {% capture text %}info{{i}}text{% endcapture %}
              {% capture link %}info{{i}}link{% endcapture %}
              {% capture desc %}info{{i}}desc{% endcapture %}
              <div class="bottom-box xlarge-3 large-6 small-6">
                {% if section.settings[icon] %}<div class="box-icon"><a href="{{ section.settings[link] }}"><img src="{{ section.settings[icon] | img_url: 'master' }}" alt="" /></a></div>{% endif %}
                <div class="text"><a href="{{ section.settings[link] }}">{{ section.settings[text] }}</a></div>
                <div class="desc">{{ section.settings[desc] }}</div>
              </div>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

