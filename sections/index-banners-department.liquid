{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banners-department">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background: {{ section.settings.background }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content more-position-{{ section.settings.morepo }}">
        {%- if section.settings.title != blank or section.settings.sub_title != blank -%}
        <div class="box-divider">
          <div class="blog-title position-{{ section.settings.title_position }}">
            {%- if section.settings.title != blank -%}
            <h2 class="box-title width-100" style="font-size:{{ section.settings.titlesize2 }}px; color:{{ section.settings.color3 }}">{{ section.settings.title }}</h2>            
            {%- endif -%}
            {% if section.settings.morepo == 'neartitle' %}
            {% if section.settings.more != '' %}
              <div class="more-text">
                <a href="{{ collections[section.settings.collectionmore].url }}">{{ section.settings.more }} <em class="sli sli-arrow-right"></em></a>
              </div>
            {% endif %}
            {% endif %}
          </div>            
          {% if section.settings.title2 != '' %}<div class="department-sub-title position-{{ section.settings.title_position }}"><span class="desc">{{ section.settings.title2 }}</span></div> {% endif %}        
        </div>
        {%- endif -%}
        <div class="banners-content box-content {% if section.settings.border %}have-border{% endif %} radius-{{section.settings.radius}}">
          {% if section.blocks.size > 0 %}
          <div class="grid-x grid-margin-x grid-margin-y">
            {%- for block in section.blocks -%}
            <div class="gallery-element title-pos-{{block.settings.pos}} cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }} xxlarge-{{ block.settings.column_xxlarge }} xxxlarge-{{ block.settings.column_xxxlarge }}"> 
              {% if block.settings.pos == 'top' %}
                {% if block.settings.title != '' %}
                <div class="banner-caption">
                  {% if block.settings.title %}<a href="{{ block.settings.link }}" style="color:{{section.settings.color}}; font-size:{{ section.settings.titlesize }}px;"> {{ block.settings.title }}</a>{% endif %}              
                </div>
                {% endif %}
              {% endif %}
              <div class="banner-image effect-{{section.settings.effect}} effect">
                <a href="{{ block.settings.link }}" title="">                
                  <img class="" src="{% if block.settings.image %}{{ block.settings.image | img_url: 'master' }}{% else %}{{ '270x270.png' | asset_url }}{% endif %}" alt="{{ block.settings.image.alt }}" />
                </a>
              </div>  
              {% if block.settings.pos == 'bottom' %}
                {% if block.settings.title != '' %}
                <div class="banner-caption postion-{{ section.settings.title_position2 }}">
                  {% if block.settings.title %}<a class="element-title" href="{{ block.settings.link }}" style="color:{{section.settings.color}}; font-size:{{ section.settings.titlesize }}px;"> {{ block.settings.title }}</a>{% endif %}              
                  {% if block.settings.title2 != '' %}
                  <div class="banner-info" style="color:{{section.settings.color}}; font-size:16px;">
                    {{ block.settings.title2 }}             
                  </div>
                  {% endif %}
                </div>
                {% endif %}
                
              {% endif %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
          
          {% if section.settings.morepo == 'bottom' %}
          {% if section.settings.more != '' %}
            <div class="more-text">
              <a href="{{ collections[section.settings.collectionmore].url }}">{{ section.settings.more }}</a>
            </div>
          {% endif %}
          {% endif %}
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


