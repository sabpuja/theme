{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="products" data-section-name="index-collection-grid-custom1">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">  
        <div class="index-collection-grid-container box border-none position-{{ section.settings.title_position }}">
        {%- if section.settings.title != blank or section.settings.sub_title != blank -%}
        <div class="box-divider grid-x">
          {%- if section.settings.title != blank -%}
          <h2 class="box-title width-100">{{ section.settings.title }}</h2>
          {%- endif -%}
        </div>
        {%- endif -%}
        <div class="box-content">        
          {% case section.settings.rightnumber %}
          {% when '4' %}
          {% assign limit = 4 %}
          {% assign grid = 'small-6 medium-6 large-6 xlarge-6' %}
          {% assign gridw1 = 'small-12 medium-6 large-6 xlarge-6' %}
          {% assign gridw2 = 'small-12 medium-6 large-6 xlarge-6' %}
          {% when '6' %}
          {% assign limit = 6 %}
          {% assign grid = 'small-6 medium-6 large-4 xlarge-4' %}
          {% assign gridw1 = 'small-12 medium-6 large-6 xlarge-6' %}
          {% assign gridw2 = 'small-12 medium-6 large-6 xlarge-6' %}
          {% when '8' %}
          {% assign limit = 8 %}
          {% assign grid = 'small-6 medium-6 large-4 xlarge-3 ' %}
          {% assign gridw1 = 'small-12 medium-6 large-4 xlarge-4' %}
          {% assign gridw2 = 'small-12 medium-6 large-8 xlarge-8' %}
          {% endcase %}
          <div class="products-area grid-x grid-margin-x">
            <div class="product-left cell {{gridw1}}">
              {% for product in collections[section.settings.collection].products limit:1 %}
              <div class="product-grid">
                {% include 'index-product-item-slider' %} 
              </div>
              {% else %}
              {% for i in (1..1) %}
              {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
              <div class="product-grid">
                <div class="product-item" data-product-item>
                  <div class="product-item-thumb">
                    <a href="javascript:void(0);" class="display-block">
                      {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                    </a>                          
                  </div>
                  <div class="product-item-caption">
                    <div class="grid-x">
                      <div class="cell auto">
                        <h4 class="product-item-title">
                          <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                        </h4>
                      </div>
                    </div>
                    <div class="product-item-price">
                      <span class="product-item-price-sale">$99.00</span>
                    </div>
                  </div>
                </div>
              </div>
              {% endfor %}
              {% endfor %}
            </div>
            <div class="product-right cell {{gridw2}}">              
              <div class="group-right grid-x grid-margin-x grid-margin-y">
                {% for product in collections[section.settings.collection].products limit:limit offset:1 %}
                <div class="product-grid cell {{ grid }}">
                  {% include 'index-product-item' %} 
                </div>
                {% else %}
                {% for i in (1..limit) %}
                {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                <div class="product-grid cell {{ grid }}">
                  <div class="product-item" data-product-item>
                    <div class="product-item-thumb">
                      <a href="javascript:void(0);" class="display-block">
                        {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                      </a>                          
                    </div>
                    <div class="product-item-caption">
                      <div class="grid-x">
                        <div class="cell auto">
                          <h4 class="product-item-title">
                            <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                          </h4>
                        </div>
                      </div>
                      <div class="product-item-price">
                        <span class="product-item-price-sale">$99.00</span>
                      </div>
                    </div>
                  </div>
                </div>
                {% endfor %}
                {% endfor %}
              </div>
            </div>        
          </div>
        </div>
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>  
  

{% schema %}
{
  "name": "Products Grid & Custom 1",
  "class": "index-section index-collection-grid-custom1",
  "settings": [
	{
      "type": "paragraph",
      "content": "View [Mockup of Section layout](https:\/\/i.imgur.com\/Ey5oOvA.png)"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
	{
      "type": "select",
      "id": "title_position",
      "label": "Title Position",
      "options": [
        {
          "value": "full-left",
          "label": "One Whole - Left"
        },
        {
          "value": "full-center",
          "label": "One Whole - Center"
        },
        {
          "value": "onehalf-left",
          "label": "One Half - Left"
        }
      ],
      "default": "full-left"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
	{
      "type": "select",
      "id": "rightnumber",
      "label": "Number products in right",
      "options": [
        {
          "value": "4",
          "label": "4 Products"
        },
        {
          "value": "6",
          "label": "6 Products"
        },
        {
          "value": "8",
          "label": "8 Products"
        }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "navigation",
      "label": "Enable Navigaiton",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pagination",
      "label": "Enable Pagination",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Products Grid & Custom 1",
      "category": "Products"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}