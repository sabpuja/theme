{{ 'sabpuja-ritual-journey.css' | asset_url | stylesheet_tag }}

{% liquid
  assign variant = section.settings.variant | default: 'four_step'
  assign heading_tag = section.settings.heading_tag | default: 'h2'
%}

<section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | escape }}"{% endif %} class="sp-ritual-journey sp-ritual-journey--{{ variant }} sp-ritual-journey--{{ section.settings.background }} sp-ritual-journey--width-{{ section.settings.width }} sp-ritual-journey--align-{{ section.settings.alignment }}">
  <div class="sp-ritual-journey__inner">
    <header class="sp-ritual-journey__head">
      {% if section.settings.eyebrow != blank %}<p class="sp-ritual-journey__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<{{ heading_tag }} class="sp-ritual-journey__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>{% endif %}
      {% if section.settings.body != blank %}<div class="sp-ritual-journey__body">{{ section.settings.body }}</div>{% endif %}
    </header>

    {% if variant == 'accordion' %}
      <div class="sp-ritual-journey__steps">
        {% for block in section.blocks %}
          <details class="sp-ritual-journey__details"{% if section.settings.open_first and forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              {% if section.settings.show_step_numbers %}<span class="sp-ritual-journey__number" style="counter-reset:none"><span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span></span>{% else %}<span class="sp-ritual-journey__icon">{% render 'sabpuja-icon', name: block.settings.icon %}</span>{% endif %}
              <span class="sp-ritual-journey__details-title">{{ block.settings.title | escape }}</span>
              <span class="sp-ritual-journey__chevron">{% render 'sabpuja-icon', name: 'chevron-down' %}</span>
            </summary>
            {% if block.settings.description != blank %}<div class="sp-ritual-journey__details-body">{{ block.settings.description }}</div>{% endif %}
          </details>
        {% endfor %}
      </div>
    {% else %}
      <ol class="sp-ritual-journey__steps">
        {% for block in section.blocks %}
          <li class="sp-ritual-journey__step" {{ block.shopify_attributes }}>
            <article class="sp-ritual-journey__card">
              <div class="sp-ritual-journey__topline">
                {% if section.settings.show_step_numbers %}<span class="sp-ritual-journey__number" aria-hidden="true"></span>{% else %}<span class="sp-ritual-journey__icon">{% render 'sabpuja-icon', name: block.settings.icon %}</span>{% endif %}
                {% if block.settings.label != blank %}<p class="sp-ritual-journey__label">{{ block.settings.label | escape }}</p>{% endif %}
              </div>
              <h3 class="sp-ritual-journey__title">{{ block.settings.title | escape }}</h3>
              {% if block.settings.description != blank %}<div class="sp-ritual-journey__text">{{ block.settings.description }}</div>{% endif %}
            </article>
          </li>
        {% endfor %}
      </ol>
    {% endif %}

    {% if section.settings.note != blank %}
      <div class="sp-ritual-journey__note"><span aria-hidden="true">{% render 'sabpuja-icon', name: 'info' %}</span><div>{{ section.settings.note }}</div></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Sabpuja Ritual Journey",
  "settings": [
    {"type":"text","id":"anchor_id","label":"Anchor ID"},
    {"type":"select","id":"variant","label":"Layout variant","default":"four_step","options":[{"value":"three_step","label":"Three-step cards"},{"value":"four_step","label":"Four-step cards"},{"value":"horizontal","label":"Horizontal journey"},{"value":"timeline","label":"Numbered timeline"},{"value":"compact","label":"Compact steps"},{"value":"accordion","label":"Disclosure accordion"}]},
    {"type":"select","id":"heading_tag","label":"Heading level","default":"h2","options":[{"value":"h2","label":"H2"},{"value":"h3","label":"H3"}]},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"How to use your kit"},
    {"type":"text","id":"heading","label":"Heading","default":"A simple way to prepare"},
    {"type":"richtext","id":"body","label":"Supporting copy","default":"<p>Use these steps as practical preparation guidance. Exact ritual practice can vary by family, region and sampradaya.</p>"},
    {"type":"checkbox","id":"show_step_numbers","label":"Show step numbers","default":true},
    {"type":"checkbox","id":"open_first","label":"Open first disclosure by default","default":true},
    {"type":"richtext","id":"note","label":"Closing note","default":"<p>Follow your family tradition or priest guidance for the ritual itself.</p>"},
    {"type":"select","id":"alignment","label":"Heading alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}]},
    {"type":"select","id":"background","label":"Section background","default":"ivory","options":[{"value":"white","label":"White"},{"value":"ivory","label":"Ivory"},{"value":"cream","label":"Cream"},{"value":"sacred-brown","label":"Sacred Brown"}]},
    {"type":"select","id":"width","label":"Section width","default":"contained","options":[{"value":"contained","label":"Contained"},{"value":"wide","label":"Wide"},{"value":"full","label":"Full width"}]}
  ],
  "blocks": [
    {"type":"step","name":"Journey step","settings":[
      {"type":"text","id":"label","label":"Small label","default":"Preparation"},
      {"type":"text","id":"title","label":"Step title","default":"Prepare your puja space"},
      {"type":"richtext","id":"description","label":"Step description","default":"<p>Set out the supplied items in a clean, organized area before beginning.</p>"},
      {"type":"select","id":"icon","label":"Icon","default":"sparkles","options":[{"value":"sparkles","label":"Sparkles"},{"value":"package","label":"Package"},{"value":"check","label":"Check"},{"value":"book","label":"Book"},{"value":"home","label":"Home"},{"value":"heart","label":"Heart"},{"value":"info","label":"Info"}]}
    ]}
  ],
  "max_blocks": 8,
  "presets": [{"name":"Sabpuja Ritual Journey","blocks":[
    {"type":"step","settings":{"label":"Prepare","title":"Prepare your puja space","description":"<p>Set out the supplied items in a clean, organized area before beginning.</p>","icon":"home"}},
    {"type":"step","settings":{"label":"Review","title":"Review the kit items","description":"<p>Identify the included items and keep sign-specific or festival-specific pieces easy to find.</p>","icon":"package"}},
    {"type":"step","settings":{"label":"Arrange","title":"Add fresh or family-specific items","description":"<p>Add flowers, fruit, coconut, leaves or other items required by your household tradition.</p>","icon":"sparkles"}},
    {"type":"step","settings":{"label":"Practice","title":"Follow your customary practice","description":"<p>Continue according to your family tradition or priest guidance.</p>","icon":"book"}}
  ]}]
}
{% endschema %}
