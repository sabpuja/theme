{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banners-contact">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none index-banner-grid-container">
          <div class="box-content grid-x">
            <div class="left-banners">
              <div class="left-banners-group">              
                <div class="left-area">
                  <div class="left-top effect-{{section.settings.effect}} effect">
                    <a href="{{ section.settings.banenr1link }}"><img src="{% if section.settings.banner1 %}{{ section.settings.banner1 | img_url: 'master' }}{% else %}{{ '777x375.png' | asset_url }}{% endif %}" alt="{{ section.settings.banner1.alt }}"/></a>
                  </div>
                  <div class="left-bottom">
                    <div class="left-bottom-left effect-{{section.settings.effect}} effect">
                      <a href="{{ section.settings.banenr2link }}"><img src="{% if section.settings.banner2 %}{{ section.settings.banner2 | img_url: 'master' }}{% else %}{{ '375x375.png' | asset_url }}{% endif %}" alt="{{ section.settings.banner2.alt }}"/></a>
                    </div>
                    <div class="left-bottom-right effect-{{section.settings.effect}} effect">
                      <a href="{{ section.settings.banenr3link }}"><img src="{% if section.settings.banner3 %}{{ section.settings.banner3 | img_url: 'master' }}{% else %}{{ '375x375.png' | asset_url }}{% endif %}" alt="{{ section.settings.banner3.alt }}"/></a>
                    </div>
                  </div>
                </div>
                <div class="right-area effect-{{section.settings.effect}} effect">
                  <a href="{{ section.settings.banenr4link }}"><img src="{% if section.settings.banner4 %}{{ section.settings.banner4 | img_url: 'master' }}{% else %}{{ '375x777.png' | asset_url }}{% endif %}" alt="{{ section.settings.banner4.alt }}"/></a>
                </div>
              </div>
            </div>  
            <div class="right-contact" {% if section.settings.bkg %}style="background-image:url({{ section.settings.bkg | img_url: 'master' }});"{% endif %}>
              <div class="info-box">
                <div class="info-box-group">
                  <div class="box-title">
                    {% if section.settings.title != '' %}<div class="title">{{ section.settings.title }}</div>{% endif %}
                    {% if section.settings.icon %}<div class="_icon"><img src="{{ section.settings.icon | img_url: 'master' }}"/></div>{% endif %}
                  </div>
                  <div class="box-time">
                    <ul>
                      <li>
                        <div class="time-text">{{ section.settings.time1text}}</div>
                        <div class="line"></div>
                        <div class="time-time">{{ section.settings.time1time}}</div>
                      </li>
                      <li>
                        <div class="time-text">{{ section.settings.time2text}}</div>
                        <div class="line"></div>
                        <div class="time-time">{{ section.settings.time2time}}</div>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="more-info">
                {% if section.settings.logo %}<div class="logo"><img src="{{ section.settings.logo | img_url: 'master' }}" alt="{{ section.settings.logo.alt}}"  /></div>{% endif %}
                {% if section.settings.address != '' %}<div class="address">{{ section.settings.address }}</div>{% endif %}
                {% if section.settings.phone != '' %}<div class="phone">{{ section.settings.phone }}</div>{% endif %}
                {% if section.settings.email != '' %}<div class="address">{{ section.settings.email }}</div>{% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

