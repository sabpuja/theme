{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="collection" data-section-name="index-categories-caption3">
  <div class="index-listing-collection-custom3-bg {{ section.settings.display }} {% if section.settings.padding %}have-padding{% else %}no-padding{% endif %} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">   
        <div class="box border-none index-listing-collection-container">
        <div class="box-divider position-{{ section.settings.title_position }} {% if section.settings.border-bt %}have-border{% else %}no-border{% endif %}">       
          {%- if section.settings.title != '' -%}
          <h2 class="box-title">{{ section.settings.title }}</h2>
          {%- endif -%}
        </div>
        <div class="box-content">
        {% case section.blocks.size %}
          {% when 1 %}
            {% assign col = 'cell small-12 medium-12 large-12 xlarge-12' %}
          {% when 2 %}
            {% assign col = 'cell small-12 medium-6 large-6 xlarge-6' %}
          {% when 3 %}
            {% assign col = 'cell small-12 medium-4 large-4 xlarge-4' %}
          {% when 4 %}
            {% assign col = 'cell small-12 medium-6 large-3 xlarge-3' %}
          {% when 5 %}
            {% assign col = 'cell small-12 medium-4 large-2-4 xlarge-2-4' %}
          {% when 6 %}
            {% assign col = 'cell small-6 medium-4 large-4 xlarge-2 xxlarge-2' %}
        {% endcase %}
        {% if section.blocks.size > 0 %}
          <div class="grid-x grid-margin-y">
            {% for block in section.blocks %}
              <div class="index-categories-item {{ col }}">
                <div class="grid-x">
                  <div class="cell large-12 xlarge-12 index-categories-item-banner effect-{{section.settings.effect}} effect">
                    <a href="{{ block.settings.link }}">
                      {% if block.settings.banner %}
                      <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.banner | img_url: '', crop: 'center' }}" class="lazyload width-100" alt="{{ block.settings.banner.alt }}"/>
                      {% else %}
                      <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '480x520.png' | asset_url }}" class="lazyload width-100" alt="{{ block.settings.banner.alt }}"/>
                      {% endif %}
                    </a>
                  </div>
                  <a class="overlaplink" href="{{ block.settings.link }}"></a>
                  {% if block.settings.title != '' or block.settings.sub_title != '' or block.settings.action != '' %}
                  <div class="cell large-12 xlarge-12 index-categories-item-content">
                    <div class="index-categories-item-divider">
                      {% if block.settings.title != ''%}<h2 class="index-categories-item-title"><a href="{{ block.settings.link }}">{{ block.settings.title }}</a></h2>{% endif %}
                      {% if block.settings.sub_title != ''%}<p class="index-categories-item-subtitle">{{ block.settings.sub_title }}</p>{% endif %}
                      {% if block.settings.action != ''%}<p class="index-categories-item-action"><a href="{{ block.settings.link }}">{{ block.settings.action }}</a></p>{% endif %}
                    </div>
                  </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


