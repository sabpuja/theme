        },
        {
          "type": "image_picker",
          "id": "payment_1",
          "label": "Payment #1"
        },
        {
          "type": "image_picker",
          "id": "payment_2",
          "label": "Payment #2"
        },
        {
          "type": "image_picker",
          "id": "payment_3",
          "label": "Payment #3"
        },
        {
          "type": "image_picker",
