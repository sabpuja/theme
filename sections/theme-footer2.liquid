{%- include 'amp-detector' -%}
{%- unless googleamp-%}
  {%- include 'theme-footer2' -%}
{%- else -%}
  {%- include 'amp-theme-footer' -%}
{%- endunless -%}
{% schema %}
{
  "name": "Footer Style #2",
  "settings": [
    {
      "type": "header",
      "content": "Footer Information"
    },
	{
      "type": "checkbox",
      "id": "footerinfo_active",
      "label": "Show this block"
    },
    {
      "type": "select",
      "id": "footerinfo_display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "text",
      "id": "footerinfo_title",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "footerinfo_location",
      "label": "Location Text"
    },
	{
      "type": "textarea",
      "id": "footerinfo_phone",
      "label": "Phone Text"
    },
	{
      "type": "text",
      "id": "footerinfo_email",
      "label": "Email Text"
    },
	{
      "type": "header",
      "content": "Footer Main content"
    },
	{
      "type": "checkbox",
      "id": "footermain_active",
      "label": "Show this block"
    },
	{
      "type": "paragraph",
      "content": "Add content with type is \"Link List\" or \"Newsletter\""
    },
	{
      "type": "header",
      "content": "Footer Bottom"
    },
	{
      "type": "checkbox",
      "id": "footerbottom_active",
      "label": "Show this block"
    },
	{
      "type": "paragraph",
      "content": "Add content with type is \"Copy-right\" or \"Payment\""
    }
  ],
  "blocks": [    	 
    {
      "type": "link2",
      "name": "Link List",
      "settings": [
        {
          "type": "select",
          "id": "display",
          "label": "Display on",
          "options": [
            {
              "value": "",
              "label": "Desktop & Mobile"
            },
            {
              "value": "show-for-large",
              "label": "Desktop only"
            },
            {
              "value": "hide-for-large",
              "label": "Mobile only"
            }
          ],
          "default": ""
        },
        {
          "type": "select",
          "id": "grid",
          "label": "Grid For Desktop",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            },
            {
              "value": "3",
              "label": "1/4"
            },
            {
              "value": "2",
              "label": "1/6"
            }
          ],
          "default": "3"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "link_list",
          "id": "linklist1",
          "label": "Select linklist left"
        },
        {
          "type": "link_list",
          "id": "linklist2",
          "label": "Select linklist right"
        }
      ]
    },   
	{
