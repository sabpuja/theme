          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            },
            {
              "value": "3",
              "label": "1/4"
            },
            {
              "value": "2",
              "label": "1/6"
            }
          ],
          "default": "3"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
		{
          "type": "text",
          "id": "desc",
          "label": "Description"
        },
        {
          "type": "textarea",
          "id": "newsletter_action",
          "label": "Mailchimp form action URL",
          "info": "[Find your MailChimp form action URL](https://docs.shopify.com/manual/configuration/store-customization/communicating-with-customers/accounts-and-newsletters/get-a-mailchimp-form-action-url)."
        },
        {
          "type": "text",
          "id": "newsletter_placeholder",
          "label": "Placeholder text"
        },
        {
          "type": "text",
          "id": "newsletter_actiontext",
          "label": "Action text"
        },
		{
          "type": "checkbox",
          "id": "social",
          "label": "Show Social icons"
        },
		{
          "type": "paragraph",
          "content": "Go to Theme settings tab > Social media to control those social icons"
        }
      ]
    },
    {
      "type": "payment",
      "name": "Payment",
      "settings": [
        {
          "type": "select",
          "id": "display",
          "label": "Display on",
          "options": [
            {
              "value": "",
              "label": "Desktop & Mobile"
            },
            {
              "value": "show-for-large",
              "label": "Desktop only"
            },
            {
              "value": "hide-for-large",
              "label": "Mobile only"
            }
          ],
          "default": ""
        },
        {
          "type": "select",
          "id": "grid",
          "label": "Grid For Desktop",
          "options": [
            {
              "value": "12",
              "label": "1/1"
