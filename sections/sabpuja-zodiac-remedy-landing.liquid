  const itemNote = item => {
    const lower=item.toLowerCase();
    if(lower.includes('yantra')) return 'Sign-specific yantra included as a devotional focal object in this assortment.';
    if(lower.includes('rudraksha')) return 'Traditional Rudraksha bead included in the selected sign’s devotional kit.';
    if(lower.includes('chalisa')||lower.includes('mantra')||lower.includes('sahasranama')||lower.includes('hridayam')||lower.includes('card')) return 'Devotional recitation or guidance material included for ritual context.';
    if(lower.includes('cloth')||lower.includes('chandan')||lower.includes('sindoor')||lower.includes('turmeric')||lower.includes('sesame')||lower.includes('seeds')||lower.includes('incense')||lower.includes('cardamom')) return 'Included as part of the sign-specific ritual presentation and puja setup.';
    return 'A sign-specific devotional object included in this kit’s planned assortment.';
  };

