    hero.src=z.hero; hero.alt='Sabpuja '+z.name+' ('+z.vedic+') Zodiac Remedy Kit';
    const contents=root.querySelector('[data-zodiac-contents]');
    contents.src=z.contents; contents.alt='Contents of the Sabpuja '+z.name+' Zodiac Remedy Kit';
    const medallion=root.querySelector('[data-zodiac-medallion]');
    medallion.innerHTML=symbolMarkup(z);
    root.querySelector('[data-zodiac-traits]').innerHTML=z.trait.map(item=>'<span>'+item+'</span>').join('');
    root.querySelector('[data-zodiac-product-link]').href='/products/'+z.handle;
    root.querySelector('[data-zodiac-product-link]').textContent='View full '+z.name+' product details →';
    const list=[...z.items.map(item=>({name:item,note:noteFor(item)})),...common];
    root.querySelector('[data-zodiac-items]').innerHTML=list.map((item,index)=>'<li><b>'+(index+1)+'</b><span><strong>'+item.name+'</strong><small>'+item.note+'</small></span></li>').join('');
    root.querySelector('[data-zodiac-status]').textContent='';
    document.title=z.name+' Zodiac Remedy Kit | Sabpuja';
    if(updateUrl){
      const url=new URL(window.location.href);
      url.pathname='/collections/astrology-remedy-kits';
      url.searchParams.set('sign',key);
      history.pushState({zodiac:key},'',url.pathname+url.search+url.hash);
    }
    if(scroll){
      root.querySelector('#zodiac-buy')?.scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'});
    }
  }

  root.querySelectorAll('[data-sign]').forEach(btn=>btn.addEventListener('click',()=>render(btn.dataset.sign,{updateUrl:true,scroll:window.innerWidth<760})));

  const qty=root.querySelector('[data-zodiac-qty]');
  const readQty=()=>Math.min(10,Math.max(1,parseInt(qty?.value||'1',10)||1));
  const setQty=value=>{ if(qty) qty.value=Math.min(10,Math.max(1,value)); };
  root.querySelector('[data-zodiac-minus]')?.addEventListener('click',()=>setQty(readQty()-1));
  root.querySelector('[data-zodiac-plus]')?.addEventListener('click',()=>setQty(readQty()+1));
  qty?.addEventListener('change',()=>setQty(readQty()));
  root.querySelector('[data-zodiac-purchase]')?.addEventListener('click',()=>{
    root.querySelector('[data-zodiac-status]').textContent='Preview only — Zodiac Remedy Kits are not yet available for purchase.';
  });

  window.addEventListener('popstate',()=>{
    const sign=new URL(window.location.href).searchParams.get('sign');
    render(data[sign]?sign:'aries');
  });

  const lightbox=root.querySelector('[data-zodiac-review-lightbox]');
  const lightboxImage=root.querySelector('[data-zodiac-review-lightbox-image]');
  const openLightbox=src=>{
    if(!lightbox||!lightboxImage) return;
    lightboxImage.src=src;
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden','false');
    document.documentElement.classList.add('sp-zodiac-lock');
  };
  const closeLightbox=()=>{
    lightbox?.classList.remove('is-open');
    lightbox?.setAttribute('aria-hidden','true');
    document.documentElement.classList.remove('sp-zodiac-lock');
  };
  root.querySelectorAll('[data-zodiac-review-open]').forEach(btn=>btn.addEventListener('click',()=>openLightbox(btn.dataset.reviewImage)));
  root.querySelectorAll('[data-zodiac-review-close]').forEach(btn=>btn.addEventListener('click',closeLightbox));
  document.addEventListener('keydown',event=>{ if(event.key==='Escape') closeLightbox(); });

  const reveals=[...root.querySelectorAll('[data-reveal]')];
  if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window){
    reveals.forEach(el=>el.classList.add('sp-zodiac__reveal-ready'));
    const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{
      if(entry.isIntersecting){ entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
    }),{threshold:.1,rootMargin:'0px 0px -5% 0px'});
    reveals.forEach(el=>observer.observe(el));
  } else {
    reveals.forEach(el=>el.classList.add('is-visible'));
  }

  const initial=new URL(window.location.href).searchParams.get('sign');
  render(data[initial]?initial:'aries');
})();
</script>

