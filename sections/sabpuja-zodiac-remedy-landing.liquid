    const signParam = url.searchParams.get('sign');
    if (signParam && data[signParam]) return signParam;
    const pathHandle = window.location.pathname.split('/').filter(Boolean).pop();
    return keyByHandle[pathHandle] || keyByHandle[root.dataset.currentHandle] || 'aries';
  };

