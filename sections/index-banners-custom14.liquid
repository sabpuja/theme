{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banners-custom14">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        {% if section.settings.bkg %}
        <div class="top-banner effect-{{section.settings.effect}} effect">   
          <div class="effect-parent">
            <img src="{{ section.settings.bkg | img_url: 'master' }}" alt="{{ section.settings.bkg.alt }}" />
          </div>                 
        </div>
        {% endif %}
        <div class="text-content">
          {% if section.blocks.size > 0 %}
          <div class="grid-x {% if section.settings.padding %}grid-margin-x{% else %}no-padding{% endif %}">
            {%- for block in section.blocks -%}
            <div class="text-element cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }}">  
              <div class="text-element-gr">
                  {% if block.settings.title != '' or block.settings.desc != '' %}              
                    {% if block.settings.title %}<div class="heading"><a href="{{ block.settings.link }}"> {{ block.settings.title }}</a></div>{% endif %}
                    {% if block.settings.desc %}<div class="desc">{{ block.settings.desc }}</div>{% endif %}              
                  {% endif %}
              </div>              
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </div>   
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

