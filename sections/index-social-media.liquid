{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-social-media">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{section.settings.color}}; ">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="grid-x">
        {%- if section.settings.title != blank or section.settings.sub_title != blank -%}
        <div class="cell small-12 c-title">
          <h2 class="box-title width-100">{{ section.settings.title }}</h2>
        </div>
        {%- endif -%}
        <div class="section-content cell small-12 c-content">
          <div class="banners-content">
            {% if section.blocks.size > 0 %}
            <div class="social-listing">
              {%- for block in section.blocks -%}
                <div class="social-element">                  
                  <div class="gr-social" style="color: {{ block.settings.color_text }}; {% if block.settings.bkg %}background-image:url({{ block.settings.bkg | img_url: 'master' }}){% else %}background-color:{{block.settings.color}}{% endif %}; ">
                      <a href="{{ block.settings.link }}"></a>
                      <div class="box-content">
                        <div class="box-icon"><img src="{{ block.settings.banner | img_url: 'master' }}" alt="{{ block.settings.type }}"/></div>
                        <div class="box-name">{{ block.settings.title }}</div>
                        <div class="box-type">{{ block.settings.type }}</div>
                      </div>
                  </div>                  
                </div>  
              {% endfor %}
            </div>
            {% endif %}
          </div>   
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Social Media",
  "class": "index-section index-social-media",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "title",
      "label": "Title",
	  "default":"FOLLOW US ON SOCIAL MEDIA"
    },
	{
      "type": "color",
      "id": "color",
      "label": "Background Color",
	  "default":"#161532"
    }
  ],  
  "blocks": [	
	{
      "type": "image",
      "name": "Social Media",
      "settings": [        
        {
          "type": "image_picker",
          "id": "banner",
          "label": "Icon"
        },
		{
          "type": "text",
          "id": "title",
          "label": "Social Name"
        },
		{
          "type": "text",
          "id": "type",
          "label": "Social Type"
        },
		{
          "type": "url",
          "id": "link",
          "label": "Social Link"
        },
		{
          "type": "image_picker",
          "id": "bkg",
          "label": "Background Image"
        },
		{
          "type": "color",
          "id": "color",
          "label": "Background Color"
        },
		{
          "type": "color",
          "id": "color_text",
          "label": "Text Color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Media",
      "category": "Advanced"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}