{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="none" data-section-name="index-leftsidebar">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none index-leftsidebar-grid-container">
      <div class="box-content">
        <div class="grid-x grid-margin-x">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'linklist' %}
              <div class="indexsb isb-allcollections cell small-12 medium-6 large-12">
                <div class="isb-title conllections-title">{{ block.settings.title }}</div>
                <div class="isb-content">
                  <ul class="conllections-list" style="margin-bottom:{{ section.settings.margin4 }}px;">
                    {% for l in linklists[block.settings.allcollection].links %}
                    <li class="link-element"><a href="{{ l.url }}">{{ l.title }}</a></li>
                    {% endfor %}
                  </ul>
                </div>
              </div>
            {% when 'banner' %}
              <div class="indexsb isb-banner cell small-12 medium-6 large-12">              
                <div class="isb-content effect-{{block.settings.effect2}} effect">                 
                  <a href="{{ block.settings.url }}" class="index-banner-grid-image display-block text-center">
                    {% if block.settings.banner %}
                    <img src="{{ block.settings.banner | img_url: 'master' }}" class="lazyload" alt="{{ block.settings.banner.alt }}" />
                    {% else %}
                    <img src="{{ '345x520.png' | asset_url }}" class="lazyload" alt="{{ block.settings.banner.alt }}" />
                    {% endif %}
                  </a>
                </div>
              </div>
            {% when 'testimonial' %}
              <div class="indexsb isb-testimonial cell small-12 medium-6 large-12"> 
                <div class="box-slider">
                  <div class="carousel" data-carousel-param='{"effect": "{{ block.settings.effect }}", "autoplay": "{{ block.settings.autoplay }}", "autoplaySpeed": "{{ block.settings.autoplay_speed }}", "space": "0", "column_small": "1", "column_medium": "1", "column_large": "1", "column_xlarge": "1", "column_xxlarge": "1", "column_xxxlarge": "1", "row": "1"}' data-carousel>
                    <div class="carousel-wrapper carousel-{{ block.settings.navigation_position }}">
                      <div class="swiper-container" data-carousel-container>
                        <div class="swiper-wrapper grid-margin-x small-up-1 medium-up-1 large-up-1 xlarge-up-1 xxlarge-up-1 xxxlarge-up-1">
                          {% for i in (1..5) %}
                            {% capture active %}active{{i}}{% endcapture %}
                            {% capture avatar %}avatar{{i}}{% endcapture %}
                            {% capture url %}url{{i}}{% endcapture %}
                            {% capture name %}name{{i}}{% endcapture %}
                            {% capture job %}job{{i}}{% endcapture %}
                            {% capture review %}review{{i}}{% endcapture %}
                            {% if block.settings[active] %}
                              <div class="swiper-slide cell" data-carousel-item>
                                <div class="testimonial-element testimonial-{{i}}">
                                  <div class="te-avatar">
                                    <a href="{{ block.settings[url] }}">
                                      {% if block.settings[avatar] %}
                                      <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings[avatar] | img_url: 'master' }}" class="lazyload" alt="{{ block.settings[avatar].alt }}" />
                                      {% else %}
                                      <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '110x110.png' | asset_url }}" class="lazyload" alt="{{ block.settings.banner.alt }}" />
                                      {% endif %}
                                    </a>
                                  </div>
                                  {% if block.settings[name] != '' %}<div class="te-name">{{ block.settings[name] }}</div>{% endif %}
                                  {% if block.settings[job] != '' %}<div class="te-job">{{ block.settings[job] }}</div>{% endif %}
                                  {% if block.settings[review] != '' %}<div class="te-review">{{ block.settings[review] }}</div>{% endif %}                    
                                </div>
                              </div>
                            {% endif %}
                          {% endfor %}
                        </div>
                      </div>
                      {%- if block.settings.navigation -%}
                      <!-- If we need navigation buttons -->
                      <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                      <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.pagination -%}
                    <!-- If we need pagination -->
                    <div class="carousel-pagination" data-carousel-pagination></div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {% when 'article' %}
              <div class="indexsb isb-article cell small-12 medium-6 large-12">   
                <div class="isb-title">{{ block.settings.title }}</div>
                <div class="isb-content">                
                  <div class="carousel" data-carousel-param='{"effect": "{{ block.settings.effect }}", "autoplay": "{{ block.settings.autoplay }}", "autoplaySpeed": "{{ block.settings.autoplay_speed }}", "space": "0", "column_small": "1", "column_medium": "1", "column_large": "1", "column_xlarge": "1", "column_xxlarge": "1", "column_xxxlarge": "1", "row": "1"}' data-carousel>
                    <div class="carousel-wrapper carousel-{{ block.settings.navigation_position }}">
                      {%- assign image_size = section.settings.image_width | append: 'x' | append: section.settings.image_height -%}
                      {% assign readmore = block.settings.readmore %}
                      {% assign effect2 = block.settings.effect2 %}
                      <div class="swiper-container" data-carousel-container>
                        <div class="swiper-wrapper grid-margin-x small-up-1 medium-up-1 large-up-1 xlarge-up-1 xxlarge-up-1 xxxlarge-up-1">
                          {% for article in blogs[block.settings.blog].articles limit:block.settings.limit %}
                          <div class="swiper-slide cell" data-carousel-item>
                            <div class="index-blogs-item">
                              {%- include 'index-article-item' -%}
                            </div>
                          </div>
                          {% else %}
                          {% for i in (1..block.settings.limit) %}
                          <div class="swiper-slide cell" data-carousel-item>
                            <div class="index-blogs-item">
                              <div class="article-item">
                                <div class="article-item-thumb">
                                  <a href="javascript:void(0);" class="display-block">
                                    <img src="{{ '345x250.png' | asset_url }}" class="article-item-image" alt="{{ article.title }}"/>
                                  </a>
                                </div>
                                <div class="article-item-caption">                
                                  <h2 class="article-item-title">
                                    <a href="{{ article.url }}">{{ 'homepage.onboarding.blog_title' |t }}</a>
                                  </h2>
                                  <div class="article-item-info">       
                                    <span class="article-item-date">March 25, 2018</span>
                                  </div>
                                  <div class="article-content">
                                    Your post content
                                  </div>
                                  <a class="article-readmore" href="{{ article.url }}">{{ block.settings.readmore }}</a>
                                </div>
                              </div>
                            </div>
                          </div>
                          {% endfor %}
                          {% endfor %}
                        </div>
                      </div>
                      {%- if block.settings.navigation -%}
                      <!-- If we need navigation buttons -->
                      <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                      <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.pagination -%}
                    <!-- If we need pagination -->
                    <div class="carousel-pagination" data-carousel-pagination></div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {% when 'product' %}
              <div class="indexsb isb-product cell small-12 medium-6 large-12">   
                <div class="isb-title">{{ block.settings.title }}</div>
                <div class="isb-content">                
                  {% for product in collections[block.settings.collection].products limit:block.settings.limit %}
                  <div class="product-grid">
                    {% include 'index-product-item-grid' %} 
                  </div>
                  {% else %}
                  {% for i in (1..block.settings.limit) %}
                  {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}                
                    <div class="product-grid">
                            <div class="product-item grid-x" data-product-item>
                              <div class="product-item-thumb cell small-12 medium-12 large-4 xlarge-4 xxlarge-4 xxxlarge-4">
                                <a href="javascript:void(0);" class="display-block">
                                  {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                </a>  
                                <div class="group-button top-right">      
                                  {%- if settings.product_item_quick_view -%}
                                  <a href="javascript:void(0);" class="group-button-quickview group-button-item product-item-button product-item-button-quick-view" title="{{ 'general.button.quick_view' | t }}"><em class="sli sli-magnifier"></em>
                                  </a>
                                  {%- endif -%}
                                  {%- if settings.product_item_wishlist -%}
                                  <div class="group-button-wishlist group-button-item product-item-button-wishlist">
                                    <em class="sli sli-heart icon-add" title="{{ 'general.button.wishlist' | t }}"></em>
                                    <em class="sli sli-check icon-added" title="{{ 'general.button.wishlist_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>
                                  </div>
                                  {%- endif -%}
                                  {%- if settings.product_item_compare -%}
                                  <div class="group-button-compare group-button-item product-item-button product-item-button-compare">
                                    <em class="sli sli-refresh icon-add" title="{{ 'general.button.compare' | t }}"></em>
                                    <em class="sli sli-check icon-added" title="{{ 'general.button.compare_added' | t }}" data-tooltip data-position="top" data-alignment="center" data-hover-delay="0" data-trigger-class="is-tip"></em>        
                                  </div>
                                  {%- endif -%}
                                </div>
                              </div>
                              <div class="product-item-caption cell small-12 medium-12 large-8 xlarge-8 xxlarge-8 xxxlarge-8">
                                <h4 class="product-item-title">
                                  <a href="javascript:void(0);">{{ 'homepage.onboarding.product_title' | t }}</a>
                                </h4>
                                {% if settings.product_item_vendor %}
                                <div class="product-item-vendor">
                                  {{ 'homepage.onboarding.vendor' | t }}
                                </div>
                                {% endif %}                                 
                                <div class="product-item-price">
                                  <span class="product-item-price-sale">$99.00</span>
                                </div>                              
                              </div>
                            </div>
                          </div>                 
                  {% endfor %}
                  {% endfor %}
                </div>
              </div>
            {% when 'instagram' %}
              <div class="indexsb isb-instagram cell small-12 medium-6 large-12">   
                <div class="isb-title">{{ block.settings.title }}</div>
                <div class="isb-content"> 
                  <div class="instafeed-photos grid-x">                    
                    {% if block.settings.photo1a %}<div class="cell small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6"><div class="effect-{{block.settings.effect2}} effect"><a href="{{ block.settings.photo1 }}" title=""><img src="{{ block.settings.photo1a | img_url: 'master' }}" alt=""/></a></div></div>{% endif %}
                    {% if block.settings.photo2a %}<div class="cell small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6"><div class="effect-{{block.settings.effect2}} effect"><a href="{{ block.settings.photo2 }}" title=""> <img src="{{ block.settings.photo2a | img_url: 'master' }}" alt=""/></a></div></div>{% endif %}
                    {% if block.settings.photo3a %}<div class="cell small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6"><div class="effect-{{block.settings.effect2}} effect"><a href="{{ block.settings.photo3 }}" title=""> <img src="{{ block.settings.photo3a | img_url: 'master' }}" alt=""/></a></div></div>{% endif %}
                    {% if block.settings.photo4a %}<div class="cell small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6"><div class="effect-{{block.settings.effect2}} effect"><a href="{{ block.settings.photo4 }}" title=""> <img src="{{ block.settings.photo4a | img_url: 'master' }}" alt=""/></a></div></div>{% endif %}
                    {% if block.settings.photo5a %}<div class="cell small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6"><div class="effect-{{block.settings.effect2}} effect"><a href="{{ block.settings.photo5 }}" title=""> <img src="{{ block.settings.photo5a | img_url: 'master' }}" alt=""/></a></div></div>{% endif %}
                    {% if block.settings.photo6a %}<div class="cell small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6"><div class="effect-{{block.settings.effect2}} effect"><a href="{{ block.settings.photo6 }}" title=""> <img src="{{ block.settings.photo6a | img_url: 'master' }}" alt=""/></a></div></div>{% endif %}                   
                    {% if block.settings.photo7a %}<div class="cell small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6"><div class="effect-{{block.settings.effect2}} effect"><a href="{{ block.settings.photo7 }}" title=""> <img src="{{ block.settings.photo7a | img_url: 'master' }}" alt=""/></a></div></div>{% endif %}                   
                    {% if block.settings.photo8a %}<div class="cell small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6"><div class="effect-{{block.settings.effect2}} effect"><a href="{{ block.settings.photo8 }}" title=""> <img src="{{ block.settings.photo8a | img_url: 'master' }}" alt=""/></a></div></div>{% endif %}                   
                    {% if block.settings.photo9a %}<div class="cell small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6"><div class="effect-{{block.settings.effect2}} effect"><a href="{{ block.settings.photo9 }}" title=""> <img src="{{ block.settings.photo9a | img_url: 'master' }}" alt=""/></a></div></div>{% endif %}                   
                    {% if block.settings.photo10a %}<div class="cell small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6"><div class="effect-{{block.settings.effect2}} effect"><a href="{{ block.settings.photo10 }}" title=""> <img src="{{ block.settings.photo10a | img_url: 'master' }}" alt=""/></a></div></div>{% endif %}                   
                    {% if block.settings.photo11a %}<div class="cell small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6"><div class="effect-{{block.settings.effect2}} effect"><a href="{{ block.settings.photo11 }}" title=""> <img src="{{ block.settings.photo11a | img_url: 'master' }}" alt=""/></a></div></div>{% endif %}                   
                    {% if block.settings.photo12a %}<div class="cell small-6 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6"><div class="effect-{{block.settings.effect2}} effect"><a href="{{ block.settings.photo12 }}" title=""> <img src="{{ block.settings.photo12a | img_url: 'master' }}" alt=""/></a></div></div>{% endif %}                   
                  </div>
                </div>
              </div>
            {% when 'feature' %}
              <div class="indexsb isb-feature cell small-12 medium-6 large-12">              
                <div class="isb-content">                
                  {% for i in (1..3) %}
                  {% capture active %}feature{{i}}{% endcapture %}
                  {% capture icon %}feature{{i}}_icon{% endcapture %}
                  {% capture title %}feature{{i}}_title{% endcapture %}
                  {% capture caption %}feature{{i}}_caption{% endcapture %}
                  {% if block.settings[active] %}
                  <div class="isb-item">
                    {% if block.settings[icon] %}
                    <div class="feature-icon">
                      <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings[icon] | img_url: 'master' }}" class="lazyload" alt="{{ block.settings[icon].alt }}" />
                    </div>
                    {% endif %}
                    <div class="feature-content">
                      <p class="title">{{ block.settings[title] }}</p>
                      <p class="caption">{{ block.settings[caption] }}</p>
                    </div>
                  </div>
                  {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% when 'phone' %}
              <div class="indexsb isb-phone cell small-12 medium-12 large-12">              
                <div class="isb-content" style="background-image:url({% if block.settings.background %}{{ block.settings.background | img_url: '', crop: '' }}{% else %}{{ '345x119.png' | asset_url }}{% endif %})">                
                  <span class="phone-title">{{ block.settings.title }}</span>
                  <a href="tel:{{ block.settings.number_phone }}" class="phone-number">{{ block.settings.number_phone }}</a>
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      {% endif %}
        </div>
      </div>
    </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


{% schema %}
  {
    "name": "Left Sidebar",
 	"class": "index-section index-leftsidebar",
	"settings": [
      {
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	  {
        "type": "text",
        "id": "margin4",
        "label": "Spacing between these blocks",
        "default":"48"
      }
	],
    "blocks": [	  
      {
        "type": "linklist",
        "name": "Collections Listing",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
		  {
            "type": "link_list",
            "id": "allcollection",
            "label": "All collection link"
          }
        ]
      },
	  {
        "type": "banner",
        "name": "Banner",
        "settings": [          
		  {
            "type": "image_picker",
            "id": "banner",
            "label": "Upload banner"
          },
		  {
            "type": "url",
            "id": "url",
            "label": "Link to"
          },
		  {    
            "type": "select",
            "id": "effect2",
            "label": "Hover Effect",
            "options": [
              {
                "value": "scope",
                "label": "Scope"
              },       
              {
                "value": "pulse",
                "label": "Pulse"
              },
              {
                "value": "circle",
                "label": "Circle"
              },
              {
                "value": "square",
                "label": "Square"
              },       
              {
                "value": "blur",
                "label": "Blur"
              },
              {
                "value": "grayscale",
                "label": "Gray scale"
              },                            
              {
                "value": "scope3",
                "label": "Line 2"
              },              
              {
                "value": "zoom",
                "label": "Zoom"        
              },
              {
                "value": "zoom-opacity",
                "label": "Zoom Opacity"        
              },
              {
                "value": "apollo",
                "label": "Apollo"        
              },
              {
                "value": "jazz",
                "label": "Jazz"        
              },
              {
                "value": "ming",
                "label": "Ming"        
              },
              {
                "value": "bounce",
                "label": "Bounce"        
              },
              {
                "value": "flash",
                "label": "Flash"        
              },
              {
                "value": "animate-pulse",
                "label": "Animate Pulse"        
              },
              {
                "value": "heartBeat",
                "label": "Heart Beat"        
              },
              {
                "value": "backInDown",
                "label": "Back In Down"        
              },                
              {
                "value": "bounceInUp",
                "label": "Bounce In Up"        
              },        
              {
                "value": "bounceInRight",
                "label": "Bounce In Right"        
              },
              {
                "value": "bounceInLeft",
                "label": "Bounce In Left"        
              },
              {
                "value": "bounceInDown",
                "label": "Bounce In Down"        
              },
              {
                "value": "bounceIn",
                "label": "Bounce In"        
              },        
              {
                "value": "rotateInUpRight",
                "label": "Rotate In Up Right"        
              },
              {
                "value": "rotateInUpLeft",
                "label": "Rotate In Up Left"        
              },
              {
                "value": "rotateInDownRight",
                "label": "Rotate In Down Right"        
              },
              {
                "value": "rotateInDownLeft",
                "label": "Rotate In Down Left"        
              },
              {
                "value": "rotateIn",
                "label": "Rotate In"        
              },        
              {
                "value": "lightSpeedInLeft",
                "label": "Light Speed InLeft"        
              },        
              {
                "value": "flipInY",
                "label": "Flip In Y"        
              },
              {
                "value": "flipInX",
                "label": "Flip In X"        
              },
              {
                "value": "flip",
                "label": "Flip"        
              },
              {
                "value": "jackInTheBox",
                "label": "Jack In The Box"        
              }                                                    
            ],
            "default": "scope"      
          }
        ]
      },
	  {
        "type": "article",
        "name": "Article",
        "settings": [          
		  {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
		  {
            "type": "blog",
            "id": "blog",
            "label": "Select Article"
          },
		  {
            "type": "text",
            "id": "limit",
            "label": "Limit",
          "default": "1"
          },
		  {
            "type": "text",
            "id": "readmore",
            "label": "Read More text"
          },
	      {
            "type": "checkbox",
            "id": "autoplay",
            "label": "Auto-play slides",
            "default": true
          },
          {
            "type": "select",
            "id": "autoplay_speed",
            "label": "Change slides every",
            "options": [
              {
                "value": "3000",
                "label": "3 seconds"
              },
              {
                "value": "4000",
                "label": "4 seconds"
              },
              {
                "value": "5000",
                "label": "5 seconds"
              },
              {
                "value": "6000",
                "label": "6 seconds"
              },
              {
                "value": "7000",
                "label": "7 seconds"
              },
              {
                "value": "8000",
                "label": "8 seconds"
              },
