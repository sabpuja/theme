{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-banners-polygon">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content" style="background-color:{{ section.settings.bkg }}">
        <div class="box border-none index-text-banner-grid-container">
          <div class="box-content">
            <div class="gr-polygon-area">  
              <div class="carousel" data-carousel-param='{"effect": "{{ section.settings.effect }}", "direction": "horizontal", "autoplay": "{{ section.settings.autoplay }}", "autoplaySpeed": "{{ section.settings.autoplay_speed }}", "space": "0", "column_small": "1", "column_medium": "1", "column_large": "1", "column_xlarge": "1", "column_xxlarge": "1", "column_xxxlarge": "1", "row": "1", "center": "true"}' data-carousel>
                <div class="carousel-wrapper carousel-{{ section.settings.navigation_position }}">
                  <div class="swiper-container" data-carousel-container>
                    <div class="swiper-wrapper grid-margin-x small-up-1 medium-up-1 large-up-1 xlarge-up-1 xxlarge-up-1 xxxlarge-up-1">
                      {% for block in section.blocks %}
                      <div class="swiper-slide text-center" data-carousel-item style="background:{{ section.settings.bkg }};">
                        <div class="banner-area">
                          <div class="banner-img">
                            {%- unless block.settings.image == blank -%}
                            <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">
                              <img src="{{ block.settings.image | img_url: image_size }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                            </a>
                            {% else %}
                            <a href="{{ block.settings.link }}" class="index-banner-grid-image display-block">                
                              <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '625x500.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image.alt }}" />
                            </a>
                            {%- endunless -%}
                          </div>
                          <div class="banner-caption">
                            <a href="{{ block.settings.link }}">
                              {{ block.settings.text }}
                            </a>
                          </div>
                        </div>         
                      </div>
                      {% endfor %}    
                    </div>
                  </div>
                  {%- if section.settings.navigation -%}
                  <!-- If we need navigation buttons -->
                  <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                  <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                  {%- endif -%}
                </div>
                {%- if section.settings.pagination -%}
                <!-- If we need pagination -->
                <div class="carousel-pagination" data-carousel-pagination></div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

  
{% schema %}
{
  "name": "Banners Polygon",
  "class": "index-section index-polygon",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "color",
      "id": "bkg",
      "label": "Background color",
	  "default":"#f4f4f4"
    },
	{
      "type": "header",
      "content": "Carousel settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-play slides",
      "default": true
    },
    {
      "type": "select",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "options": [
        {
          "value": "3000",
          "label": "3 seconds"
        },
        {
          "value": "4000",
          "label": "4 seconds"
        },
        {
          "value": "5000",
          "label": "5 seconds"
        },
        {
          "value": "6000",
          "label": "6 seconds"
        },
        {
          "value": "7000",
          "label": "7 seconds"
        },
        {
          "value": "8000",
          "label": "8 seconds"
        },
        {
          "value": "9000",
          "label": "9 seconds"
        },
        {
          "value": "10000",
          "label": "10 seconds"
        }
      ],
      "default": "5000"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Slide effect",
      "options": [
        {
          "value": "slide",
          "label": "Sliding"
        },
        {
          "value": "fade",
          "label": "Fading"
        },
        {
          "value": "cube",
          "label": "Cube"
        },
        {
          "value": "flip",
          "label": "Flipping"
        }
      ],
      "default": "slide"
    },
    {
      "type": "number",
      "id": "image_width",
      "label": "Image width",
      "default": 200
    },
    {
      "type": "number",
      "id": "image_height",
      "label": "Image height",
      "default": 200
    },
    {
      "type": "checkbox",
      "id": "navigation",
      "label": "Enable Navigaiton",
      "default": true
    },
    {
      "type": "select",
      "id": "navigation_position",
      "label": "Navigation position",
      "options": [
        {
          "value": "nav-top",
          "label": "Top"
        },
        {
          "value": "nav-top-left",
          "label": "Top Left"
        },
        {
          "value": "nav-top-right",
          "label": "Top Right"
        },
        {
          "value": "nav-middle",
          "label": "Middle"
        },
        {
          "value": "nav-bottom",
          "label": "Bottom"
        },
        {
          "value": "nav-bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "nav-bottom-right",
          "label": "Bottom Right"
        },
        {
          "value": "nav-top-bottom-left",
          "label": "Top Bottom Left"
        },
        {
          "value": "nav-top-bottom-right",
          "label": "Top Bottom Right"
        }
      ],
      "default": "nav-middle"
    },
    {
      "type": "checkbox",
      "id": "pagination",
      "label": "Enable Pagination",
      "default": true
    }
  ],  
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
		  "default":"/collections/all"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Caption"
        }     
      ]
    }
  ],
  "presets": [
    {
      "name": "Banners Polygon",
      "category": "Image"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}