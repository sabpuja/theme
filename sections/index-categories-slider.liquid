{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="collection" data-section-name="index-categories-slider">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content"> 
        <div class="cate-slider box border-none">
          <div class="box-divider left-caption">
            {%- if section.settings.title2 != blank -%}
            <div class="box-heading" style="color:{{ section.settings.color2 }}; font-size: {{ section.settings.titlesize2 }}px;">{{ section.settings.title2 }}</div>
            {%- endif -%}
            {%- if section.settings.title != blank -%}
            <h2 class="box-title" style="color:{{ section.settings.color }}; font-size: {{ section.settings.titlesize }}px; font-weight: {{ section.settings.title_weight }}">{{ section.settings.title }}</h2>
            {%- endif -%}
            {%- if section.settings.title3 != blank -%}
            <div class="box-desc" style="color:{{ section.settings.color3 }}; font-size: {{ section.settings.titlesize3 }}px;">{{ section.settings.title3 }}</div>
            {%- endif -%}
            {%- if section.settings.title4 != blank -%}
            <div class="box-action"><a class="btn" href="{{ section.settings.url }}" style="color:{{ section.settings.color4 }}; font-size: {{ section.settings.titlesize4 }}px; background-color:{{ section.settings.color5 }};">{{ section.settings.title4 }}</a></div>
            {%- endif -%}
          </div>
          <div class="box-content">        
          {% if section.blocks.size > 0 %}
          <div class="carousel" data-carousel-param='{"effect": "{{ section.settings.effect }}", "autoplay": "{{ section.settings.autoplay }}", "autoplaySpeed": "{{ section.settings.autoplay_speed }}", "space": "{{ section.settings.space }}", "column_small": "{{ section.settings.column_small }}", "column_medium": "{{ section.settings.column_medium }}", "column_large": "{{ section.settings.column_large }}", "column_xlarge": "{{ section.settings.column_xlarge }}", "column_xxlarge": "{{ section.settings.column_xxlarge }}", "column_xxxlarge": "{{ section.settings.column_xxxlarge }}", "row": "{{ section.settings.row }}"}' data-carousel>
            <div class="carousel-wrapper carousel-{{ section.settings.navigation_position }}">
              <div class="swiper-container" data-carousel-container>
                <div class="swiper-wrapper grid-margin-x small-up-{{ section.settings.column_small }} medium-up-{{ section.settings.column_medium }} large-up-{{ section.settings.column_large }} xlarge-up-{{ section.settings.column_xlarge }} xxlarge-up-{{ section.settings.column_xxlarge }} xxxlarge-up-{{ section.settings.column_xxxlarge }}">
                {%- for block in section.blocks -%}
                 <div class="swiper-slide cell" data-carousel-item> 
                    <div class="effect-{{section.settings.effect2}} effect">
                      <div class="effect-parent">
                        <img class="img-bkg width-100" src="{% if block.settings.image %}{{ block.settings.image | img_url: 'master' }}{% else %}{{ '270x460.png' | asset_url }}{% endif %}" alt="{{ block.settings.image.alt }}" />                
                      </div>                  
                    </div>                           
                    <a class="img-caption" href="{{ block.settings.link }}" title="">{{ block.settings.title }}</a> 
                </div>
                {% endfor %}
                </div>
              </div>
              {%- if section.settings.navigation -%}
              <!-- If we need navigation buttons -->
              <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
              <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
              {%- endif -%}
            </div>
            {%- if section.settings.pagination -%}
            <!-- If we need pagination -->
            <div class="carousel-pagination" data-carousel-pagination></div>
            {%- endif -%}
          </div>
          {% endif %}
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div> 

