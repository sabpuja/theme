{{ 'sabpuja-home-gifting-reviews.css' | asset_url | stylesheet_tag }}

{% assign sp_review_numbers = '01,02,03,04,05,06' | split: ',' %}
<section id="sp-reviews-{{ section.id }}" class="sp2026-extra sp2026-reviews-section" aria-labelledby="sp-reviews-title-{{ section.id }}">
  <div class="sp2026-extra__inner">
    <div class="sp2026-reviews-heading-row">
      <div>
        <p class="sp2026-extra__eyebrow">{{ 'sabpuja_custom.auto.s065' | t }}</p>
        <h2 id="sp-reviews-title-{{ section.id }}" class="sp2026-reviews-title">{{ 'sabpuja_custom.auto.s285' | t }}</h2>
        <p class="sp2026-reviews-intro">{{ 'sabpuja_custom.auto.s251' | t }}</p>
      </div>
      <div class="sp2026-reviews-controls" aria-label="{{ 'sabpuja_custom.auto.s066' | t }}">
        <button class="sp2026-reviews-button" type="button" data-sp-reviews-prev aria-label="{{ 'sabpuja_custom.auto.s187' | t }}">←</button>
        <button class="sp2026-reviews-button" type="button" data-sp-reviews-next aria-label="{{ 'sabpuja_custom.auto.s154' | t }}">→</button>
      </div>
    </div>

    <div class="sp2026-reviews-track" data-sp-reviews-track tabindex="0" aria-label="{{ 'sabpuja_custom.auto.s067' | t }}">
      {% for review_number in sp_review_numbers %}
        {% capture review_asset %}sabpuja-customer-review-{{ review_number }}.webp{% endcapture %}
        <article class="sp2026-review-image-card">
          <img src="{{ review_asset | asset_url }}" width="1448" height="1086" loading="lazy" decoding="async" alt="Illustrative Sabpuja customer review card {{ forloop.index }} of 6.">
        </article>
      {% endfor %}
    </div>

    <p class="sp2026-reviews-disclosure">{{ 'sabpuja_custom.auto.s130' | t }}</p>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('sp-reviews-{{ section.id }}');
    if (!root || root.dataset.spReviewsReady === 'true') return;
    root.dataset.spReviewsReady = 'true';

    var track = root.querySelector('[data-sp-reviews-track]');
    var previous = root.querySelector('[data-sp-reviews-prev]');
    var next = root.querySelector('[data-sp-reviews-next]');
    if (!track || !previous || !next) return;

    var timer = null;
    var restartTimer = null;
    var isVisible = true;
    var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var AUTOPLAY_MS = 2200;

    function cardStep() {
      var card = track.querySelector('.sp2026-review-image-card');
      if (!card) return Math.max(280, Math.round(track.clientWidth * 0.84));
      var styles = getComputedStyle(track);
      var gap = parseFloat(styles.columnGap || styles.gap || 0) || 0;
      return card.getBoundingClientRect().width + gap;
    }

    function move(direction) {
      if (!track) return;
      var behavior = reducedMotion ? 'auto' : 'smooth';
      var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
      var atStart = track.scrollLeft <= 8;

      if (direction > 0 && atEnd) {
        track.scrollTo({ left: 0, behavior: behavior });
      } else if (direction < 0 && atStart) {
        track.scrollTo({ left: Math.max(0, track.scrollWidth - track.clientWidth), behavior: behavior });
      } else {
        track.scrollBy({ left: direction * cardStep(), behavior: behavior });
      }
    }

    function stopAuto() {
      if (timer) window.clearInterval(timer);
      timer = null;
      if (restartTimer) window.clearTimeout(restartTimer);
      restartTimer = null;
    }

    function startAuto() {
      if (reducedMotion || !isVisible || document.hidden) return;
      if (timer) window.clearInterval(timer);
      timer = window.setInterval(function () { move(1); }, AUTOPLAY_MS);
    }

    function restartAutoSoon() {
      stopAuto();
      if (reducedMotion || !isVisible || document.hidden) return;
      restartTimer = window.setTimeout(startAuto, 900);
    }

    previous.addEventListener('click', function () { move(-1); restartAutoSoon(); });
    next.addEventListener('click', function () { move(1); restartAutoSoon(); });

    track.addEventListener('pointerdown', stopAuto);
    track.addEventListener('pointerup', restartAutoSoon);
    track.addEventListener('pointercancel', restartAutoSoon);

    root.addEventListener('focusin', stopAuto);
    root.addEventListener('focusout', restartAutoSoon);

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stopAuto();
      else startAuto();
    });

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        isVisible = !!(entries[0] && entries[0].isIntersecting);
        if (isVisible) startAuto();
        else stopAuto();
      }, { threshold: 0.18 });
      observer.observe(root);
    } else {
      startAuto();
    }
  }());
</script>

