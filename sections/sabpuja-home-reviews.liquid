{{ 'sabpuja-home-gifting-reviews.css' | asset_url | stylesheet_tag }}

{% capture sp_review_names %}Karan Verma||Sunita Rao||Amit Deshmukh||Vidya Reddy||Rajesh Gupta||Anonymous||Atreyee Giri||Kavita Mishra||Priya Singh||Meena Kulkarni{% endcapture %}
{% capture sp_review_texts %}Bohot hi badhiya pooja box hai. Kapoor aur haldi ki khushboo bohot pure hai. Strongly recommended for working couples.||Bought this for my son who lives in a different city for his new flat's puja. He easily managed the whole katha without panicking about missing items.||The quality of the dhoop cones and Mauli thread is excellent. It feels good to know you aren't getting cheap, stale materials for an auspicious puja.||I bought this for our housewarming Satyanarayan katha. The pandit ji was highly impressed seeing how organized everything was. The quality of the samagri is very pure.||This 21-in-1 box made our monthly Satyanarayan vrat so hassle-free. Everything from the janeu to the yellow cloth was inside. Saved me a trip to three different shops. Thank you Sabpuja.||This is a thoughtfully curated offering for anyone seeking a structured and spiritually enriching ritual experience at home. It feels authentic, well-balanced, and free from artificial additives, which is important for those who prioritize purity in rituals. The packaging also deserves mention—it’s sturdy and aesthetically pleasing.||Bahoot hi achha product hai. Jab se hawan samagri ka ghar main use kar raha hoon tab se ghar main positive environment hai aur mann main bhi shanti rehti hai. Om Shanti Om.||Bought this samagri collection to start doing a simple prayer every morning after meditation. The kit comes with organic samidha sticks and feels much better than buying loose samagri.||This was perfect for our festive havan and helped us prepare for Mangalwar and Guruvar with the right blends. The freshness of the samagri and the neat packaging made the experience peaceful and meaningful.||The samagri quality feels good. I bought this for weekly rituals and it’s turned out to be a complete, convenient kit that saves time and stress.{% endcapture %}
{% assign sp_review_names = sp_review_names | split: '||' %}
{% assign sp_review_texts = sp_review_texts | split: '||' %}

<section id="sp-reviews-{{ section.id }}" class="sp2026-extra sp2026-reviews-section" aria-labelledby="sp-reviews-title-{{ section.id }}">
  <div class="sp2026-extra__inner">
    <div class="sp2026-reviews-heading-row">
      <div>
        <p class="sp2026-extra__eyebrow">Customer experiences</p>
        <h2 id="sp-reviews-title-{{ section.id }}" class="sp2026-reviews-title">What people say about Sabpuja</h2>
        <p class="sp2026-reviews-intro">Feedback from pilot customers who received complimentary Sabpuja products.</p>
      </div>
      <div class="sp2026-reviews-controls" aria-label="Customer review carousel controls">
        <button class="sp2026-reviews-button" type="button" data-sp-reviews-prev aria-label="Previous reviews">←</button>
        <button class="sp2026-reviews-button" type="button" data-sp-reviews-next aria-label="Next reviews">→</button>
      </div>
    </div>

    <div class="sp2026-reviews-track" data-sp-reviews-track tabindex="0" aria-label="Customer reviews" role="list">
      {% for review_name in sp_review_names %}
        {% assign review_text = sp_review_texts[forloop.index0] %}
        {% assign review_initial = review_name | slice: 0 %}
        <article class="sp2026-review-image-card sp2026-review-text-card" role="listitem">
          <div class="sp2026-review-quote-mark" aria-hidden="true">“</div>
          <blockquote>{{ review_text }}</blockquote>
          <div class="sp2026-review-author">
            <span class="sp2026-review-avatar" aria-hidden="true">{{ review_initial }}</span>
            <span><strong>{{ review_name }}</strong><small>Pilot customer</small></span>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('sp-reviews-{{ section.id }}');
    if (!root || root.dataset.spReviewsReady === 'true') return;
    root.dataset.spReviewsReady = 'true';

    var track = root.querySelector('[data-sp-reviews-track]');
    var previous = root.querySelector('[data-sp-reviews-prev]');
    var next = root.querySelector('[data-sp-reviews-next]');
    if (!track || !previous || !next) return;

    var timer = null;
    var restartTimer = null;
    var isVisible = true;
    var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var AUTOPLAY_MS = 4200;

    function cardStep() {
      var card = track.querySelector('.sp2026-review-image-card');
      if (!card) return Math.max(280, Math.round(track.clientWidth * 0.84));
      var styles = getComputedStyle(track);
      var gap = parseFloat(styles.columnGap || styles.gap || 0) || 0;
      return card.getBoundingClientRect().width + gap;
    }

    function move(direction) {
      if (!track) return;
      var behavior = reducedMotion ? 'auto' : 'smooth';
      var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
      var atStart = track.scrollLeft <= 8;

      if (direction > 0 && atEnd) {
        track.scrollTo({ left: 0, behavior: behavior });
      } else if (direction < 0 && atStart) {
        track.scrollTo({ left: Math.max(0, track.scrollWidth - track.clientWidth), behavior: behavior });
      } else {
        track.scrollBy({ left: direction * cardStep(), behavior: behavior });
      }
    }

    function stopAuto() {
      if (timer) window.clearInterval(timer);
      timer = null;
      if (restartTimer) window.clearTimeout(restartTimer);
      restartTimer = null;
    }

    function startAuto() {
      if (reducedMotion || !isVisible || document.hidden) return;
      if (timer) window.clearInterval(timer);
      timer = window.setInterval(function () { move(1); }, AUTOPLAY_MS);
    }

    function restartAutoSoon() {
      stopAuto();
      if (reducedMotion || !isVisible || document.hidden) return;
      restartTimer = window.setTimeout(startAuto, 1200);
    }

    previous.addEventListener('click', function () { move(-1); restartAutoSoon(); });
    next.addEventListener('click', function () { move(1); restartAutoSoon(); });

    track.addEventListener('pointerdown', stopAuto);
    track.addEventListener('pointerup', restartAutoSoon);
    track.addEventListener('pointercancel', restartAutoSoon);

    root.addEventListener('focusin', stopAuto);
    root.addEventListener('focusout', restartAutoSoon);

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stopAuto();
      else startAuto();
    });

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        isVisible = !!(entries[0] && entries[0].isIntersecting);
        if (isVisible) startAuto();
        else stopAuto();
      }, { threshold: 0.18 });
      observer.observe(root);
    } else {
      startAuto();
    }
  }());
</script>

