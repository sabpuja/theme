{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="blogs" data-section-name="index-blogs-grid">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    <div class="bloggrid-wrapper"></div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">   
        <div class="box-content grid-x">
		  <div class="left-area cell large-6 small-12">
            {% for block in section.blocks %}
              {% if block.type == 'blog1' %}
                <div class="index-blogs-item effect-{{section.settings.effect}} effect">
                  <a class="article-image" href="{{ block.settings.url }}">
                    <img src="{{ block.settings.banner | img_url: 'master' }}" alt="{{ block.settings.banner.alt }}"/>
                  </a>
                  <a class="article-text no-effect" href="{{ block.settings.url }}"><span>{{ block.settings.title }}</span></a>
                </div>
              {% endif %}
            {% endfor %}
          </div>
          <div class="right-area cell large-6 small-12">
            <div class="grid-x">              
              {% for block in section.blocks %}              
                {% if block.type == 'blog2' %}
                <div class="cell large-6 small-12">
                  <div class="index-blogs-item effect-{{section.settings.effect}} effect">
                    <a class="article-image" href="{{ block.settings.url }}"><img src="{{ block.settings.banner | img_url: 'master' }}" alt="{{ block.settings.banner.alt }}"/></a>
                    <a class="article-text no-effect" href="{{ block.settings.url }}"><span>{{ block.settings.title }}</span></a>
                  </div>
                </div>
                {% endif %}              
              {% endfor %}              
            </div>
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


