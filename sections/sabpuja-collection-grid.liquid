{{ 'sabpuja-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sabpuja-collection-interactions.js' | asset_url }}" defer></script>

{% assign sp_active_filter_count = 0 %}
{% for filter in collection.filters %}
  {% assign sp_active_filter_count = sp_active_filter_count | plus: filter.active_values.size %}
  {% if filter.type == 'price_range' %}
    {% if filter.min_value.value != blank or filter.max_value.value != blank %}
      {% assign sp_active_filter_count = sp_active_filter_count | plus: 1 %}
    {% endif %}
  {% endif %}
{% endfor %}

<section class="sp-col" data-sp-col aria-labelledby="sp-col-title">
  <div class="sp-col__container">
    <nav class="sp-col__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <span>{{ collection.title }}</span>
    </nav>

    <header class="sp-col__head sp-col__head--editorial">
      <div class="sp-col__head-copy">
        {% if section.settings.eyebrow != blank %}<p class="sp-col__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if collection.handle == 'astrology-remedy-kits' %}<h2 id="sp-col-title">{{ collection.title }}</h2>{% else %}<h1 id="sp-col-title">{{ collection.title }}</h1>{% endif %}
        {% if collection.description != blank %}
          <div class="sp-col__description">{{ collection.description }}</div>
        {% elsif section.settings.intro != blank %}
          <p class="sp-col__description">{{ section.settings.intro | escape }}</p>
        {% endif %}
      </div>
      {% if section.settings.show_product_count %}
        <div class="sp-col__head-count" aria-label="{{ collection.products_count }} products in this collection">
          <strong>{{ collection.products_count }}</strong><span>products to explore</span>
        </div>
      {% endif %}
    </header>

    {% assign sp_shortcut_menu = linklists[section.settings.category_menu] %}
    <nav class="sp-col__shortcuts" aria-label="Shop by collection">
      {% if section.settings.show_shop_all %}
      <a class="sp-col__shortcut{% if collection.handle == 'all' %} is-active{% endif %}" href="{{ routes.all_products_collection_url }}"{% if collection.handle == 'all' %} aria-current="page"{% endif %}>{% render 'sabpuja-icon', name: 'grid' %}<span>{{ section.settings.shop_all_label | escape }}</span></a>
      {% endif %}
      {% for sp_category in sp_shortcut_menu.links %}
        {% if sp_category.type == 'collection_link' %}
          <a class="sp-col__shortcut{% if sp_category.object.handle == collection.handle %} is-active{% endif %}" href="{{ sp_category.url }}"{% if sp_category.object.handle == collection.handle %} aria-current="page"{% endif %}>{% render 'sabpuja-icon', name: 'package' %}<span>{{ sp_category.title | escape }}</span></a>
        {% endif %}
      {% endfor %}
    </nav>

    {% if sp_active_filter_count > 0 %}
      <div class="sp-col__active" aria-label="Active filters">
        <span class="sp-col__active-label">Filtered by</span>
        {% for filter in collection.filters %}
          {% for active_value in filter.active_values %}
            <a class="sp-col__chip" href="{{ active_value.url_to_remove }}"><span>{{ active_value.label }}</span><span aria-hidden="true">×</span></a>
          {% endfor %}
          {% if filter.type == 'price_range' %}
            {% if filter.min_value.value != blank or filter.max_value.value != blank %}
              <a class="sp-col__chip" href="{{ filter.url_to_remove }}">
                <span>
                  {% if filter.min_value.value != blank %}{{ filter.min_value.value | money }}{% else %}{{ 0 | money }}{% endif %}
                  to
                  {% if filter.max_value.value != blank %}{{ filter.max_value.value | money }}{% else %}{{ filter.range_max | money }}{% endif %}
                </span>
                <span aria-hidden="true">×</span>
              </a>
            {% endif %}
          {% endif %}
        {% endfor %}
        <a class="sp-col__clear" href="{{ collection.url }}">Clear all</a>
      </div>
    {% endif %}

    <div class="sp-col__mobile-tools">
      {% if collection.filters != empty %}
        <details class="sp-col-mobile-filters" data-sp-filter-drawer>
          <summary aria-label="Open product filters">
            {% render 'sabpuja-icon', name: 'grid' %}
            <span>Filters{% if sp_active_filter_count > 0 %} ({{ sp_active_filter_count }}){% endif %}</span>
          </summary>
          <button type="button" class="sp-col-mobile-filters__scrim" aria-label="Close filters" data-sp-filter-close tabindex="-1"></button>
          <div class="sp-col-mobile-filters__panel" role="region" aria-label="Product filters">
            <div class="sp-col-mobile-filters__head">
              <strong>Filter products</strong>
              <button type="button" data-sp-filter-close aria-label="Close filters">×</button>
            </div>
            {% render 'sabpuja-collection-filters', collection: collection, scope: 'mobile', category_menu: section.settings.category_menu %}
          </div>
        </details>
      {% endif %}

      <form class="sp-col__sort" action="{{ collection.url }}" method="get">
        <label for="SortByMobile">Sort</label>
        {% for filter in collection.filters %}
          {% for active_value in filter.active_values %}<input type="hidden" name="{{ active_value.param_name }}" value="{{ active_value.value | escape }}">{% endfor %}
          {% if filter.type == 'price_range' %}
            {% if filter.min_value.value != blank %}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}">{% endif %}
            {% if filter.max_value.value != blank %}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}">{% endif %}
          {% endif %}
        {% endfor %}
        {% assign sp_sort_by = collection.sort_by | default: collection.default_sort_by %}
        <select id="SortByMobile" name="sort_by" onchange="this.form.submit()">
          {% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sp_sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}
        </select>
      </form>
    </div>

      <div class="sp-col__toolbar">
        <span class="sp-col__count">{{ collection.products_count }} product{% unless collection.products_count == 1 %}s{% endunless %}</span>

        <form class="sp-col__sort" action="{{ collection.url }}" method="get">
          <label for="SortBy">Sort by</label>
          {% for filter in collection.filters %}
            {% for active_value in filter.active_values %}<input type="hidden" name="{{ active_value.param_name }}" value="{{ active_value.value | escape }}">{% endfor %}
            {% if filter.type == 'price_range' %}
            {% if filter.min_value.value != blank %}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}">{% endif %}
            {% if filter.max_value.value != blank %}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}">{% endif %}
            {% endif %}
          {% endfor %}
          {% assign sp_sort_by = collection.sort_by | default: collection.default_sort_by %}
          <select id="SortBy" name="sort_by" onchange="this.form.submit()">
            {% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sp_sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}
          </select>
        </form>
      </div>

    <div class="sp-col__layout{% if collection.filters == empty %} sp-col__layout--wide{% endif %}">
      {% if collection.filters != empty %}
        <aside class="sp-col__sidebar" aria-label="Product filters">
          {% render 'sabpuja-collection-filters', collection: collection, scope: 'desktop', category_menu: section.settings.category_menu %}
        </aside>
      {% endif %}

      <div class="sp-col__results">


        {% paginate collection.products by section.settings.products_per_page %}
          {% if collection.products_count > 0 %}
            <div class="sp-col__grid">
              {% for product in collection.products %}
                {% render 'sabpuja-product-card', product: product %}
              {% endfor %}
            </div>

            {% assign sp_rendered = paginate.current_offset | plus: paginate.page_size %}
            {% if sp_rendered > collection.products_count %}{% assign sp_rendered = collection.products_count %}{% endif %}
            {% assign sp_progress = sp_rendered | times: 100.0 | divided_by: collection.products_count %}
            <div class="sp-col__progress" aria-label="Product browsing progress">
              <div class="sp-col__progress-track" aria-hidden="true"><span class="sp-col__progress-bar" style="width:{{ sp_progress }}%"></span></div>
              <p>Showing {{ paginate.current_offset | plus: 1 }} to {{ sp_rendered }} of {{ collection.products_count }} products</p>
            </div>

            {% if paginate.pages > 1 %}
              <nav class="sp-col__pagination" aria-label="Collection pages">
                {% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}
                <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
                {% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}
              </nav>
            {% endif %}
          {% else %}
            <div class="sp-col__empty">
              <span class="sp-col__empty-mark" aria-hidden="true">✦</span>
              <h2>No products match these filters</h2>
              <p>Clear the current filters or browse all Sabpuja products to continue.</p>
              <a href="{{ collection.url }}">Clear filters</a>
            </div>
          {% endif %}
        {% endpaginate %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{"name":"Sabpuja collection grid","settings":[{"type":"header","content":"Introduction"},{"type":"text","id":"eyebrow","label":"Small heading","default":"Discover Sabpuja"},{"type":"text","id":"intro","label":"Fallback description","default":"Explore puja kits and essentials thoughtfully organized for everyday worship."},{"type":"checkbox","id":"show_product_count","label":"Show introduction product count","default":true},{"type":"header","content":"Category navigation"},{"type":"link_list","id":"category_menu","label":"Collection links menu","default":"main-menu","info":"Only collection links from the chosen Shopify navigation menu are shown."},{"type":"checkbox","id":"show_shop_all","label":"Include Shop All","default":true},{"type":"text","id":"shop_all_label","label":"Shop All text","default":"Shop All"},{"type":"header","content":"Product browsing"},{"type":"range","id":"products_per_page","label":"Products per page","min":8,"max":32,"step":4,"default":20}]}
{% endschema %}
