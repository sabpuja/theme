{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div class='index-information-custom6-inner' data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-information-custom6">
  <div class="index-information-custom6-bg {{ section.settings.display }} {% if section.settings.bkg %}have-bkg{% else %}no-bkg{% endif %} spacing-{{ section.id }}" style="{% if section.settings.bkg %}background-image:url({{ section.settings.bkg | img_url: 'master' }});{% endif %}">    
    <div class="section--bkg" > 
       <img src="{% if section.settings.banner1 %}{{ section.settings.banner1 | img_url : 'master' }}{% else %}{{ '820x530.png' | asset_url }}{% endif %}" alt="{{ section.settings.banner1.alt }}"/>
    </div>   
	{% if settings.index_style == '1' or template contains 'page' %}
     <div class="section--info">
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">  
      <div class="top-area">      
        <div class="title">{{ section.settings.title }}</div>  
        <div class="desc">{{ section.settings.desc }}</div>          
      </div>       
        <div class="bottom-area index-information-grid-container">
          <div class="bottom-information">
            {%- if section.blocks.size > 0 -%}
            <div class="box-content">
              <div class="index-information-grid-list grid-x align-center">
                {%- for block in section.blocks -%}
                <div class="index-information-item cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }}" style="background-color:{{ block.settings.color }}">
                  <div class="effect effect-scope layout-2">
                    <div class="info-icon">                 
                      {% if block.settings.image %}
                      <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image.alt }}"/>
                      {% endif %}               
                    </div>
                    <div class="info-text">
                      {%- if block.settings.title != blank -%}
                      <div class="title">{{ block.settings.title }}</div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
                {%- endfor -%}
              </div>
            </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    </div>
    {% endif %}
  </div>
</div>  


{% schema %}
{
  "name": "Information Custom #6",
  "class": "index-section index-information-custom6",
  "settings": [
	{
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "header",
      "content": "Top Text"
    },
	{
      "type": "image_picker",
      "id": "banner1",
      "label": "Image background"
    },
	{
      "type": "text",
      "id": "title",
      "label": "Title"
    },
	{
      "type": "text",
      "id": "desc",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "information",
      "name": "Information",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "header",
          "content": "Responsive width"
        },
        {
          "type": "select",
          "id": "column_small",
          "label": "Width",
          "info": "For small screen (0px - 550px)",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            }
          ],
          "default": "12"
        },
        {
          "type": "select",
          "id": "column_medium",
          "label": "Width",
          "info": "For medium screen (551px - 800px)",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            }
          ],
          "default": "4"
        },
        {
          "type": "select",
          "id": "column_large",
          "label": "Width",
          "info": "For large screen (801px - 1260px)",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            }
          ],
          "default": "4"
        },
        {
          "type": "select",
          "id": "column_xlarge",
          "label": "Width",
          "info": "For xlarge screen (1261px - infinity)",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            }
          ],
          "default": "4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Information Custom #6",
      "category": "Advanced"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}