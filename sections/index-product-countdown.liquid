{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="products" data-section-name="index-collection-countdown">
  <div class="{% if section.settings.bkg %}_is-bg{% endif %}{{ section.settings.display }} spacing-{{ section.id }}" {% if section.settings.bkg %}style="background-image:url({{ section.settings.bkg | img_url: 'master' }})"{% endif %}>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content"> 
        <div class="index-collection-countdown-container">        
          <div class="box-content">                  
            <div class="product-image effect-{{section.settings.effect}} effect">         
              <a href="{{ section.settings.link }}"><img src="{% if section.settings.banner %}{{ section.settings.banner | img_url: 'master' }}{% else %}{{ '620x620.png' | asset_url }}{% endif %}" alt="{{ section.settings.banner.alt }}"/></a>             
            </div>
            <div class="info-area">
              {% if section.settings.title != '' %}
              <h2 class="box-title">
                {{ section.settings.title }}
              </h2>
              {% endif %}
              {% if section.settings.title2 != '' %}
              <div class="box-desc">
                {{ section.settings.title2 }}
              </div>
              {% endif %}
              {% if section.blocks.size > 0 %}
              <div class="product-spec">
                <div class="spec-name">
                  <ul>
                  {% for block in section.blocks %}
                    <li class="spec-line line-{{forloop.index}}">{{ block.settings.title }}</li>
                  {% endfor %}
                  </ul>
                </div>
                <div class="spec-value">
                  <ul>
                  {% for block in section.blocks %}
                    <li class="spec-line line-{{forloop.index}}">{{ block.settings.title2 }}</li>
                  {% endfor %}
                  </ul>
                </div>
              </div>
              {% endif %}
              <div class="product-price">
                {% if section.settings.price1 != '' %}<div class="price1">{{ section.settings.price1 | money }}</div>{% endif %}
                {% if section.settings.price2 != '' %}<span class="dash"></span><div class="price2"><del>{{ section.settings.price2 | money }}</del></div>{% endif %}
              </div>
              {% if section.settings.countdown %}
              <div class="index-banner-parallax-countdown-timer" data-languages='{"day": "{{ section.settings.day }}", "hours": "{{ section.settings.hours }}", "minutes": "{{ section.settings.minutes }}", "seconds": "{{ section.settings.seconds }}"}' data-timer="deal{{ section.id }}" data-timervalue={{ section.settings.timer }}>
                <div class="timer" data-countdown-timer id="deal{{ section.id }}"></div>
              </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>  
  

