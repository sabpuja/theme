{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banners-custom11">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none index-banner-grid-container">
          <div class="box-content">
            <div class="grid-x bn-position-{{ section.settings.position }}">            
            {% for block in section.blocks %}
            
              {% if block.type == 'banner' %}
              <div class="bannerbig-area effect-{{section.settings.effect}} effect">
                <a href="{{ block.settings.bannerlink }}">
                  <img src="{% if block.settings.banner %}{{ block.settings.banner | img_url:'master' }}{% else %}{{'540x470.png' | asset_url }}{% endif %}" alt="{{ block.settings.banner.alt }}"/>
                </a>
              </div>
              {% elsif block.type == 'banner2' %}
              <div class="bannersmall-caption-area">
                <div class="bannersmall-area effect-{{section.settings.effect}} effect">
                  <a href="{{ block.settings.bannerlink }}">
                    <img src="{% if block.settings.banner %}{{ block.settings.banner | img_url:'master' }}{% else %}{{'450x390.png' | asset_url }}{% endif %}" alt="{{ block.settings.banner.alt }}"/>
                  </a>
                </div>
                <div class="caption-area">
                  <div class="title">{{ block.settings.text }}</div>
                  <div class="action">
                    <a href="{{ block.settings.actionlink }}">{{ block.settings.action }}</a>
                  </div>
                </div>
              </div>
              {% endif %}
            {% endfor %}
            </div>
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


