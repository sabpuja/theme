{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-pricing">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      {%- if section.settings.title != blank -%}
        <div class="box-divider blog-title">
          <h2 class="box-title width-100">{{ section.settings.title }}</h2>          
        </div>
      {%- endif -%}
      <div class="section-content">
        {% case section.blocks.size %}
          {% when 1 %}
            {% assign col = 'cell small-12 medium-12 large-12 xlarge-12' %}
          {% when 2 %}
            {% assign col = 'cell small-12 medium-6 large-6 xlarge-6' %}
          {% when 3 %}
            {% assign col = 'cell small-12 medium-4 large-6 xlarge-4' %}
          {% when 4 %}
            {% assign col = 'cell small-12 medium-6 large-6 xlarge-3' %}
        {% endcase %}
        <div class="pricing-content grid-x">
          {% if section.blocks.size > 0 %}        
            {% for block in section.blocks %}
          	   <div class="index-pricing-item {{ col }}">
                <div class="index-pricing-item-gr">
                      <div class="name">{{ block.settings.title }}</div>
                      <div class="price">{{ block.settings.price }}</div>
                      <div class="options">
                        <ul>
                          {% if block.settings.line1 != '' %}<li>{{ block.settings.line1 }}</li>{% endif %}
                          {% if block.settings.line2 != '' %}<li>{{ block.settings.line2 }}</li>{% endif %}
                          {% if block.settings.line3 != '' %}<li>{{ block.settings.line3 }}</li>{% endif %}
                          {% if block.settings.line4 != '' %}<li>{{ block.settings.line4 }}</li>{% endif %}
                          {% if block.settings.line5 != '' %}<li>{{ block.settings.line5 }}</li>{% endif %}
                        </ul>
                      </div>
                      <div class="action"><a style="background: linear-gradient(90deg, {{section.settings.color1}} 0%, {{section.settings.color2}} 100%);" href="{{ block.settings.url }}">{{ block.settings.action }}</a></div>
                </div>                
               </div>
            {% endfor %}
          {% endif %}
        </div>   
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Pricing",
  "class": "index-section index-pricing",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "title",
      "label": "Title"
    },
	{
      "type": "color",
      "id": "color1",
      "label": "Gradient Color 1"
    },
	{
      "type": "color",
      "id": "color2",
      "label": "Gradient Color 2"
    }
  ],  
  "max_blocks":4,
  "blocks": [	
	{
      "type": "price",
      "name": "Pricing",
      "settings": [        
        {
          "type": "text",
          "id": "title",
          "label": "Name"
        },
		{
          "type": "textarea",
          "id": "price",
          "label": "Price"
        },
		{
          "type": "text",
          "id": "line1",
          "label": "Option #1"
        },
		{
          "type": "text",
          "id": "line2",
          "label": "Option #2"
        },
		{
          "type": "text",
          "id": "line3",
          "label": "Option #3"
        },
		{
          "type": "text",
          "id": "line4",
          "label": "Option #4"
        },
		{
          "type": "text",
          "id": "line5",
          "label": "Option #5"
        },
		{
          "type": "text",
          "id": "action",
          "label": "Action text",
		  "default":"Book your place"
        },
		{
          "type": "url",
          "id": "url",
          "label": "Link to"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pricing",
      "category": "Advanced"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}