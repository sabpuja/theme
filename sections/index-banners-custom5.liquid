{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banners-custom5">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none index-banner-grid-container">
          <div class="box-content">
            <div class="grid-x grid-margin-x">
              {% for block in section.blocks %}
              {% if block.type == 'banner_small' %}
              <div class="index-banner-custom-small">
                <div class="index-banner-custom-item banner-top effect-{{section.settings.effect}} effect">
                  {%- unless block.settings.banner1_image == blank -%}
                  <a href="{{ block.settings.banner1_link }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.banner1_image | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.banner1_image.alt }}" />
                  </a>
                  {% else %}
                  <a href="{{ block.settings.banner1_link }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '380x300.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.banner1_image.alt }}" />
                  </a>
                  {%- endunless -%}
                </div>
                <div class="index-banner-custom-item banner-bottom effect-{{section.settings.effect}} effect">
                  {%- unless block.settings.banner2_image == blank -%}
                  <a href="{{ block.settings.banner2_link }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.banner2_image | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.banner2_image.alt }}" />
                  </a>
                  {% else %}
                  <a href="{{ block.settings.banner2_link }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '380x300.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.banner2_image.alt }}" />
                  </a>
                  {%- endunless -%}
                </div>
              </div>
              {% else %}
              <div class="index-banner-custom-large">
                <div class="index-banner-custom-item effect-{{section.settings.effect}} effect">
                  {%- unless block.settings.banner_image == blank -%}
                  <a href="{{ block.settings.banner_link }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.banner_image | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.banner_image.alt }}" />
                  </a>
                  {% else %}
                  <a href="{{ block.settings.banner_link }}" class="index-banner-grid-image display-block">
                    <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '650x630.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.banner_image.alt }}" />
                  </a>
                  {%- endunless -%}
                </div>
              </div>
              {% endif %}
              {% endfor %}         
            </div>        
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


