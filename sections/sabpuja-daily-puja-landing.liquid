    <section class="sp-daily__benefits">
      <div class="sp-daily__section-head sp-daily__section-head--center">
        <p class="sp-daily__eyebrow">Made for everyday rhythm</p>
        <h2>Less searching. More time for your puja.</h2>
      </div>

      <div class="sp-daily__benefit-grid">
        <article>
          <span class="sp-daily__benefit-icon">{% render 'sabpuja-icon', name: 'clock' %}</span>
