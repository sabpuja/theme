<link href="{{ 'sabpuja-daily-puja-landing.css' | asset_url }}" rel="stylesheet" type="text/css" media="all">

{% assign sp_variant = product.selected_or_first_available_variant %}
{% assign sp_reviews = '01,02,03,04,05,06' | split: ',' %}

<div class="sp-daily" data-sp-daily data-variant-available="{{ sp_variant.available }}">
  <main>
    <section class="sp-daily__hero">
      <div class="sp-daily__hero-media">
        <img
          src="{{ 'sabpuja-daily-puja-kit-hero.webp' | asset_url }}"
          alt="Sabpuja Daily Puja Kit arranged near a warm home mandir"
          width="1448"
          height="1086"
          loading="eager"
          fetchpriority="high">
      </div>

      <div class="sp-daily__hero-copy">
        <nav class="sp-daily__breadcrumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span>/</span>
          <span>{{ product.title }}</span>
        </nav>

        <p class="sp-daily__eyebrow">Everyday worship, thoughtfully prepared</p>
        <h1>Daily Puja, Made Simple.</h1>
        <p class="sp-daily__lede">Keep the essentials for everyday home worship together in one ready kit—easy to store, easy to reach, and easy to make part of your daily routine.</p>

        <div class="sp-daily__hero-points" aria-label="Daily Puja Kit highlights">
          <span>{% render 'sabpuja-icon', name: 'package' %} 18 everyday puja essentials</span>
          <span>{% render 'sabpuja-icon', name: 'home' %} Designed for home mandir use</span>
          <span>{% render 'sabpuja-icon', name: 'truck' %} Delhi NCR · 1–3 business days</span>
        </div>

        <div class="sp-daily__hero-actions">
          <a class="sp-daily__btn sp-daily__btn--primary" href="#daily-puja-buy">Buy Daily Puja Kit</a>
          <a class="sp-daily__btn sp-daily__btn--secondary" href="#daily-puja-contents">See what’s included</a>
        </div>

        <div class="sp-daily__trustline">
          <span>Prepaid online</span>
          <span>Sabpuja support</span>
          <span>Customer stories</span>
        </div>
      </div>
    </section>

    <section class="sp-daily__value-strip" aria-label="Why Daily Puja Kit">
      <article>
        {% render 'sabpuja-icon', name: 'sparkles' %}
        <div><strong>Ready when you are</strong><span>No need to gather common essentials one by one.</span></div>
      </article>
      <article>
        {% render 'sabpuja-icon', name: 'package' %}
        <div><strong>One organized kit</strong><span>A simple format for keeping daily puja items together.</span></div>
      </article>
      <article>
        {% render 'sabpuja-icon', name: 'gift' %}
        <div><strong>Thoughtful for home or gifting</strong><span>A practical devotional choice for families and loved ones.</span></div>
      </article>
    </section>

    <section class="sp-daily__buy-wrap" id="daily-puja-buy">
      <div class="sp-daily__buy-card">
        <div>
          <p class="sp-daily__eyebrow">Daily Puja Kit</p>
          <h2>Everything together. One simple start.</h2>
          <p class="sp-daily__buy-copy">A compact everyday puja kit prepared for regular home worship, aarti and devotional routines.</p>
        </div>

        <div class="sp-daily__buy-panel">
          <div class="sp-daily__price-row">
            <div>
              <span>Price</span>
              <strong>₹{{ sp_variant.price | money_without_currency }}</strong>
            </div>
            {% if sp_variant.sku != blank %}<span class="sp-daily__sku">SKU {{ sp_variant.sku }}</span>{% endif %}
          </div>

          {% form 'product', product, class: 'sp-daily__form', data-sp-daily-form: '' %}
            <input type="hidden" name="id" value="{{ sp_variant.id }}">

            <div class="sp-daily__purchase-row">
              <div>
                <label for="DailyQty-{{ section.id }}">Quantity</label>
                <div class="sp-daily__qty">
                  <button type="button" data-daily-minus aria-label="Decrease quantity">−</button>
                  <input id="DailyQty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric" data-daily-qty>
                  <button type="button" data-daily-plus aria-label="Increase quantity">+</button>
                </div>
              </div>
              <div class="sp-daily__total">
                <span>Total</span>
                <strong data-daily-total>₹{{ sp_variant.price | money_without_currency }}</strong>
              </div>
            </div>

            <button type="submit" class="sp-daily__add">
              {% render 'sabpuja-icon', name: 'shop' %}
              <span>Add to Cart</span>
            </button>
          {% endform %}

          <div class="sp-daily__buy-reassurance">
            <span>{% render 'sabpuja-icon', name: 'truck' %} 1–3 business days in Delhi NCR</span>
            <span>{% render 'sabpuja-icon', name: 'info' %} Prepaid online only</span>
          </div>

          {% unless sp_variant.available %}
            
          {% endunless %}
        </div>
      </div>
    </section>

