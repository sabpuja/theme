          <p>Yes. Use the quantity controls in the buy section to increase or reduce the number of kits before adding to cart.</p>
        </details>
        <details>
          <summary>Can I gift the kit?</summary>
          <p>Yes. Its organized presentation makes it suitable as a practical devotional gift for family members and loved ones.</p>
        </details>
        <details>
          <summary>How can I contact Sabpuja?</summary>
          <p>Email <a href="mailto:support@sabpuja.com">support@sabpuja.com</a> or call <a href="tel:+919667819241">+91 96678 19241</a>, Monday–Saturday, 10am–6pm IST.</p>
        </details>
      </div>
    </section>

    <section class="sp-daily__final">
      <div>
        <p class="sp-daily__eyebrow">Keep the essentials ready</p>
        <h2>Make daily puja preparation one less thing to think about.</h2>
        <p>Choose your quantity, add the kit to your cart, and keep your everyday puja essentials together.</p>
      </div>
      <a class="sp-daily__btn sp-daily__btn--primary" href="#daily-puja-buy">Buy Daily Puja Kit</a>
    </section>
  </main>

  <div class="sp-daily__drawer" data-daily-drawer aria-hidden="true">
    <button class="sp-daily__drawer-backdrop" type="button" data-daily-close aria-label="Close cart preview"></button>
    <aside class="sp-daily__drawer-panel" aria-label="Cart preview">
      <div class="sp-daily__drawer-head">
        <div><strong>Added to cart</strong><span data-daily-drawer-mode></span></div>
        <button type="button" data-daily-close aria-label="Close">×</button>
      </div>
      <div class="sp-daily__drawer-product">
        <img src="{{ 'sabpuja-daily-puja-kit-hero.webp' | asset_url }}" alt="" width="96" height="72">
        <div><strong>{{ product.title }}</strong><span data-daily-drawer-qty>Qty 1</span></div>
        <strong data-daily-drawer-price>₹{{ sp_variant.price | money_without_currency }}</strong>
      </div>
      <div class="sp-daily__drawer-summary"><span>Total</span><strong data-daily-drawer-total>₹{{ sp_variant.price | money_without_currency }}</strong></div>
      {% if sp_variant.available %}
        <a class="sp-daily__drawer-checkout" href="/checkout">Checkout</a>
      {% else %}
        <button class="sp-daily__drawer-checkout sp-daily__drawer-checkout--demo" type="button" disabled>Checkout enabled after inventory approval</button>
      {% endif %}
      <p>Prepaid online · Delhi NCR · 1–3 business days</p>
    </aside>
  </div>

  <div class="sp-daily__sticky">
    <div><span>{{ product.title }}</span><strong>₹{{ sp_variant.price | money_without_currency }}</strong></div>
    <a href="#daily-puja-buy">Choose quantity</a>
  </div>
</div>

<script>
(() => {
  const root = document.querySelector('[data-sp-daily]');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const form = root.querySelector('[data-sp-daily-form]');
  const qty = root.querySelector('[data-daily-qty]');
  const total = root.querySelector('[data-daily-total]');
  const drawer = root.querySelector('[data-daily-drawer]');
  const priceCents = {{ sp_variant.price | default: 0 }};
  const available = {{ sp_variant.available | json }};
  const money = (cents) => new Intl.NumberFormat('en-IN', {style:'currency', currency:'INR', maximumFractionDigits:2}).format(cents / 100);

  const readQty = () => {
    const value = Math.max(1, parseInt(qty?.value || '1', 10) || 1);
    if (qty) qty.value = value;
    return value;
  };

  const refresh = () => {
    if (total) total.textContent = money(priceCents * readQty());
  };

  root.querySelector('[data-daily-minus]')?.addEventListener('click', () => {
    if (qty) qty.value = Math.max(1, readQty() - 1);
    refresh();
  });
  root.querySelector('[data-daily-plus]')?.addEventListener('click', () => {
    if (qty) qty.value = readQty() + 1;
    refresh();
  });
  qty?.addEventListener('change', refresh);

  const openDrawer = (count, cart) => {
    if (!drawer) return;
    const lineTotal = cart?.items?.[cart.items.length - 1]?.final_line_price || priceCents * count;
    const cartTotal = cart?.total_price || priceCents * count;
    drawer.querySelector('[data-daily-drawer-qty]').textContent = 'Qty ' + count;
    drawer.querySelector('[data-daily-drawer-price]').textContent = money(lineTotal);
    drawer.querySelector('[data-daily-drawer-total]').textContent = money(cartTotal);
    drawer.querySelector('[data-daily-drawer-mode]').textContent = available ? 'Your cart is ready.' : 'Demo cart preview — inventory is not yet commercially activated.';
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    document.documentElement.classList.add('sp-daily-lock');
  };

  const closeDrawer = () => {
    drawer?.classList.remove('is-open');
    drawer?.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('sp-daily-lock');
  };

  root.querySelectorAll('[data-daily-close]').forEach((button) => button.addEventListener('click', closeDrawer));

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const count = readQty();
    const button = form.querySelector('.sp-daily__add');
    if (!button) return;

    if (!available) {
      openDrawer(count, null);
      return;
    }

    const original = button.innerHTML;
    button.disabled = true;
    button.textContent = 'Adding…';

    try {
      const addResponse = await fetch('/cart/add.js', {method:'POST', headers:{Accept:'application/json'}, body:new FormData(form)});
      if (!addResponse.ok) throw new Error('Cart add failed');
      const cartResponse = await fetch('/cart.js', {headers:{Accept:'application/json'}});
      if (!cartResponse.ok) throw new Error('Cart fetch failed');
      openDrawer(count, await cartResponse.json());
    } catch (error) {
      form.submit();
      return;
    } finally {
      button.disabled = false;
      button.innerHTML = original;
    }
  });

  const track = root.querySelector('[data-daily-review-track]');
  const step = () => {
    const card = track?.querySelector('.sp-daily__review-card');
    if (!card || !track) return 320;
    const styles = getComputedStyle(track);
    return card.getBoundingClientRect().width + (parseFloat(styles.gap) || 0);
  };
  root.querySelector('[data-daily-review-prev]')?.addEventListener('click', () => track?.scrollBy({left:-step(), behavior:'smooth'}));
  root.querySelector('[data-daily-review-next]')?.addEventListener('click', () => track?.scrollBy({left:step(), behavior:'smooth'}));
})();
</script>

