          <div><b>11</b><span><strong>Cotton Wicks</strong><small>30 pcs</small></span></div>
          <div><b>12</b><span><strong>Supari</strong><small>5 pcs</small></span></div>
          <div><b>13</b><span><strong>Laung</strong><small>10 pcs</small></span></div>
          <div><b>14</b><span><strong>Elaichi</strong><small>10 pcs</small></span></div>
          <div><b>15</b><span><strong>Mishri</strong><small>50 g</small></span></div>
          <div><b>16</b><span><strong>Mauli / Kalava</strong><small>1 roll</small></span></div>
          <div><b>17</b><span><strong>Matchbox</strong><small>1 pc</small></span></div>
