        </figure>
        <aside class="sp-daily__lightbox-review sp-daily__lightbox-review--product">
          <span class="sp-daily__eyebrow">Daily Puja Kit</span>
          <img src="{{ 'sabpuja-daily-puja-kit-hero.webp' | asset_url }}" alt="Daily Puja Kit" width="1448" height="1086" loading="lazy" decoding="async">
          <h3>Everything together. One simple start.</h3>
          <p>View the full review image while keeping the product context visible beside it.</p>
          <a class="sp-daily__btn sp-daily__btn--primary" href="#daily-puja-buy" data-lightbox-close>Choose quantity</a>
