<link href="{{ 'sabpuja-daily-puja-landing.css' | asset_url }}" rel="stylesheet" type="text/css" media="all">

{% assign sp_variant = product.selected_or_first_available_variant %}
{% assign sp_reviews = '01,02,03,04,05,06' | split: ',' %}

<div class="sp-daily" data-sp-daily data-variant-available="{{ sp_variant.available }}">
  <main>
    <section class="sp-daily__hero sp-daily__module" data-reveal>
      <div class="sp-daily__hero-media">
        <img
          src="{{ 'sabpuja-daily-puja-kit-hero.webp' | asset_url }}"
          alt="Sabpuja Daily Puja Kit arranged near a warm home mandir"
          width="1448"
          height="1086"
          loading="eager"
          fetchpriority="high">
        <div class="sp-daily__hero-float" aria-hidden="true">
          <span>🪔</span>
          <div><strong>Everyday-ready</strong><small>One organized puja kit</small></div>
        </div>
      </div>

      <div class="sp-daily__hero-copy">
        <nav class="sp-daily__breadcrumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span>/</span>
          <span>{{ product.title }}</span>
        </nav>

        <div class="sp-daily__hero-chips" aria-label="Product highlights">
          <span>🪔 Daily-ready</span>
          <span>🏠 Home mandir</span>
          <span>🎁 Giftable</span>
        </div>

        <p class="sp-daily__eyebrow">Everyday worship, thoughtfully prepared</p>
        <h1>Daily Puja, Made Simple.</h1>
        <p class="sp-daily__lede">Keep common home-puja essentials together in one ready kit—organized, easy to reach, and simpler to make part of your everyday routine.</p>

        <a class="sp-daily__rating-link" href="#daily-puja-reviews" aria-label="Jump to product photos and review section">
          <span class="sp-daily__stars" aria-hidden="true">
            {% for i in (1..5) %}{% render 'sabpuja-icon', name: 'star' %}{% endfor %}
          </span>
          <strong>See product photos & reviews</strong>
        </a>

        <div class="sp-daily__hero-points" aria-label="Daily Puja Kit highlights">
          <span>{% render 'sabpuja-icon', name: 'package' %}<b>18</b> everyday essentials</span>
          <span>{% render 'sabpuja-icon', name: 'truck' %}<b>1–3 days</b> across Delhi NCR</span>
          <span>{% render 'sabpuja-icon', name: 'shield' %}<b>Prepaid</b> online checkout</span>
        </div>

        <div class="sp-daily__hero-actions">
          <a class="sp-daily__btn sp-daily__btn--primary sp-daily__btn--glow" href="#daily-puja-buy">Buy Daily Puja Kit</a>
          <a class="sp-daily__btn sp-daily__btn--secondary" href="#daily-puja-contents">See what’s included</a>
        </div>
      </div>
    </section>

    <section class="sp-daily__value-strip sp-daily__module" aria-label="Why Daily Puja Kit" data-reveal>
      <article>
        <span class="sp-daily__icon-tile">{% render 'sabpuja-icon', name: 'clock' %}</span>
        <div><strong>Less prep</strong><span>Keep the usual basics close instead of searching each time.</span></div>
      </article>
      <article>
        <span class="sp-daily__icon-tile">{% render 'sabpuja-icon', name: 'package' %}</span>
        <div><strong>One place</strong><span>A compact format for organizing daily puja samagri.</span></div>
      </article>
      <article>
        <span class="sp-daily__icon-tile">{% render 'sabpuja-icon', name: 'heart' %}</span>
        <div><strong>Easy to share</strong><span>Practical for your home or as a thoughtful devotional gift.</span></div>
      </article>
    </section>

    <section class="sp-daily__buy-wrap" id="daily-puja-buy" data-reveal>
      <div class="sp-daily__buy-card sp-daily__module">
        <div class="sp-daily__buy-intro">
          <span class="sp-daily__mini-badge">{% render 'sabpuja-icon', name: 'sparkles' %} Ready for your routine</span>
          <p class="sp-daily__eyebrow">Daily Puja Kit</p>
          <h2>Everything together. One simple start.</h2>
          <p class="sp-daily__buy-copy">A compact everyday kit for regular home worship, aarti and devotional routines—without turning preparation into another task.</p>

          <div class="sp-daily__micro-proof">
            <span>{% render 'sabpuja-icon', name: 'check' %} Organized presentation</span>
            <span>{% render 'sabpuja-icon', name: 'check' %} Quantity control</span>
            <span>{% render 'sabpuja-icon', name: 'check' %} Delhi NCR delivery</span>
          </div>
        </div>

        <div class="sp-daily__buy-panel">
          <div class="sp-daily__price-row">
            <div>
              <span>Price</span>
              <strong>₹{{ sp_variant.price | money_without_currency }}</strong>
            </div>
            {% if sp_variant.sku != blank %}<span class="sp-daily__sku">SKU {{ sp_variant.sku }}</span>{% endif %}
          </div>

          {% form 'product', product, class: 'sp-daily__form', data-sp-daily-form: '' %}
            <input type="hidden" name="id" value="{{ sp_variant.id }}">

            <div class="sp-daily__purchase-row">
              <div class="sp-daily__qty-wrap">
                <label for="DailyQty-{{ section.id }}">Quantity</label>
                <div class="sp-daily__qty">
                  <button type="button" data-daily-minus aria-label="Decrease quantity">−</button>
                  <input id="DailyQty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric" data-daily-qty>
                  <button type="button" data-daily-plus aria-label="Increase quantity">+</button>
                </div>
              </div>
              <div class="sp-daily__total">
                <span>Total</span>
                <strong data-daily-total>₹{{ sp_variant.price | money_without_currency }}</strong>
              </div>
            </div>

            <button type="submit" class="sp-daily__add">
              {% render 'sabpuja-icon', name: 'shop' %}
              <span>Add to Cart</span>
            </button>
          {% endform %}

          <div class="sp-daily__buy-reassurance">
            <span>{% render 'sabpuja-icon', name: 'truck' %}<b>1–3 business days</b><small>Delhi NCR only</small></span>
            <span>{% render 'sabpuja-icon', name: 'shield' %}<b>Prepaid online</b><small>UPI, cards & supported methods</small></span>
          </div>
        </div>
      </div>
    </section>

    <section class="sp-daily__visual-problems sp-daily__module" data-reveal>
      <div class="sp-daily__section-head">
        <div>
          <p class="sp-daily__eyebrow">Why a ready kit helps</p>
          <h2>Small frictions add up fast.</h2>
        </div>
        <p>A visual way to show the everyday problems this kit is meant to simplify.</p>
      </div>
      <div class="sp-daily__visual-card-row">
        <article>
          <span class="sp-daily__visual-emoji">🧭</span>
          <h3>“Where did I keep it?”</h3>
          <p>Frequently used items end up spread across drawers, shelves and boxes.</p>
        </article>
        <article>
          <span class="sp-daily__visual-emoji">⏰</span>
          <h3>Last-minute searching</h3>
          <p>Small missing items can make a simple daily routine feel longer than it should.</p>
        </article>
        <article>
          <span class="sp-daily__visual-emoji">📦</span>
          <h3>Too many loose packets</h3>
          <p>A single organized kit makes everyday storage easier to understand at a glance.</p>
        </article>
        <article>
          <span class="sp-daily__visual-emoji">🎁</span>
          <h3>Gifting without guesswork</h3>
          <p>A ready assortment is easier to present than assembling many individual basics.</p>
        </article>
      </div>
    </section>

    <section class="sp-daily__contents sp-daily__module" id="daily-puja-contents" data-reveal>
      <div class="sp-daily__section-head sp-daily__section-head--full">
        <div>
          <p class="sp-daily__eyebrow">What’s inside</p>
          <h2>18 essentials, one organized view.</h2>
        </div>
        <p>Commonly used home-puja samagri arranged so the everyday basics stay easy to identify and easy to reach.</p>
      </div>

      <div class="sp-daily__contents-layout">
        <figure class="sp-daily__contents-image">
          <img
            src="{{ 'sabpuja-daily-puja-kit-contents.webp' | asset_url }}"
            alt="Sabpuja Daily Puja Kit flat lay showing 18 included puja essentials"
            width="1254"
            height="1254"
            loading="lazy"
            decoding="async">
          <figcaption><span>✨</span> Everything visible at a glance</figcaption>
        </figure>

        <!-- Demo assortment: replace quantities/content when the final commercial BOM is approved. -->
        <div class="sp-daily__contents-list">
          <div><b>01</b><span><strong>Gangajal</strong><small>100 ml</small></span></div>
          <div><b>02</b><span><strong>Gulabjal</strong><small>100 ml</small></span></div>
          <div><b>03</b><span><strong>Agarbatti / Dhoop</strong><small>20–25 sticks</small></span></div>
          <div><b>04</b><span><strong>Roli / Kumkum</strong><small>25 g</small></span></div>
          <div><b>05</b><span><strong>Haldi</strong><small>25 g</small></span></div>
          <div><b>06</b><span><strong>Chandan</strong><small>25 g</small></span></div>
          <div><b>07</b><span><strong>Puja Ghee</strong><small>100 g</small></span></div>
          <div><b>08</b><span><strong>Honey</strong><small>50 g</small></span></div>
          <div><b>09</b><span><strong>Akshat</strong><small>50 g</small></span></div>
          <div><b>10</b><span><strong>Kapoor</strong><small>25 g</small></span></div>
          <div><b>11</b><span><strong>Cotton Wicks</strong><small>30 pcs</small></span></div>
          <div><b>12</b><span><strong>Supari</strong><small>5 pcs</small></span></div>
          <div><b>13</b><span><strong>Laung</strong><small>10 pcs</small></span></div>
          <div><b>14</b><span><strong>Elaichi</strong><small>10 pcs</small></span></div>
          <div><b>15</b><span><strong>Mishri</strong><small>50 g</small></span></div>
          <div><b>16</b><span><strong>Mauli / Kalava</strong><small>1 roll</small></span></div>
          <div><b>17</b><span><strong>Matchbox</strong><small>1 pc</small></span></div>
          <div><b>18</b><span><strong>Puja Diya</strong><small>1 pc</small></span></div>
        </div>
      </div>
    </section>

    <section class="sp-daily__story sp-daily__module" data-reveal>
      <div class="sp-daily__story-copy">
        <span class="sp-daily__mini-badge">{% render 'sabpuja-icon', name: 'package' %} Neat & easy to scan</span>
        <p class="sp-daily__eyebrow">Prepared with care</p>
        <h2>See the details before it reaches your mandir.</h2>
        <p>Clear jars, labeled essentials and a neat presentation make it easier to understand what you have and reach for what you need.</p>
        <div class="sp-daily__story-points">
          <span>{% render 'sabpuja-icon', name: 'check' %} Easy-to-recognize essentials</span>
          <span>{% render 'sabpuja-icon', name: 'check' %} Compact presentation</span>
          <span>{% render 'sabpuja-icon', name: 'check' %} Built around repeat home use</span>
        </div>
      </div>
      <div class="sp-daily__story-media">
        <img
          src="{{ 'sabpuja-daily-puja-kit-detail.webp' | asset_url }}"
          alt="Close-up of Sabpuja Daily Puja Kit packaging and puja essentials"
          width="1254"
          height="1254"
          loading="lazy"
          decoding="async">
      </div>
    </section>

    <section class="sp-daily__how sp-daily__module" data-reveal>
      <div class="sp-daily__section-head sp-daily__section-head--full">
        <div>
          <p class="sp-daily__eyebrow">How it fits into your day</p>
          <h2>Three calm steps. That’s it.</h2>
        </div>
        <p>Use the kit as an organized starting point and follow your own family tradition or priest guidance where appropriate.</p>
      </div>
      <ol class="sp-daily__steps">
        <li><span class="sp-daily__step-icon">{% render 'sabpuja-icon', name: 'home' %}</span><div><b>01</b><strong>Keep it near your mandir</strong><p>Store the kit together so the basics are ready when it is time for puja.</p></div></li>
        <li><span class="sp-daily__step-icon">{% render 'sabpuja-icon', name: 'sparkles' %}</span><div><b>02</b><strong>Use what your tradition calls for</strong><p>Select the samagri relevant to your regular prayer or aarti routine.</p></div></li>
        <li><span class="sp-daily__step-icon">{% render 'sabpuja-icon', name: 'package' %}</span><div><b>03</b><strong>Replenish as needed</strong><p>Replace consumable items as they are used and keep the rest organized.</p></div></li>
      </ol>
    </section>

    <section class="sp-daily__lifestyle sp-daily__module" data-reveal>
      <div class="sp-daily__lifestyle-media">
        <img
          src="{{ 'sabpuja-daily-puja-kit-lifestyle.webp' | asset_url }}"
          alt="Sabpuja Daily Puja Kit being used in a calm home puja setting"
          width="1448"
          height="1086"
          loading="lazy"
          decoding="async">
      </div>
      <div class="sp-daily__lifestyle-copy">
        <span class="sp-daily__mini-badge">{% render 'sabpuja-icon', name: 'heart' %} Made for everyday moments</span>
        <p class="sp-daily__eyebrow">Calm, familiar, practical</p>
        <h2>Prepared to feel at home in your puja space.</h2>
        <p>The kit is designed around everyday worship—not complicated instructions. Keep what you use close, follow your customary practice, and let the setup stay simple.</p>
        <div class="sp-daily__quote-bubble">
          <span>🙏</span>
          <div><small>A simpler daily rhythm</small><strong>Keep everyday essentials together, visible and easy to reach.</strong></div>
        </div>
        <a class="sp-daily__text-link" href="#daily-puja-buy">Choose your quantity {% render 'sabpuja-icon', name: 'arrow-right' %}</a>
      </div>
    </section>

    <section class="sp-daily__reviews sp-daily__module" id="daily-puja-reviews" aria-labelledby="daily-reviews-title" data-demo-reviews="true" data-reveal>
      <div class="sp-daily__marketplace-reviews">
        <aside class="sp-daily__review-summary-panel">
          <h2 id="daily-reviews-title">Customer reviews</h2>

          <div class="sp-daily__review-score-row">
            <span class="sp-daily__stars sp-daily__stars--large" aria-hidden="true">
