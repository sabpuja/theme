  <div class="sp-daily__drawer" data-daily-drawer aria-hidden="true">
    <button class="sp-daily__drawer-backdrop" type="button" data-daily-close aria-label="Close cart preview"></button>
    <aside class="sp-daily__drawer-panel" aria-label="Cart preview">
      <div class="sp-daily__drawer-head">
        <div><strong>Added to cart</strong><span data-daily-drawer-mode></span></div>
        <button type="button" data-daily-close aria-label="Close">×</button>
      </div>
      <div class="sp-daily__drawer-product">
        <img src="{{ 'sabpuja-daily-puja-kit-hero.webp' | asset_url }}" alt="" width="96" height="72">
        <div><strong>{{ product.title }}</strong><span data-daily-drawer-qty>Qty 1</span></div>
        <strong data-daily-drawer-price>₹{{ sp_variant.price | money_without_currency }}</strong>
      </div>
      <div class="sp-daily__drawer-summary"><span>Total</span><strong data-daily-drawer-total>₹{{ sp_variant.price | money_without_currency }}</strong></div>
      {% if sp_variant.available %}
        <a class="sp-daily__drawer-checkout" href="/checkout">Checkout</a>
      {% else %}
        <button class="sp-daily__drawer-checkout sp-daily__drawer-checkout--demo" type="button" disabled>Checkout enabled after inventory approval</button>
      {% endif %}
      <p>Prepaid online · Delhi NCR · 1–3 business days</p>
    </aside>
  </div>
</div>

<script>
(() => {
  const root = document.querySelector('[data-sp-daily]');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const form = root.querySelector('[data-sp-daily-form]');
  const qty = root.querySelector('[data-daily-qty]');
  const total = root.querySelector('[data-daily-total]');
  const drawer = root.querySelector('[data-daily-drawer]');
  const priceCents = {{ sp_variant.price | default: 0 }};
  const available = {{ sp_variant.available | json }};
  const money = (cents) => new Intl.NumberFormat('en-IN', {style:'currency', currency:'INR', maximumFractionDigits:2}).format(cents / 100);

  const readQty = () => {
    const value = Math.max(1, parseInt(qty?.value || '1', 10) || 1);
    if (qty) qty.value = value;
    return value;
  };

  const refresh = () => {
    if (total) total.textContent = money(priceCents * readQty());
  };

  root.querySelector('[data-daily-minus]')?.addEventListener('click', () => {
    if (qty) qty.value = Math.max(1, readQty() - 1);
    refresh();
  });

  root.querySelector('[data-daily-plus]')?.addEventListener('click', () => {
    if (qty) qty.value = readQty() + 1;
    refresh();
  });

  qty?.addEventListener('change', refresh);

  const openDrawer = (count, cart) => {
    if (!drawer) return;
    const lineTotal = cart?.items?.[cart.items.length - 1]?.final_line_price || priceCents * count;
    const cartTotal = cart?.total_price || priceCents * count;
    drawer.querySelector('[data-daily-drawer-qty]').textContent = 'Qty ' + count;
    drawer.querySelector('[data-daily-drawer-price]').textContent = money(lineTotal);
    drawer.querySelector('[data-daily-drawer-total]').textContent = money(cartTotal);
    drawer.querySelector('[data-daily-drawer-mode]').textContent = available ? 'Your cart is ready.' : 'Cart preview — checkout will be available when inventory is activated.';
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    document.documentElement.classList.add('sp-daily-lock');
  };

  const closeDrawer = () => {
    drawer?.classList.remove('is-open');
    drawer?.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('sp-daily-lock');
  };

  root.querySelectorAll('[data-daily-close]').forEach((button) => button.addEventListener('click', closeDrawer));

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const count = readQty();
    const button = form.querySelector('.sp-daily__add');
    if (!button) return;

    if (!available) {
      openDrawer(count, null);
      return;
    }

    const original = button.innerHTML;
    button.disabled = true;
    button.innerHTML = '<span>Adding to cart…</span>';

    try {
      const addResponse = await fetch('/cart/add.js', {method:'POST', headers:{Accept:'application/json'}, body:new FormData(form)});
      if (!addResponse.ok) throw new Error('Cart add failed');
      const cartResponse = await fetch('/cart.js', {headers:{Accept:'application/json'}});
      if (!cartResponse.ok) throw new Error('Cart fetch failed');
      openDrawer(count, await cartResponse.json());
    } catch (error) {
      form.submit();
      return;
    } finally {
      button.disabled = false;
      button.innerHTML = original;
    }
  });

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealItems = [...root.querySelectorAll('[data-reveal]')];

  if (!prefersReduced && 'IntersectionObserver' in window) {
    revealItems.forEach((item) => item.classList.add('sp-daily__reveal-ready'));
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        obs.unobserve(entry.target);
      });
    }, {threshold:0.12, rootMargin:'0px 0px -6% 0px'});
    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }

  const reviews = [...root.querySelectorAll('.sp-daily__review-item')];
  const reviewFilters = [...root.querySelectorAll('[data-review-filter]')];
  const moreButton = root.querySelector('[data-review-more]');
  let expanded = false;
  let activeFilter = 'all';

  const applyReviewState = () => {
    reviews.forEach((review) => {
      const isMore = review.classList.contains('sp-daily__review-item--more');
      const matches = activeFilter === 'all'
        || (activeFilter === '5' && review.dataset.stars === '5')
        || (activeFilter === 'photo' && review.dataset.photo === 'true');
      const visibleByExpansion = activeFilter !== 'all' || expanded || !isMore;
      review.hidden = !(matches && visibleByExpansion);
    });
    if (moreButton) moreButton.hidden = activeFilter !== 'all' || expanded;
  };

  reviewFilters.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = button.dataset.reviewFilter || 'all';
      reviewFilters.forEach((item) => item.classList.toggle('is-active', item === button));
      applyReviewState();
    });
  });

  moreButton?.addEventListener('click', () => {
    expanded = true;
    applyReviewState();
  });

  const lightbox = root.querySelector('[data-daily-lightbox]');
  const lightboxReview = root.querySelector('[data-lightbox-review]');

  const openLightbox = (image) => {
    if (!lightbox || !image) return;
    if (lightboxReview) lightboxReview.src = image;
    if (typeof lightbox.showModal === 'function') {
      if (!lightbox.open) lightbox.showModal();
    } else {
      lightbox.setAttribute('open', '');
    }
    document.documentElement.classList.add('sp-daily-lock');
    lightbox.querySelector('[data-lightbox-close]')?.focus();
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    if (typeof lightbox.close === 'function' && lightbox.open) {
      lightbox.close();
    } else {
      lightbox.removeAttribute('open');
    }
    document.documentElement.classList.remove('sp-daily-lock');
  };

  root.querySelectorAll('[data-review-image-open]').forEach((button) => {
    button.addEventListener('click', () => openLightbox(button.dataset.reviewImage));
  });

  root.querySelectorAll('[data-lightbox-close]').forEach((button) => {
    button.addEventListener('click', closeLightbox);
  });

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  lightbox?.addEventListener('close', () => {
    document.documentElement.classList.remove('sp-daily-lock');
  });

  applyReviewState();
})();
</script>

