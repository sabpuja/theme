{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-menu2">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none index-banner-grid-container">
          {%- if section.settings.title != blank -%}
          <div class="box-divider blog-title">
            <h2 class="box-title width-100" style="font-size:{{ section.settings.titlesize }}px; color:{{ section.settings.color }}; font-weight:{{ section.settings.title_weight}};">{{ section.settings.title }}</h2>            
          </div>
          {%- endif -%}
          <div class="box-content">
            <div class="title-tablist-menu">
              <ul  id="index-menu-tab-{{ section.id }}" class="index-menu-tab-tab grid-x align-center-middle no-bullet" data-tabs>
                {% for block in section.blocks %}
                <li class="tabs-title index-menu-tab-title text-uppercase {% if forloop.first == true %}is-active{% endif %}">
                  <a href="#menu-{{ section.id }}-{{forloop.index}}" class="padding-0">{{ block.settings.title }}</a>
                </li>
                {% endfor %}
              </ul>
            </div>           
            <div class="index-menu-tab-content" data-tabs-content="index-menu-tab-{{ section.id }}">
              {% for block in section.blocks %}
              <div class="tabs-panel padding-0 index-menu-tab-panel {% if forloop.first == true %}is-active{% endif %}" id="menu-{{ section.id }}-{{forloop.index}}">
                <div class="grid-x">                 
                  {% for i in (1..6 ) %}
                  <div class="menu-element menu-{{forloop.index}} cell small-12 medium-6 large-6 xlarge-6 xxlarge-6 xxxlarge-6">                    
                    {% capture banner %}banner{{ i }}{% endcapture %}
                    {% capture link %}banner{{ i }}url{% endcapture %}
                    {% capture name %}banner{{ i }}title{% endcapture %}
                    {% capture desc %}banner{{ i }}desc{% endcapture %}              	
                    {% capture price %}banner{{ i }}price{% endcapture %}
                    {% if block.settings[banner] %}
                    <div class="left-area effect-{{section.settings.effect}} effect">
                      <a class="menu-image" href="{{ block.settings[link] }}">
                        <img src="{{ block.settings[banner] | img_url: 'master' }}" alt="{{ block.settings[banner].alt }}" />
                      </a>
                    </div>              
                    {% endif %}
                    <div class="right-area">
                      <div class="top-line">
                        <div class="menu-name">{{ block.settings[name] }}</div>
                        <div class="menu-price">{{ block.settings[price] | money }}</div>
                      </div>
                      <div class="bottom-line menu-desc">
                        {{ block.settings[desc] }}
                      </div>
                    </div>                     
                  </div>   
                  {% endfor %}
                </div>   
              </div>
              {% endfor %}
            </div>            
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


