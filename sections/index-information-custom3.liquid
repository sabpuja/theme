{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-information-custom3">
  <div class=" {{ section.settings.display }} spacing-{{ section.id }}">
	{% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content index-information-custom2-group {% if section.settings.path %}no-path{% else %}have-path{% endif %}" style="background-color:{{ section.settings.colorbkg }};">
        <div class="index-information-grid-container">
          {%- if section.settings.title != blankk -%}
          <div class="box-divider blog-title">
            <div class="box-toptext">{{ section.settings.title1 }}</div>
            <h2 class="box-title" style="font-size:{{ section.settings.titlesize }}px;">{{ section.settings.title }}</h2>
            <dev class="box-desc">{{ section.settings.desc }}</dev>
          </div>
          {%- endif -%}
          <div class="box-content">
            {%- if section.blocks.size > 0 -%}
            <div class="">
              <div class="index-information-grid-list grid-x grid-margin-x grid-margin-y align-center">
                {%- for block in section.blocks -%}
                <div class="index-information-grid-item cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }}" style="background-color:{{ block.settings.color }}">
                  <div class="info-icon">                 
                    <a href="{{ block.settings.link }}" class="index-information-background display-block" style="background-color:{{ block.settings.color }}">
                      {% if block.settings.image %}
                      <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image.alt }}"/>
                      {% else %}

                      {% endif %}
                    </a>                  
                  </div>
                  <div class="info-text">
                    {%- if block.settings.title != blank -%}
                    <div class="title">{{ block.settings.title }}</div>
                    {%- endif -%}
                  </div>
                </div>              
                {%- endfor -%}
              </div>
            </div>
            {%- endif -%}
          </div>
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div> 


