{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-text-countdown">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{ section.settings.color }};">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="index-text-countdown-container">
          <div class="grid-container">
            <div class="index-text-countdown-content {% if section.settings.title2 !='' %}custom99{% endif %}" style="border:solid {{section.settings.border}}px; {% if section.settings.margin4 %}margin-left:150px; margin-right:150px;{% endif %}">
              {% if section.settings.title !='' %}
              <div class="caption" style="font-size:{{ section.settings.titlesize }}px; color: {{ section.settings.color2 }};">{{ section.settings.title }}</div>
              {% endif %}
              {% if section.settings.countdown %}
              <div class="index-banner-parallax-countdown-timer" style="font-size:{{ section.settings.titlesize2 }}px; color: {{ section.settings.color2 }};" data-languages='{"day": "{{ section.settings.day }}", "hours": "{{ section.settings.hours }}", "minutes": "{{ section.settings.minutes }}", "seconds": "{{ section.settings.seconds }}"}' data-timer="deal{{ section.id }}" data-timervalue={{ section.settings.timer }}>
                <div class="timer" data-countdown-timer id="deal{{ section.id }}"></div>
              </div>
              {% endif %}
              {% if section.settings.title2 !='' %}
              <div class="caption2" style="font-size:{{ section.settings.titlesize }}px; color: {{ section.settings.color2 }};">{{ section.settings.title2 }}</div>
              {% endif %}
            </div>                
          </div>           
        </div>  
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div> 
  
  
{% schema %}
{
  "name": "Text & Countdown",
  "class": "index-section index-text-coutdown",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "checkbox",
      "id": "margin4",
      "label": "Active the Spacing in Left/Right"
    },
    {
      "type": "header",
      "content": "Section settings"
    }, 
	{
      "type":   "range",
      "id":     "border",
      "min":       0,
      "max":       10,
      "step":      1,
      "unit":      "px",
      "label":     "Border Pixel",
      "default":   4
    },
	{
      "type": "textarea",
      "id": "title",
	  "label":"Caption #1"
    },	
	{
      "type":   "range",
      "id":     "titlesize",
      "min":       12,
      "max":       40,
      "step":      1,
      "unit":      "px",
      "label":     "Font size",
      "default":   27
    },
	{
      "type": "color",
      "id": "color2",
      "label": "Color",
	  "default":"#000"
    },
	{
      "type": "checkbox",
      "id": "countdown",
	  "label":"Active Countdown"
    },
	{
      "type": "text",
      "id": "timer",
      "label": "Deal Time",
      "default": "2018-11-25 22:11:00",
	    "info":"Syntax YYYY-MM-DD HH-MM-SS"
    },
	{
      "type": "text",
      "id": "day",
	  "label":"Day"
    },
	{
      "type": "text",
      "id": "hours",
	  "label":"Hours"
    },
	{
      "type": "text",
      "id": "minutes",
	  "label":"Minutes"
    },
	{
      "type": "text",
      "id": "seconds",
	  "label":"Seconds"
    },
	{
      "type":   "range",
      "id":     "titlesize2",
      "min":       12,
      "max":       100,
      "step":      1,
      "unit":      "px",
      "label":     "Font size",
      "default":   14
    },
	{
      "type": "textarea",
      "id": "title2",
	  "label":"Caption #2"
    },
	{
      "type": "color",
      "id": "color",
      "label": "Background Color",
	  "default":"#fff"
    }
  ],
  "presets": [
    {
      "name": "Text & Countdown",
      "category": "Advanced"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}