{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
{% assign padding = section.settings.padding | split: ',' %}
{% assign toppadding = padding[0] %}
{% assign bottompadding = padding[1] %}

<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-parameter">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}" style="{% if section.settings.bkg %}background-image:url({{ section.settings.bkg | img_url: 'master' }}){% endif %}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="parameter-content grid-x" style="padding-top:{{toppadding}}px; padding-bottom:{{bottompadding}}px;">
          {% if section.blocks.size > 0 %}    
          {%- for block in section.blocks -%}
          <div class="parameter-element cell small-{{ block.settings.column_small }} medium-{{ block.settings.column_medium }} large-{{ block.settings.column_large }} xlarge-{{ block.settings.column_xlarge }} content-{% if block.settings.banner %}left{% else %}center{% endif %}">
            <div class="grid-x">
              {% if block.settings.banner %}
              <div class="parameter-icon cell large-3">
                <img src="{{ block.settings.banner | img_url: 'master' }}" alt="{{ block.settings.banner.alt }}" />
              </div>
              {% endif %}
              <div class="parameter-info cell {% if block.settings.banner %}large-9{% else %}large-12{% endif %}">
                <div class="parameter-title">{{ block.settings.title }}</div>
                <div class="parameter-count">{{ block.settings.count }}</div>
              </div>
            </div>
          </div>
          {% endfor %}
          {% endif %}
        </div>  
        {%- if section.settings.bottom != blank -%}
          <div class="bottom-text">{{ section.settings.bottom }}</div>
        {%- endif -%}
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Parameter",
  "class": "index-section index-parameter",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "image_picker",
      "id": "bkg",
      "label": "Image background"
    },
	{
      "type": "textarea",
      "id": "bottom",
      "label": "Bottom Text"
    },
	{
      "type": "text",
      "id": "padding",
      "label": "Style value (Padding)",
	  "default":"55,40",
	  "info":"Top(px),Bottom(px)"
    }
  ],  
  "blocks": [	
	{
      "type": "info",
      "name": "Information",
      "settings": [       
		{
          "type": "image_picker",
          "id": "banner",
          "label": "Icon",
		  "info":"set blank to disable"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
		{
          "type": "text",
          "id": "count",
          "label": "Count"
        },
		{
          "type": "header",
          "content": "Responsive width"
        },
		{
          "type": "select",
          "id": "column_small",
          "label": "Width",
          "info": "For small screen (0px - 550px)",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            },
            {
              "value": "3",
              "label": "1/4"
            }
          ],
          "default": "12"
        },
        {
          "type": "select",
          "id": "column_medium",
          "label": "Width",
          "info": "For medium screen (551px - 800px)",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            },
            {
              "value": "3",
              "label": "1/4"
            }
          ],
          "default": "6"
        },
        {
          "type": "select",
          "id": "column_large",
          "label": "Width",
          "info": "For large screen (801px - 1260px)",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            },
            {
              "value": "3",
              "label": "1/4"
            }
          ],
          "default": "4"
        },
        {
          "type": "select",
          "id": "column_xlarge",
          "label": "Width",
          "info": "For xlarge screen (1261px - infinity)",
          "options": [
            {
              "value": "12",
              "label": "1/1"
            },
            {
              "value": "6",
              "label": "1/2"
            },
            {
              "value": "4",
              "label": "1/3"
            },
            {
              "value": "3",
              "label": "1/4"
            }
          ],
          "default": "4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Parameter",
      "category": "Advanced"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}