{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="advanced" data-section-name="index-links">
  <div class="index-link-bg {{ section.settings.display }} spacing-{{ section.id }}" style="background-color:{{ section.settings.color6 }};">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="pricing-content">
          {%- if section.settings.title != blank -%}
          <div class="box-divider">
            <h2 class="box-title" style="font-size:{{ section.settings.titlesize }}px; color:{{ section.settings.color0 }};">{{ section.settings.title }}</h2>
          </div>
          {%- endif -%}
          <div class="box-content grid-x">
            {% if section.blocks.size > 0 %}        
            {% for block in section.blocks %}
            <div class="index-link-item cell small-{{ section.settings.column_small }} medium-{{ section.settings.column_medium }} large-{{ section.settings.column_large }} xlarge-{{ section.settings.column_xlarge }}">
              <a href="{{ block.settings.url }}" class="link-{{section.id}}-{{block.id}}" style="{% unless section.settings.color7 %}border:2px solid{% endunless %} {{ section.settings.color5}};">{{ block.settings.title }}</a>   
              <style>
                {% unless section.settings.color7 %}
                .link-{{section.id}}-{{block.id}}{
                  color: {{ section.settings.color1 }};
                  background: {{ section.settings.color3 }};                
                }
                .link-{{section.id}}-{{block.id}}:hover{
                  color: {{ section.settings.color2 }};
                  background: {{ section.settings.color4 }};
                }
                {% else %}
                .link-{{section.id}}-{{block.id}}{
                  color: {{ block.settings.color1 }};
                  background: {{ block.settings.color2 }};                
                }
                {% endunless %}
              </style>
            </div>                
            {% endfor %}
            {% endif %}
          </div>
        </div>   
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>

