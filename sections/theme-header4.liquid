<link href="{{ 'sabpuja-staging.css' | asset_url }}" rel="stylesheet" type="text/css" media="all">
<link href="{{ 'sabpuja-header.css' | asset_url }}" rel="stylesheet" type="text/css" media="all">
<link href="{{ 'sabpuja-header-interactions.css' | asset_url }}" rel="stylesheet" type="text/css" media="all">
<script src="{{ 'sabpuja-header.js' | asset_url }}" defer></script>

<div class="sp-announcement" role="status">
  <div class="sp-container">Delhi NCR delivery in 1–3 business days <span aria-hidden="true">•</span> ₹100 flat shipping <span aria-hidden="true">•</span> Prepaid orders</div>
</div>

<header class="sp-site-header sp-site-header-v2{% if section.settings.header_sticky %} sp-header-sticky{% endif %}">
  <div class="sp-header-shell">
    <div class="sp-header-main">
      <a class="sp-header-logo" href="{{ routes.root_url }}" aria-label="Sabpuja home">
