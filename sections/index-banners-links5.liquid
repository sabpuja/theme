{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}
{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banners-links5">
  <div class="{{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content">
        <div class="box border-none banners-content">  
          {%- unless section.settings.bkg == blank -%}
            <a href="{{ section.settings.link }}" class="banners-content-image display-block">
              <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ section.settings.bkg | img_url: 'master' }}" class="width-100 lazyload" alt="{{ section.settings.bkg.alt }}" />
            </a>
          {% else %}
            <a href="{{ section.settings.link }}" class="banners-content-image display-block">
              <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '1470x300.png' | asset_url }}" class="width-100 lazyload" alt="" />
            </a>
          {%- endunless -%}
          <div class="banners-content-caption">
            <div class="caption-linklist-content">
              <div class="caption-linklist">
                <div class="title">{{ section.settings.title }}</div>
                <div class="desc">{{ section.settings.desc }}</div>
                <ul class="listlist no-bullet margin-0">
                  {% for l in linklists[section.settings.linklist].links %}
                  <li class="listlist-element"><a href="{{ l.url }}">{{ l.title }}</a></li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>


{% schema %}
{
  "name": "Banner  & Links #5",
  "class": "index-section index-banners-links5",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "checkbox",
      "id": "full",
      "label": "Show Full width"
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,60,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,50,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,30,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "title",
      "label": "Title"
    },
	{
      "type": "text",
      "id": "desc",
      "label": "Description"
    },
	{
      "type": "link_list",
      "id": "linklist",
      "label": "Link list"
    },	
	{
      "type": "image_picker",
      "id": "bkg",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Banners & Links #5",
      "category": "Image"
    }
  ],
  "templates": ["index","page"]
}
{% endschema %}