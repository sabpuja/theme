{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}
<div data-section-id="{{ section.id }}" data-section-type="slideshow" data-section-name="index-slideshow-custom13">
  <div class="index-slideshow-custom13 index-slideshow-custom13-bg {{ section.settings.display }} spacing-{{ section.id }}">
    {% if settings.index_style == '1' or template contains 'page' %}
    <div class="grid-container">
    {% endif %}
      <div class="section-content">
        <div class="index-slideshow-collections-container" data-section-id="{{ section.id }}">
        <div class="">       
          <div class="collection-slideshow-banner-content">
            <div class="slideshow-banners-content">              
              <div class="slideshow-area">
                <div class="slideshow-area-gr">
                    <div class="index-slideshow-container {{ section.settings.display }} {{ section.settings.navigation_position }}" data-section-id="{{ section.id }}" data-slideshow-param='{"effect": "{{ section.settings.effect }}", "autoplay": "{{ section.settings.autoplay }}", "autoplaySpeed": "{{ section.settings.autoplay_speed }}", "height": "{{ section.settings.slideshow_height }}", "width": "{{ section.settings.slideshow_width }}"}' data-index-slideshow>
                      {%- assign slideshow_size = section.settings.slideshow_width | append: 'x' | append: section.settings.slideshow_height -%}
                      {%- if section.blocks.size > 0 -%}
                      <div class="swiper-container" data-slideshow-container>
                        <div class="swiper-wrapper">
                          {%- for block in section.blocks -%}
                          {%- if block.type == 'image' -%}
                          <div class="swiper-slide" data-slideshow-slide-type="image" data-slideshow-slide>
                            {%- if block.settings.link != blank and block.settings.action == blank -%}
                            <a class="index-slideshow-link" href="{{ block.settings.link }}"></a>
                            {%- endif -%}
                            <div class="index-slideshow-background">
                              {%- if forloop.first == true -%}
                              {% if block.settings.background %}
                              <img src="{{ block.settings.background | img_url: slideshow_size }}" alt="{{ block.settings.background.alt }}" />
                              {% else %}
                              <img src="{{ '720x600.png' | asset_url }}" alt="" />
                              {% endif %}
                              {%- else -%}
                              {% if block.settings.background %}
                              <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.background | img_url: slideshow_size }}" alt="{{ block.settings.background.alt }}" class="swiper-lazy" />
                              {% else %}
                              <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '720x600.png' | asset_url }}" alt="" class="swiper-lazy" />
                              {% endif %}
                              {%- endif -%}
                            </div>
                            {%- if block.settings.title != blank -%}
                            <div class="index-slideshow-caption index-slideshow-caption-title {{ block.settings.title_style }}">
                              <div class="animated" data-slideshow-caption='{"type": "text", "positionX": "{{ block.settings.title_x }}", "positionY": "{{ block.settings.title_y }}", "zIndex": "{{ block.settings.title_z }}", "align" : "{{ block.settings.title_align }}", "entranceEffect": "{{ block.settings.entrance_effect }}", "exitEffect": "{{ block.settings.exit_effect }}"}'>{{ block.settings.title }}</div>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.description != blank -%}
                            <div class="index-slideshow-caption index-slideshow-caption-description {{ block.settings.description_style }}">
                              <div class="animated" data-slideshow-caption='{"type": "text", "positionX": "{{ block.settings.description_x }}", "positionY": "{{ block.settings.description_y }}", "zIndex": "{{ block.settings.description_z }}", "align" : "{{ block.settings.description_align }}", "entranceEffect": "{{ block.settings.entrance_effect }}", "exitEffect": "{{ block.settings.exit_effect }}"}'>{{ block.settings.description }}</div>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.action != blank -%}
                            <div class="index-slideshow-caption index-slideshow-caption-action {{ block.settings.action_style }}">
                              <a href="{{ block.settings.link }}" class="flex-container align-middle animated" data-slideshow-caption='{"type": "text", "positionX": "{{ block.settings.action_x }}", "positionY": "{{ block.settings.action_y }}", "zIndex": "{{ block.settings.action_z }}", "align" : "{{ block.settings.action_align }}", "entranceEffect": "{{ block.settings.entrance_effect }}", "exitEffect": "{{ block.settings.exit_effect }}"}'>
                                {{ block.settings.action }}
                              </a>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.caption_1 != blank -%}
                            <div class="index-slideshow-caption index-slideshow-caption-image">
                              <img src="{{ block.settings.caption_1 | img_url: 'master' }}" alt="{{ block.settings.caption_1.alt }}" class="animated" data-slideshow-caption='{"type": "image", "positionX": "{{ block.settings.caption_1_x }}", "positionY": "{{ block.settings.caption_1_y }}", "zIndex": "{{ block.settings.caption_1_z }}", "align" : "{{ block.settings.caption_1_align }}", "entranceEffect": "{{ block.settings.entrance_effect }}", "exitEffect": "{{ block.settings.exit_effect }}"}'/>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.caption_2 != blank -%}
                            <div class="index-slideshow-caption index-slideshow-caption-image">
                              <img src="{{ block.settings.caption_2 | img_url: 'master' }}" alt="{{ block.settings.caption_2.alt }}" class="animated" data-slideshow-caption='{"type": "image", "positionX": "{{ block.settings.caption_2_x }}", "positionY": "{{ block.settings.caption_2_y }}", "zIndex": "{{ block.settings.caption_2_z }}", "align" : "{{ block.settings.caption_2_align }}", "entranceEffect": "{{ block.settings.entrance_effect }}", "exitEffect": "{{ block.settings.exit_effect }}"}'/>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.caption_3 != blank -%}
                            <div class="index-slideshow-caption index-slideshow-caption-image">
                              <img src="{{ block.settings.caption_3 | img_url: 'master' }}" alt="{{ block.settings.caption_3.alt }}" class="animated" data-slideshow-caption='{"type": "image", "positionX": "{{ block.settings.caption_3_x }}", "positionY": "{{ block.settings.caption_3_y }}", "zIndex": "{{ block.settings.caption_3_z }}", "align" : "{{ block.settings.caption_3_align }}", "entranceEffect": "{{ block.settings.entrance_effect }}", "exitEffect": "{{ block.settings.exit_effect }}"}'/>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.caption_4 != blank -%}
                            <div class="index-slideshow-caption index-slideshow-caption-image">
                              <img src="{{ block.settings.caption_4 | img_url: 'master' }}" alt="{{ block.settings.caption_4.alt }}" class="animated" data-slideshow-caption='{"type": "image", "positionX": "{{ block.settings.caption_4_x }}", "positionY": "{{ block.settings.caption_4_y }}", "zIndex": "{{ block.settings.caption_4_z }}", "align" : "{{ block.settings.caption_4_align }}", "entranceEffect": "{{ block.settings.entrance_effect }}", "exitEffect": "{{ block.settings.exit_effect }}"}'/>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.caption_5 != blank -%}
                            <div class="index-slideshow-caption index-slideshow-caption-image">
                              <img src="{{ block.settings.caption_5 | img_url: 'master' }}" alt="{{ block.settings.caption_5.alt }}" class="animated" data-slideshow-caption='{"type": "image", "positionX": "{{ block.settings.caption_5_x }}", "positionY": "{{ block.settings.caption_5_y }}", "zIndex": "{{ block.settings.caption_5_z }}", "align" : "{{ block.settings.caption_5_align }}", "entranceEffect": "{{ block.settings.entrance_effect }}", "exitEffect": "{{ block.settings.exit_effect }}"}'/>
                            </div>
                            {%- endif -%}
                            {%- if block.settings.caption_6 != blank -%}
                            <div class="index-slideshow-caption index-slideshow-caption-image">
                              <img src="{{ block.settings.caption_6 | img_url: 'master' }}" alt="{{ block.settings.caption_6.alt }}" class="animated" data-slideshow-caption='{"type": "image", "positionX": "{{ block.settings.caption_6_x }}", "positionY": "{{ block.settings.caption_6_y }}", "zIndex": "{{ block.settings.caption_6_z }}", "align" : "{{ block.settings.caption_6_align }}", "entranceEffect": "{{ block.settings.entrance_effect }}", "exitEffect": "{{ block.settings.exit_effect }}"}'/>
                            </div>
                            {%- endif -%}
                          </div>
                          {%- endif -%}
                          {%- if block.type == 'video' -%}
                          <div class="swiper-slide" data-slideshow-slide-type="video" data-slideshow-slide>
                            <div id="slideshow-video-container-{{ block.id }}" class="index-slideshow-video-container" data-slideshow-video='{"type": "{{ block.settings.video_type }}", "id": "{{ block.settings.video_url.id }}", "autoplay": "{{ block.settings.autoplay }}"}'>
                              {%- if block.settings.image != blank -%}
                              {%- if forloop.first == true -%}
                              <img src="{{ block.settings.image | img_url: slideshow_size }}" alt="{{ block.settings.image.alt }}"/>
                              {%- else -%}
                              <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image | img_url: slideshow_size }}" alt="{{ block.settings.image.alt }}" class="swiper-lazy"/>
                              {%- endif -%}
                              {%- endif -%}
                              <div class="index-slideshow-video-loader"></div>
                              <div data-id="{{ block.settings.video_url.id }}" data-slideshow-video-place></div>
                            </div>
                          </div>
                          {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>
                      {%- if section.settings.pagination -%}
                      <!-- If we need pagination -->
                      <div class="index-slideshow-pagination" data-slideshow-pagination></div>
                      {%- endif -%}
                      {%- if section.settings.navigation -%}
                      <!-- If we need navigation buttons -->
                      <div class="index-slideshow-navigation index-slideshow-nav-prev show-for-large" data-slideshow-nav-prev><em class="sli sli-arrow-left"></em></div>
                      <div class="index-slideshow-navigation index-slideshow-nav-next show-for-large" data-slideshow-nav-next><em class="sli sli-arrow-right"></em></div>
                      {%- endif -%}
                      {%- else -%}
                      <div class="text-center">
                        {{ 'homepage.onboarding.no_content' | t }}
                      </div>
                      {%- endif -%}
                    </div>
                </div>                                
              </div>
              <div class="products-slider-area">   
                <div class="top-slider">
                  {% if section.settings.slimit1 != '' %}
                  <div class="title-bar">
                    <div class="slider-title">
                      {{ section.settings.slimit1 }}
                    </div>
                    {% if section.settings.shopall != '' %}
                    <div class="shopall">{{ section.settings.shopall }}</div>
                    {% endif %}
                  </div>
                  {% endif %}
                  <div class="carousel" data-carousel-param='{"effect": "{{ section.settings.effect1 }}", "autoplay": "{{ section.settings.autoplay1 }}", "autoplaySpeed": "{{ section.settings.autoplay_speed1 }}", "space": "{{ section.settings.space1 }}", "column_small": "{{ section.settings.column_small1 }}", "column_medium": "{{ section.settings.column_medium1 }}", "column_large": "{{ section.settings.column_large1 }}", "column_xlarge": "{{ section.settings.column_xlarge1 }}", "column_xxlarge": "{{ section.settings.column_xxlarge1 }}", "column_xxxlarge": "{{ section.settings.column_xxxlarge1 }}", "row": "{{ section.settings.row1 }}"}' data-carousel>
                    <div class="carousel-wrapper carousel-{{ section.settings.navigation_position1 }}">
                      <div class="swiper-container" data-carousel-container>
                        <div class="swiper-wrapper grid-margin-x small-up-{{ section.settings.column_small1 }} medium-up-{{ section.settings.column_medium1 }} large-up-{{ section.settings.column_large1 }} xlarge-up-{{ section.settings.column_xlarge1 }} xxlarge-up-{{ section.settings.column_xxlarge1 }} xxxlarge-up-{{ section.settings.column_xxxlarge1 }}">
                          {%- if  section.settings.image_width and section.settings.image_height -%}
                          {%- assign product_image_size = section.settings.image_width | append: 'x' | append: section.settings.image_height -%}
                          {%- elsif section.settings.image_width -%}
                          {%- assign product_image_size = section.settings.image_width | append: 'x' -%}
                          {%- elsif section.settings.image_height -%}
                          {%- assign product_image_size = 'x' | append: section.settings.image_height -%}
                          {%- else -%}
                          {%- assign product_image_size = 'master' -%}
                          {%- endif -%}
                          {% for product in collections[section.settings.collection1].products limit:section.settings.limit1 %}
                          <div class="swiper-slide cell" data-carousel-item>
                            <div class="product-grid">
                              {% include 'index-product-item' %} 
                            </div>
                          </div>                          
                          {% endfor %}
                        </div>
                      </div>
                      {%- if section.settings.navigation1 -%}
                      <!-- If we need navigation buttons -->
                      <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                      <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                      {%- endif -%}
                    </div>
                    {%- if section.settings.pagination1 -%}
                    <!-- If we need pagination -->
                    <div class="carousel-pagination" data-carousel-pagination></div>
                    {%- endif -%}
                  </div>
                </div>  
                <div class="bottom-slider">
                  {% if section.settings.slimit2 != '' %}
                  <div class="title-bar">
                    <div class="slider-title">
                      {{ section.settings.slimit2 }}
                    </div>
                    {% if section.settings.countdown != '' %}
                    <div class="right-countdown">
                      <div class="text">{{ section.settings.title2 }}</div>
                      <div class="index-countdown-timer" data-languages='{"day": "{{ section.settings.day }}", "hours": "{{ section.settings.hours }}", "minutes": "{{ section.settings.minutes }}", "seconds": "{{ section.settings.seconds }}"}' data-timer="deal{{ section.id }}" data-timervalue={{ section.settings.timer }}>
                        <div class="timer" data-countdown-timer id="deal{{ section.id }}"></div>
                      </div>
                    </div>
                    {% endif %}
                  </div>
                  {% endif %}
                  <div class="carousel" data-carousel-param='{"effect": "{{ section.settings.effect2 }}", "autoplay": "{{ section.settings.autoplay2 }}", "autoplaySpeed": "{{ section.settings.autoplay_speed2 }}", "space": "{{ section.settings.space2 }}", "column_small": "{{ section.settings.column_small2 }}", "column_medium": "{{ section.settings.column_medium2 }}", "column_large": "{{ section.settings.column_large2 }}", "column_xlarge": "{{ section.settings.column_xlarge2 }}", "column_xxlarge": "{{ section.settings.column_xxlarge2 }}", "column_xxxlarge": "{{ section.settings.column_xxxlarge2 }}", "row": "{{ section.settings.row2 }}"}' data-carousel>
                    <div class="carousel-wrapper carousel-{{ section.settings.navigation_position2 }}">
                      <div class="swiper-container" data-carousel-container>
                        <div class="swiper-wrapper grid-margin-x small-up-{{ section.settings.column_small2 }} medium-up-{{ section.settings.column_medium2 }} large-up-{{ section.settings.column_large2 }} xlarge-up-{{ section.settings.column_xlarge2 }} xxlarge-up-{{ section.settings.column_xxlarge2 }} xxxlarge-up-{{ section.settings.column_xxxlarge2 }}">
                          {%- if  section.settings.image_width and section.settings.image_height -%}
                          {%- assign product_image_size = section.settings.image_width | append: 'x' | append: section.settings.image_height -%}
                          {%- elsif section.settings.image_width -%}
                          {%- assign product_image_size = section.settings.image_width | append: 'x' -%}
                          {%- elsif section.settings.image_height -%}
                          {%- assign product_image_size = 'x' | append: section.settings.image_height -%}
                          {%- else -%}
                          {%- assign product_image_size = 'master' -%}
                          {%- endif -%}
                          {% for product in collections[section.settings.collection2].products limit:section.settings.limit2 %}
                          <div class="swiper-slide cell" data-carousel-item>
                            <div class="product-grid">
                              {% include 'index-product-item-grid' %} 
                            </div>
                          </div>                          
                          {% endfor %}
                        </div>
                      </div>
                      {%- if section.settings.navigation2 -%}
                      <!-- If we need navigation buttons -->
                      <div class="carousel-navigation carousel-nav-prev" data-carousel-nav-prev><em class="sli sli-arrow-left"></em></div>
                      <div class="carousel-navigation carousel-nav-next" data-carousel-nav-next><em class="sli sli-arrow-right"></em></div>
                      {%- endif -%}
                    </div>
                    {%- if section.settings.pagination2 -%}
                    <!-- If we need pagination -->
                    <div class="carousel-pagination" data-carousel-pagination></div>
                    {%- endif -%}
                  </div>
                </div> 
              </div>
            </div>
          </div>
        </div>
      </div>
      </div>
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    </div>
    {% endunless %}
    {% endif %}
  </div>
</div>  
  
  
{% schema %}
{
  "name": "Slideshow & Products",
  "class": "index-slideshow slideshow-custom13",
  "max_blocks": 10,
  "settings": [
	{
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display on",
      "options": [
        {
          "value": "",
          "label": "Desktop & Mobile"
        },
        {
          "value": "show-for-large",
          "label": "Desktop only"
        },
        {
          "value": "hide-for-large",
          "label": "Mobile only"
        }
      ],
      "default": ""
    },
	{
      "type": "text",
      "id": "margin1",
      "label": "Desktop: Section Spacing value",
	  "default":"0,0,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin2",
      "label": "Tablet: Section Spacing value",
	  "default":"0,0,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "text",
      "id": "margin3",
      "label": "Mobile: Section Spacing value",
	  "default":"0,0,0,0",
	  "info":"Margin-Top(px),Margin-Bottom(px), Padding-Top(px),Padding-Bottom(px)"
    },
	{
      "type": "header",
      "content": "Products Top Slider"
    },
	{
      "type": "text",
      "id": "slimit1",
      "label": "Title"
    },
	{
      "type": "text",
      "id": "shopall",
      "label": "Shop All text",
      "default": "Shop All >"
    },
	{
      "type": "collection",
      "id": "collection1",
      "label": "Select collection to show products"
    },
	{
      "type": "text",
      "id": "limit1",
      "label": "Limit products",
	  "default": "3"
    },
	{
      "type": "number",
      "id": "image_width",
      "label": "Image Width",
      "info": "Must be set a non-zero number",
      "default": 450
    },
    {
      "type": "number",
      "id": "image_height",
      "label": "Image Height",
      "info": "Must be set a non-zero number",
      "default": 577
    },
	{
      "type": "checkbox",
      "id": "autoplay1",
      "label": "Auto-play slides",
      "default": true
    },
    {
      "type": "select",
      "id": "autoplay_speed1",
      "label": "Change slides every",
      "options": [
        {
          "value": "3000",
          "label": "3 seconds"
        },
        {
          "value": "4000",
          "label": "4 seconds"
        },
        {
          "value": "5000",
          "label": "5 seconds"
        },
        {
          "value": "6000",
          "label": "6 seconds"
        },
        {
          "value": "7000",
          "label": "7 seconds"
        },
        {
          "value": "8000",
          "label": "8 seconds"
        },
        {
          "value": "9000",
          "label": "9 seconds"
        },
        {
          "value": "10000",
          "label": "10 seconds"
        }
      ],
      "default": "5000"
    },
	{
      "type": "select",
      "id": "effect1",
      "label": "Slide effect",
      "options": [
        {
          "value": "slide",
          "label": "Sliding"
        },
        {
          "value": "fade",
          "label": "Fading"
        },
        {
          "value": "cube",
          "label": "Cube"
        },
        {
          "value": "flip",
          "label": "Flipping"
        }
      ],
      "default": "slide"
    },
    {
      "type": "number",
      "id": "space1",
      "label": "Space between images",
      "default": 30
    },
	{
      "type": "select",
      "id": "column_small1",
      "label": "Products per row",
      "info": "For small screen (0px - 550px)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "column_medium1",
      "label": "Products per row",
      "info": "For medium screen (551px - 800px)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "column_large1",
      "label": "Products per row",
      "info": "For large screen (801px - 1260px)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
