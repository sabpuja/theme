                    </a>
                    {%- endunless -%}
                  </div>              
                </div>
                <div class="index-banner-grid-item banner-item banner-right cell small-12 medium-4 large-4 xlarge-4">
                  <div class="background effect-{{section.settings.effect}} effect">
                    {%- unless block.settings.image2 == blank -%}
