                    </a>
                    <a href="{{ block.settings.link1 }}" class="no-effect caption-item caption-{{ block.settings.caption-position1 }} display-block">
                      <img src="{{ block.settings.caption1 | img_url: 'master' }}"/>
                    </a>                    
                    {% else %}
