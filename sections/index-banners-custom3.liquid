{%- assign image_size = 'master' -%}
{% assign full = section.settings.full %}
{% assign desktop = section.settings.margin1 | split: ',' %}
{% assign d1 = desktop[0] %}
{% assign d2 = desktop[1] %}
{% assign d3 = desktop[2] %}
{% assign d4 = desktop[3] %}
{% assign tablet = section.settings.margin2 | split: ',' %}
{% assign t1 = tablet[0] %}
{% assign t2 = tablet[1] %}
{% assign t3 = tablet[2] %}
{% assign t4 = tablet[3] %}
{% assign mobile = section.settings.margin3 | split: ',' %}
{% assign m1 = mobile[0] %}
{% assign m2 = mobile[1] %}
{% assign m3 = mobile[2] %}
{% assign m4 = mobile[3] %}

{% style %}  
  @media screen and (min-width: 1261px){
	.spacing-{{ section.id }}{
      margin-top: {{d1}}px;
      margin-bottom: {{d2}}px;
      padding-top: {{d3}}px;
      padding-bottom: {{d4}}px;
    }
  }
  @media screen and (min-width: 801px) and (max-width: 1260px){
    .spacing-{{ section.id }}{
      margin-top: {{t1}}px;
      margin-bottom: {{t2}}px;
      padding-top: {{t3}}px;
      padding-bottom: {{t4}}px;
    }
  }
  @media screen and (max-width: 800px){
	.spacing-{{ section.id }}{
      margin-top: {{m1}}px;
      margin-bottom: {{m2}}px;
      padding-top: {{m3}}px;
      padding-bottom: {{m4}}px;
    }
  }
{% endstyle %}

<div data-section-id="{{ section.id }}" data-section-type="banner" data-section-name="index-banners-custom3">
  <div class="bkg-section {{ section.settings.display }} spacing-{{ section.id }}" style="{% if section.settings.bkgp == '1'%} {% if section.settings.bkg %}background-image:url({{ section.settings.bkg | img_url: 'master' }});{% endif %} background-color:{{ section.settings.color }}{% endif %}">
    {% if settings.index_style == '1' or template contains 'page' %}
    {% unless full %}
    <div class="grid-container">
    {% endunless %}
    {% endif %}
      <div class="section-content bkg-section" style="{% if section.settings.bkgp == '2'%} {% if section.settings.bkg %}background-image:url({{ section.settings.bkg | img_url: 'master' }});{% endif %} background-color:{{ section.settings.color }}{% endif %}">
        <div class="box border-none index-banner-grid-container">
          <div class="box-content">
            {%- if section.blocks.size > 0 -%}
            <div class="index-banner-grid-list">
              {%- for block in section.blocks -%}
              {% if block.type == 'banner1' %}
              <div class="bannerstyle-1 grid-x">
                <div class="index-banner-grid-item banner-item banner-left cell small-12 medium-8 large-8 xlarge-8">
                  <div class="background effect-{{section.settings.effect}} effect">
                    {%- unless block.settings.image1 == blank -%}
                    <a href="{{ block.settings.link1 }}" class="index-banner-grid-image display-block">
                      <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image1 | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.image1.alt }}" />
                    </a>
                    {% else %}
                    <a href="{{ block.settings.link1 }}" class="index-banner-grid-image display-block">
                      <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '979x763.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image1.alt }}" />
                    </a>
                    {%- endunless -%}
                  </div>
                  {% if block.settings.caption1 or block.settings.text1 != '' or block.settings.action1 !='' %}
                  <div class="caption align-center">
                    {% if block.settings.caption1 %}
                    <div class="caption-image">
                      <img src="{{ block.settings.caption1 | img_url: 'master' }}" data-src="{{ block.settings.caption1 | img_url: 'master' }}" alt="{{ block.settings.caption1.alt }}" />
                    </div>
                    {% endif %}
                    {% if block.settings.action1 != '' %}
                    <div class="caption-action"><a href="{{ block.settings.link1 }}">{{ block.settings.action1 }}</a></div>
                    {% endif %}
                  </div>
                  {% endif %}
                </div>
                <div class="index-banner-grid-item banner-right cell small-12 medium-4 large-4 xlarge-4">
                  <div class="banner-right-top banner-item ">
                    <div class="background effect-{{section.settings.effect}} effect">
                      {%- unless block.settings.image2 == blank -%}
                      <a href="{{ block.settings.link2 }}" class="index-banner-grid-image display-block">
                        <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image2 | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.image2.alt }}" />                        
                      </a>
                      <a href="{{ block.settings.link2 }}" class="no-effect caption-item caption-{{ block.settings.caption-position2 }} display-block">
                        <img src="{{ block.settings.caption2 | img_url: 'master' }}" />
                      </a>                                            
                      {% else %}
                      <a href="{{ block.settings.link2 }}" class="index-banner-grid-image display-block">
                        <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '488x380.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image2.alt }}" />
                      </a>
                      {%- endunless -%}
                    </div>
                  </div>
                  <div class="banner-right-bottom banner-item">
                    <div class="background effect-{{section.settings.effect}} effect">
                      {%- unless block.settings.image3 == blank -%}
                      <a href="{{ block.settings.link3 }}" class="index-banner-grid-image display-block ">
                        <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ block.settings.image3 | img_url: 'master' }}" class="width-100 lazyload" alt="{{ block.settings.image3.alt }}" />                        
                      </a>
                      <a href="{{ block.settings.link3 }}" class="no-effect caption-item caption-{{ block.settings.caption-position3 }} display-block ">
                        <img src="{{ block.settings.caption3 | img_url: 'master' }}"/>
                      </a>                      
                      {% else %}
                      <a href="{{ block.settings.link3 }}" class="index-banner-grid-image display-block">
                        <img src="{{ 'icon-loader-clock.svg' | asset_url }}" data-src="{{ '488x380.png' | asset_url }}" class="width-100 lazyload" alt="{{ block.settings.image3.alt }}" />
                      </a>
                      {%- endunless -%}
                    </div>
                  </div>
                </div>
              </div>
              {% endif %}
              {% if block.type == 'banner2' %}
              <div class="bannerstyle-2 grid-x">
                <div class="index-banner-grid-item banner-item banner-left cell small-12 medium-4 large-4 xlarge-4">
                  <div class="background effect-{{section.settings.effect}} effect">
                    {%- unless block.settings.image1 == blank -%}
