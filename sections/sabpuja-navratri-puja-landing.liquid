<script>
(() => {
  const root = document.querySelector('[data-sp-navratri]');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const form = root.querySelector('[data-sp-navratri-form]');
  const qty = root.querySelector('[data-navratri-qty]');
  const total = root.querySelector('[data-navratri-total]');
  const drawer = root.querySelector('[data-navratri-drawer]');
  const priceCents = {{ sp_variant.price | default: 0 }};
  const available = {{ sp_variant.available | json }};
  const money = (cents) => new Intl.NumberFormat('en-IN', {style:'currency', currency:'INR', maximumFractionDigits:2}).format(cents / 100);

  const readQty = () => {
    const value = Math.max(1, parseInt(qty?.value || '1', 10) || 1);
    if (qty) qty.value = value;
    return value;
  };

  const refresh = () => {
    if (total) total.textContent = money(priceCents * readQty());
  };

  root.querySelector('[data-navratri-minus]')?.addEventListener('click', () => {
    if (qty) qty.value = Math.max(1, readQty() - 1);
    refresh();
  });

  root.querySelector('[data-navratri-plus]')?.addEventListener('click', () => {
    if (qty) qty.value = readQty() + 1;
    refresh();
  });

  qty?.addEventListener('change', refresh);

  const openDrawer = (count, cart) => {
    if (!drawer) return;
    const lineTotal = cart?.items?.[cart.items.length - 1]?.final_line_price || priceCents * count;
    const cartTotal = cart?.total_price || priceCents * count;
    drawer.querySelector('[data-navratri-drawer-qty]').textContent = 'Qty ' + count;
    drawer.querySelector('[data-navratri-drawer-price]').textContent = money(lineTotal);
    drawer.querySelector('[data-navratri-drawer-total]').textContent = money(cartTotal);
    drawer.querySelector('[data-navratri-drawer-mode]').textContent = available ? 'Your cart is ready.' : 'Cart preview — checkout will be available when inventory is activated.';
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    document.documentElement.classList.add('sp-navratri-lock');
  };

  const closeDrawer = () => {
    drawer?.classList.remove('is-open');
    drawer?.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('sp-navratri-lock');
  };

  root.querySelectorAll('[data-navratri-close]').forEach((button) => button.addEventListener('click', closeDrawer));

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const count = readQty();
    const button = form.querySelector('.sp-navratri__add');
    if (!button) return;

    if (!available) {
      openDrawer(count, null);
      return;
    }

    const original = button.innerHTML;
    button.disabled = true;
    button.innerHTML = '<span>Adding to cart…</span>';

    try {
      const addResponse = await fetch('/cart/add.js', {method:'POST', headers:{Accept:'application/json'}, body:new FormData(form)});
      if (!addResponse.ok) throw new Error('Cart add failed');
      const cartResponse = await fetch('/cart.js', {headers:{Accept:'application/json'}});
      if (!cartResponse.ok) throw new Error('Cart fetch failed');
      openDrawer(count, await cartResponse.json());
    } catch (error) {
      form.submit();
      return;
    } finally {
      button.disabled = false;
      button.innerHTML = original;
    }
  });

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealItems = [...root.querySelectorAll('[data-reveal]')];

  if (!prefersReduced && 'IntersectionObserver' in window) {
    revealItems.forEach((item) => item.classList.add('sp-navratri__reveal-ready'));
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        obs.unobserve(entry.target);
      });
    }, {threshold:0.12, rootMargin:'0px 0px -6% 0px'});
    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }

  const reviews = [...root.querySelectorAll('.sp-navratri__review-item')];
  const reviewFilters = [...root.querySelectorAll('[data-review-filter]')];
  const moreButton = root.querySelector('[data-review-more]');
  let expanded = false;
  let activeFilter = 'all';

  const applyReviewState = () => {
    reviews.forEach((review) => {
      const isMore = review.classList.contains('sp-navratri__review-item--more');
      const matches = activeFilter === 'all'
        || (activeFilter === '5' && review.dataset.stars === '5')
        || (activeFilter === 'photo' && review.dataset.photo === 'true');
      const visibleByExpansion = activeFilter !== 'all' || expanded || !isMore;
      review.hidden = !(matches && visibleByExpansion);
    });
    if (moreButton) moreButton.hidden = activeFilter !== 'all' || expanded;
  };

  reviewFilters.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = button.dataset.reviewFilter || 'all';
      reviewFilters.forEach((item) => item.classList.toggle('is-active', item === button));
      applyReviewState();
    });
  });

  moreButton?.addEventListener('click', () => {
    expanded = true;
    applyReviewState();
  });

  const lightbox = root.querySelector('[data-navratri-lightbox]');
  const lightboxReview = root.querySelector('[data-lightbox-review]');

  const openLightbox = (image) => {
    if (!lightbox || !image) return;
    if (lightboxReview) lightboxReview.src = image;
    if (typeof lightbox.showModal === 'function') {
      if (!lightbox.open) lightbox.showModal();
    } else {
      lightbox.setAttribute('open', '');
    }
    document.documentElement.classList.add('sp-navratri-lock');
    lightbox.querySelector('[data-lightbox-close]')?.focus();
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    if (typeof lightbox.close === 'function' && lightbox.open) {
      lightbox.close();
    } else {
      lightbox.removeAttribute('open');
    }
    document.documentElement.classList.remove('sp-navratri-lock');
  };

  root.querySelectorAll('[data-review-image-open]').forEach((button) => {
    button.addEventListener('click', () => openLightbox(button.dataset.reviewImage));
  });

  root.querySelectorAll('[data-lightbox-close]').forEach((button) => {
    button.addEventListener('click', closeLightbox);
  });

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  lightbox?.addEventListener('close', () => {
    document.documentElement.classList.remove('sp-navratri-lock');
  });

  applyReviewState();
})();
</script>

