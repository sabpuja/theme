    <aside class="sp-navratri__drawer-panel" aria-label="Cart preview">
      <div class="sp-navratri__drawer-head">
        <div><strong>Added to cart</strong><span data-navratri-drawer-mode></span></div>
        <button type="button" data-navratri-close aria-label="Close">×</button>
      </div>
      <div class="sp-navratri__drawer-product">
        <img src="https://cdn.shopify.com/s/files/1/0923/1381/3308/files/sabpuja-navratri-hero-banner_d5ca8f09-8c84-44c4-b221-1d9e3bce552e.webp?v=1789736745" alt="" width="96" height="72">
